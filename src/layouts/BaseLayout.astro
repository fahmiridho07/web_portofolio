---
import SiteFooter from "@components/SiteFooter.astro";
import SiteHeader from "@components/SiteHeader.astro";
import { profile } from "@data/profile";
import { defaultOg, formatDocumentTitle, siteBrand } from "@data/seo";
import {
  getOpenGraphImage,
  getPersonSchema,
  getWebSiteSchema,
  serializeJsonLd,
} from "@lib/seo";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
  ogImagePath?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: "website" | "article";
}

const {
  title,
  description,
  jsonLd,
  robots,
  ogImagePath = defaultOg.imagePath,
  ogImageAlt = defaultOg.imageAlt,
  ogImageWidth,
  ogImageHeight,
  ogType = defaultOg.type,
} = Astro.props;
const pageTitle = formatDocumentTitle(title);
const siteUrl = Astro.site?.href ?? Astro.url.origin;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ogImage = getOpenGraphImage(siteUrl, ogImagePath, {
  width: ogImageWidth,
  height: ogImageHeight,
  alt: ogImageAlt,
});
const identityLinks = profile.links.filter((link) => link.href.startsWith("http"));
const structuredData = [
  getPersonSchema(siteUrl),
  getWebSiteSchema(siteUrl),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {robots ? <meta name="robots" content={robots} /> : null}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f3f6fb" />
    <link rel="canonical" href={canonicalUrl} />
    {identityLinks.map((link) => <link rel="me" href={link.href} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
    />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteBrand} />
    <meta property="og:locale" content={defaultOg.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.url} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
    <style is:inline>
      html,
      body {
        background: #f3f6fb;
        color: #111827;
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <SiteHeader />
      <main id="main" class="content-frame">
        <slot />
      </main>
      <SiteFooter />
    </div>

    <script>
      const revealItems = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          {
            rootMargin: "0px 0px -12% 0px",
            threshold: 0.12,
          },
        );

        revealItems.forEach((item) => {
          const delay = item.dataset.revealDelay;

          if (delay) {
            item.style.setProperty("--reveal-delay", `${delay}ms`);
          }

          observer.observe(item);
        });
      }
    </script>
  </body>
</html>

<style>
  .content-frame {
    position: relative;
    z-index: 1;
  }
</style>