---
import SiteFooter from "@components/SiteFooter.astro";
import SiteHeader from "@components/SiteHeader.astro";
import { getPersonSchema, getWebSiteSchema, serializeJsonLd } from "@lib/seo";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, jsonLd } = Astro.props;
const pageTitle = title.includes("Portfolio") ? title : `${title} | Portfolio`;
const siteUrl = Astro.site?.href ?? Astro.url.origin;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ogImageUrl = new URL("/og-image.png", Astro.site ?? Astro.url).href;
const ogImageAlt =
  "Achmad Fahmi Ainur Ridho portfolio preview for data products, machine learning systems, and workflow automation.";
const structuredData = [
  getPersonSchema(siteUrl),
  getWebSiteSchema(siteUrl),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f3f6fb" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Achmad Fahmi Ainur Ridho Portfolio" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
    <style is:inline>
      html,
      body {
        background: #f3f6fb;
        color: #111827;
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <SiteHeader />
      <main id="main" class="content-frame">
        <slot />
      </main>
      <SiteFooter />
    </div>

    <script>
      const revealItems = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          {
            rootMargin: "0px 0px -12% 0px",
            threshold: 0.12,
          },
        );

        revealItems.forEach((item) => {
          const delay = item.dataset.revealDelay;

          if (delay) {
            item.style.setProperty("--reveal-delay", `${delay}ms`);
          }

          observer.observe(item);
        });
      }
    </script>
  </body>
</html>

<style>
  .content-frame {
    position: relative;
    z-index: 1;
  }
</style>