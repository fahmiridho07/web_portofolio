---
import SiteFooter from "@components/SiteFooter.astro";
import SiteHeader from "@components/SiteHeader.astro";
import { profile } from "@data/profile";
import { liquidTransition } from "@lib/view-transitions";

import { ClientRouter } from "astro:transitions";
import { defaultOg, formatDocumentTitle, siteBrand } from "@data/seo";
import {
  getOpenGraphImage,
  getPersonSchema,
  getWebSiteSchema,
  serializeJsonLd,
} from "@lib/seo";
import interLatin400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import interLatin500 from "@fontsource/inter/files/inter-latin-500-normal.woff2?url";
import frauncesLatin from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
  ogImagePath?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: "website" | "article";
  articlePublishedTime?: string;
}

const {
  title,
  description,
  jsonLd,
  robots,
  ogImagePath = defaultOg.imagePath,
  ogImageAlt = defaultOg.imageAlt,
  ogImageWidth,
  ogImageHeight,
  ogType = defaultOg.type,
  articlePublishedTime,
} = Astro.props;
const pageTitle = formatDocumentTitle(title);
const siteUrl = Astro.site?.href ?? Astro.url.origin;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ogImage = getOpenGraphImage(siteUrl, ogImagePath, {
  width: ogImageWidth,
  height: ogImageHeight,
  alt: ogImageAlt,
});
const identityLinks = profile.links.filter((link) => link.href.startsWith("http"));
const structuredData = [
  getPersonSchema(siteUrl),
  getWebSiteSchema(siteUrl),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {robots ? <meta name="robots" content={robots} /> : null}
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap.xml" type="application/xml" title="Sitemap" />
    {identityLinks.map((link) => <link rel="me" href={link.href} />)}
    <meta name="theme-color" content="#f7f8f6" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteBrand} />
    <meta property="og:locale" content={defaultOg.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {
      ogType === "article" && articlePublishedTime ? (
        <meta property="article:published_time" content={articlePublishedTime} />
      ) : null
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.url} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={interLatin400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
    <style is:inline>
      html,
      body {
        background: #f7f8f6;
        color: #16181d;
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <SiteHeader />
      <main
        id="main"
        class="content-frame"
        tabindex="-1"
        transition:name="main-content"
        transition:animate={liquidTransition}
      >
        <slot />
      </main>
      <SiteFooter />
    </div>

    <script>
      import { initOnPageLoad } from "@lib/page-script";

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      // Native CSS scroll-driven animations handle reveals without JS
      const nativeReveal = CSS.supports("animation-timeline: view()");

      initOnPageLoad(() => {
        if (nativeReveal) {
          return;
        }

        const revealItems = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));

        if (reduceMotion || !("IntersectionObserver" in window)) {
          revealItems.forEach((item) => item.classList.add("is-visible"));
          return;
        }

        revealItems.forEach((item) => item.classList.remove("is-visible"));

        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                revealObserver.unobserve(entry.target);
              }
            });
          },
          {
            rootMargin: "0px 0px -8% 0px",
            threshold: [0, 0.08, 0.2],
          },
        );

        revealItems.forEach((item) => {
          const delay = item.dataset.revealDelay;

          if (delay) {
            item.style.setProperty("--reveal-delay", `${delay}ms`);
          }

          revealObserver.observe(item);
        });

        return () => revealObserver.disconnect();
      });
    </script>
  </body>
</html>

<style>
  .content-frame {
    position: relative;
    z-index: 1;
  }

  .content-frame:focus {
    outline: none;
  }
</style>