---
// VisualProjectExhibits.astro: Interactive Engineering Lab & Exhibits
// Provides tangible, playful micro-sandboxes where visitors can test algorithms live:
// 1. Fraud Detection: Live anomaly injection & latent space radar
// 2. Route Optimization: Ant colony convergence solver & cluster cycler
// 3. Demand Forecasting: Multi-horizon projection & confidence envelope
---

<section id="work" class="exhibits-section divider">
  <div class="container">
    {/* Header */}
    <div class="exhibits-header" data-reveal>
      <div class="header-tag">
        <span class="tag-pulse"></span>
        <span class="tag-title">Interactive Lab</span>
      </div>
      <h2 class="exhibits-title">Working systems you can test.</h2>
      <p class="exhibits-subhead">
        Real algorithms from my shipped work. Inject anomalies, solve routes,
        and project time horizons before diving into code.
      </p>
    </div>

    {/* The 3 Interactive Exhibits */}
    <div class="exhibits-stack">
      {/* EXHIBIT 1: Fraud Detection */}
      <article class="exhibit-card exhibit-fraud" data-reveal data-card-tilt>
        <div class="exhibit-inner">
          <div class="exhibit-visual">
            <div class="visual-backdrop" aria-hidden="true">
              <div class="grid-mesh"></div>
            </div>

            <div class="visual-interactive-zone">
              <div class="stream-container" data-stream>
                <div class="stream-track" data-fraud-track>
                  <div class="stream-item item-ok">
                    <div class="item-head">
                      <span class="stream-id">TX 4820</span>
                      <span class="stream-amount">$124.50</span>
                    </div>
                    <span class="stream-status ok">&bull; CLEARED</span>
                  </div>
                  <div class="stream-item item-ok">
                    <div class="item-head">
                      <span class="stream-id">TX 4821</span>
                      <span class="stream-amount">$89.00</span>
                    </div>
                    <span class="stream-status ok">&bull; CLEARED</span>
                  </div>
                  <div class="stream-item item-flagged" data-primary-anomaly>
                    <div class="item-head">
                      <span class="stream-id">TX 4822</span>
                      <span class="stream-amount">$4,920.00</span>
                    </div>
                    <span class="stream-status flag">&bull; ANOMALY</span>
                    <span class="stream-radar"></span>
                  </div>
                  <div class="stream-item item-ok">
                    <div class="item-head">
                      <span class="stream-id">TX 4823</span>
                      <span class="stream-amount">$32.10</span>
                    </div>
                    <span class="stream-status ok">&bull; CLEARED</span>
                  </div>
                  <div class="stream-item item-ok">
                    <div class="item-head">
                      <span class="stream-id">TX 4824</span>
                      <span class="stream-amount">$215.80</span>
                    </div>
                    <span class="stream-status ok">&bull; CLEARED</span>
                  </div>
                  <div class="stream-item item-ok">
                    <div class="item-head">
                      <span class="stream-id">TX 4825</span>
                      <span class="stream-amount">$14.50</span>
                    </div>
                    <span class="stream-status ok">&bull; CLEARED</span>
                  </div>
                </div>
                <div class="scanner-laser" aria-hidden="true"></div>
              </div>

              {/* Interactive Lab Control Bar */}
              <div class="lab-control-bar">
                <button
                  type="button"
                  class="lab-action-btn"
                  data-inject-fraud
                  aria-label="Inject simulated fraudulent transaction"
                >
                  <span class="btn-icon">&plus;</span>
                  <span>Inject Anomaly Payload</span>
                </button>
                <div class="lab-status-pill" data-fraud-status>
                  <span class="status-dot"></span>
                  <span class="status-msg"
                    >Scanner active &middot; 1:590 Imbalance</span
                  >
                </div>
              </div>
            </div>
          </div>

          <div class="exhibit-copy">
            <div class="copy-badge">01 &middot; Machine Learning</div>
            <h3 class="copy-title">
              <a
                href="/projects/fraud-detection-ml-pipeline/"
                class="title-link"
              >
                Fraud Detection Pipeline
              </a>
            </h3>
            <p class="copy-desc">
              Detecting fraudulent payment transactions under heavy class
              imbalance using latent oversampling and LightGBM.
            </p>

            <div class="metric-preview-row">
              <div class="metric-block">
                <span class="m-val">0.855</span>
                <span class="m-lbl">PR-AUC</span>
              </div>
              <div class="metric-block">
                <span class="m-val" data-fraud-caught-counter>3,087</span>
                <span class="m-lbl">Caught</span>
              </div>
              <div class="metric-block">
                <span class="m-val">89%</span>
                <span class="m-lbl">Precision</span>
              </div>
            </div>

            <div class="copy-action">
              <a
                href="/projects/fraud-detection-ml-pipeline/"
                class="cta-button"
                data-astro-prefetch="hover"
              >
                <span>View Case Study</span>
                <span class="cta-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </article>

      {/* EXHIBIT 2: Route Optimization */}
      <article class="exhibit-card exhibit-routing" data-reveal data-card-tilt>
        <div class="exhibit-inner">
          <div class="exhibit-visual">
            <div class="visual-backdrop" aria-hidden="true">
              <div class="grid-mesh"></div>
            </div>

            <div class="visual-interactive-zone">
              <svg class="routing-svg" viewBox="0 0 380 220" aria-hidden="true">
                <g class="routing-grid">
                  <line x1="20" y1="55" x2="360" y2="55"></line>
                  <line x1="20" y1="110" x2="360" y2="110"></line>
                  <line x1="20" y1="165" x2="360" y2="165"></line>
                  <line x1="95" y1="20" x2="95" y2="200"></line>
                  <line x1="190" y1="20" x2="190" y2="200"></line>
                  <line x1="285" y1="20" x2="285" y2="200"></line>
                </g>

                {/* Dynamic SVG Routes for Clusters */}
                <g class="aco-paths" data-aco-paths>
                  <path
                    class="route-converged path-active loop-1"
                    d="M40,150 L95,85 L145,115 L80,165 Z"></path>
                  <path
                    class="route-converged path-active loop-2"
                    d="M145,115 L205,55 L255,95 L215,145 Z"></path>
                  <path
                    class="route-converged path-active loop-3"
                    d="M205,55 L285,35 L340,75 L300,125 Z"></path>
                </g>

                {/* Map Nodes */}
                <circle cx="40" cy="150" r="5.5" class="node-depot"></circle>
                <text x="40" y="172" class="node-text">DEPOT</text>
                <circle cx="95" cy="85" r="3.5" class="node-point"></circle>
                <circle cx="145" cy="115" r="3.5" class="node-point"></circle>
                <circle cx="80" cy="165" r="3.5" class="node-point"></circle>
                <circle cx="205" cy="55" r="3.5" class="node-point"></circle>
                <circle cx="255" cy="95" r="3.5" class="node-point"></circle>
                <circle cx="215" cy="145" r="3.5" class="node-point"></circle>
                <circle cx="285" cy="35" r="3.5" class="node-point"></circle>
                <circle cx="340" cy="75" r="3.5" class="node-point"></circle>
                <circle cx="300" cy="125" r="3.5" class="node-point"></circle>
              </svg>

              {/* Interactive Lab Control Bar */}
              <div class="lab-control-bar">
                <button
                  type="button"
                  class="lab-action-btn"
                  data-run-aco
                  aria-label="Run Ant Colony Optimization simulation"
                >
                  <span class="btn-icon">&#x21bb;</span>
                  <span>Solve Optimal Path</span>
                </button>
                <div class="cluster-pill-group">
                  <button
                    type="button"
                    class="cluster-pill is-active"
                    data-cluster="all"
                  >
                    5 Clusters
                  </button>
                  <button
                    type="button"
                    class="cluster-pill"
                    data-cluster="north"
                  >
                    North
                  </button>
                  <button
                    type="button"
                    class="cluster-pill"
                    data-cluster="coast"
                  >
                    Coast
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div class="exhibit-copy">
            <div class="copy-badge">02 &middot; Operations Research</div>
            <h3 class="copy-title">
              <a
                href="/projects/orphanage-inspection-route-optimization/"
                class="title-link"
              >
                Ant Colony Route Optimization
              </a>
            </h3>
            <p class="copy-desc">
              Multi-cluster vehicle routing across 24 inspection sites,
              constrained by operational daylight hours.
            </p>

            <div class="metric-preview-row">
              <div class="metric-block">
                <span class="m-val" data-aco-km-counter>153.34</span>
                <span class="m-lbl">Kilometers</span>
              </div>
              <div class="metric-block">
                <span class="m-val">24</span>
                <span class="m-lbl">Locations</span>
              </div>
              <div class="metric-block">
                <span class="m-val">4,189</span>
                <span class="m-lbl">Iterations</span>
              </div>
            </div>

            <div class="copy-action">
              <a
                href="/projects/orphanage-inspection-route-optimization/"
                class="cta-button"
                data-astro-prefetch="hover"
              >
                <span>View Case Study</span>
                <span class="cta-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </article>

      {/* EXHIBIT 3: Demand Forecasting */}
      <article
        class="exhibit-card exhibit-forecasting"
        data-reveal
        data-card-tilt
      >
        <div class="exhibit-inner">
          <div class="exhibit-visual">
            <div class="visual-backdrop" aria-hidden="true">
              <div class="grid-mesh"></div>
            </div>

            <div class="visual-interactive-zone">
              <svg
                class="forecast-svg"
                viewBox="0 0 380 220"
                aria-hidden="true"
              >
                <polygon
                  points="190,95 260,60 350,40 350,165 260,145 190,95"
                  class="forecast-area"
                  data-forecast-envelope></polygon>

                <path
                  class="forecast-history"
                  d="M30,155 Q70,175 110,130 T160,110 T190,95"></path>

                <path
                  class="forecast-projected"
                  d="M190,95 Q235,75 280,95 T350,85"
                  data-forecast-line></path>

                <line x1="190" y1="20" x2="190" y2="195" class="today-marker"
                ></line>
                <text x="196" y="36" class="today-text">PROJECTED</text>
                <circle cx="190" cy="95" r="4.5" class="forecast-pivot"
                ></circle>
              </svg>

              {/* Interactive Lab Control Bar */}
              <div class="lab-control-bar">
                <span class="lab-label">Horizon:</span>
                <div class="horizon-pill-group">
                  <button
                    type="button"
                    class="horizon-pill is-active"
                    data-horizon="12"
                  >
                    12 Mo
                  </button>
                  <button type="button" class="horizon-pill" data-horizon="24">
                    24 Mo
                  </button>
                  <button type="button" class="horizon-pill" data-horizon="36">
                    36 Mo
                  </button>
                </div>
                <div class="lab-status-pill">
                  <span class="status-msg" data-horizon-status
                    >R&sup2; 0.869 Model Fit</span
                  >
                </div>
              </div>
            </div>
          </div>

          <div class="exhibit-copy">
            <div class="copy-badge">03 &middot; Time Series &amp; ML</div>
            <h3 class="copy-title">
              <a
                href="/projects/juanda-airport-visitor-forecasting/"
                class="title-link"
              >
                Airport Passenger Forecasting
              </a>
            </h3>
            <p class="copy-desc">
              Ten years of monthly passenger traffic modeled to project terminal
              capacity and post-shock recovery curves.
            </p>

            <div class="metric-preview-row">
              <div class="metric-block">
                <span class="m-val">R&sup2; 0.869</span>
                <span class="m-lbl">Accuracy</span>
              </div>
              <div class="metric-block">
                <span class="m-val">120</span>
                <span class="m-lbl">Months Data</span>
              </div>
              <div class="metric-block">
                <span class="m-val">Random Forest</span>
                <span class="m-lbl">Best Fit</span>
              </div>
            </div>

            <div class="copy-action">
              <a
                href="/projects/juanda-airport-visitor-forecasting/"
                class="cta-button"
                data-astro-prefetch="hover"
              >
                <span>View Case Study</span>
                <span class="cta-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </article>
    </div>

    {/* Footer Navigation */}
    <div class="exhibits-footer" data-reveal>
      <a href="/projects/" class="all-projects-btn" data-astro-prefetch="hover">
        Explore full catalogue with 11 projects &amp; case studies
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<script>
  import { initOnPageLoad } from "@lib/page-script";

  initOnPageLoad(() => {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // 1. 3D Tilt & Magnetic Cursor Highlight on Cards
    const tiltCards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-card-tilt]"),
    );
    if (!reduceMotion) {
      tiltCards.forEach((card) => {
        const onMove = (e: MouseEvent) => {
          const rect = card.getBoundingClientRect();
          const x =
            (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2);
          const y =
            (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2);
          const tiltX = -y * 2.8;
          const tiltY = x * 2.8;
          card.style.transform = `perspective(1000px) rotateX(${tiltX}deg) rotateY(${tiltY}deg) translate3d(0, -3px, 0)`;
        };

        const onLeave = () => {
          card.style.transform =
            "perspective(1000px) rotateX(0deg) rotateY(0deg) translate3d(0, 0, 0)";
        };

        card.addEventListener("mousemove", onMove, { passive: true });
        card.addEventListener("mouseleave", onLeave);
      });
    }

    // 2. Interactive Feature: Fraud Anomaly Injection
    const injectBtn = document.querySelector<HTMLButtonElement>(
      "[data-inject-fraud]",
    );
    const fraudTrack =
      document.querySelector<HTMLElement>("[data-fraud-track]");
    const fraudStatus = document.querySelector<HTMLElement>(
      "[data-fraud-status] .status-msg",
    );
    const fraudCounter = document.querySelector<HTMLElement>(
      "[data-fraud-caught-counter]",
    );
    let caughtCount = 3087;

    injectBtn?.addEventListener("click", () => {
      caughtCount += 1;
      if (fraudCounter) {
        fraudCounter.textContent = caughtCount.toLocaleString();
        fraudCounter.style.transform = "scale(1.2)";
        fraudCounter.style.color = "var(--signal)";
        setTimeout(() => {
          fraudCounter.style.transform = "scale(1)";
          fraudCounter.style.color = "var(--ink)";
        }, 300);
      }

      if (fraudStatus) {
        fraudStatus.textContent =
          "Outlier intercepted: TX #9420 ($8,450.00) · 4.82σ distance";
        fraudStatus.style.color = "var(--signal)";
      }

      if (fraudTrack) {
        const newCard = document.createElement("div");
        newCard.className = "stream-item item-flagged newly-injected";
        newCard.innerHTML = `
          <div class="item-head">
            <span class="stream-id">TX 9420</span>
            <span class="stream-amount">$8,450.00</span>
          </div>
          <span class="stream-status flag">&bull; ANOMALY CAUGHT</span>
          <span class="stream-radar"></span>
        `;
        fraudTrack.prepend(newCard);

        setTimeout(() => {
          newCard.classList.remove("newly-injected");
        }, 1200);
      }
    });

    // 3. Interactive Feature: ACO Path Solver
    const runAcoBtn =
      document.querySelector<HTMLButtonElement>("[data-run-aco]");
    const acoPaths =
      document.querySelectorAll<SVGPathElement>(".aco-paths path");
    const kmCounter = document.querySelector<HTMLElement>(
      "[data-aco-km-counter]",
    );
    const clusterPills = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".cluster-pill"),
    );

    runAcoBtn?.addEventListener("click", () => {
      acoPaths.forEach((path) => {
        path.style.strokeDasharray = "300";
        path.style.strokeDashoffset = "300";
        path.style.transition =
          "stroke-dashoffset 900ms cubic-bezier(0.16, 1, 0.3, 1)";
        requestAnimationFrame(() => {
          path.style.strokeDashoffset = "0";
        });
      });

      if (kmCounter) {
        kmCounter.textContent = "184.20";
        setTimeout(() => {
          kmCounter.textContent = "168.10";
        }, 280);
        setTimeout(() => {
          kmCounter.textContent = "153.34";
        }, 650);
      }
    });

    clusterPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        clusterPills.forEach((p) => p.classList.remove("is-active"));
        pill.classList.add("is-active");

        const cluster = pill.dataset.cluster;
        acoPaths.forEach((path, idx) => {
          if (cluster === "all") {
            path.style.opacity = "1";
            path.style.strokeWidth = "2.2";
          } else if (cluster === "north" && idx === 0) {
            path.style.opacity = "1";
            path.style.strokeWidth = "3";
          } else if (cluster === "coast" && idx === 2) {
            path.style.opacity = "1";
            path.style.strokeWidth = "3";
          } else {
            path.style.opacity = "0.2";
            path.style.strokeWidth = "1.5";
          }
        });
      });
    });

    // 4. Interactive Feature: Horizon Projection Switcher
    const horizonPills = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".horizon-pill"),
    );
    const forecastLine = document.querySelector<SVGPathElement>(
      "[data-forecast-line]",
    );
    const forecastEnvelope = document.querySelector<SVGPolygonElement>(
      "[data-forecast-envelope]",
    );
    const horizonStatus = document.querySelector<HTMLElement>(
      "[data-horizon-status]",
    );

    horizonPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        horizonPills.forEach((p) => p.classList.remove("is-active"));
        pill.classList.add("is-active");

        const horizon = pill.dataset.horizon;
        if (horizon === "12") {
          forecastLine?.setAttribute("d", "M190,95 Q235,75 280,95 T350,85");
          forecastEnvelope?.setAttribute(
            "points",
            "190,95 260,60 350,40 350,165 260,145 190,95",
          );
          if (horizonStatus) horizonStatus.textContent = "R² 0.869 Model Fit";
        } else if (horizon === "24") {
          forecastLine?.setAttribute("d", "M190,95 Q240,65 295,85 T370,70");
          forecastEnvelope?.setAttribute(
            "points",
            "190,95 265,48 370,25 370,180 265,155 190,95",
          );
          if (horizonStatus)
            horizonStatus.textContent = "24 Mo Horizon · Upper Bound: +14%";
        } else if (horizon === "36") {
          forecastLine?.setAttribute("d", "M190,95 Q250,55 310,80 T375,60");
          forecastEnvelope?.setAttribute(
            "points",
            "190,95 270,35 375,15 375,195 270,165 190,95",
          );
          if (horizonStatus)
            horizonStatus.textContent =
              "36 Mo Long Horizon · Confidence Interval: 95%";
        }
      });
    });
  });
</script>

<style>
  .exhibits-section {
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
    background: var(--paper);
  }

  .exhibits-header {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 820px;
  }

  .header-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .tag-pulse {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--signal);
    animation: beacon 2s infinite ease-in-out;
  }

  @keyframes beacon {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.85);
    }
  }

  .exhibits-title {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4.8vw, 3.8rem);
    font-weight: 480;
    line-height: 1.12;
    letter-spacing: -0.015em;
  }

  .exhibits-subhead {
    margin: 0;
    color: var(--ink-muted);
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    line-height: 1.65;
    max-width: 58ch;
  }

  /* ------------------- Exhibits Stack ------------------- */
  .exhibits-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .exhibit-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 10px 32px rgba(22, 24, 29, 0.04);
    transition:
      box-shadow 300ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 300ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
    transform-style: preserve-3d;
  }

  .exhibit-card:hover {
    border-color: var(--ink);
    box-shadow: 0 16px 44px rgba(22, 24, 29, 0.08);
  }

  .exhibit-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    min-height: 380px;
  }

  /* ------------------- Visual Area & Interactive Zone ------------------- */
  .exhibit-visual {
    position: relative;
    background: #fcfcfb;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  .visual-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .grid-mesh {
    width: 100%;
    height: 100%;
    background-image:
      linear-gradient(to right, rgba(22, 24, 29, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(22, 24, 29, 0.035) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .visual-interactive-zone {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    gap: 1.25rem;
  }

  /* ------------------- Fraud Stream Track ------------------- */
  .stream-container {
    position: relative;
    overflow: hidden;
    padding: 0.75rem 0;
    border-radius: var(--radius-sm);
    background: var(--paper-soft);
    border: 1px solid var(--line);
  }

  .stream-track {
    display: flex;
    gap: 0.85rem;
    width: max-content;
    will-change: transform;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
    animation: stream-scroll 24s linear infinite;
  }

  .stream-track:hover {
    animation-play-state: paused;
  }

  @keyframes stream-scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

