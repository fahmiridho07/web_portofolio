---
import { profile } from "@data/profile";

const year = new Date().getFullYear();
---

<footer
  class="site-footer glass-backdrop-chrome divider"
  transition:persist="site-footer"
  transition:name="site-footer"
  transition:animate="none"
>
  <div class="container footer-inner">
    <a class="footer-brand" href="/" aria-label={`${profile.name} home`} data-astro-prefetch="hover">
      <span class="mark glass-chip">{profile.mark}</span>
      <span class="name">{profile.shortName}</span>
    </a>

    <p class="year">{year}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--footer-bg);
    padding-block: clamp(1.35rem, 2.5vw, 1.75rem);
    color: var(--text-soft);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-stack-sm) var(--space-stack-lg);
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: inherit;
  }

  .mark {
    display: inline-grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border-radius: var(--radius-pill);
    color: var(--text);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .name {
    color: var(--text);
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .year {
    margin: 0;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.72rem;
    line-height: 1;
  }
</style>