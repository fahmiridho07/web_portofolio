---
import { profile } from "@data/profile";

const year = new Date().getFullYear();
const externalLinks = profile.links.filter((link) =>
  link.href.startsWith("http"),
);
---

<footer
  class="site-footer divider"
  transition:persist="site-footer"
  transition:name="site-footer"
  transition:animate="none"
>
  <div class="container footer-inner">
    <p class="footer-name">{profile.shortName}</p>

    <ul class="footer-links">
      <li><a href={profile.emailHref}>Email</a></li>
      {
        externalLinks.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noreferrer">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="footer-meta">
      Surabaya, ID <span class="footer-dot" aria-hidden="true"></span>
      {year}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--paper);
    padding-block: clamp(1.5rem, 3vw, 2rem);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .footer-name {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    color: var(--ink-muted);
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    transition:
      color var(--motion-fast) var(--ease-standard),
      text-decoration-color var(--motion-fast) var(--ease-standard);
  }

  .footer-links a:hover {
    color: var(--rust);
    text-decoration-color: var(--rust);
  }

  .footer-meta {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1;
  }

  .footer-dot {
    display: inline-block;
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 999px;
    background: var(--signal);
    box-shadow:
      0 0 0 2.5px transparent,
      0 0 0 1px var(--signal) inset;
    outline: 1px solid color-mix(in srgb, var(--signal) 55%, transparent);
    outline-offset: 2px;
    margin-inline: 0.15rem;
    transform: translateY(-0.05rem);
  }
</style>
