---
import { profile } from "@data/profile";
import { getResumeAction } from "@lib/resume";

const year = new Date().getFullYear();
const resumeAction = getResumeAction();

const footerLinks = [
  ...profile.links,
  {
    label: resumeAction.download ? "Resume" : "Resume request",
    href: resumeAction.href,
  },
];
---

<footer class="site-footer divider">
  <div class="container footer-inner">
    <p>
      <span>{profile.name}</span>
      <span>Building practical data products and systems - graduating 2026</span>
    </p>

    <nav aria-label="Footer links">
      {
        footerLinks.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noreferrer" : undefined}
            download={link.href === resumeAction.href && resumeAction.download ? "" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <p class="year">{year}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: rgba(232, 238, 247, 0.42);
    padding-block: 2.2rem;
    color: var(--text-soft);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 1.5rem;
  }

  p {
    margin: 0;
  }

  p:first-child {
    display: grid;
    gap: 0.15rem;
  }

  p:first-child span:first-child {
    color: var(--text);
    font-weight: 500;
  }

  p:first-child span:last-child {
    font-size: 0.86rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.9rem;
  }

  nav a {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  nav a:hover {
    color: var(--accent);
  }

  .year {
    font-family:
      "JetBrains Mono", "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.82rem;
  }

  @media (max-width: 760px) {
    .footer-inner {
      grid-template-columns: 1fr;
      align-items: start;
    }

    nav {
      justify-content: flex-start;
    }
  }
</style>