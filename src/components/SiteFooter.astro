---
import { profile } from "@data/profile";

const year = new Date().getFullYear();
---

<footer
  class="site-footer divider"
  transition:persist="site-footer"
  transition:name="site-footer"
  transition:animate="none"
>
  <div class="container footer-inner">
    {/* Identity & Origin Datum */}
    <div class="footer-identity">
      <p class="footer-name">{profile.shortName}</p>
      <span class="footer-sep" aria-hidden="true">&middot;</span>
      <p class="footer-location">Surabaya, Indonesia</p>
    </div>

    {/* Colophon & Back to Top */}
    <div class="footer-colophon">
      <p class="footer-copy">
        &copy; {year} &middot; The Anomaly Design System
      </p>
      <a
        href="#main"
        class="footer-top-link"
        aria-label="Scroll to top of page"
      >
        Back to top <span aria-hidden="true">&uarr;</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--paper);
    padding-block: clamp(1.6rem, 3.2vw, 2.25rem);
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .footer-identity {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-name {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 520;
    line-height: 1.2;
  }

  .footer-sep {
    color: var(--line-strong);
  }

  .footer-location {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .footer-colophon {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-copy {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1;
  }

  .footer-top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .footer-top-link:hover {
    color: var(--signal-deep);
  }

  .footer-top-link span {
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .footer-top-link:hover span {
    transform: translateY(-2px);
  }

  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }

    .footer-colophon {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
