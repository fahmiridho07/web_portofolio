---
// FloatingHeroStage.astro: Interactive 3D Floating Illustrations Stage
// Solves the "rigid, overly technical, unfriendly" feeling with an engaging,
// beautiful floating ecosystem representing Fahmi's code, data, and analog rituals.
// Inspired by Olivier Larose's 3D Float Effect, Paco Coursey, and Apple product stages.

interface FloatingItem {
  id: string;
  name: string;
  tag: string;
  image: string;
  image400: string;
  depth: number;
  rotation: number;
  initialX: number;
  initialY: number;
}

const items: FloatingItem[] = [
  {
    id: "code",
    name: "Software & AI Systems",
    tag: "Full-Stack .NET & Python",
    image: "/assets/floating/code-laptop.webp",
    image400: "/assets/floating/code-laptop-400.webp",
    depth: 0.05,
    rotation: -4,
    initialX: 0,
    initialY: 0,
  },
  {
    id: "coffee",
    name: "Manual Pour-Over Ritual",
    tag: "V60 Ceramic & 92°C Bloom",
    image: "/assets/floating/coffee-v60.webp",
    image400: "/assets/floating/coffee-v60-400.webp",
    depth: 0.12,
    rotation: 6,
    initialX: -36,
    initialY: -22,
  },
  {
    id: "badminton",
    name: "Competitive Badminton",
    tag: "28 lbs BG66 & Rear Attack",
    image: "/assets/floating/badminton.webp",
    image400: "/assets/floating/badminton-400.webp",
    depth: 0.09,
    rotation: -8,
    initialX: 38,
    initialY: -18,
  },
  {
    id: "running",
    name: "Road Running Telemetry",
    tag: "4:48/km Pace & 178 SPM",
    image: "/assets/floating/running.webp",
    image400: "/assets/floating/running-400.webp",
    depth: 0.14,
    rotation: 5,
    initialX: -34,
    initialY: 26,
  },
  {
    id: "cinema",
    name: "Cinema & Narrative",
    tag: "35mm Widescreen & Direction",
    image: "/assets/floating/cinema-reel.webp",
    image400: "/assets/floating/cinema-reel-400.webp",
    depth: 0.1,
    rotation: -5,
    initialX: 36,
    initialY: 24,
  },
];
---

<div class="floating-stage-wrapper" data-floating-stage>
  <div class="floating-stage">
    <!-- Ambient Stage Glow & Backdrop Grid -->
    <div class="stage-backdrop" aria-hidden="true">
      <div class="stage-grid"></div>
      <div class="stage-halo"></div>
    </div>

    <!-- The 5 Floating Artifacts -->
    <div class="floating-container" data-stage-container>
      {
        items.map((item, idx) => (
          <div
            class:list={["floating-card", `item-${item.id}`]}
            data-float-item
            data-depth={item.depth}
            data-rot={item.rotation}
            data-init-x={item.initialX}
            data-init-y={item.initialY}
            style={`--delay: ${idx * 0.4}s; --base-rot: ${item.rotation}deg;`}
          >
            <div class="artifact-frame">
              <picture>
                <source
                  srcset={`${item.image400} 400w, ${item.image} 800w`}
                  sizes="(max-width: 640px) 140px, (max-width: 1024px) 180px, 240px"
                  type="image/webp"
                />
                <img
                  src={item.image}
                  alt={item.name}
                  width="400"
                  height="400"
                  loading={idx === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class="artifact-img"
                />
              </picture>

              <div class="artifact-tooltip">
                <span class="tooltip-name">{item.name}</span>
                <span class="tooltip-tag">{item.tag}</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Friendly Interactive Prompt -->
    <div class="stage-footer">
      <span class="interactive-pill">
        <svg
          viewBox="0 0 16 16"
          width="12"
          height="12"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 2a5 5 0 1 1 0 10A5 5 0 0 1 8 3zm0 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"
          ></path>
        </svg>
        Move cursor or touch to explore the craft world
      </span>
    </div>
  </div>
</div>

<script>
  import { initOnPageLoad } from "@lib/page-script";

  initOnPageLoad(() => {
    const stage = document.querySelector<HTMLElement>("[data-floating-stage]");
    if (!stage) return;

    const items = Array.from(
      stage.querySelectorAll<HTMLElement>("[data-float-item]"),
    );
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduceMotion) return;

    const controller = new AbortController();
    const { signal } = controller;

    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;
    let raf = 0;

    const onMove = (e: MouseEvent) => {
      const rect = stage.getBoundingClientRect();
      const relX =
        (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2);
      const relY =
        (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2);
      targetX = Math.max(-1, Math.min(1, relX));
      targetY = Math.max(-1, Math.min(1, relY));

      if (!raf) {
        raf = requestAnimationFrame(render);
      }
    };

    const onLeave = () => {
      targetX = 0;
      targetY = 0;
      if (!raf) {
        raf = requestAnimationFrame(render);
      }
    };

    // Device orientation for mobile tilt
    const onOrientation = (e: DeviceOrientationEvent) => {
      if (e.gamma !== null && e.beta !== null) {
        targetX = Math.max(-1, Math.min(1, e.gamma / 30));
        targetY = Math.max(-1, Math.min(1, (e.beta - 45) / 30));
        if (!raf) {
          raf = requestAnimationFrame(render);
        }
      }
    };

    const render = () => {
      mouseX += (targetX - mouseX) * 0.08;
      mouseY += (targetY - mouseY) * 0.08;

      items.forEach((item) => {
        const depth = parseFloat(item.dataset.depth || "0.1");
        const initX = parseFloat(item.dataset.initX || "0");
        const initY = parseFloat(item.dataset.initY || "0");
        const baseRot = parseFloat(item.dataset.rot || "0");

        const moveX = initX + mouseX * depth * 80;
        const moveY = initY + mouseY * depth * 80;
        const tiltX = -mouseY * depth * 18;
        const tiltY = mouseX * depth * 18;
        const rot = baseRot + mouseX * depth * 8;

        item.style.transform = `translate3d(${moveX}%, ${moveY}%, 0) rotateZ(${rot}deg) rotateX(${tiltX}deg) rotateY(${tiltY}deg)`;
      });

      if (
        Math.abs(targetX - mouseX) > 0.001 ||
        Math.abs(targetY - mouseY) > 0.001
      ) {
        raf = requestAnimationFrame(render);
      } else {
        raf = 0;
      }
    };

    window.addEventListener("pointermove", onMove, { passive: true, signal });
    window.addEventListener("pointerleave", onLeave, { signal });
    if (window.DeviceOrientationEvent) {
      window.addEventListener("deviceorientation", onOrientation, {
        passive: true,
        signal,
      });
    }

    return () => {
      controller.abort();
      if (raf) cancelAnimationFrame(raf);
    };
  });
</script>

<style>
  .floating-stage-wrapper {
    position: relative;
    width: 100%;
    margin-top: 2rem;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
  }

  .floating-stage {
    position: relative;
    width: 100%;
    height: clamp(380px, 52vw, 520px);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: #fdfdfc;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 32px rgba(22, 24, 29, 0.03);
  }

  /* Backdrop Grid & Halo */
  .stage-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .stage-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(22, 24, 29, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(22, 24, 29, 0.04) 1px, transparent 1px);
    background-size: 36px 36px;
    opacity: 0.75;
  }

  .stage-halo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60%;
    height: 60%;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      rgba(201, 46, 62, 0.05) 0%,
      rgba(247, 247, 246, 0) 70%
    );
    filter: blur(40px);
  }

  /* Floating Container */
  .floating-container {
    position: relative;
    width: 100%;
    height: 100%;
    perspective: 1000px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .floating-card {
    position: absolute;
    cursor: grab;
    user-select: none;
    transition: filter var(--motion-fast) var(--ease-standard);
    animation: gentle-levitate 5s ease-in-out infinite alternate;
    animation-delay: var(--delay);
    will-change: transform;
  }

  .floating-card:active {
    cursor: grabbing;
  }

  @keyframes gentle-levitate {
    0% {
      margin-top: -6px;
    }
    100% {
      margin-top: 6px;
    }
  }

  /* Distinct Size Ratios */
  .item-code {
    z-index: 10;
    width: clamp(160px, 24vw, 240px);
  }

  .item-coffee {
    z-index: 8;
    width: clamp(130px, 18vw, 190px);
  }

  .item-badminton {
    z-index: 8;
    width: clamp(130px, 18vw, 190px);
  }

  .item-running {
    z-index: 7;
    width: clamp(140px, 19vw, 200px);
  }

  .item-cinema {
    z-index: 7;
    width: clamp(130px, 18vw, 190px);
  }

  .artifact-frame {
    position: relative;
    width: 100%;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .floating-card:hover .artifact-frame {
    transform: scale(1.08) translateY(-4px);
  }

  .artifact-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    filter: drop-shadow(0 12px 24px rgba(22, 24, 29, 0.08));
    transition: filter var(--motion-fast) var(--ease-standard);
  }

  .floating-card:hover .artifact-img {
    filter: drop-shadow(0 20px 32px rgba(22, 24, 29, 0.14));
  }

  /* Interactive Tooltip on Hover */
  .artifact-tooltip {
    position: absolute;
    bottom: -12px;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    opacity: 0;
    pointer-events: none;
    white-space: nowrap;
    background: rgba(22, 24, 29, 0.92);
    color: #ffffff;
    border-radius: var(--radius-pill);
    padding: 0.35rem 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.16);
    backdrop-filter: blur(8px);
    transition: all var(--motion-fast) var(--ease-out);
    z-index: 20;
  }

  .floating-card:hover .artifact-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .tooltip-name {
    font-family: var(--font-serif);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .tooltip-tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: rgba(255, 255, 255, 0.75);
    letter-spacing: 0.04em;
  }

  /* Stage Footer */
  .stage-footer {
    position: absolute;
    bottom: 0.85rem;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .interactive-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    background: rgba(247, 247, 246, 0.9);
    border: 1px solid var(--line);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    backdrop-filter: blur(8px);
  }

  .interactive-pill svg {
    color: var(--signal);
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-card {
      animation: none !important;
    }
  }

  @media (max-width: 768px) {
    .floating-stage {
      height: 440px;
    }

    .item-code {
      width: 140px;
    }

    .item-coffee {
      width: 110px;
    }

    .item-badminton {
      width: 110px;
    }

    .item-running {
      width: 110px;
    }

    .item-cinema {
      width: 110px;
    }

    .artifact-tooltip {
      display: none;
    }
  }
</style>
