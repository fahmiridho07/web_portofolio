---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="section-header">
  <p class="eyebrow">{eyebrow}</p>
  <div>
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>
</div>

<style>
  .section-header {
    display: grid;
    grid-template-columns: minmax(10rem, 0.3fr) 1fr;
    gap: clamp(1.25rem, 4vw, 3.5rem);
    align-items: start;
    margin-bottom: 1.35rem;
  }

  h2 {
    max-width: 620px;
    margin: 0;
    color: var(--text);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.045em;
  }

  p:not(.eyebrow) {
    max-width: 520px;
    margin: 0.7rem 0 0;
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.72;
  }

  @media (max-width: 760px) {
    .section-header {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
  }
</style>
