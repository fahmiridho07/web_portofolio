---
import { getResponsiveImageSources } from "@lib/images";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"img">;

const {
  src,
  alt = "",
  width,
  height,
  loading = "lazy",
  decoding = "async",
  ...rest
} = Astro.props;

if (!src || typeof src !== "string") {
  throw new Error("ContentImage requires a string src.");
}

const image = getResponsiveImageSources(src);
---

<img
  src={image.src}
  srcset={image.srcset}
  sizes={image.sizes}
  alt={alt}
  width={width ?? image.width}
  height={height ?? image.height}
  loading={loading}
  decoding={decoding}
  {...rest}
/>
