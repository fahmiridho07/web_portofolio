---
import { focusItems, profile } from "@data/profile";

const contactActions = [
  {
    label: "Email me",
    href: profile.emailHref,
    variant: "primary",
  },
  {
    label: "Request resume",
    href: profile.resumeRequestHref,
    variant: "secondary",
  },
  ...profile.links
    .filter((link) => link.label !== "Email")
    .map((link) => ({
      label: link.label === "LinkedIn" ? "Connect on LinkedIn" : `View ${link.label}`,
      href: link.href,
      variant: "secondary",
    })),
];
---

<aside class="focus-panel surface" aria-labelledby="focus-title">
  <div>
    <p class="eyebrow">Contact</p>
    <h2 id="focus-title">{profile.availability}.</h2>
    <p class="focus-copy">{profile.contactPrompt}</p>
  </div>

  <ul>
    {focusItems.map((item) => <li>{item}</li>)}
  </ul>

  <div class="contact-actions">
    {
      contactActions.map((link) => (
        <a
          class:list={["button", link.variant === "primary" ? "button-primary" : "button-secondary"]}
          href={link.href}
          target={link.href.startsWith("http") ? "_blank" : undefined}
          rel={link.href.startsWith("http") ? "noreferrer" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </div>
</aside>

<style>
  .focus-panel {
    display: grid;
    gap: 1.25rem;
    border-color: rgba(15, 159, 135, 0.18);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(29, 158, 117, 0.1), rgba(255, 255, 255, 0.68)),
      rgba(255, 255, 255, 0.76);
    box-shadow: 0 16px 46px rgba(17, 24, 39, 0.055);
    padding: clamp(1.15rem, 3vw, 1.6rem);
  }

  h2 {
    max-width: 680px;
    margin: 0.75rem 0 0;
    color: var(--text);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .focus-copy {
    max-width: 620px;
    margin: 0.8rem 0 0;
    color: var(--text-muted);
    line-height: 1.65;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    border: 1px solid rgba(15, 159, 135, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.58);
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.25;
    padding: 0.52rem 0.72rem;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  a {
    min-height: 2.45rem;
    border-radius: 999px;
    padding: 0.72rem 0.95rem;
    text-decoration: none;
  }

  .button-primary {
    background: var(--accent);
    color: #ffffff;
    box-shadow: 0 12px 28px rgba(15, 159, 135, 0.16);
  }

  .button-secondary {
    border: 1px solid rgba(15, 159, 135, 0.2);
    background: rgba(255, 255, 255, 0.62);
    color: var(--accent);
    box-shadow: none;
  }

  a:hover {
    opacity: 0.82;
  }

  .button-primary:hover {
    color: #ffffff;
  }

  @media (max-width: 620px) {
    .focus-panel {
      gap: 1rem;
    }

    h2 {
      font-size: 1.28rem;
      line-height: 1.16;
    }
  }
</style>
