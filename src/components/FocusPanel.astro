---
import { focusItems, profile } from "@data/profile";
import { getResumeAction } from "@lib/resume";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const resumeAction = getResumeAction();

const contactActions = [
  {
    label: "Email me",
    href: profile.emailHref,
    variant: "primary" as const,
  },
  {
    label: resumeAction.label,
    href: resumeAction.href,
    variant: "secondary" as const,
    download: resumeAction.download,
  },
  ...profile.links
    .filter((link) => link.label !== "Email")
    .map((link) => ({
      label: link.label === "LinkedIn" ? "LinkedIn" : link.label,
      href: link.href,
      variant: "secondary" as const,
      download: false,
    })),
];
---

<aside class:list={["focus-panel", "glass-panel", compact && "is-compact"]} aria-labelledby="focus-title">
  <div>
    {!compact && <p class="eyebrow">Contact</p>}
    <h2 id="focus-title">{compact ? "Let's connect." : profile.availability}</h2>
    {!compact && <p class="focus-copy">{profile.contactPrompt}</p>}
  </div>

  {!compact && (
    <ul class="focus-chips" aria-label="Collaboration focus">
      {focusItems.map((item) => <li class="glass-chip">{item}</li>)}
    </ul>
  )}

  <div class="contact-actions">
    {
      contactActions.map((link) => (
        <a
          class:list={[
            "button",
            link.variant === "primary" ? "button-primary" : "button-secondary glass-chip",
          ]}
          href={link.href}
          target={link.href.startsWith("http") ? "_blank" : undefined}
          rel={link.href.startsWith("http") ? "noreferrer" : undefined}
          download={link.download ? "" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </div>
</aside>

<style>
  .focus-panel.is-compact {
    gap: var(--space-stack-md);
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    padding: clamp(1rem, 2.2vw, 1.2rem) clamp(1.1rem, 2.6vw, 1.35rem);
  }

  .focus-panel.is-compact h2 {
    margin: 0;
    font-size: clamp(1.2rem, 2.4vw, 1.45rem);
    font-weight: 600;
    line-height: 1.12;
  }

  .focus-panel.is-compact .contact-actions {
    justify-content: flex-end;
  }

  .focus-panel {
    display: grid;
    gap: var(--space-stack-lg);
    border-color: color-mix(in srgb, var(--accent) 24%, var(--panel-border));
    padding: clamp(1.1rem, 2.5vw, 1.45rem) clamp(1.25rem, 3vw, 1.65rem);
  }

  h2 {
    max-width: 680px;
    margin: var(--label-gap) 0 0;
    color: var(--text);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .focus-copy {
    max-width: 620px;
    margin: 0.8rem 0 0;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .focus-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .focus-chips li {
    border-color: var(--badge-border);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.25;
    padding: 0.52rem 0.72rem;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }

  a {
    min-height: 2.45rem;
    border-radius: 999px;
    padding: 0.72rem 0.95rem;
    text-decoration: none;
  }

  .button-primary {
    background: var(--accent);
    color: var(--button-on-accent);
    box-shadow: 0 12px 28px color-mix(in srgb, var(--accent) 16%, transparent);
    font-weight: 600;
  }

  .button-secondary {
    border-color: var(--badge-border);
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 500;
    min-height: 2.2rem;
    padding: 0.58rem 0.82rem;
  }

  a:hover {
    opacity: 0.82;
  }

  .button-primary:hover {
    color: var(--button-on-accent);
  }

  .button-secondary:hover {
    border-color: color-mix(in srgb, var(--accent) 28%, var(--badge-border));
    color: var(--accent);
    opacity: 1;
  }

  @media (max-width: 720px) {
    .focus-panel.is-compact {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .focus-panel.is-compact .contact-actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 620px) {
    .focus-panel {
      gap: 1rem;
    }

    h2 {
      font-size: 1.28rem;
      line-height: 1.16;
    }

    .contact-actions {
      gap: 0.45rem;
    }
  }
</style>