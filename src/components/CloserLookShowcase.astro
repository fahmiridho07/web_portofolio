---
// CloserLookShowcase.astro: Apple-Style "Take a closer look." Interactive Inspector
// Replaces the arbitrary V60 coffee showcase with a dedicated, product-focused showcase
// of Fahmi's 4 flagship engineering & AI projects.
//
// UX Architecture:
// - Left: Inspector Stack with stepper navigation, dormant + pills, and active capsule card.
// - Right: 3D Floating Hardware Studio Slate with pointer parallax, 3-phase recoil & spring emerge,
//   and live interactive project simulations (including clickable MediMate prescription checklist!).
// - Strict adherence to "The Anomaly" design system (Paper, Ink, Carmine accent).

import { getSortedProjects } from "@lib/projects";

const allProjects = await getSortedProjects();

interface ShowcaseItem {
  id: string;
  slug: string;
  number: string;
  discipline: string;
  title: string;
  thesis: string;
  metricBadge: string;
  caseStudyHref: string;
}

const showcaseItems: ShowcaseItem[] = [
  {
    id: "fraud-ai",
    slug: "fraud-detection-ml-pipeline",
    number: "01",
    discipline: "Machine Learning & Research",
    title: "Fraud Detection AI",
    thesis:
      "Detecting payment fraud under extreme 1:590 class imbalance using latent oversampling and LightGBM on the IEEE-CIS benchmark.",
    metricBadge: "0.855 PR-AUC · 74.7% Recall",
    caseStudyHref: "/projects/fraud-detection-ml-pipeline/",
  },
  {
    id: "mining-dotnet",
    slug: "kpc-ideku-v3-dotnet-stabilization",
    number: "02",
    discipline: "Enterprise Software Architecture",
    title: "Mining Operations Platform",
    thesis:
      "Stabilizing mission-critical ASP.NET Core workflows, hardening role-based access control, and tuning query latency for 5,000+ mining personnel.",
    metricBadge: "5,000+ Personnel · 42ms Query",
    caseStudyHref: "/projects/kpc-ideku-v3-dotnet-stabilization/",
  },
  {
    id: "medimate-mobile",
    slug: "medimate-medicine-reminder-app",
    number: "03",
    discipline: "Mobile Product Engineering",
    title: "MediMate Healthcare",
    thesis:
      "A calm, resilient Flutter prescription companion with zero-latency SQLite persistence and reliable background notification alarm scheduling.",
    metricBadge: "Flutter · Zero Latency SQLite",
    caseStudyHref: "/projects/medimate-medicine-reminder-app/",
  },
  {
    id: "route-aco",
    slug: "orphanage-inspection-route-optimization",
    number: "04",
    discipline: "Operations Research & Heuristics",
    title: "Social Inspection Routing",
    thesis:
      "Ant Colony Optimization compressing social welfare inspection travel across 24 orphanages down to 153.34 km within strict working-hour constraints.",
    metricBadge: "153.34 km Optimum · -38.3% Travel",
    caseStudyHref: "/projects/orphanage-inspection-route-optimization/",
  },
];
---

<section class="closer-look-section divider" id="projects" data-closer-look>
  <div class="container">
    {/* Section Header */}
    <div class="section-header-block" data-reveal>
      <div class="header-badge-row">
        <span class="header-kicker">THE WORKBENCH</span>
        <span class="header-sep" aria-hidden="true">&middot;</span>
        <span class="header-sub">SELECTED SHIPPED WORK</span>
      </div>
      <h2 class="display section-headline">Take a closer look.</h2>
      <p class="section-lead">
        Interactive demonstrations of core software systems, machine learning
        pipelines, and algorithmic architectures.
      </p>
    </div>

    {/* Master Inspector Frame */}
    <div class="inspector-card" data-reveal>
      {/* -------------------- LEFT: INSPECTOR STACK -------------------- */}
      <div class="inspector-sidebar">
        {/* Stepper Navigation Buttons */}
        <div class="stepper-bar" aria-label="Exhibit sequencing">
          <button
            type="button"
            class="stepper-btn"
            data-stepper="prev"
            aria-label="Previous project"
            title="Previous project (ArrowUp)"
          >
            <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
              <path
                d="M8 3.5l5 5-.7.7L8 4.9 3.7 9.2l-.7-.7 5-5z"
                fill-rule="evenodd"></path>
            </svg>
          </button>
          <button
            type="button"
            class="stepper-btn"
            data-stepper="next"
            aria-label="Next project"
            title="Next project (ArrowDown)"
          >
            <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
              <path
                d="M8 12.5l-5-5 .7-.7L8 11.1l4.3-4.3.7.7-5 5z"
                fill-rule="evenodd"></path>
            </svg>
          </button>
          <span class="stepper-counter" data-stepper-counter>01 / 04</span>
        </div>

        {/* The Tabs / Pills List */}
        <div
          class="pill-stack"
          role="tablist"
          aria-label="Select project to inspect"
        >
          {
            showcaseItems.map((item, idx) => (
              <div
                class:list={["pill-item-wrapper", idx === 0 && "is-active"]}
                data-item-index={idx}
                data-item-id={item.id}
              >
                {/* Dormant Pill (shown when not active) */}
                <button
                  type="button"
                  class="dormant-pill"
                  role="tab"
                  aria-selected={idx === 0 ? "true" : "false"}
                  aria-controls={`panel-${item.id}`}
                  data-pill-trigger={idx}
                >
                  <span class="pill-plus" aria-hidden="true">
                    +
                  </span>
                  <span class="pill-name">{item.title}</span>
                  <span class="pill-discipline">{item.discipline}</span>
                </button>

                {/* Expanded Capsule Card (shown when active) */}
                <div
                  class="active-capsule"
                  role="tabpanel"
                  id={`panel-${item.id}`}
                  aria-hidden={idx === 0 ? "false" : "true"}
                >
                  <div class="capsule-kicker-row">
                    <span class="capsule-num">{item.number}</span>
                    <span class="capsule-discipline">{item.discipline}</span>
                  </div>

                  <h3 class="capsule-title">{item.title}</h3>
                  <p class="capsule-thesis">{item.thesis}</p>

                  <div class="capsule-footer">
                    <span class="capsule-metric">{item.metricBadge}</span>
                    <a
                      href={item.caseStudyHref}
                      class="capsule-cta-link"
                      data-astro-prefetch="hover"
                    >
                      <span>Explore Case Study</span>
                      <span class="cta-arrow" aria-hidden="true">
                        &rarr;
                      </span>
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      {
        /* -------------------- RIGHT: 3D STUDIO SLATE VIEWPORT -------------------- */
      }
      <div class="inspector-viewport-col">
        <div class="slate-perspective-wrapper" data-slate-rig>
          {/* Floating 3D Hardware Studio Slate */}
          <div class="slate-chassis" data-slate-chassis>
            {/* Top Glass Slate Status Bar */}
            <div class="slate-hardware-bar">
              <div class="bar-left-lights">
                <span class="slate-dot red" aria-hidden="true"></span>
                <span class="slate-dot yellow" aria-hidden="true"></span>
                <span class="slate-dot green" aria-hidden="true"></span>
              </div>
              <div class="slate-title-label" data-slate-header-title>
                SYSTEM RUNTIME // FRAUD_DETECTION_AI
              </div>
              <div class="bar-status-chip">
                <span class="live-pulse-dot" aria-hidden="true"></span>
                <span class="status-chip-text" data-slate-header-status
                  >ACTIVE</span
                >
              </div>
            </div>

            {/* Viewport Screen Surface (Hosts the 4 Live Project Exhibits) */}
            <div class="slate-screen" data-slate-screen>
              {/* EXHIBIT 1: FRAUD DETECTION AI (Active by default) */}
              <div
                class="exhibit-panel exhibit-fraud is-visible"
                data-exhibit-panel="0"
                aria-label="Fraud Detection Live Simulation"
              >
                <div class="radar-hud-bar">
                  <span class="hud-tag">LATENT SIGNAL DETECTOR</span>
                  <span class="hud-metric"
                    >THRESHOLD: 0.942 · IMBALANCE: 1:590</span
                  >
                </div>

                <div class="tx-stream-container">
                  <div class="tx-item tx-clean">
                    <span class="tx-time">10:42:01</span>
                    <span class="tx-id">TX-94021</span>
                    <span class="tx-amount">$42.50</span>
                    <span class="tx-badge clean">CLEARED</span>
                  </div>
                  <div class="tx-item tx-clean">
                    <span class="tx-time">10:42:03</span>
                    <span class="tx-id">TX-94022</span>
                    <span class="tx-amount">$18.90</span>
                    <span class="tx-badge clean">CLEARED</span>
                  </div>
                  {/* The Anomaly Outlier */}
                  <div
                    class="tx-item tx-anomaly"
                    data-anomaly-card
                    title="Outlier flagged by Autoencoder"
                  >
                    <div class="anomaly-sonar-waves" aria-hidden="true">
                      <span class="sonar-ring wave-1"></span>
                      <span class="sonar-ring wave-2"></span>
                    </div>
                    <span class="tx-time">10:42:05</span>
                    <span class="tx-id">TX-94023</span>
                    <span class="tx-amount">$1,294.00</span>
                    <span class="tx-badge anomaly">&bull; ANOMALY DETECTED</span
                    >
                  </div>
                  <div class="tx-item tx-clean">
                    <span class="tx-time">10:42:08</span>
                    <span class="tx-id">TX-94024</span>
                    <span class="tx-amount">$7.25</span>
                    <span class="tx-badge clean">CLEARED</span>
                  </div>
                </div>

                <div class="exhibit-telemetry-bar">
                  <div class="telemetry-stat">
                    <span class="t-label">TEST PR-AUC</span>
                    <span class="t-value highlight">0.855</span>
                  </div>
                  <div class="telemetry-stat">
                    <span class="t-label">RECALL @ 89% PRECISION</span>
                    <span class="t-value">74.7%</span>
                  </div>
                  <div class="telemetry-stat">
                    <span class="t-label">MODEL STACK</span>
                    <span class="t-value">Autoencoder + LightGBM</span>
                  </div>
                </div>
              </div>

              {/* EXHIBIT 2: MINING OPERATIONS PLATFORM (.NET) */}
              <div
                class="exhibit-panel exhibit-mining"
                data-exhibit-panel="1"
                aria-label="Enterprise Mining Operations Console"
              >
                <div class="radar-hud-bar">
                  <span class="hud-tag"
                    >KPC IdeKU V3 // ASP.NET CORE RUNTIME</span
                  >
                  <span class="hud-metric">ACTIVE PERSONNEL: 5,240</span>
                </div>

                <div class="mining-console-split">
                  {/* Left Blade: RBAC Matrix */}
                  <div class="console-blade blade-rbac">
                    <span class="blade-kicker">RBAC SECURITY MATRIX</span>
                    <div class="rbac-rows">
                      <div class="rbac-cell on">
                        <span class="rbac-dot"></span>
                        <span class="rbac-role">Operations Dispatcher</span>
                        <span class="rbac-perm">WRITE / APPROVE</span>
                      </div>
                      <div class="rbac-cell on">
                        <span class="rbac-dot"></span>
                        <span class="rbac-role">Site Engineer</span>
                        <span class="rbac-perm">TELEMETRY_LOG</span>
                      </div>
                      <div class="rbac-cell warn">
                        <span class="rbac-dot"></span>
                        <span class="rbac-role">External Auditor</span>
                        <span class="rbac-perm">RESTRICTED_READ</span>
                      </div>
                    </div>
                  </div>

                  {/* Right Blade: Live Query Latency Telemetry */}
                  <div class="console-blade blade-perf">
                    <span class="blade-kicker">SYSTEM TELEMETRY</span>
                    <div class="perf-metric-box">
                      <span class="perf-num">42<small>ms</small></span>
                      <span class="perf-sub">P95 Database Query Latency</span>
                    </div>
                    <div class="perf-pipe-track">
                      <div class="perf-pipe-fill" style="width: 78%;"></div>
                    </div>
                    <span class="perf-note"
                      >Task.WhenAll Parallel Pipeline &middot; Zero Bottlenecks</span
                    >
                  </div>
                </div>

                <div class="exhibit-telemetry-bar">
                  <div class="telemetry-stat">
                    <span class="t-label">USER CONCURRENCY</span>
                    <span class="t-value highlight">5,000+ Active</span>
                  </div>
                  <div class="telemetry-stat">
                    <span class="t-label">ARCHITECTURE</span>
                    <span class="t-value">ASP.NET Core &amp; SQL Server</span>
                  </div>
                  <div class="telemetry-stat">
                    <span class="t-label">STABILIZATION</span>
                    <span class="t-value">RBAC Hardening + Power BI</span>
                  </div>
                </div>
              </div>

              {/* EXHIBIT 3: MEDIMATE HEALTHCARE APP */}
              <div
                class="exhibit-panel exhibit-medimate"
                data-exhibit-panel="2"
                aria-label="MediMate Mobile Healthcare Companion"
              >
                <div class="medimate-phone-frame">
                  <div class="phone-screen-header">
                    <span class="phone-time">09:41</span>
                    <span class="phone-notch"></span>
                    <span class="phone-net">100% 5G</span>
                  </div>

                  <div class="medimate-header-row">
                    <div>
                      <span class="med-greeting">Today&rsquo;s Regimen</span>
                      <span class="med-day">Thursday, Sep 17</span>
                    </div>
                    <span class="med-streak-pill">34 Day Streak &bull;</span>
                  </div>

                  {/* Interactive Prescription Items */}
                  <div class="med-items-list" data-med-list>
                    <div class="med-card is-taken">
                      <div class="med-info">
                        <span class="med-name">Amoxicillin 500mg</span>
                        <span class="med-schedule"
                          >08:00 AM &middot; After breakfast</span
                        >
                      </div>
                      <span class="med-check taken" aria-label="Dose completed"
                        >✓</span
                      >
                    </div>

                    <div class="med-card current" data-interactive-med>
                      <div class="med-info">
                        <span class="med-name">Vitamin D3 1000 IU</span>
                        <span class="med-schedule"
                          >01:00 PM &middot; Take with water</span
                        >
                      </div>
                      <button
                        type="button"
                        class="med-check action-btn"
                        data-med-toggle
                        aria-label="Mark Vitamin D3 as taken"
                        title="Click to record dose!"
                      >
                        <span class="check-icon">✓</span>
                        <span class="check-label" data-med-label>Take</span>
                      </button>
                    </div>

                    <div class="med-card upcoming">
                      <div class="med-info">
                        <span class="med-name">Metformin 500mg</span>
                        <span class="med-schedule"
                          >08:00 PM &middot; With dinner</span
                        >
                      </div>
                      <span class="med-check pending" aria-label="Upcoming dose"
                        >&bull;&bull;&bull;</span
                      >
                    </div>
                  </div>

                  <span class="phone-footer-caption">
                    Background SQLite Alarm &middot; Zero Network Latency
                  </span>
                </div>
              </div>

              {/* EXHIBIT 4: SOCIAL INSPECTION ROUTING (ACO) */}
              <div
                class="exhibit-panel exhibit-route"
                data-exhibit-panel="3"
                aria-label="Ant Colony Optimization Routing Graph"
              >
                <div class="radar-hud-bar">
                  <span class="hud-tag"
                    >ANT COLONY OPTIMIZATION // GRAPH ENGINE</span
                  >
                  <span class="hud-metric"
                    >24 ORPHANAGES &middot; 5 DISTRICTS</span
                  >
                </div>

                <div class="route-topology-canvas" aria-hidden="true">
                  <svg
                    viewBox="0 0 460 220"
                    width="100%"
                    height="100%"
                    class="route-svg-mesh"
                  >
                    {/* Background District Geometries */}
                    <polygon
                      points="40,30 140,20 120,90 30,80"
                      class="district-poly d-1"></polygon>
                    <polygon
                      points="160,25 280,35 260,110 150,95"
                      class="district-poly d-2"></polygon>
                    <polygon
                      points="310,40 430,30 420,120 300,105"
                      class="district-poly d-3"></polygon>
                    <polygon
                      points="60,120 180,115 160,195 50,185"
                      class="district-poly d-4"></polygon>
                    <polygon
                      points="260,130 390,125 410,200 270,205"
                      class="district-poly d-5"></polygon>

                    {/* Central Depot Hub */}
                    <circle cx="230" cy="110" r="8" class="depot-hub"></circle>
                    <circle cx="230" cy="110" r="16" class="depot-pulse"
                    ></circle>
                    <text x="230" y="98" class="depot-text" text-anchor="middle"
                      >DEPOT HUB</text
                    >

                    {/* Ant Pheromone Optimized Loop Path */}
                    <path
                      d="M230,110 L85,55 L210,60 L365,75 L335,165 L110,155 Z"
                      class="route-loop-trail"></path>

                    {/* District Inspection Nodes */}
                    <circle cx="85" cy="55" r="5" class="route-node"></circle>
                    <circle cx="210" cy="60" r="5" class="route-node"></circle>
                    <circle cx="365" cy="75" r="5" class="route-node"></circle>
                    <circle cx="335" cy="165" r="5" class="route-node"></circle>
                    <circle cx="110" cy="155" r="5" class="route-node"></circle>
                  </svg>
                </div>

                <div class="exhibit-telemetry-bar">
                  <div class="telemetry-stat">
                    <span class="t-label">OPTIMAL ROUTE</span>
                    <span class="t-value highlight">153.34 km</span>
                  </div>
                  <div class="telemetry-stat">
                    <span class="t-label">DISTANCE COMPRESSION</span>
                    <span class="t-value">-38.3% vs Baseline</span>
                  </div>
                  <div class="telemetry-stat">
                    <span class="t-label">HEURISTIC PARADIGM</span>
                    <span class="t-value">Ant Colony Optimization</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {/* Dynamic Ground Ambient Shadow underneath the 3D Slate */}
          <div class="slate-ground-shadow" aria-hidden="true" data-slate-shadow>
          </div>
        </div>
      </div>
    </div>

    {/* Section Bottom CTA */}
    <div class="closer-look-bottom-action" data-reveal>
      <a
        href="/projects/"
        class="catalogue-btn"
        data-astro-prefetch="hover"
        data-magnetic
      >
        <span
          >Browse All {allProjects.length} Shipped Projects &amp; Lab Code</span
        >
        <span class="btn-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<script>
  import { initOnPageLoad } from "@lib/page-script";

  initOnPageLoad(() => {
    const root = document.querySelector<HTMLElement>("[data-closer-look]");
    if (!root) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // Component DOM references
    const wrappers = Array.from(
      root.querySelectorAll<HTMLElement>("[data-item-index]"),
    );
    const pillTriggers = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-pill-trigger]"),
    );
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>("[data-exhibit-panel]"),
    );
    const chassis = root.querySelector<HTMLElement>("[data-slate-chassis]");
    const shadow = root.querySelector<HTMLElement>("[data-slate-shadow]");
    const counterText = root.querySelector<HTMLElement>(
      "[data-stepper-counter]",
    );
    const headerTitle = root.querySelector<HTMLElement>(
      "[data-slate-header-title]",
    );
    const prevBtn = root.querySelector<HTMLButtonElement>(
      '[data-stepper="prev"]',
    );
    const nextBtn = root.querySelector<HTMLButtonElement>(
      '[data-stepper="next"]',
    );

    let activeIndex = 0;
    let isTransitioning = false;

    const titles = [
      "SYSTEM RUNTIME // FRAUD_DETECTION_AI",
      "KPC IdeKU V3 // ASP.NET CORE RUNTIME",
      "MEDIMATE MOBILE // PRESCRIPTION COMPANION",
      "ANT COLONY OPTIMIZATION // GRAPH ENGINE",
    ];

    // -------------------------------------------------------------
    // 1. 3-PHASE RECOIL & SPRING EMERGE STATE SWITCHER
    // -------------------------------------------------------------
    const switchExhibit = (newIndex: number) => {
      if (newIndex === activeIndex || isTransitioning) return;
      isTransitioning = true;

      // Update stepper counter
      if (counterText) {
        counterText.textContent = `0${newIndex + 1} / 04`;
      }

      // Update sidebar pill states
      wrappers.forEach((wrap, i) => {
        const isActive = i === newIndex;
        wrap.classList.toggle("is-active", isActive);

        const dormantBtn =
          wrap.querySelector<HTMLButtonElement>(".dormant-pill");
        if (dormantBtn) {
          dormantBtn.setAttribute("aria-selected", isActive ? "true" : "false");
        }

        const capsule = wrap.querySelector<HTMLElement>(".active-capsule");
        if (capsule) {
          capsule.setAttribute("aria-hidden", isActive ? "false" : "true");
        }
      });

      if (reduceMotion || !chassis) {
        // Instant switch for reduced motion
        panels.forEach((p, i) => {
          p.classList.toggle("is-visible", i === newIndex);
        });
        if (headerTitle) headerTitle.textContent = titles[newIndex];
        activeIndex = newIndex;
        isTransitioning = false;
        return;
      }

      // Phase 1: Recoil & Egress (140ms)
      chassis.classList.add("is-recoiling");
      chassis.classList.remove("is-emerging");

      window.setTimeout(() => {
        // Phase 2: State Swap (instant under motion blur)
        panels.forEach((p, i) => {
          p.classList.toggle("is-visible", i === newIndex);
        });
        if (headerTitle) headerTitle.textContent = titles[newIndex];

        // Phase 3: Spring Emerge & Snap (320ms)
        chassis.classList.remove("is-recoiling");
        chassis.classList.add("is-emerging");

        activeIndex = newIndex;

        window.setTimeout(() => {
          chassis.classList.remove("is-emerging");
          isTransitioning = false;
        }, 340);
      }, 140);
    };

    // Pill trigger click events
    pillTriggers.forEach((btn, idx) => {
      btn.addEventListener("click", () => switchExhibit(idx));
    });

    const totalItems = wrappers.length || 4;

    // Stepper navigation
    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        const target = (activeIndex - 1 + totalItems) % totalItems;
        switchExhibit(target);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        const target = (activeIndex + 1) % totalItems;
        switchExhibit(target);
      });
    }

    // Keyboard support (ArrowUp, ArrowDown)
    const onKeyDown = (e: KeyboardEvent) => {
      const activeEl = document.activeElement;
      if (!root.contains(activeEl)) return;

      if (e.key === "ArrowDown" || e.key === "ArrowRight") {
        e.preventDefault();
        const target = (activeIndex + 1) % totalItems;
        switchExhibit(target);
      } else if (e.key === "ArrowUp" || e.key === "ArrowLeft") {
        e.preventDefault();
        const target = (activeIndex - 1 + totalItems) % totalItems;
        switchExhibit(target);
      }
    };
    window.addEventListener("keydown", onKeyDown);

    // -------------------------------------------------------------
    // 2. INTERACTIVE MEDIMATE CHECKMARK TOGGLE
    // -------------------------------------------------------------
    const medToggleBtn =
      root.querySelector<HTMLButtonElement>("[data-med-toggle]");
    const medLabel = root.querySelector<HTMLElement>("[data-med-label]");
    const medCard = root.querySelector<HTMLElement>("[data-interactive-med]");

    if (medToggleBtn) {
      medToggleBtn.addEventListener("click", () => {
        const isDone = medToggleBtn.classList.toggle("completed");
        if (medCard) medCard.classList.toggle("is-taken", isDone);
        if (medLabel) medLabel.textContent = isDone ? "Taken!" : "Take";
      });
    }

    // -------------------------------------------------------------
    // 3. DESKTOP POINTER PARALLAX FOR 3D HARDWARE SLATE
    // -------------------------------------------------------------
    let mouseX = 0;
    let mouseY = 0;
    let velocityX = 0;
    let velocityY = 0;
    let targetX = 0;
    let targetY = 0;
    let lastTime = performance.now();
    let raf = 0;

    const onPointerMove = (e: PointerEvent) => {
      if (
        reduceMotion ||
        !chassis ||
        window.matchMedia("(hover: none)").matches
      )
        return;

      const rect = chassis.getBoundingClientRect();
      const x = (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2);
      const y = (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2);
      targetX = Math.max(-1, Math.min(1, x));
      targetY = Math.max(-1, Math.min(1, y));

      if (!raf) raf = requestAnimationFrame(updateSlateParallax);
    };

    const updateSlateParallax = () => {
      const now = performance.now();
      const dt = Math.min((now - lastTime) / 1000, 0.05);
      lastTime = now;

      // Damped spring physics
      const stiffness = 90;
      const damping = 12;

      velocityX += (targetX - mouseX) * stiffness * dt;
      velocityX *= Math.exp(-damping * dt);
      mouseX += velocityX * dt;

      velocityY += (targetY - mouseY) * stiffness * dt;
      velocityY *= Math.exp(-damping * dt);
      mouseY += velocityY * dt;

      if (chassis && !chassis.classList.contains("is-recoiling")) {
        const rotY = mouseX * 8; // subtle tilt
        const rotX = -mouseY * 8;
        chassis.style.transform = `rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg)`;
      }

      if (shadow) {
        const sX = mouseX * -18;
        const sY = mouseY * -12;
        shadow.style.transform = `translate3d(${sX.toFixed(1)}px, ${sY.toFixed(1)}px, 0)`;
      }

      const settling =
        Math.abs(targetX - mouseX) > 0.001 ||
        Math.abs(targetY - mouseY) > 0.001 ||
        Math.abs(velocityX) > 0.01 ||
        Math.abs(velocityY) > 0.01;

      if (settling) {
        raf = requestAnimationFrame(updateSlateParallax);
      } else {
        raf = 0;
      }
    };

    window.addEventListener("pointermove", onPointerMove, { passive: true });

    return () => {
      window.removeEventListener("keydown", onKeyDown);
      window.removeEventListener("pointermove", onPointerMove);
      if (raf) cancelAnimationFrame(raf);
    };
  });
</script>

