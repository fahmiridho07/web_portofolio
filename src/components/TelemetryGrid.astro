---
// TelemetryGrid.astro: Engineering Impact & Verification Metrics
// Replaces wordy resume text with immediate, high-contrast engineering telemetry.
// Inspired by Linear, Vercel Ship, and editorial research publications.

interface StatItem {
  metric: string;
  label: string;
  context: string;
  badge?: string;
  href?: string;
  isAnomaly?: boolean;
}

const stats: StatItem[] = [
  {
    metric: "0.8547",
    label: "PR-AUC Score",
    context:
      "Fraud Detection Thesis · Autoencoder + LightGBM under extreme imbalance",
    badge: "Flagship ML",
    href: "/projects/fraud-detection-ml-pipeline/",
    isAnomaly: true,
  },
  {
    metric: "3,087",
    label: "Anomalies Flagged",
    context: "89% precision on held-out test data with zero data leakage",
    badge: "Model Precision",
    href: "/projects/fraud-detection-ml-pipeline/",
  },
  {
    metric: "7 Features",
    label: "Shipped in Production",
    context:
      "PT Kaltim Prima Coal · ASP.NET Core enterprise stabilization & RBAC",
    badge: "Enterprise .NET",
    href: "/projects/kpc-ideku-v3-dotnet-stabilization/",
  },
  {
    metric: "153.34 km",
    label: "ACO Route Distance",
    context:
      "Ant Colony Optimization for 24 orphanages across 5 district clusters",
    badge: "Operations Research",
    href: "/projects/orphanage-inspection-route-optimization/",
  },
];
---

<div class="telemetry-bar divider" data-reveal>
  <div class="container">
    <div class="telemetry-header">
      <span class="telemetry-kicker"
        >ENGINEERING TELEMETRY & VERIFIED OUTCOMES</span
      >
      <span class="telemetry-note"
        >REAL MEASUREMENTS FROM SHIPPED REPOSITORIES</span
      >
    </div>

    <div class="telemetry-grid">
      {
        stats.map((stat, idx) => (
          <a
            href={stat.href}
            class:list={["telemetry-card", stat.isAnomaly && "is-anomaly"]}
            data-telemetry-idx={idx}
            data-astro-prefetch="hover"
          >
            <div class="card-header">
              <span class="stat-badge">{stat.badge}</span>
              {stat.isAnomaly && <span class="anomaly-tag">Thesis</span>}
              <span class="card-arrow" aria-hidden="true">
                &nearr;
              </span>
            </div>

            <div class="metric-display">
              <span class="metric-number">{stat.metric}</span>
              <span class="metric-label">{stat.label}</span>
            </div>

            <p class="metric-context">{stat.context}</p>

            <div class="card-footer">
              <span class="inspect-text">Inspect evidence</span>
              <span class="stat-line" />
            </div>
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  .telemetry-bar {
    padding-block: clamp(2rem, 4.5vw, 3.5rem);
    background: var(--paper);
  }

  .telemetry-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }

  .telemetry-kicker {
    font-weight: 600;
  }

  .telemetry-note {
    font-size: 0.62rem;
  }

  .telemetry-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .telemetry-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: clamp(1rem, 2vw, 1.35rem);
    transition: all var(--motion-fast) var(--ease-standard);
    position: relative;
    overflow: hidden;
  }

  .telemetry-card:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(22, 24, 29, 0.05);
  }

  .telemetry-card.is-anomaly {
    border-top: 2.5px solid var(--signal);
  }

  .telemetry-card.is-anomaly:hover {
    border-color: var(--signal);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .stat-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    background: var(--paper-soft);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
  }

  .anomaly-tag {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #ffffff;
    background: var(--signal);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-pill);
    letter-spacing: 0.04em;
  }

  .card-arrow {
    font-size: 0.85rem;
    color: var(--ink-soft);
    transition:
      transform var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-standard);
  }

  .telemetry-card:hover .card-arrow {
    transform: translate(2px, -2px);
    color: var(--signal);
  }

  .metric-display {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-bottom: 0.6rem;
  }

  .metric-number {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.5vw, 2.2rem);
    font-weight: 550;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1;
  }

  .telemetry-card.is-anomaly .metric-number {
    color: var(--signal-deep);
  }

  .metric-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
    font-weight: 600;
  }

  .metric-context {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 0 0 1rem;
    flex-grow: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    border-top: 1px solid var(--line);
    padding-top: 0.6rem;
  }

  .inspect-text {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .telemetry-card:hover .inspect-text {
    color: var(--signal);
  }

  .stat-line {
    height: 2px;
    width: 24px;
    background: var(--line);
    transition:
      width var(--motion-fast) var(--ease-out),
      background var(--motion-fast) var(--ease-standard);
  }

  .telemetry-card:hover .stat-line {
    width: 36px;
    background: var(--signal);
  }

  @media (max-width: 960px) {
    .telemetry-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 580px) {
    .telemetry-grid {
      grid-template-columns: 1fr;
    }
    .telemetry-header {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
