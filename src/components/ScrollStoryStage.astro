---
// ScrollStoryStage.astro: Continuous Scroll-Driven Storytelling Canvas (Scenes 1 to 4)
// Pure engineering and AI narrative flow.
// No standalone hobby section; 3D craft illustrations are used purely as tasteful ambient decorations.
// Scene 1: Hey, I'm Ridho. (3D Kinetic Builder Cube with subtle ambient floating decorations)
// Scene 2: I like building things. (3D Modular Architectural Voxels)
// Scene 3: Software. (3D Layered Terminal Monolith with floating depth planes)
// Scene 4: And lately, I've been curious about AI. (3D Revolving Neural Constellation Sphere)

const storySteps = [
  { num: "01", label: "Introduction" },
  { num: "02", label: "Drive" },
  { num: "03", label: "Software" },
  { num: "04", label: "AI Curiosity" },
];
---

<div class="story-track" data-story-track>
  <div class="story-sticky">
    <!-- Ambient Canvas Grid & Background Halo -->
    <div class="canvas-grid" aria-hidden="true">
      <div class="grid-pattern"></div>
      <div class="ambient-glow" data-ambient-glow></div>

      <!-- Tasteful Floating 3D Ambient Craft Decorations (Subtle depth in backdrop) -->
      <div class="ambient-decorations" data-ambient-decorations>
        <div class="decor-item decor-laptop" data-parallax="-0.15">
          <img
            src="/assets/floating/code-laptop.webp"
            alt=""
            width="240"
            height="240"
            loading="lazy"
            decoding="async"
            class="decor-img"
          />
        </div>
        <div class="decor-item decor-coffee" data-parallax="0.12">
          <img
            src="/assets/floating/coffee-v60.webp"
            alt=""
            width="200"
            height="200"
            loading="lazy"
            decoding="async"
            class="decor-img"
          />
        </div>
      </div>
    </div>

    <!-- Structured Main Container: 2-Column Responsive Grid -->
    <div class="container story-container">
      <div class="story-layout">
        <!-- COLUMN 1: Narrative Story Panes (Staggered Cross-Fade) -->
        <div class="narrative-col">
          <!-- Scene 1 Text -->
          <div class="narrative-pane pane-1 active" data-pane="1">
            <p class="pane-kicker">Achmad Fahmi Ainur Ridho</p>
            <h1 class="pane-title display">Hey, I&rsquo;m Ridho.</h1>
            <p class="pane-lead">Full-stack engineer &amp; AI researcher.</p>
          </div>

          <!-- Scene 2 Text -->
          <div class="narrative-pane pane-2" data-pane="2">
            <h2 class="pane-title display">I like building things.</h2>
          </div>

          <!-- Scene 3 Text -->
          <div class="narrative-pane pane-3" data-pane="3">
            <h2 class="pane-title display">Software.</h2>
          </div>

          <!-- Scene 4 Text -->
          <div class="narrative-pane pane-4" data-pane="4">
            <h2 class="pane-title display">
              And lately, I&rsquo;ve been curious about AI.
            </h2>
          </div>
        </div>

        <!-- COLUMN 2: Central 3D Kinetic Stage (Morphs smoothly between 3D scenes) -->
        <div class="stage-col">
          <div class="kinetic-stage" data-kinetic-stage>
            <!-- SCENE 1: Creator Contemplation & 3D Idea Core -->
            <div class="kinetic-scene scene-1 active" data-scene="1">
              <div class="creator-stage-frame">
                <!-- Atmospheric Halo Glow -->
                <div class="creator-halo" aria-hidden="true"></div>

                <!-- Floating 3D Kinetic Builder's Cube (In Ridho's line of sight) -->
                <div
                  class="core-cube-wrapper"
                  data-core-cube
                  title="Click me to squish!"
                >
                  <div class="cube-facet front">
                    <span class="facet-glyph">{`{ }`}</span>
                  </div>
                  <div class="cube-facet back"></div>
                  <div class="cube-facet right">
                    <span class="facet-glyph">&lt;/&gt;</span>
                  </div>
                  <div class="cube-facet left"></div>
                  <div class="cube-facet top">
                    <span class="facet-dot"></span>
                  </div>
                  <div class="cube-facet bottom"></div>
                  <div class="cube-shadow"></div>
                </div>

                <!-- Fahmi Ridho Portrait Cutout (Centered & Grounded) -->
                <div class="creator-photo-wrapper" data-creator-photo>
                  <img
                    src="/assets/profile/photo-think-480.webp"
                    srcset="/assets/profile/photo-think-480.webp 480w, /assets/profile/photo-think-960.webp 960w"
                    sizes="(max-width: 900px) 220px, 300px"
                    alt="Achmad Fahmi Ainur Ridho in contemplation"
                    width="480"
                    height="640"
                    loading="eager"
                    decoding="async"
                    class="creator-photo-img"
                  />
                </div>
              </div>
            </div>

            <!-- SCENE 2: 3D Modular Architectural Polyhedrons -->
            <div class="kinetic-scene scene-2" data-scene="2">
              <div class="voxel-stage" data-voxel-stage>
                <!-- 3D Voxel Block A (UI) -->
                <div class="voxel-block block-ui">
                  <div class="voxel-face v-front">UI</div>
                  <div class="voxel-face v-top"></div>
                  <div class="voxel-face v-right"></div>
                  <div class="voxel-face v-left"></div>
                  <div class="voxel-face v-back"></div>
                  <div class="voxel-face v-bottom"></div>
                </div>

                <!-- 3D Voxel Block B (API Core) -->
                <div class="voxel-block block-api">
                  <div class="voxel-face v-front">API</div>
                  <div class="voxel-face v-top"></div>
                  <div class="voxel-face v-right"></div>
                  <div class="voxel-face v-left"></div>
                  <div class="voxel-face v-back"></div>
                  <div class="voxel-face v-bottom"></div>
                </div>

                <!-- 3D Voxel Block C (Database) -->
                <div class="voxel-block block-db">
                  <div class="voxel-face v-front">DATA</div>
                  <div class="voxel-face v-top"></div>
                  <div class="voxel-face v-right"></div>
                  <div class="voxel-face v-left"></div>
                  <div class="voxel-face v-back"></div>
                  <div class="voxel-face v-bottom"></div>
                </div>

                <div class="voxel-shadow"></div>
              </div>
            </div>

            <!-- SCENE 3: 3D Layered Terminal & Data Monolith -->
            <div class="kinetic-scene scene-3" data-scene="3">
              <div class="terminal-3d-stage" data-terminal-stage>
                <!-- Layer 1: Base Monolith Chassis (Depth 0) -->
                <div class="monolith-chassis">
                  <div class="chassis-face ch-front"></div>
                  <div class="chassis-face ch-top"></div>
                  <div class="chassis-face ch-right"></div>
                </div>

                <!-- Layer 2: Floating 3D Code Plane (Z: 40px) -->
                <div class="floating-code-plane">
                  <div class="code-bar-3d">
                    <span class="dot-3d d-red"></span>
                    <span class="dot-3d d-yellow"></span>
                    <span class="dot-3d d-green"></span>
                    <span class="title-3d">system.runtime</span>
                  </div>
                  <div class="code-lines-3d">
                    <span class="line-3d l-accent"></span>
                    <span class="line-3d l-long"></span>
                    <span class="line-3d l-med"></span>
                  </div>
                </div>

                <!-- Layer 3: Floating 3D API Gateway (Z: 85px) -->
                <div class="floating-gateway-plane">
                  <span class="gw-badge">POST /api/v1/stream</span>
                  <div class="gw-pulse-beam"></div>
                </div>

                <div class="terminal-shadow"></div>
              </div>
            </div>

            <!-- SCENE 4: 3D Revolving Neural Constellation Sphere -->
            <div class="kinetic-scene scene-4" data-scene="4">
              <div class="neural-sphere-stage" data-neural-stage>
                <div class="neural-orbit-ring ring-x"></div>
                <div class="neural-orbit-ring ring-y"></div>
                <div class="neural-orbit-ring ring-z"></div>

                <!-- 3D Orbiting Nodes -->
                <div class="orbit-node node-3d-1">
                  <span class="node-dot"></span>
                </div>
                <div class="orbit-node node-3d-2">
                  <span class="node-dot"></span>
                </div>
                <div class="orbit-node node-3d-3">
                  <span class="node-dot"></span>
                </div>
                <div class="orbit-node node-3d-4">
                  <span class="node-dot"></span>
                </div>
                <div class="orbit-node node-3d-5">
                  <span class="node-dot"></span>
                </div>

                <!-- Central 3D Outlier Anomaly Beacon -->
                <div class="anomaly-beacon-3d">
                  <div class="beacon-core"></div>
                  <div class="beacon-pulse-ring"></div>
                  <div class="beacon-label-3d">Anomaly Caught</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Step Navigation (Interactive Clickable 4-Scene Jump) -->
    <div class="story-footer">
      <div class="container footer-container">
        <nav class="steps-nav" aria-label="Story scene navigation">
          {
            storySteps.map((step, idx) => (
              <button
                type="button"
                class:list={["step-btn", idx === 0 && "active"]}
                data-step-nav={idx + 1}
                aria-label={`Jump to scene ${idx + 1}: ${step.label}`}
              >
                <span class="step-num">{step.num}</span>
                <span class="step-label">{step.label}</span>
              </button>
            ))
          }
        </nav>
        <div class="progress-track" aria-hidden="true">
          <div class="progress-bar-fill" data-story-progress></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { initOnPageLoad } from "@lib/page-script";

  initOnPageLoad(() => {
    const track = document.querySelector<HTMLElement>("[data-story-track]");
    if (!track) return;

    const controller = new AbortController();
    const { signal } = controller;

    const panes = Array.from(
      track.querySelectorAll<HTMLElement>("[data-pane]"),
    );
    const scenes = Array.from(
      track.querySelectorAll<HTMLElement>("[data-scene]"),
    );
    const stepBtns = Array.from(
      track.querySelectorAll<HTMLButtonElement>("[data-step-nav]"),
    );
    const progressBar = track.querySelector<HTMLElement>(
      "[data-story-progress]",
    );
    const coreCube = track.querySelector<HTMLElement>("[data-core-cube]");
    const creatorPhoto = track.querySelector<HTMLElement>(
      "[data-creator-photo]",
    );
    const voxelStage = track.querySelector<HTMLElement>("[data-voxel-stage]");
    const terminalStage = track.querySelector<HTMLElement>(
      "[data-terminal-stage]",
    );
    const neuralStage = track.querySelector<HTMLElement>("[data-neural-stage]");
    const stage = track.querySelector<HTMLElement>("[data-kinetic-stage]");
    const ambientGlow = track.querySelector<HTMLElement>("[data-ambient-glow]");
    const decorItems = Array.from(
      track.querySelectorAll<HTMLElement>("[data-parallax]"),
    );

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // Desktop Pointer Parallax for 3D stages and ambient decorations
    // Uses damped spring physics for organic, physical movement
    let mouseX = 0;
    let mouseY = 0;
    let velocityX = 0;
    let velocityY = 0;
    let targetX = 0;
    let targetY = 0;
    let lastTime = performance.now();
    let raf = 0;

    // Cursor-reactive ambient lighting
    const stickyEl = track.querySelector<HTMLElement>(".story-sticky");

    const onPointerMove = (e: PointerEvent) => {
      if (reduceMotion || !stage) return;
      const rect = stage.getBoundingClientRect();
      const x = (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2);
      const y = (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2);
      targetX = Math.max(-1, Math.min(1, x));
      targetY = Math.max(-1, Math.min(1, y));

      // Update cursor lighting position
      if (stickyEl) {
        const stickyRect = stickyEl.getBoundingClientRect();
        const mxPct = ((e.clientX - stickyRect.left) / stickyRect.width) * 100;
        const myPct = ((e.clientY - stickyRect.top) / stickyRect.height) * 100;
        stickyEl.style.setProperty("--mx", `${mxPct}%`);
        stickyEl.style.setProperty("--my", `${myPct}%`);
      }

      if (!raf) raf = requestAnimationFrame(updateParallax);
    };

    const updateParallax = () => {
      const now = performance.now();
      const dt = Math.min((now - lastTime) / 1000, 0.05); // Cap delta to avoid jumps
      lastTime = now;

      // Damped spring physics: stiffness controls snap, damping controls settle
      const stiffness = 120;
      const damping = 14;

      velocityX += (targetX - mouseX) * stiffness * dt;
      velocityX *= Math.exp(-damping * dt);
      mouseX += velocityX * dt;

      velocityY += (targetY - mouseY) * stiffness * dt;
      velocityY *= Math.exp(-damping * dt);
      mouseY += velocityY * dt;

      // 3D Scene 1: Creator & Floating Cube
      if (creatorPhoto) {
        const pX = mouseX * -7;
        const pY = mouseY * -4;
        creatorPhoto.style.transform = `translate3d(${pX}px, ${pY}px, 0)`;
      }
      if (coreCube) {
        const rotY = -24 + mouseX * 24;
        const rotX = 18 - mouseY * 20;
        coreCube.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;
      }

      // 3D Scene 2: Voxel Stage
      if (voxelStage) {
        const vRotY = -20 + mouseX * 20;
        const vRotX = 22 - mouseY * 16;
        voxelStage.style.transform = `rotateX(${vRotX}deg) rotateY(${vRotY}deg)`;
      }

      // 3D Scene 3: Terminal Stage
      if (terminalStage) {
        const tRotY = -22 + mouseX * 22;
        const tRotX = 20 - mouseY * 18;
        terminalStage.style.transform = `rotateX(${tRotX}deg) rotateY(${tRotY}deg)`;
      }

      // 3D Scene 4: Neural Sphere Stage
      if (neuralStage) {
        const nRotY = mouseX * 36;
        const nRotX = -mouseY * 28;
        neuralStage.style.transform = `rotateX(${nRotX}deg) rotateY(${nRotY}deg)`;
      }

      // Ambient 3D Decorations Parallax with multi-layer depth
      decorItems.forEach((decor) => {
        const factor = parseFloat(decor.dataset.parallax || "0.1");
        decor.style.transform = `translate3d(${mouseX * factor * 75}px, ${mouseY * factor * 75}px, 0)`;
      });

      const settling =
        Math.abs(targetX - mouseX) > 0.001 ||
        Math.abs(targetY - mouseY) > 0.001 ||
        Math.abs(velocityX) > 0.01 ||
        Math.abs(velocityY) > 0.01;

      if (settling) {
        raf = requestAnimationFrame(updateParallax);
      } else {
        raf = 0;
      }
    };

    window.addEventListener("pointermove", onPointerMove, {
      passive: true,
      signal,
    });

    // Mobile Gyroscope Tilt: 3D art responds organically to device orientation
    if (typeof window !== "undefined" && "DeviceOrientationEvent" in window) {
      const onDeviceOrientation = (e: DeviceOrientationEvent) => {
        if (reduceMotion || !stage) return;
        if (e.gamma === null || e.beta === null) return;
        // gamma: tilt left-to-right [-90, 90]
        // beta: tilt front-to-back [-180, 180], baseline holding angle ~45 deg
        const x = Math.max(-1, Math.min(1, (e.gamma || 0) / 32));
        const y = Math.max(-1, Math.min(1, ((e.beta || 0) - 45) / 32));
        targetX = x;
        targetY = y;
        if (!raf) raf = requestAnimationFrame(updateParallax);
      };

      window.addEventListener("deviceorientation", onDeviceOrientation, {
        passive: true,
        signal,
      });
    }

    // Interactive Click Squish for Scene 1 Cube
    if (coreCube) {
      coreCube.addEventListener("click", () => {
        coreCube.classList.add("is-squished");
        window.setTimeout(() => coreCube.classList.remove("is-squished"), 400);
      });
    }

    // Interactive Clickable Scene Step Navigation (4 Scenes)
    const HEADER_HEIGHT = 56;

    stepBtns.forEach((btn, idx) => {
      btn.addEventListener("click", () => {
        const trackRect = track.getBoundingClientRect();
        const trackTop = trackRect.top + window.scrollY - HEADER_HEIGHT;
        const totalDist =
          track.offsetHeight - (window.innerHeight - HEADER_HEIGHT);
        const sceneFractions = [0, 0.33, 0.66, 0.95];
        const targetScroll = trackTop + sceneFractions[idx] * totalDist;
        window.scrollTo({
          top: targetScroll,
          behavior: "smooth",
        });
      });
    });

    // Scroll Progress & Scene Switching Logic with rAF & Hysteresis
    let scrollRaf = 0;
    let activeScene = 0;

    const updateScenes = () => {
      scrollRaf = 0;
      if (reduceMotion) return;

      const rect = track.getBoundingClientRect();
      const totalDist =
        track.offsetHeight - (window.innerHeight - HEADER_HEIGHT);
      if (totalDist <= 0) return;

      const scrolled = HEADER_HEIGHT - rect.top;
      const progress = Math.max(0, Math.min(1, scrolled / totalDist));

      // Natural progressive scroll: starts from 0 and tracks scroll 1:1 up to 1.00
      if (progressBar) {
        progressBar.style.transform = `scaleX(${progress})`;
      }

      // Hysteresis deadband: prevent scene jitter at thresholds
      let newScene = activeScene;
      if (activeScene === 0 && progress >= 0.25) newScene = 1;
      else if (activeScene === 1) {
        if (progress >= 0.5) newScene = 2;
        else if (progress <= 0.21) newScene = 0;
      } else if (activeScene === 2) {
        if (progress >= 0.75) newScene = 3;
        else if (progress <= 0.46) newScene = 1;
      } else if (activeScene === 3 && progress <= 0.71) {
        newScene = 2;
      }

      if (newScene !== activeScene) {
        activeScene = newScene;

        panes.forEach((pane, idx) => {
          pane.classList.toggle("active", idx === activeScene);
        });

        scenes.forEach((sc, idx) => {
          sc.classList.toggle("active", idx === activeScene);
        });

        stepBtns.forEach((nav, idx) => {
          nav.classList.toggle("active", idx === activeScene);
        });

        if (ambientGlow) {
          if (activeScene === 3) {
            ambientGlow.style.background =
              "radial-gradient(circle, rgba(201, 46, 62, 0.16) 0%, rgba(247, 247, 246, 0) 70%)";
          } else {
            ambientGlow.style.background =
              "radial-gradient(circle, rgba(22, 24, 29, 0.05) 0%, rgba(247, 247, 246, 0) 70%)";
          }
        }
      }
    };

    // Initialize state on load: progress starts at 0
    const initialRect = track.getBoundingClientRect();
    const initialTotalDist =
      track.offsetHeight - (window.innerHeight - HEADER_HEIGHT);
    if (initialTotalDist > 0) {
      const initialScrolled = HEADER_HEIGHT - initialRect.top;
      const p = Math.max(0, Math.min(1, initialScrolled / initialTotalDist));
      activeScene = Math.min(3, Math.floor(p * 4));
      panes.forEach((pane, idx) =>
        pane.classList.toggle("active", idx === activeScene),
      );
      scenes.forEach((sc, idx) =>
        sc.classList.toggle("active", idx === activeScene),
      );
      stepBtns.forEach((nav, idx) =>
        nav.classList.toggle("active", idx === activeScene),
      );
      if (progressBar) {
        progressBar.style.transform = `scaleX(${p})`;
      }
    }

    const onScroll = () => {
      if (!scrollRaf) {
        scrollRaf = requestAnimationFrame(updateScenes);
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true, signal });

    return () => {
      controller.abort();
      if (raf) cancelAnimationFrame(raf);
      if (scrollRaf) cancelAnimationFrame(scrollRaf);
    };
  });
</script>

<style>
  /* ------------------------------- Track & Viewport ------------------------------- */

  .story-track {
    position: relative;
    height: 380vh;
    background: var(--paper);
  }

  .story-sticky {
    position: sticky;
    top: var(--header-height, 56px);
    height: calc(100vh - var(--header-height, 56px));
    height: calc(100dvh - var(--header-height, 56px));
    width: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* Cursor-reactive ambient lighting: subtle carmine warmth follows pointer */
  .story-sticky::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      800px circle at var(--mx, 50%) var(--my, 50%),
      rgba(201, 46, 62, 0.035),
      transparent 50%
    );
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .story-sticky:hover::before {
    opacity: 1;
  }

  /* ------------------------------ Ambient Backdrop ------------------------------ */

  .canvas-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .grid-pattern {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(22, 24, 29, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(22, 24, 29, 0.035) 1px, transparent 1px);
    background-size: 44px 44px;
  }

  .ambient-glow {
    position: absolute;
    top: 50%;
    right: 25%;
    transform: translate(50%, -50%);
    width: 60vw;
    height: 60vw;
    max-width: 650px;
    max-height: 650px;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      rgba(22, 24, 29, 0.05) 0%,
      rgba(247, 247, 246, 0) 70%
    );
    filter: blur(60px);
    transition: background 0.8s ease;
  }

  /* Tasteful Ambient 3D Decorations */
  .ambient-decorations {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .decor-item {
    position: absolute;
    opacity: 0.16;
    transition: transform 0.2s ease-out;
  }

  .decor-laptop {
    top: 18%;
    right: 8%;
    width: clamp(140px, 18vw, 220px);
    transform: rotate(15deg);
    filter: blur(1px);
  }

  .decor-coffee {
    bottom: 15%;
    left: 4%;
    width: clamp(100px, 14vw, 170px);
    transform: rotate(-12deg);
    filter: blur(1px);
  }

  .decor-img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* --------------------------- 2-Column Responsive Grid -------------------------- */

  .story-container {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    z-index: 1;
    padding-top: clamp(1.5rem, 3.5vh, 2.5rem);
    padding-bottom: clamp(1.5rem, 3.5vh, 2.5rem);
  }

  .story-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    width: 100%;
  }

  /* ----------------------------- Column 1: Narrative ----------------------------- */

  .narrative-col {
    display: grid;
    grid-template-areas: "stack";
    align-items: center;
    width: 100%;
  }

  .narrative-pane {
    grid-area: stack;
    width: 100%;
    max-width: 540px;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    will-change: opacity, transform;
  }

  .narrative-pane.active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .pane-kicker {
    margin: 0 0 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    text-transform: uppercase;
  }

  .pane-title {
    margin: 0 0 1.15rem;
    color: var(--ink);
    font-family: var(--font-serif);
