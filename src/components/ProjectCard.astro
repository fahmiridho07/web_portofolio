---
import { getCategoryMeta } from "@lib/projects";
import { getImageMeta } from "@lib/images";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const href = `/projects/${project.data.slug}/`;
const metric = project.data.metric ?? project.data.status;
const category = getCategoryMeta(project.data.category);
const projectLogo = project.data.logo ?? category.logo;
const coverMeta = getImageMeta(project.data.coverImage);
const stackLine = project.data.stack.slice(0, 4).join(" / ");
const proofLine = project.data.proof?.[0] ?? metric;
---

<article class="project-card" data-category={project.data.category}>
  <a class="project-link" href={href} aria-label={`Read case study: ${project.data.title}`}>
    <div class="project-thumb" aria-hidden="true">
      <img
        src={project.data.coverImage}
        alt=""
        width={coverMeta?.width}
        height={coverMeta?.height}
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="project-main">
      <div class="project-kicker">
        <p class="project-category">
          {projectLogo && <img src={projectLogo} alt="" width="24" height="24" loading="lazy" decoding="async" />}
          <span>{category.title}</span>
        </p>
        <p>{project.data.year}</p>
      </div>
      <h3>{project.data.title}</h3>
      <p class="project-summary">{project.data.summary}</p>
      <p class="project-proof">{proofLine}</p>

      <div class="project-footer">
        <span class="project-metric">{metric}</span>
        <small>{stackLine}</small>
      </div>
    </div>
  </a>
</article>

<style>
  .project-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.5);
    transition:
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }

  .project-card::before {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--accent);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms ease;
  }

  .project-card:hover {
    border-color: var(--line-strong);
    background: #ffffff;
    transform: translateY(-2px);
  }

  .project-card:hover::before {
    transform: scaleX(1);
  }

  .project-link {
    display: grid;
    height: 100%;
    color: inherit;
  }

  .project-thumb {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-subtle);
  }

  .project-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 200ms ease;
  }

  .project-card:hover .project-thumb img {
    transform: scale(1.03);
  }

  .project-main {
    display: grid;
    align-content: start;
    gap: 0.72rem;
    min-width: 0;
    padding: clamp(1rem, 2.5vw, 1.25rem);
  }

  .project-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
    align-items: center;
    justify-content: space-between;
  }

  .project-kicker p,
  small {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.6875rem;
    line-height: 1.35;
  }

  .project-category {
    display: inline-flex;
    width: fit-content;
    min-width: 0;
    align-items: center;
    gap: 0.38rem;
    border-radius: 999px;
    background: var(--accent-dim);
    color: var(--accent);
    padding: 0.4rem 0.62rem;
    line-height: 1;
  }

  .project-category img {
    width: 0.92rem;
    height: 0.92rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  h3 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.15rem, 2vw, 1.42rem);
    font-weight: 500;
    line-height: 1.12;
    overflow-wrap: break-word;
  }

  .project-summary {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--text-muted);
    font-size: 0.86rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .project-proof {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    border-left: 2px solid var(--accent);
    color: var(--text);
    font-size: 0.82rem;
    line-height: 1.42;
    padding-left: 0.65rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .project-footer {
    display: grid;
    gap: 0.6rem;
    align-self: end;
  }

  .project-metric {
    width: fit-content;
    border-radius: 999px;
    background: var(--accent-dim);
    color: var(--accent);
    font-size: 0.75rem;
    line-height: 1;
    padding: 0.42rem 0.66rem;
  }

  small {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (max-width: 520px) {
    .project-thumb {
      aspect-ratio: 1.5;
    }

    h3 {
      font-size: 1.15rem;
      line-height: 1.16;
    }
  }
</style>
