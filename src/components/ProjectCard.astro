---
import ProjectMockup from "@components/ProjectMockup.astro";
import { getCategoryMeta } from "@lib/projects";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const href = `/projects/${project.data.slug}/`;
const metric = project.data.metric ?? project.data.status;
const category = getCategoryMeta(project.data.category);
const projectLogo = project.data.logo ?? category.logo;
const buildLine = project.data.stack.slice(0, 3).join(" / ");
const proofLine = project.data.proof?.[0] ?? metric;
const resultLine = project.data.metric ?? proofLine;
const storyItems = [
  {
    label: "Problem",
    value: project.data.summary,
  },
  {
    label: "Built",
    value: buildLine,
  },
  {
    label: "Result",
    value: resultLine,
  },
];
---

<article class="project-card" data-category={project.data.category} data-reveal>
  <a class="project-link" href={href} aria-label={`Open the build: ${project.data.title}`}>
    <div class="project-thumb" aria-hidden="true">
      <ProjectMockup project={project} variant="card" />
    </div>

    <div class="project-main">
      <div class="project-kicker">
        <p class="project-category">
          {projectLogo && <img src={projectLogo} alt="" width="24" height="24" loading="lazy" decoding="async" />}
          <span>{category.title}</span>
        </p>
        <p>{project.data.year}</p>
      </div>
      <h3>{project.data.title}</h3>
      <dl class="project-story" aria-label={`${project.data.title} quick story`}>
        {
          storyItems.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="project-footer">
        <small>{project.data.role}</small>
        <span class="project-arrow" aria-hidden="true">Open -&gt;</span>
      </div>
    </div>
  </a>
</article>

<style>
  .project-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(17, 24, 39, 0.1);
    border-radius: 8px;
    background:
      radial-gradient(circle at 90% 0%, rgba(125, 211, 252, 0.07), transparent 10rem),
      linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.72)),
      #ffffff;
    box-shadow: 0 10px 32px rgba(17, 24, 39, 0.045);
    transition:
      border-color var(--motion-medium) var(--ease-standard),
      background var(--motion-medium) var(--ease-standard),
      box-shadow var(--motion-medium) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
  }

  .project-card::before {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-cyan), var(--accent-amber));
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-medium) var(--ease-out);
    z-index: 1;
  }

  .project-card:hover,
  .project-card:focus-within {
    border-color: rgba(47, 123, 255, 0.34);
    background: #ffffff;
    box-shadow:
      0 18px 54px rgba(17, 24, 39, 0.1),
      0 0 32px rgba(125, 211, 252, 0.06);
    transform: translateY(-3px);
  }

  .project-card:hover::before,
  .project-card:focus-within::before {
    transform: scaleX(1);
  }

  .project-link {
    display: grid;
    height: 100%;
    color: inherit;
  }

  .project-thumb {
    position: relative;
    aspect-ratio: 1.62;
    overflow: hidden;
    background: var(--surface-subtle);
  }

  .project-main {
    display: grid;
    align-content: start;
    gap: 0.58rem;
    min-width: 0;
    padding: clamp(0.9rem, 1.9vw, 1.05rem);
  }

  .project-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
    align-items: center;
    justify-content: space-between;
  }

  .project-kicker p,
  small {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.6875rem;
    line-height: 1.35;
  }

  .project-category {
    display: inline-flex;
    width: fit-content;
    min-width: 0;
    align-items: center;
    gap: 0.38rem;
    border-radius: 999px;
    border: 1px solid rgba(15, 159, 135, 0.2);
    background: var(--accent-dim);
    color: #0f5f54;
    padding: 0.34rem 0.52rem;
    line-height: 1;
  }

  .project-category img {
    width: 0.92rem;
    height: 0.92rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .project-category span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  h3 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.02rem, 1.45vw, 1.18rem);
    font-weight: 600;
    line-height: 1.14;
    overflow-wrap: break-word;
  }

  .project-story {
    display: grid;
    gap: 0.45rem;
    margin: 0;
  }

  .project-story div {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: start;
  }

  .project-story dt {
    color: var(--accent);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.63rem;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .project-story dd {
    display: -webkit-box;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.38;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .project-story div:last-child dd {
    color: var(--text);
    font-weight: 500;
  }

  .project-footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: end;
    align-self: end;
  }

  small {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .project-arrow {
    color: var(--accent-coral);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1;
    opacity: 0;
    transform: translateX(-5px);
    transition:
      opacity var(--motion-fast) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
  }

  .project-card:hover .project-arrow,
  .project-card:focus-within .project-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 620px) {
    .project-link {
      grid-template-columns: 6.35rem minmax(0, 1fr);
      align-items: stretch;
    }

    .project-thumb {
      aspect-ratio: auto;
      min-height: 8.35rem;
      height: 100%;
      border-right: 1px solid rgba(17, 24, 39, 0.08);
    }

    .project-story div:nth-child(2),
    .project-category img,
    .project-footer small {
      display: none;
    }

    .project-main {
      gap: 0.48rem;
      padding: 0.82rem 0.86rem;
    }

    .project-kicker {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.32rem;
    }

    .project-category {
      width: 100%;
      max-width: 100%;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--text-soft);
      font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
      text-transform: uppercase;
    }

    .project-footer {
      grid-template-columns: 1fr;
      margin-top: 0.1rem;
    }

    .project-arrow {
      opacity: 1;
      transform: none;
    }

    h3 {
      font-size: 0.98rem;
      line-height: 1.16;
    }

    .project-story {
      gap: 0.38rem;
    }

    .project-story div {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 0.45rem;
    }

    .project-story dt,
    .project-story dd {
      font-size: 0.78rem;
      line-height: 1.38;
    }
  }

  @media (max-width: 370px) {
    .project-link {
      grid-template-columns: 5.7rem minmax(0, 1fr);
    }
  }
</style>
