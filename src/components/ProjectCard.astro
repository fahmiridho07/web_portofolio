---
import ProjectMockup from "@components/ProjectMockup.astro";
import { getCategoryMeta } from "@lib/projects";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const href = `/projects/${project.data.slug}/`;
const metric = project.data.metric ?? project.data.status;
const category = getCategoryMeta(project.data.category);
const projectLogo = project.data.logo ?? category.logo;
---

<article class="project-card glass-card" data-category={project.data.category} data-reveal>
  <a
    class="project-link"
    href={href}
    aria-label={`Open the build: ${project.data.title}`}
    data-astro-prefetch="hover"
  >
    <div class="project-thumb" aria-hidden="true">
      <ProjectMockup project={project} variant="card" />
    </div>

    <div class="project-main">
      <div class="project-kicker">
        <p class="project-category glass-chip">
          {projectLogo && <img src={projectLogo} alt="" width="24" height="24" loading="lazy" decoding="async" />}
          <span>{category.title}</span>
        </p>
        <p>{project.data.year}</p>
      </div>

      <h3>{project.data.title}</h3>

      <div class="project-meta">
        <span class="project-metric glass-chip">{metric}</span>
        <span class="project-role">{project.data.role}</span>
      </div>

      <span class="project-arrow" aria-hidden="true">Open -&gt;</span>
    </div>
  </a>
</article>

<style>
  .project-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    transition:
      border-color var(--motion-medium) var(--ease-standard),
      box-shadow var(--motion-medium) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
  }

  .project-card::before {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent-cyan), var(--accent-amber));
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-medium) var(--ease-out);
    z-index: 1;
  }

  .project-card:hover,
  .project-card:focus-within {
    border-color: color-mix(in srgb, var(--accent-cyan) 30%, var(--card-border));
    background: var(--card-bg-hover, var(--card-bg));
    box-shadow:
      var(--shadow-soft),
      0 0 32px color-mix(in srgb, var(--accent-cyan) 6%, transparent);
    transform: translateY(-3px);
  }

  .project-card:hover::before,
  .project-card:focus-within::before {
    transform: scaleX(1);
  }

  .project-link {
    display: grid;
    height: 100%;
    color: inherit;
  }

  .project-thumb {
    position: relative;
    aspect-ratio: 1.62;
    overflow: hidden;
    background: var(--surface-subtle);
  }

  .project-main {
    display: grid;
    align-content: start;
    gap: var(--space-stack-sm);
    min-width: 0;
    padding: clamp(0.9rem, 1.9vw, 1.05rem) clamp(1rem, 2vw, 1.15rem);
  }

  .project-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
    align-items: center;
    justify-content: space-between;
  }

  .project-kicker p {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.6875rem;
    line-height: 1.35;
  }

  .project-category {
    display: inline-flex;
    width: fit-content;
    min-width: 0;
    align-items: center;
    gap: 0.38rem;
    border-color: var(--badge-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent-dim) 78%, var(--surface-elevated));
    color: var(--accent-on);
    padding: 0.34rem 0.52rem;
    line-height: 1;
  }

  .project-category img {
    width: 0.92rem;
    height: 0.92rem;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .project-category span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  h3 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    font-weight: 600;
    line-height: 1.14;
    overflow-wrap: break-word;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }

  .project-metric {
    border-color: var(--badge-border-strong);
    border-radius: 999px;
    background: color-mix(in srgb, var(--badge-metric-bg) 82%, var(--surface-elevated));
    color: var(--accent-on);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.68rem;
    line-height: 1;
    padding: 0.4rem 0.58rem;
  }

  .project-role {
    color: var(--text-soft);
    font-size: 0.72rem;
    line-height: 1.3;
  }

  .project-arrow {
    color: var(--accent-coral);
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1;
    opacity: 0;
    transform: translateX(-5px);
    transition:
      opacity var(--motion-fast) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
  }

  .project-card:hover .project-arrow,
  .project-card:focus-within .project-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 620px) {
    .project-link {
      grid-template-columns: 6.35rem minmax(0, 1fr);
      align-items: stretch;
    }

    .project-thumb {
      aspect-ratio: auto;
      min-height: 8.35rem;
      height: 100%;
      border-right: 1px solid var(--grid-line);
    }

    .project-category img {
      display: none;
    }

    .project-main {
      gap: 0.42rem;
      padding: 0.82rem 0.86rem;
    }

    .project-kicker {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.32rem;
    }

    .project-category {
      width: 100%;
      max-width: 100%;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--text-soft);
      font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
      text-transform: uppercase;
    }

    .project-role {
      display: none;
    }

    .project-arrow {
      opacity: 1;
      transform: none;
    }

    h3 {
      font-size: 0.96rem;
      line-height: 1.16;
    }
  }

  @media (max-width: 370px) {
    .project-link {
      grid-template-columns: 5.7rem minmax(0, 1fr);
    }
  }
</style>