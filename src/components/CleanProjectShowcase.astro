---
// CleanProjectShowcase.astro: Human-Friendly, Visual-First Project Showcase
// Solves the "text-heavy, nobody reads it" problem with large imagery,
// 1-sentence plain-English benefits, clean tags, and direct CTA buttons.
import { getResponsiveImageSources } from "@lib/images";
import { getSortedProjects } from "@lib/projects";

const allProjects = await getSortedProjects();

// Plain-English translations of project benefits for ordinary visitors & recruiters
const friendlyProjectMap: Record<
  string,
  {
    humanTitle: string;
    plainHeadline: string;
    humanImpact: string;
    badge?: string;
    tags: string[];
  }
> = {
  "fraud-detection-ml-pipeline": {
    humanTitle: "Fraud Detection AI",
    plainHeadline:
      "Catching payment fraud with machine learning before transactions settle.",
    humanImpact:
      "Engineered under 1:590 class imbalance with 89% precision on IEEE-CIS benchmarks.",
    badge: "Flagship ML & Research",
    tags: ["Machine Learning", "Python", "Optuna", "Signals"],
  },
  "medimate-medicine-reminder-app": {
    humanTitle: "MediMate Healthcare",
    plainHeadline:
      "Clean Flutter mobile experience for personal prescription routines.",
    humanImpact:
      "Intuitive timeline schedule, local reminder triggers, and zero-latency storage.",
    badge: "Mobile UI & Experience",
    tags: ["Flutter", "Dart", "Material 3", "Android"],
  },
  "kpc-ideku-v3-dotnet-stabilization": {
    humanTitle: "Mining Operations Platform",
    plainHeadline:
      "Stabilizing mission-critical ASP.NET Core workflows for 5,000+ mining staff.",
    humanImpact:
      "Fixed security access control, embedded live analytics, and cut query latency.",
    badge: "Enterprise .NET",
    tags: ["ASP.NET Core", "C#", "SQL Server", "Enterprise"],
  },
  "scent2me-perfume-recommendation": {
    humanTitle: "Scent2Me Fragrance AI",
    plainHeadline:
      "Interactive fragrance discovery matching personal scent preferences.",
    humanImpact:
      "TF-IDF vector matching across 1,000+ fragrance notes with live FastAPI recommendations.",
    badge: "Vector Search",
    tags: ["FastAPI", "Vector Similarity", "Python", "Web"],
  },
};

const selectedSlugs = [
  "fraud-detection-ml-pipeline",
  "medimate-medicine-reminder-app",
  "kpc-ideku-v3-dotnet-stabilization",
  "scent2me-perfume-recommendation",
];

const showcaseList = selectedSlugs
  .map((slug) => {
    const proj = allProjects.find((p) => p.data.slug === slug);
    const friendly = friendlyProjectMap[slug];
    if (!proj || !friendly) return null;
    return {
      proj,
      friendly,
      image: getResponsiveImageSources(
        proj.data.coverImage,
        "(max-width: 900px) 100vw, 48vw",
      ),
    };
  })
  .filter((item): item is NonNullable<typeof item> => Boolean(item));
---

<section id="work" class="showcase-section divider">
  <!-- Ambient 3D Geometric Accents (Pure visual decoration, zero text) -->
  <div class="ambient-3d-scene" aria-hidden="true">
    <div class="ambient-shape shape-cube">
      <div class="cube-facet-amb f-front"></div>
      <div class="cube-facet-amb f-top"></div>
      <div class="cube-facet-amb f-right"></div>
    </div>
    <div class="ambient-shape shape-ring"></div>
  </div>

  <div class="container relative-z">
    <!-- Header -->
    <div class="showcase-header" data-reveal>
      <div>
        <p class="section-kicker">CURATED WORKS & DESIGN</p>
        <h2 class="showcase-title">Selected builds &amp; interface craft.</h2>
      </div>
      <p class="showcase-lead">
        A selection of shipped software, mobile experiences, and applied machine
        learning systems built with relentless attention to design and code.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="cards-grid">
      {
        showcaseList.map(({ proj, friendly, image }, idx) => {
          const isLead = idx === 0;
          return (
            <article
              class:list={["project-card", isLead && "is-lead-card"]}
              data-card-tilt
              data-reveal
              data-reveal-delay={String(idx * 70)}
            >
              <a
                href={`/projects/${proj.data.slug}/`}
                class="card-inner"
                data-astro-prefetch="hover"
              >
                {/* Visual Cover */}
                <div class="card-visual">
                  <img
                    src={image.src}
                    srcset={image.srcset}
                    sizes={image.srcset ? image.sizes : undefined}
                    alt={friendly.humanTitle}
                    width={image.width}
                    height={image.height}
                    loading={isLead ? "eager" : "lazy"}
                    decoding="async"
                    class="project-img"
                  />
                  {friendly.badge && (
                    <span class="project-badge">
                      <span class="badge-dot" />
                      {friendly.badge}
                    </span>
                  )}
                </div>

                {/* Text Content: Ultra-Concise & Scannable */}
                <div class="card-details">
                  <div class="card-top-row">
                    <h3 class="card-heading">
                      {friendly.humanTitle}
                      <span class="arrow-icon" aria-hidden="true">
                        &rarr;
                      </span>
                    </h3>
                  </div>

                  <p class="card-headline">{friendly.plainHeadline}</p>
                  <p class="card-impact">{friendly.humanImpact}</p>

                  <div class="card-tags">
                    {friendly.tags.map((tag) => (
                      <span class="tag-pill">{tag}</span>
                    ))}
                  </div>

                  <div class="card-cta">
                    <span class="cta-text">Read Case Study</span>
                    <span class="cta-arrow" aria-hidden="true">
                      &rarr;
                    </span>
                  </div>
                </div>
              </a>
            </article>
          );
        })
      }
    </div>

    <!-- Footer Action -->
    <div class="showcase-footer" data-reveal>
      <a href="/projects/" class="view-all-btn" data-astro-prefetch="hover">
        Browse All {allProjects.length} Projects & Case Studies
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<script>
  import { initOnPageLoad } from "@lib/page-script";

  initOnPageLoad(() => {
    const cards = document.querySelectorAll<HTMLElement>("[data-card-tilt]");
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduceMotion || window.innerWidth < 900) return;

    cards.forEach((card) => {
      let isHovered = false;

      card.addEventListener("mouseenter", () => {
        isHovered = true;
        card.style.transition =
          "transform 140ms ease-out, box-shadow 140ms ease-out";
      });

      card.addEventListener("mousemove", (e) => {
        if (!isHovered) return;
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        const rotX = -y * 8;
        const rotY = x * 8;
        card.style.transform = `perspective(1000px) rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg) translateY(-4px)`;
      });

      card.addEventListener("mouseleave", () => {
        isHovered = false;
        card.style.transition =
          "transform 360ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 360ms ease-out";
        card.style.transform =
          "perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0)";
      });
    });
  });
</script>

<style>
  .showcase-section {
    position: relative;
    padding-block: clamp(3.5rem, 7vw, 6rem);
    background: var(--paper);
    overflow: hidden;
  }

  .relative-z {
    position: relative;
    z-index: 1;
  }

  /* Ambient 3D Geometric Accents (Pure visual depth decoration) */
  .ambient-3d-scene {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  .ambient-shape {
    position: absolute;
    transform-style: preserve-3d;
  }

  .shape-cube {
    top: 6%;
    right: 4%;
    width: 72px;
    height: 72px;
    transform: rotateX(24deg) rotateY(-32deg);
    animation: ambient-drift 18s ease-in-out infinite alternate;
  }

  .cube-facet-amb {
    position: absolute;
    inset: 0;
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.5);
    box-shadow: inset 0 0 14px rgba(22, 24, 29, 0.02);
  }

  .cube-facet-amb.f-top {
    transform: rotateX(90deg) translateZ(36px);
    background: rgba(255, 255, 255, 0.7);
  }

  .cube-facet-amb.f-right {
    transform: rotateY(90deg) translateZ(36px);
    background: rgba(238, 238, 236, 0.6);
  }

  .cube-facet-amb.f-front {
    transform: translateZ(36px);
  }

  .shape-ring {
    bottom: 10%;
    left: 2%;
    width: 100px;
    height: 100px;
    border: 1.5px dashed rgba(201, 46, 62, 0.22);
    border-radius: 999px;
    transform: rotateX(68deg) rotateZ(25deg);
    animation: ambient-spin 28s linear infinite;
  }

  @keyframes ambient-drift {
    0% {
      transform: rotateX(24deg) rotateY(-32deg) translateY(0);
    }
    100% {
      transform: rotateX(34deg) rotateY(-18deg) translateY(-18px);
    }
  }

  @keyframes ambient-spin {
    to {
      transform: rotateX(68deg) rotateZ(385deg);
    }
  }

  .showcase-header {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 1.5rem 3rem;
    align-items: baseline;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    margin: 0;
  }

  .showcase-title {
    margin: 0.5rem 0 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 470;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .showcase-lead {
    margin: 0;
    color: var(--ink-muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  /* Cards Grid */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .project-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all var(--motion-fast) var(--ease-standard);
  }

  .project-card:hover {
    border-color: var(--ink);
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(22, 24, 29, 0.06);
  }

  /* Lead flagship card spans both columns on desktop */
  .project-card.is-lead-card {
    grid-column: 1 / -1;
    border-top: 3px solid var(--signal);
  }

  .card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .is-lead-card .card-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  }

  .card-visual {
    position: relative;
    width: 100%;
    aspect-ratio: 1.6;
    background: var(--paper-soft);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .is-lead-card .card-visual {
    aspect-ratio: auto;
    min-height: 300px;
    border-bottom: none;
    border-right: 1px solid var(--line);
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-slow) var(--ease-out);
  }

  .project-card:hover .project-img {
    transform: scale(1.03);
  }

  .project-badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(22, 24, 29, 0.9);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-pill);
    backdrop-filter: blur(8px);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--signal);
  }

  .card-details {
    padding: clamp(1.25rem, 2.5vw, 1.85rem);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-top-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }

  .card-heading {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .is-lead-card .card-heading {
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
  }

  .project-card:hover .card-heading {
    color: var(--signal-deep);
  }

  .arrow-icon {
    font-size: 1.1rem;
    color: var(--ink-soft);
    transition:
      transform var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-standard);
  }

  .project-card:hover .arrow-icon {
    transform: translateX(4px);
    color: var(--signal);
  }

  .card-headline {
    margin: 0 0 0.5rem;
    font-size: 0.96rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink);
  }

  .card-impact {
    margin: 0 0 1.25rem;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--ink-muted);
    flex-grow: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .tag-pill {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--ink-soft);
    background: var(--paper-soft);
    border: 1px solid var(--line);
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--signal-deep);
    border-top: 1px solid var(--line);
    padding-top: 0.85rem;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .project-card:hover .card-cta {
    color: var(--signal);
  }

  .cta-arrow {
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .project-card:hover .cta-arrow {
    transform: translateX(3px);
  }

  /* Footer */
  .showcase-footer {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .view-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.85rem 1.6rem;
    border-radius: var(--radius-pill);
    transition: all var(--motion-fast) var(--ease-standard);
  }

  .view-all-btn:hover {
    background: var(--signal-deep);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(201, 46, 62, 0.2);
  }

  @media (max-width: 900px) {
    .showcase-header {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .cards-grid {
      grid-template-columns: 1fr;
    }
    .is-lead-card .card-inner {
      grid-template-columns: 1fr;
    }
    .is-lead-card .card-visual {
      border-right: none;
      border-bottom: 1px solid var(--line);
      min-height: 220px;
    }
  }
</style>
