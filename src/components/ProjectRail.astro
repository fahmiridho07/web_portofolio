---
import ProjectMockup from "@components/ProjectMockup.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<section class="proof-rail divider" aria-labelledby="proof-rail-title">
  <div class="container">
    <div class="rail-head">
      <div>
        <p class="section-label">Supporting proof</p>
        <h2 id="proof-rail-title">More evidence, quick to scan.</h2>
      </div>
      <a href="/projects/">All projects</a>
    </div>

    <div class="rail-track" aria-label="Featured project carousel">
      {
        projects.map((project, index) => (
          <article class="rail-card">
            <a href={`/projects/${project.data.slug}/`}>
              <div class="cover" aria-hidden="true">
                <ProjectMockup project={project} variant="rail" eager={index <= 1} />
              </div>

              <div class="card-copy">
                <h3>{project.data.title}</h3>
                <span>{project.data.metric ?? project.data.status}</span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .proof-rail {
    background:
      radial-gradient(circle at 0% 0%, rgba(125, 211, 252, 0.05), transparent 24rem),
      var(--surface-light);
    padding-block: clamp(2.6rem, 6vw, 4rem);
    overflow: hidden;
  }

  .rail-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: 1rem;
  }

  h2 {
    margin: 0.65rem 0 0;
    color: var(--text);
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.05;
  }

  .rail-head > a {
    flex: 0 0 auto;
    color: var(--accent);
    font-size: 13px;
    font-weight: 500;
  }

  .rail-head > a:hover {
    opacity: 0.72;
  }

  .rail-track {
    display: grid;
    grid-auto-columns: minmax(17.5rem, 22rem);
    grid-auto-flow: column;
    gap: 0.9rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding-bottom: 0.75rem;
    scroll-snap-type: inline mandatory;
    scrollbar-width: thin;
    cursor: grab;
  }

  .rail-card {
    min-height: 19rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.62);
    box-shadow: 0 12px 34px rgba(17, 24, 39, 0.04);
    overflow: hidden;
    scroll-snap-align: start;
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-out);
  }

  .rail-card:hover,
  .rail-card:focus-within {
    border-color: var(--line-strong);
    box-shadow: 0 16px 42px rgba(17, 24, 39, 0.07);
    transform: translateY(-2px);
  }

  .rail-card a {
    display: grid;
    min-height: 100%;
    grid-template-rows: 1fr auto;
    color: inherit;
  }

  .cover {
    align-self: center;
    aspect-ratio: 1.55;
    margin: 0.8rem 0.8rem 0;
    border: 1px solid rgba(17, 24, 39, 0.1);
    border-radius: 8px;
    background: var(--surface);
    overflow: hidden;
  }

  .card-copy {
    display: grid;
    gap: 0.65rem;
    align-content: start;
    padding: 0.9rem 0.9rem 1rem;
  }

  h3 {
    margin: 0;
    color: var(--text);
    font-size: 1.06rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.2;
  }

  .card-copy span {
    width: fit-content;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 12px;
    line-height: 1;
    padding: 0.42rem 0.64rem;
  }

  @media (max-width: 620px) {
    .rail-head {
      align-items: start;
      flex-direction: column;
    }

    .rail-track {
      grid-auto-columns: minmax(16rem, 82vw);
    }
  }
</style>
