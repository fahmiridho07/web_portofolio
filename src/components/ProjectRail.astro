---
import type { CollectionEntry } from "astro:content";
import { projectCategories } from "@data/profile";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
const accents = [
  "mint",
  "sky",
  "amber",
  "rose",
  "violet",
];

const categoryById = new Map(projectCategories.map((category) => [category.id, category]));
---

<section class="proof-rail divider" aria-labelledby="proof-rail-title">
  <div class="container">
    <div class="rail-head">
      <div>
        <p class="section-label">Supporting proof</p>
        <h2 id="proof-rail-title">More evidence, quick to scan.</h2>
      </div>
      <a href="/projects/">All projects</a>
    </div>

    <div class="rail-track" aria-label="Featured project carousel">
      {
        projects.map((project, index) => {
          const category = categoryById.get(project.data.category);
          const accent = accents[index % accents.length];

          return (
            <article class={`rail-card ${accent}`}>
              <a href={`/projects/${project.data.slug}/`}>
                <div class="card-top">
                  <span>{project.data.metric ?? project.data.status}</span>
                  <span>{project.data.year}</span>
                </div>

                <div class="cover" aria-hidden="true">
                  <img src={project.data.coverImage} alt="" loading={index > 1 ? "lazy" : "eager"} />
                </div>

                <div class="card-copy">
                  <p>{category?.title}</p>
                  <h3>{project.data.title}</h3>
                  <small>{project.data.stack.slice(0, 4).join(" / ")}</small>
                </div>
              </a>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .proof-rail {
    padding-block: clamp(2.6rem, 6vw, 4rem);
    overflow: hidden;
  }

  .rail-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: 1rem;
  }

  h2 {
    margin: 0.65rem 0 0;
    color: var(--text);
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .rail-head > a {
    flex: 0 0 auto;
    color: var(--accent);
    font-size: 13px;
    font-weight: 500;
    transition: opacity 150ms ease-out;
  }

  .rail-head > a:hover {
    opacity: 0.72;
  }

  .rail-track {
    display: grid;
    grid-auto-columns: minmax(17.5rem, 22rem);
    grid-auto-flow: column;
    gap: 0.9rem;
    margin-inline: -0.75rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding: 0.75rem;
    scroll-snap-type: inline mandatory;
    scrollbar-width: thin;
    cursor: grab;
    mask-image: linear-gradient(90deg, transparent, black 1.5rem, black calc(100% - 1.5rem), transparent);
  }

  .rail-card {
    min-height: 23rem;
    border: 1px solid rgba(212, 212, 216, 0.85);
    border-radius: 18px;
    background: #f6f6f4;
    box-shadow: 0 18px 44px rgba(24, 24, 27, 0.07);
    overflow: hidden;
    scroll-snap-align: start;
    translate: 0 0;
    transition:
      transform 150ms ease-out,
      border-color 150ms ease-out,
      box-shadow 150ms ease-out;
    animation: card-breathe 7s ease-in-out infinite;
  }

  .rail-card:nth-child(2n) {
    animation-delay: -1.8s;
  }

  .rail-card:nth-child(3n) {
    animation-delay: -3.2s;
  }

  .rail-card:hover {
    border-color: rgba(161, 161, 170, 0.7);
    box-shadow: 0 22px 52px rgba(24, 24, 27, 0.1);
    transform: translateY(-2px);
  }

  .rail-card a {
    display: grid;
    min-height: 100%;
    grid-template-rows: auto 1fr auto;
    color: inherit;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1rem 0;
    color: rgba(63, 63, 70, 0.66);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 11px;
    line-height: 1;
  }

  .cover {
    align-self: center;
    margin: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.42);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
    overflow: hidden;
  }

  .cover img {
    width: 100%;
    aspect-ratio: 1.55;
    object-fit: cover;
    transition: transform 220ms ease-out;
  }

  .rail-card:hover .cover img {
    transform: scale(1.035);
  }

  .card-copy {
    padding: 0 1rem 1rem;
  }

  .card-copy p {
    margin: 0 0 0.48rem;
    color: rgba(82, 82, 91, 0.82);
    font-size: 12px;
    line-height: 1.35;
  }

  h3 {
    margin: 0;
    color: var(--text);
    font-size: 1.06rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  small {
    display: block;
    margin-top: 0.72rem;
    color: rgba(82, 82, 91, 0.76);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 11px;
    line-height: 1.45;
  }

  .mint {
    background: linear-gradient(145deg, #ecfdf5, #f8faf7 70%);
  }

  .sky {
    background: linear-gradient(145deg, #eff6ff, #fbfbfa 72%);
  }

  .amber {
    background: linear-gradient(145deg, #fff7ed, #fbfbfa 72%);
  }

  .rose {
    background: linear-gradient(145deg, #fdf2f8, #fbfbfa 72%);
  }

  .violet {
    background: linear-gradient(145deg, #f5f3ff, #fbfbfa 72%);
  }

  @keyframes card-breathe {
    0%,
    100% {
      translate: 0 0;
    }

    50% {
      translate: 0 -3px;
    }
  }

  @media (max-width: 620px) {
    .rail-head {
      align-items: start;
      flex-direction: column;
    }

    .rail-track {
      grid-auto-columns: minmax(16rem, 82vw);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-card {
      animation: none;
    }

    .cover img {
      transition: none;
    }
  }
</style>
