---
import type { CollectionEntry } from "astro:content";
import { getImageMeta } from "@lib/images";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<section class="proof-rail divider" aria-labelledby="proof-rail-title">
  <div class="container">
    <div class="rail-head">
      <div>
        <p class="section-label">Supporting proof</p>
        <h2 id="proof-rail-title">More evidence, quick to scan.</h2>
      </div>
      <a href="/projects/">All projects</a>
    </div>

    <div class="rail-track" aria-label="Featured project carousel">
      {
        projects.map((project, index) => (
          <article class="rail-card">
            <a href={`/projects/${project.data.slug}/`}>
              <div class="cover" aria-hidden="true">
                <img
                  src={project.data.coverImage}
                  alt=""
                  width={getImageMeta(project.data.coverImage)?.width}
                  height={getImageMeta(project.data.coverImage)?.height}
                  loading={index > 1 ? "lazy" : "eager"}
                  decoding="async"
                />
              </div>

              <div class="card-copy">
                <h3>{project.data.title}</h3>
                <span>{project.data.metric ?? project.data.status}</span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .proof-rail {
    padding-block: clamp(2.6rem, 6vw, 4rem);
    overflow: hidden;
  }

  .rail-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: 1rem;
  }

  h2 {
    margin: 0.65rem 0 0;
    color: var(--text);
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.05;
  }

  .rail-head > a {
    flex: 0 0 auto;
    color: var(--accent);
    font-size: 13px;
    font-weight: 500;
  }

  .rail-head > a:hover {
    opacity: 0.72;
  }

  .rail-track {
    display: grid;
    grid-auto-columns: minmax(17.5rem, 22rem);
    grid-auto-flow: column;
    gap: 0.9rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding-bottom: 0.75rem;
    scroll-snap-type: inline mandatory;
    scrollbar-width: thin;
    cursor: grab;
  }

  .rail-card {
    min-height: 19rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: transparent;
    overflow: hidden;
    scroll-snap-align: start;
  }

  .rail-card:hover {
    border-color: var(--line-strong);
  }

  .rail-card a {
    display: grid;
    min-height: 100%;
    grid-template-rows: 1fr auto;
    color: inherit;
  }

  .cover {
    align-self: center;
    margin-block: 0.85rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    overflow: hidden;
  }

  .cover img {
    width: 100%;
    aspect-ratio: 1.55;
    object-fit: cover;
  }

  .card-copy {
    display: grid;
    gap: 0.65rem;
    align-content: start;
    padding-bottom: 1rem;
  }

  h3 {
    margin: 0;
    color: var(--text);
    font-size: 1.06rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.2;
  }

  .card-copy span {
    width: fit-content;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 12px;
    line-height: 1;
    padding: 0.42rem 0.64rem;
  }

  @media (max-width: 620px) {
    .rail-head {
      align-items: start;
      flex-direction: column;
    }

    .rail-track {
      grid-auto-columns: minmax(16rem, 82vw);
    }
  }
</style>
