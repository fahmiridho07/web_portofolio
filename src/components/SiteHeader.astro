---
import { profile } from "@data/profile";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/projects/", label: "Projects" },
  { href: "/about/", label: "About" },
  { href: profile.contactHref, label: "Contact" },
];

const normalizePath = (path: string) => {
  if (path === "/index.html") return "/";
  return path.endsWith("/") && path.length > 1 ? path.slice(0, -1) : path;
};

const pathname = normalizePath(Astro.url.pathname);

const isActive = (href: string) => {
  if (href.startsWith("/#")) {
    return false;
  }

  if (href === "/") {
    return pathname === "/";
  }

  const target = normalizePath(href.split("#")[0] ?? href);
  return pathname === target || pathname.startsWith(`${target}/`);
};
---

<header
  class="site-header"
  transition:persist="site-header"
  transition:name="site-header"
  transition:animate="none"
>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${profile.name} home`} data-astro-prefetch="hover">
      Fahmi Ridho
      <svg class="brand-mark" viewBox="0 0 16 16" aria-hidden="true">
        <circle class="mark-dot" cx="3.2" cy="11.4" r="1.1"></circle>
        <circle class="mark-dot" cx="7.2" cy="6" r="1.1"></circle>
        <circle class="mark-dot" cx="12.4" cy="12" r="1.1"></circle>
        <circle class="mark-outlier" cx="11.6" cy="4" r="1.5"></circle>
        <circle class="mark-ring" cx="11.6" cy="4" r="3.4"></circle>
      </svg>
    </a>

    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a
                class="nav-link"
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                data-astro-prefetch={
                  item.href.startsWith("/") && !item.href.includes("#") ? "hover" : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // The header persists across view transitions; keep aria-current in sync.
  import { initOnPageLoad } from "@lib/page-script";

  initOnPageLoad(() => {
    const normalizePath = (path: string) => {
      if (path === "/index.html") return "/";
      return path.endsWith("/") && path.length > 1 ? path.slice(0, -1) : path;
    };

    const pathname = normalizePath(window.location.pathname);

    document.querySelectorAll<HTMLAnchorElement>(".site-header .nav-link").forEach((link) => {
      const href = link.getAttribute("href") ?? "";

      if (href.startsWith("/#")) {
        link.removeAttribute("aria-current");
        return;
      }

      const target = normalizePath(href.split("#")[0] ?? href);
      const active =
        href === "/" ? pathname === "/" : pathname === target || pathname.startsWith(`${target}/`);

      if (active) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: var(--header-bg);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.05rem;
  }

  .brand {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 520;
    letter-spacing: -0.005em;
    line-height: 1;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .brand-mark {
    width: 1em;
    height: 1em;
    overflow: visible;
  }

  .mark-dot {
    fill: var(--ink-soft);
    opacity: 0.55;
  }

  .mark-outlier {
    fill: var(--signal);
  }

  .mark-ring {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1;
    transform-origin: 11.6px 4px;
    transition: transform 420ms var(--ease-out);
  }

  .brand:hover .mark-ring {
    transform: scale(1.45);
  }

  @media (prefers-reduced-motion: reduce) {
    .mark-ring {
      transition: none;
    }
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 3vw, 1.9rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    position: relative;
    color: var(--ink-muted);
    font-size: 0.84rem;
    font-weight: 500;
    line-height: 1;
    padding-block: 0.25rem;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: -0.15rem;
    left: 0;
    height: 1px;
    background: var(--ink);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-medium) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .nav-link[aria-current="page"] {
    color: var(--ink);
  }

  .nav-link[aria-current="page"]::after {
    background: var(--rust);
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      padding-block: 0.85rem;
    }

    .nav-list {
      gap: 0.9rem;
    }

    .nav-link {
      font-size: 0.8rem;
    }
  }
</style>
