---
import { profile } from "@data/profile";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/projects/", label: "Projects" },
  { href: "/about/", label: "About" },
  { href: profile.contactHref, label: "Contact" },
];

const normalizePath = (path: string) => {
  if (path === "/index.html") return "/";
  return path.endsWith("/") && path.length > 1 ? path.slice(0, -1) : path;
};

const pathname = normalizePath(Astro.url.pathname);

const isActive = (href: string) => {
  if (href.startsWith("/#")) {
    return false;
  }

  if (href === "/") {
    return pathname === "/";
  }

  const target = normalizePath(href.split("#")[0] ?? href);
  return pathname === target || pathname.startsWith(`${target}/`);
};
---

<header
  class="site-header"
  transition:persist="site-header"
  transition:name="site-header"
  transition:animate="none"
>
  <div class="container header-inner">
    <a
      class="brand"
      href="/"
      aria-label={`${profile.name} home`}
      data-astro-prefetch="hover"
    >
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 64 64" width="18" height="18">
          <rect width="64" height="64" rx="16" fill="#121316"></rect>
          <polygon points="32,13 50,23.5 32,34 14,23.5" fill="#ffffff"
          ></polygon>
          <polygon points="14,23.5 32,34 32,53 14,42.5" fill="#a4a7b0"
          ></polygon>
          <polygon points="32,34 50,23.5 50,42.5 32,53" fill="#4d515a"
          ></polygon>
          <line
            x1="32"
            y1="34"
            x2="32"
            y2="53"
            stroke="#121316"
            stroke-width="1.5"
            stroke-linecap="round"></line>
          <line
            x1="14"
            y1="23.5"
            x2="32"
            y2="34"
            stroke="#121316"
            stroke-width="1.5"
            stroke-linecap="round"></line>
          <line
            x1="50"
            y1="23.5"
            x2="32"
            y2="34"
            stroke="#121316"
            stroke-width="1.5"
            stroke-linecap="round"></line>
          <circle cx="32" cy="23.5" r="4.5" fill="#c92e3e"></circle>
        </svg>
      </span>
      Fahmi Ridho<span class="brand-dot" aria-hidden="true">.</span>
    </a>

    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a
                class="nav-link"
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                data-astro-prefetch={
                  item.href.startsWith("/") && !item.href.includes("#")
                    ? "hover"
                    : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // The header persists across view transitions; keep aria-current in sync.
  import { initOnPageLoad } from "@lib/page-script";

  initOnPageLoad(() => {
    const normalizePath = (path: string) => {
      if (path === "/index.html") return "/";
      return path.endsWith("/") && path.length > 1 ? path.slice(0, -1) : path;
    };

    const pathname = normalizePath(window.location.pathname);

    document
      .querySelectorAll<HTMLAnchorElement>(".site-header .nav-link")
      .forEach((link) => {
        const href = link.getAttribute("href") ?? "";

        if (href.startsWith("/#")) {
          link.removeAttribute("aria-current");
          return;
        }

        const target = normalizePath(href.split("#")[0] ?? href);
        const active =
          href === "/"
            ? pathname === "/"
            : pathname === target || pathname.startsWith(`${target}/`);

        if (active) {
          link.setAttribute("aria-current", "page");
        } else {
          link.removeAttribute("aria-current");
        }
      });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: var(--header-bg);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.05rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 520;
    letter-spacing: -0.005em;
    line-height: 1;
    text-decoration: none;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
    border-radius: 5px;
    overflow: hidden;
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .brand:hover .brand-mark {
    transform: rotate(12deg) scale(1.08);
  }

  .brand-dot {
    color: var(--signal);
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 3vw, 1.9rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    /* Pad the hit area without changing the header's visual height */
    margin-block: -0.35rem;
    color: var(--ink-muted);
    font-size: 0.84rem;
    font-weight: 500;
    line-height: 1;
    padding-block: 0.6rem;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: 0.25rem;
    left: 0;
    height: 1px;
    background: var(--ink);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-medium) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .nav-link[aria-current="page"] {
    color: var(--ink);
  }

  .nav-link[aria-current="page"]::after {
    background: var(--rust);
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link::after {
      transition: none;
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      padding-block: 0.85rem;
    }

    .nav-list {
      gap: 0.9rem;
    }

    .nav-link {
      font-size: 0.8rem;
    }
  }
</style>
