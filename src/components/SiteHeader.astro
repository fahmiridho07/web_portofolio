---
import { profile } from "@data/profile";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/projects/", label: "Projects" },
  { href: profile.contactHref, label: "Contact" },
];

const normalizePath = (path: string) => {
  if (path === "/index.html") return "/";
  return path.endsWith("/") && path.length > 1 ? path.slice(0, -1) : path;
};

const pathname = normalizePath(Astro.url.pathname);

const isActive = (href: string) => {
  if (href.startsWith("/#")) {
    return false;
  }

  if (href === "/") {
    return pathname === "/";
  }

  const target = normalizePath(href.split("#")[0] ?? href);
  return pathname === target || pathname.startsWith(`${target}/`);
};
---

<header
  class="site-header"
  transition:persist="site-header"
  transition:name="site-header"
  transition:animate="none"
>
  <div class="container header-inner">
    {/* Left: Brand Identity */}
    <a
      class="brand"
      href="/"
      aria-label={`${profile.name} home`}
      data-astro-prefetch="hover"
    >
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 64 64" width="18" height="18">
          <rect width="64" height="64" rx="16" fill="#121316"></rect>
          <polygon points="32,13 50,23.5 32,34 14,23.5" fill="#ffffff"
          ></polygon>
          <polygon points="14,23.5 32,34 32,53 14,42.5" fill="#a4a7b0"
          ></polygon>
          <polygon points="32,34 50,23.5 50,42.5 32,53" fill="#4d515a"
          ></polygon>
          <line
            x1="32"
            y1="34"
            x2="32"
            y2="53"
            stroke="#121316"
            stroke-width="1.5"
            stroke-linecap="round"></line>
          <line
            x1="14"
            y1="23.5"
            x2="32"
            y2="34"
            stroke="#121316"
            stroke-width="1.5"
            stroke-linecap="round"></line>
          <line
            x1="50"
            y1="23.5"
            x2="32"
            y2="34"
            stroke="#121316"
            stroke-width="1.5"
            stroke-linecap="round"></line>
          <circle cx="32" cy="23.5" r="4.5" fill="#c92e3e"></circle>
        </svg>
      </span>
      <span class="brand-text">
        Fahmi Ridho<span class="brand-dot" aria-hidden="true">.</span>
      </span>
    </a>

    {/* Right: Tactile Segmented Pill Navigation Dock */}
    <nav class="header-nav" aria-label="Primary navigation">
      <ul class="nav-dock">
        {
          navItems.map((item) => (
            <li class="dock-item">
              <a
                class="nav-link"
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                data-astro-prefetch={
                  item.href.startsWith("/") && !item.href.includes("#")
                    ? "hover"
                    : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  {/* Sleek Global Scroll Progress Indicator Hairline */}
  <div class="header-progress-track" aria-hidden="true">
    <div class="header-progress-fill" data-header-progress></div>
  </div>
</header>

<script>
  // The header persists across view transitions; keep aria-current in sync.
  import { initOnPageLoad } from "@lib/page-script";

  initOnPageLoad(() => {
    const normalizePath = (path: string) => {
      if (path === "/index.html") return "/";
      return path.endsWith("/") && path.length > 1 ? path.slice(0, -1) : path;
    };

    const pathname = normalizePath(window.location.pathname);

    document
      .querySelectorAll<HTMLAnchorElement>(".site-header .nav-link")
      .forEach((link) => {
        const href = link.getAttribute("href") ?? "";

        if (href.startsWith("/#")) {
          link.removeAttribute("aria-current");
          return;
        }

        const target = normalizePath(href.split("#")[0] ?? href);
        const active =
          href === "/"
            ? pathname === "/"
            : pathname === target || pathname.startsWith(`${target}/`);

        if (active) {
          link.setAttribute("aria-current", "page");
        } else {
          link.removeAttribute("aria-current");
        }
      });

    // Update global scroll progress hairline
    const progressFill = document.querySelector<HTMLElement>(
      "[data-header-progress]",
    );
    const updateScrollProgress = () => {
      const scrollY = window.scrollY;
      const maxScroll =
        document.documentElement.scrollHeight - window.innerHeight;
      if (maxScroll > 0 && progressFill) {
        const p = Math.min(1, Math.max(0, scrollY / maxScroll));
        progressFill.style.transform = `scaleX(${p})`;
      } else if (progressFill) {
        progressFill.style.transform = "scaleX(0)";
      }
    };

    window.addEventListener("scroll", updateScrollProgress, { passive: true });
    updateScrollProgress();

    return () => {
      window.removeEventListener("scroll", updateScrollProgress);
    };
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height, 56px);
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--line);
    background: var(--header-bg);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  /* ------------------- Scroll Progress Hairline ------------------- */
  .header-progress-track {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: transparent;
    pointer-events: none;
    overflow: hidden;
  }

  .header-progress-fill {
    width: 100%;
    height: 100%;
    background: var(--signal);
    transform-origin: left center;
    transform: scaleX(0);
    will-change: transform;
    transition: transform 60ms linear;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 100%;
  }

  /* ------------------- Left: Brand ------------------- */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 520;
    letter-spacing: -0.005em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
    border-radius: 5px;
    overflow: hidden;
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .brand:hover .brand-mark {
    transform: rotate(12deg) scale(1.08);
  }

  .brand-dot {
    color: var(--signal);
  }

  /* ------------------- Right: Segmented Pill Dock ------------------- */
  .header-nav {
    display: flex;
    align-items: center;
  }

  .nav-dock {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    margin: 0;
    padding: 0.22rem 0.28rem;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--paper-soft);
  }

  .dock-item {
    display: flex;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    color: var(--ink-muted);
    font-size: 0.83rem;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      color var(--motion-fast) var(--ease-standard),
      background var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard);
  }

  .nav-link:hover {
    color: var(--ink);
    background: rgba(22, 24, 29, 0.04);
  }

  .nav-link[aria-current="page"] {
    color: var(--ink);
    font-weight: 600;
    background: #ffffff;
    border-color: var(--line-strong);
    box-shadow: 0 1px 2px rgba(22, 24, 29, 0.04);
  }

  /* ------------------- Responsive ------------------- */
  @media (max-width: 480px) {
    .header-inner {
      gap: 0.75rem;
    }

    .brand-text {
      font-size: 0.98rem;
    }

    .nav-dock {
      padding: 0.18rem 0.22rem;
      gap: 0.15rem;
    }

    .nav-link {
      padding: 0.3rem 0.65rem;
      font-size: 0.78rem;
    }
  }

  @media (max-width: 360px) {
    .nav-link {
      padding: 0.28rem 0.5rem;
      font-size: 0.74rem;
    }
  }
</style>
