---
// ProjectHeroStage3D.astro: Interactive 3D Kinetic Metaphor Stage for Project Detail Pages
// Modeled directly on the visual craft and interaction model of Scene 1 in ScrollStoryStage.astro.
// Adheres strictly to "The Anomaly" design system (Paper #f7f7f6, Ink #16181d, Carmine #c92e3e).
// Pure CSS 3D transforms, mouse pointer parallax, tactile squish on click, zero heavy runtime.

interface Props {
  slug: string;
  title: string;
  metric?: string;
  category?: string;
}

const { slug } = Astro.props;

// Determine archetype to select 3D kinetic metaphor
const isML =
  slug === "fraud-detection-ml-pipeline" || slug === "la-crime-type-prediction";
const isRoute = slug === "orphanage-inspection-route-optimization";
const isForecast = slug === "juanda-airport-visitor-forecasting";
const isSoftware =
  slug === "kpc-ideku-v3-dotnet-stabilization" ||
  slug === "kpc-power-automate-po-automation" ||
  slug === "bank-jatim-performance-dashboard";
const isNLP =
  slug === "indo-transaction-nlp" || slug === "sriwijayaair-review-sentiment";
const isTactile = !isML && !isRoute && !isForecast && !isSoftware && !isNLP;
---

<div class="project-3d-stage-wrapper" data-project-3d-stage>
  {/* Atmospheric Halo Backdrop */}
  <div class="stage-ambient-halo" aria-hidden="true"></div>
  <div class="stage-grid-pattern" aria-hidden="true"></div>

  {/* Main 3D Kinetic Viewport */}
  <div class="kinetic-viewport" data-kinetic-viewport>
    {/* ARCHETYPE 1: MACHINE LEARNING & ANOMALY DETECTION */}
    {
      isML && (
        <div
          class="kinetic-object latent-cube-wrapper"
          data-interactive-object
          title="Click to interact"
        >
          <div class="cube-facet f-front">
            <span class="facet-tag">Z_SPACE</span>
            <div class="wire-cross" />
          </div>
          <div class="cube-facet f-back" />
          <div class="cube-facet f-right">
            <span class="facet-tag">DIM:64</span>
          </div>
          <div class="cube-facet f-left" />
          <div class="cube-facet f-top">
            <span class="facet-code">&mu; &plusmn; &sigma;</span>
          </div>
          <div class="cube-facet f-bottom" />

          {/* Central Carmine Outlier Core with Pulsing Sonar Ring */}
          <div class="anomaly-core">
            <span class="core-dot" />
            <span class="core-sonar-ring" />
            <span class="core-sonar-ring-outer" />
            <div class="core-tag">ANOMALY</div>
          </div>

          <div class="cube-shadow-base" />
        </div>
      )
    }

    {/* ARCHETYPE 2: ROUTE OPTIMIZATION & CONVERGENCE (ACO) */}
    {
      isRoute && (
        <div
          class="kinetic-object route-lattice-wrapper"
          data-interactive-object
          title="Click to interact"
        >
          {/* Isometric Ground Mesh */}
          <div class="lattice-plane">
            <div class="lattice-grid" />
            {/* Elevated Central Depot Pillar */}
            <div class="depot-pillar">
              <span class="pillar-cap">DEPOT</span>
            </div>
            {/* Clustered Route Nodes */}
            <div class="cluster-node n-1">
              <span class="c-dot" />
            </div>
            <div class="cluster-node n-2">
              <span class="c-dot" />
            </div>
            <div class="cluster-node n-3">
              <span class="c-dot" />
            </div>
            <div class="cluster-node n-4">
              <span class="c-dot" />
            </div>
            {/* Converged Loop Path Ring */}
            <div class="converged-loop-ring" />
          </div>
          <div class="cube-shadow-base" />
        </div>
      )
    }

    {/* ARCHETYPE 3: TIME-SERIES & DEMAND FORECASTING */}
    {
      isForecast && (
        <div
          class="kinetic-object forecast-prism-wrapper"
          data-interactive-object
          title="Click to interact"
        >
          {/* Tiered Time Planes */}
          <div class="prism-plane plane-history">
            <span class="plane-label">HISTORICAL 120mo</span>
            <div class="wave-line-3d" />
          </div>
          <div class="prism-pivot">
            <span class="pivot-beacon" />
            <span class="pivot-line" />
            <span class="pivot-tag">NOW</span>
          </div>
          <div class="prism-plane plane-future">
            <span class="plane-label future">CONFIDENCE ENVELOPE</span>
            <div class="future-envelope-3d" />
          </div>
          <div class="cube-shadow-base" />
        </div>
      )
    }

    {/* ARCHETYPE 4: SOFTWARE ENGINEERING & SYSTEMS MONOLITH */}
    {
      isSoftware && (
        <div
          class="kinetic-object monolith-wrapper"
          data-interactive-object
          title="Click to interact"
        >
          {/* Layer 1: Security Chassis */}
          <div class="monolith-blade blade-security">
            <span class="blade-badge">RBAC / AUTH</span>
            <span class="blade-indicator on" />
          </div>
          {/* Layer 2: Async Engine Core */}
          <div class="monolith-blade blade-core">
            <span class="blade-badge">Task.WhenAll</span>
            <div class="blade-telemetry-lines">
              <span class="b-line" />
              <span class="b-line" />
            </div>
          </div>
          {/* Layer 3: Executive Analytics Surface */}
          <div class="monolith-blade blade-analytics">
            <span class="blade-badge">EXECUTIVE BI</span>
            <span class="blade-indicator pulse" />
          </div>
          <div class="cube-shadow-base" />
        </div>
      )
    }

    {/* ARCHETYPE 5: NATURAL LANGUAGE PROCESSING & TRANSFORMER */}
    {
      isNLP && (
        <div
          class="kinetic-object nlp-prism-wrapper"
          data-interactive-object
          title="Click to interact"
        >
          {/* Input Utterance Depth Plane */}
          <div class="nlp-floating-plane plane-input">
            <span class="plane-kicker">INPUT</span>
            <code class="plane-code">&ldquo;beli kopi 25rb&rdquo;</code>
          </div>
          {/* Central Transformer Attention Matrix */}
          <div class="nlp-transformer-cube">
            <div class="tf-face f-front">IndoBERT</div>
            <div class="tf-face f-top" />
            <div class="tf-face f-right">768-D</div>
          </div>
          {/* Structured Output Entity Plane */}
          <div class="nlp-floating-plane plane-output">
            <span class="plane-kicker">EXTRACTED ENTITY</span>
            <code class="plane-code-accent">{`{ Food: 25000 }`}</code>
          </div>
          <div class="cube-shadow-base" />
        </div>
      )
    }

    {/* ARCHETYPE 6: TACTILE MOBILE & FRAGRANCE / OTHER */}
    {
      isTactile && (
        <div
          class="kinetic-object tactile-stage-wrapper"
          data-interactive-object
          title="Click to interact"
        >
          <div class="tactile-tier tier-base">
            <span class="tier-code">&bull; BASE NOTE &bull;</span>
          </div>
          <div class="tactile-tier tier-mid">
            <span class="tier-code">&bull; HEART NOTE &bull;</span>
          </div>
          <div class="tactile-tier tier-apex">
            <span class="tier-code apex">&bull; ACTIVE REGIMEN &bull;</span>
          </div>
          <div class="tactile-orb">
            <span class="orb-core" />
          </div>
          <div class="cube-shadow-base" />
        </div>
      )
    }
  </div>

  {/* Architectural Datum Line (Inspired by Scene 1) */}
  <div class="stage-datum-line" aria-hidden="true">
    <span class="datum-dot left"></span>
    <span class="datum-coords">
      07&deg;15&prime;S 112&deg;45&prime;E &middot; 3D SYSTEM EXHIBIT
    </span>
    <span class="datum-dot right"></span>
  </div>

  {/* Interactive Control Pill */}
  <div class="stage-interactive-hint">
    <span class="hint-dot"></span>
    <span class="hint-text">Interactive 3D &middot; Tilt &amp; Click</span>
  </div>
</div>

<script>
  import { initOnPageLoad } from "@lib/page-script";

  initOnPageLoad(() => {
    const stageRoot = document.querySelector<HTMLElement>(
      "[data-project-3d-stage]",
    );
    if (!stageRoot) return;

    const viewport = stageRoot.querySelector<HTMLElement>(
      "[data-kinetic-viewport]",
    );
    const object = stageRoot.querySelector<HTMLElement>(
      "[data-interactive-object]",
    );
    if (!viewport || !object) return;

    const controller = new AbortController();
    const { signal } = controller;
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // Desktop Pointer Parallax
    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;
    let raf = 0;

    const onPointerMove = (e: PointerEvent) => {
      if (reduceMotion) return;
      const rect = stageRoot.getBoundingClientRect();
      const x = (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2);
      const y = (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2);
      targetX = Math.max(-1, Math.min(1, x));
      targetY = Math.max(-1, Math.min(1, y));

      if (!raf) raf = requestAnimationFrame(updateParallax);
    };

    const onPointerLeave = () => {
      targetX = 0;
      targetY = 0;
      if (!raf) raf = requestAnimationFrame(updateParallax);
    };

    const updateParallax = () => {
      mouseX += (targetX - mouseX) * 0.08;
      mouseY += (targetY - mouseY) * 0.08;

      const rotY = -22 + mouseX * 24;
      const rotX = 18 - mouseY * 18;
      object.style.transform = `rotateX(${rotX}deg) rotateY(${rotY}deg)`;

      if (
        Math.abs(targetX - mouseX) > 0.001 ||
        Math.abs(targetY - mouseY) > 0.001
      ) {
        raf = requestAnimationFrame(updateParallax);
      } else {
        raf = 0;
      }
    };

    stageRoot.addEventListener("pointermove", onPointerMove, {
      passive: true,
      signal,
    });
    stageRoot.addEventListener("pointerleave", onPointerLeave, {
      passive: true,
      signal,
    });

    // Tactile Click Squish Animation
    object.addEventListener(
      "click",
      () => {
        object.classList.add("is-squished");
        window.setTimeout(() => object.classList.remove("is-squished"), 420);
      },
      { signal },
    );

    return () => {
      controller.abort();
      if (raf) cancelAnimationFrame(raf);
    };
  });
</script>

<style>
  /* ------------------------------- Container & Backdrop ------------------------------- */
  .project-3d-stage-wrapper {
    position: relative;
    width: 100%;
    min-height: clamp(320px, 38vw, 420px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: visible;
    padding-bottom: 2rem;
  }

  .stage-ambient-halo {
    position: absolute;
    top: 48%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(260px, 36vw, 400px);
    height: clamp(260px, 36vw, 400px);
    border-radius: 999px;
    background: radial-gradient(
      circle,
      rgba(201, 46, 62, 0.09) 0%,
      rgba(22, 24, 29, 0.025) 50%,
      transparent 72%
    );
    pointer-events: none;
    z-index: 0;
  }

  .stage-grid-pattern {
    position: absolute;
    inset: 10px;
    background-image:
      linear-gradient(to right, rgba(22, 24, 29, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(22, 24, 29, 0.035) 1px, transparent 1px);
    background-size: 32px 32px;
    pointer-events: none;
    mask-image: radial-gradient(circle at center, black 40%, transparent 75%);
    -webkit-mask-image: radial-gradient(
      circle at center,
      black 40%,
      transparent 75%
    );
  }

  /* ------------------------------- 3D Viewport ------------------------------- */
  .kinetic-viewport {
    position: relative;
    width: clamp(260px, 32vw, 360px);
    height: clamp(240px, 28vw, 320px);
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1200px;
    z-index: 1;
  }

  .kinetic-object {
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(18deg) rotateY(-22deg);
    cursor: grab;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
  }

  .kinetic-object:active {
    cursor: grabbing;
  }

  .kinetic-object.is-squished {
    transform: scale3d(1.18, 0.82, 1.18) rotateX(18deg) rotateY(-22deg) !important;
  }

  /* Ground Shadow */
  .cube-shadow-base {
    position: absolute;
    bottom: -45px;
    left: 50%;
    transform: translateX(-50%) rotateX(90deg);
    width: 140px;
    height: 34px;
    border-radius: 999px;
    background: rgba(22, 24, 29, 0.12);
    filter: blur(14px);
    pointer-events: none;
  }

  /* ------------------ ARCHETYPE 1: LATENT SPACE HYPERCUBE ------------------ */
  .latent-cube-wrapper {
    width: 115px;
    height: 115px;
  }

  .cube-facet {
    position: absolute;
    width: 115px;
    height: 115px;
    background: rgba(255, 255, 255, 0.95);
    border: 1.5px solid var(--line-strong);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 20px rgba(22, 24, 29, 0.03);
  }

  .cube-facet.f-front {
    transform: translateZ(57.5px);
  }
  .cube-facet.f-back {
    transform: rotateY(180deg) translateZ(57.5px);
    background: #f0f0ee;
  }
  .cube-facet.f-right {
    transform: rotateY(90deg) translateZ(57.5px);
    background: #eaeaea;
  }
  .cube-facet.f-left {
    transform: rotateY(-90deg) translateZ(57.5px);
  }
  .cube-facet.f-top {
    transform: rotateX(90deg) translateZ(57.5px);
    background: #ffffff;
  }
  .cube-facet.f-bottom {
    transform: rotateX(-90deg) translateZ(57.5px);
    background: #e0e0de;
  }

  .facet-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }

  .facet-code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink);
  }

  .wire-cross {
    width: 24px;
    height: 24px;
    border: 1px dashed var(--line-strong);
    margin-top: 6px;
    opacity: 0.6;
  }

  /* Central Carmine Anomaly Core */
  .anomaly-core {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) translateZ(75px);
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }

  .core-dot {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: var(--signal);
    box-shadow: 0 0 14px rgba(201, 46, 62, 0.6);
  }

  .core-sonar-ring {
    position: absolute;
    top: -6px;
    left: -6px;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    border: 1.5px solid var(--signal);
    opacity: 0.8;
    animation: core-pulse 2s infinite ease-out;
  }

  .core-sonar-ring-outer {
    position: absolute;
    top: -14px;
    left: -14px;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 1px dashed var(--signal);
    opacity: 0.4;
    animation: core-pulse 2s infinite 0.4s ease-out;
  }

  .core-tag {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 0.52rem;
    font-weight: 700;
    color: var(--signal-deep);
    background: var(--accent-dim);
    border: 1px solid rgba(201, 46, 62, 0.3);
    padding: 2px 6px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  @keyframes core-pulse {
    0% {
      transform: scale(0.6);
      opacity: 0.9;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  /* ------------------ ARCHETYPE 2: ROUTE LATTICE (ACO) ------------------ */
  .route-lattice-wrapper {
    width: 160px;
    height: 160px;
  }

  .lattice-plane {
    position: relative;
    width: 160px;
    height: 160px;
    border: 1.5px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 16px 32px rgba(22, 24, 29, 0.05);
    transform-style: preserve-3d;
  }

  .lattice-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(22, 24, 29, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(22, 24, 29, 0.06) 1px, transparent 1px);
    background-size: 20px 20px;
  }

  .depot-pillar {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) translateZ(45px);
    width: 32px;
    height: 32px;
    background: var(--paper);
    border: 1.5px solid var(--signal);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 18px rgba(201, 46, 62, 0.2);
  }

  .pillar-cap {
    font-family: var(--font-mono);
    font-size: 0.48rem;
    font-weight: 700;
    color: var(--signal-deep);
  }

  .cluster-node {
    position: absolute;
    width: 8px;
    height: 8px;
    transform: translateZ(25px);
  }
  .cluster-node.n-1 {
    top: 20%;
    left: 25%;
  }
  .cluster-node.n-2 {
    top: 25%;
    right: 20%;
  }
  .cluster-node.n-3 {
    bottom: 25%;
    right: 25%;
  }
  .cluster-node.n-4 {
    bottom: 20%;
    left: 25%;
  }

  .c-dot {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 999px;
    background: var(--ink);
  }

  .converged-loop-ring {
    position: absolute;
    inset: 22px;
    border: 1.5px dashed var(--signal);
    border-radius: 35%;
    transform: translateZ(30px);
    opacity: 0.85;
    animation: ring-pulse 3s infinite ease-in-out alternate;
  }

  @keyframes ring-pulse {
    from {
      transform: translateZ(25px) scale(0.96);
    }
    to {
      transform: translateZ(35px) scale(1.04);
    }
  }

  /* ------------------ ARCHETYPE 3: FORECAST PRISM ------------------ */
  .forecast-prism-wrapper {
    width: 170px;
    height: 110px;
  }

  .prism-plane {
    position: absolute;
    width: 100px;
    height: 80px;
    background: rgba(255, 255, 255, 0.94);
    border: 1.5px solid var(--line-strong);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 6px;
  }

  .plane-history {
    left: 0;
    top: 15px;
    transform: translateZ(10px);
  }

  .wave-line-3d {
    width: 100%;
    height: 2px;
    background: var(--ink-soft);
    margin-top: 18px;
  }

  .prism-pivot {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) translateZ(48px);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pivot-beacon {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--signal);
    box-shadow: 0 0 12px rgba(201, 46, 62, 0.5);
  }

  .pivot-line {
    width: 1.5px;
    height: 45px;
    background: var(--signal);
  }

  .pivot-tag {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    color: var(--signal);
  }

  .plane-future {
    right: 0;
    top: 5px;
    transform: translateZ(25px);
    border-color: var(--signal);
    background: rgba(201, 46, 62, 0.04);
  }

  .plane-label {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 700;
    color: var(--ink-muted);
  }
  .plane-label.future {
    color: var(--signal-deep);
  }

  .future-envelope-3d {
    width: 100%;
    height: 24px;
    border: 1px dashed var(--signal);
    background: rgba(201, 46, 62, 0.08);
  }

  /* ------------------ ARCHETYPE 4: SOFTWARE MONOLITH ------------------ */
  .monolith-wrapper {
    width: 150px;
    height: 150px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .monolith-blade {
    width: 140px;
    height: 38px;
    background: rgba(255, 255, 255, 0.96);
    border: 1.5px solid var(--line-strong);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 10px;
    box-shadow: 0 8px 18px rgba(22, 24, 29, 0.04);
  }

  .blade-security {
    transform: translateZ(0px);
  }
  .blade-core {
    transform: translateZ(30px);
    border-color: var(--ink);
  }
  .blade-analytics {
    transform: translateZ(60px);
    border-color: var(--signal);
  }

  .blade-badge {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink);
  }

  .blade-indicator {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--line-strong);
  }
  .blade-indicator.on {
    background: var(--ink);
  }
  .blade-indicator.pulse {
    background: var(--signal);
    box-shadow: 0 0 8px rgba(201, 46, 62, 0.6);
  }

  .blade-telemetry-lines {
    display: flex;
    gap: 3px;
  }
  .b-line {
    width: 14px;
    height: 2px;
    background: var(--line-strong);
  }

  /* ------------------ ARCHETYPE 5: NLP TRANSFORMER PRISM ------------------ */
  .nlp-prism-wrapper {
    width: 160px;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nlp-floating-plane {
    position: absolute;
    background: #ffffff;
    border: 1px solid var(--line-strong);
    padding: 4px 8px;
    display: flex;
    flex-direction: column;
  }

  .plane-input {
    left: -15px;
    top: 15px;
    transform: translateZ(10px);
  }

  .plane-output {
    right: -15px;
    bottom: 15px;
    transform: translateZ(55px);
    border-color: var(--signal);
  }

  .plane-kicker {
    font-family: var(--font-mono);
    font-size: 0.45rem;
    font-weight: 700;
    color: var(--ink-soft);
