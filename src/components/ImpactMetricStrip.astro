---
interface MetricItem {
  value: string;
  label: string;
  detail: string;
}

interface Props {
  items: MetricItem[];
}

const { items } = Astro.props;
---

<div class="impact-strip" aria-label="Portfolio proof metrics">
  {
    items.map((item) => (
      <article>
        <strong>{item.value}</strong>
        <span>{item.label}</span>
        <p>{item.detail}</p>
      </article>
    ))
  }
</div>

<style>
  .impact-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    background:
      linear-gradient(90deg, rgba(155, 231, 212, 0.42), rgba(125, 211, 252, 0.34), rgba(216, 162, 56, 0.26)),
      rgba(255, 255, 255, 0.12);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(18px);
  }

  article {
    position: relative;
    display: grid;
    min-height: 6.6rem;
    align-content: start;
    gap: 0.35rem;
    background:
      radial-gradient(circle at 88% 0%, color-mix(in srgb, var(--metric-color) 22%, transparent), transparent 58%),
      linear-gradient(135deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0.035)),
      rgba(12, 14, 20, 0.78);
    padding: clamp(0.9rem, 2vw, 1.15rem);
    overflow: hidden;
  }

  article::before {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, var(--metric-color), transparent);
    content: "";
  }

  strong {
    color: #ffffff;
    font-size: clamp(1.35rem, 3vw, 2.05rem);
    font-weight: 600;
    line-height: 1;
  }

  span {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.25;
  }

  p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: rgba(255, 255, 255, 0.56);
    font-size: 0.74rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  article:nth-child(1) strong {
    color: #9be7d4;
  }

  article:nth-child(2) strong {
    color: #7dd3fc;
  }

  article:nth-child(3) strong {
    color: #f5b84b;
  }

  article:nth-child(4) strong {
    color: #d8a238;
  }

  article:nth-child(1) {
    --metric-color: #9be7d4;
  }

  article:nth-child(2) {
    --metric-color: #7dd3fc;
  }

  article:nth-child(3) {
    --metric-color: #ffb932;
  }

  article:nth-child(4) {
    --metric-color: #d8a238;
  }

  @media (max-width: 820px) {
    .impact-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .impact-strip {
      grid-template-columns: 1fr;
    }

    article {
      min-height: auto;
    }
  }
</style>
