---
// HeroInteractive.astro: 3D Topological Data & Outlier Constellation
// Replaces the static/hidden 2D plot with an interactive, tangible 3D WebGL experience.
// Inspired by Linear.app, Stripe Press, and Bruno Simon.
// Respects prefers-reduced-motion, no-JS, and low-power devices.
---

<div class="hero-centerpiece" data-hero-3d>
  <div class="canvas-container" data-canvas-container>
    <canvas
      class="webgl-canvas"
      data-canvas
      aria-label="Interactive 3D data constellation showing transaction graph and flagged fraud anomaly"
    ></canvas>

    <!-- Static visual fallback for no-JS, reduced motion, or WebGL-unsupported devices -->
    <div class="static-fallback" data-static-fallback aria-hidden="true">
      <svg viewBox="0 0 400 320" class="fallback-svg">
        <defs>
          <radialGradient id="outlierGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#c92e3e" stop-opacity="0.35"></stop>
            <stop offset="100%" stop-color="#c92e3e" stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        <!-- Axes & Reference Grid -->
        <path
          d="M40 280 L370 280 M40 280 L40 40"
          stroke="rgba(22, 24, 29, 0.25)"
          stroke-width="1.5"
          stroke-dasharray="3 3"></path>
        <path
          d="M40 200 L370 200 M40 120 L370 120 M120 280 L120 40 M200 280 L200 40 M280 280 L280 40"
          stroke="rgba(22, 24, 29, 0.08)"
          stroke-width="1"></path>

        <!-- Network Connection Lines -->
        <g stroke="rgba(22, 24, 29, 0.2)" stroke-width="1">
          <line x1="90" y1="240" x2="140" y2="210"></line>
          <line x1="140" y1="210" x2="190" y2="225"></line>
          <line x1="190" y1="225" x2="240" y2="180"></line>
          <line x1="140" y1="210" x2="170" y2="160"></line>
          <line x1="170" y1="160" x2="220" y2="140"></line>
          <line x1="220" y1="140" x2="270" y2="165"></line>
          <line x1="270" y1="165" x2="310" y2="130"></line>
          <line x1="220" y1="140" x2="240" y2="180"></line>
          <line x1="90" y1="240" x2="120" y2="260"></line>
          <line x1="170" y1="160" x2="130" y2="120"></line>
          <line x1="130" y1="120" x2="180" y2="90"></line>
          <line x1="180" y1="90" x2="230" y2="105"></line>
          <line x1="230" y1="105" x2="280" y2="85"></line>
          <!-- Edge reaching towards outlier -->
          <line
            x1="280"
            y1="85"
            x2="330"
            y2="55"
            stroke="#c92e3e"
            stroke-width="1.25"
            stroke-dasharray="2 2"
            stroke-opacity="0.7"></line>
        </g>

        <!-- Normal Data Cluster Nodes -->
        <g fill="#16181d">
          <circle cx="90" cy="240" r="3.5" opacity="0.6"></circle>
          <circle cx="120" cy="260" r="3" opacity="0.5"></circle>
          <circle cx="140" cy="210" r="4" opacity="0.75"></circle>
          <circle cx="190" cy="225" r="3.5" opacity="0.6"></circle>
          <circle cx="240" cy="180" r="4" opacity="0.8"></circle>
          <circle cx="170" cy="160" r="4" opacity="0.7"></circle>
          <circle cx="220" cy="140" r="4.5" opacity="0.85"></circle>
          <circle cx="270" cy="165" r="3.5" opacity="0.6"></circle>
          <circle cx="310" cy="130" r="4" opacity="0.7"></circle>
          <circle cx="130" cy="120" r="3" opacity="0.5"></circle>
          <circle cx="180" cy="90" r="3.5" opacity="0.6"></circle>
          <circle cx="230" cy="105" r="4" opacity="0.75"></circle>
          <circle cx="280" cy="85" r="4.5" opacity="0.85"></circle>
        </g>

        <!-- The Flagged Anomaly Outlier Node -->
        <circle cx="330" cy="55" r="18" fill="url(#outlierGlow)"></circle>
        <circle
          cx="330"
          cy="55"
          r="9"
          fill="none"
          stroke="#c92e3e"
          stroke-width="1.5"
          stroke-dasharray="2 2"></circle>
        <circle cx="330" cy="55" r="5" fill="#c92e3e"></circle>

        <!-- Blueprint Annotations -->
        <text
          x="330"
          y="32"
          fill="#c92e3e"
          font-family="'SFMono-Regular', Consolas, monospace"
          font-size="9"
          font-weight="600"
          text-anchor="middle"
          letter-spacing="0.08em">NODE #3087 [OUTLIER]</text
        >
        <text
          x="330"
          y="82"
          fill="#5f656f"
          font-family="'SFMono-Regular', Consolas, monospace"
          font-size="8"
          text-anchor="middle">PR-AUC 0.8547</text
        >
        <text
          x="44"
          y="272"
          fill="#5f656f"
          font-family="'SFMono-Regular', Consolas, monospace"
          font-size="8">LATENT DIMENSION 1 →</text
        >
      </svg>
    </div>

    <!-- Live Telemetry HUD -->
    <div class="hud-overlay" data-hud aria-live="polite">
      <div class="hud-header">
        <span class="hud-tag">
          <span class="hud-pulse"></span>
          GRAPH INFERENCE ENGINE
        </span>
        <span class="hud-coords" data-hud-coords
          >T: 0.00s &middot; ROT: 0.0&deg;</span
        >
      </div>

      <div class="hud-card" data-hud-card>
        <div class="hud-card-top">
          <span class="hud-node-id" data-node-id>HOVER NODE TO INSPECT</span>
          <span class="hud-node-status" data-node-status>AWAITING INPUT</span>
        </div>
        <div class="hud-metric-row">
          <div class="hud-metric">
            <span class="hud-metric-label">Model Target</span>
            <span class="hud-metric-val" data-metric-model
              >Fraud Autoencoder</span
            >
          </div>
          <div class="hud-metric">
            <span class="hud-metric-label">Separation</span>
            <span class="hud-metric-val" data-metric-sep>0.8547 PR-AUC</span>
          </div>
          <div class="hud-metric">
            <span class="hud-metric-label">Classification</span>
            <span class="hud-metric-val highlight" data-metric-class
              >Anomaly Flagged</span
            >
          </div>
        </div>
      </div>

      <!-- Controls & Triggers -->
      <div class="hud-actions">
        <button
          type="button"
          class="hud-btn hud-btn-pulse"
          data-btn-pulse
          title="Send detection wave through graph"
        >
          <svg
            viewBox="0 0 16 16"
            width="12"
            height="12"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 2a5 5 0 1 1 0 10A5 5 0 0 1 8 3zm0 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"
            ></path>
          </svg>
          Pulse Anomaly
        </button>
        <button
          type="button"
          class="hud-btn"
          data-btn-reset
          title="Reset 3D camera orientation"
        >
          Reset View
        </button>
        <span class="hud-hint"
          >Drag to orbit &middot; Hover nodes to inspect</span
        >
      </div>
    </div>
  </div>
</div>

<script>
  import { initOnPageLoad } from "@lib/page-script";
  import type * as THREE from "three";

  initOnPageLoad(() => {
    const root = document.querySelector<HTMLElement>("[data-hero-3d]");
    if (!root) return;

    const canvas = root.querySelector<HTMLCanvasElement>("[data-canvas]");
    const staticFallback = root.querySelector<HTMLElement>(
      "[data-static-fallback]",
    );
    const hudCoords = root.querySelector<HTMLElement>("[data-hud-coords]");
    const nodeIdEl = root.querySelector<HTMLElement>("[data-node-id]");
    const nodeStatusEl = root.querySelector<HTMLElement>("[data-node-status]");
    const metricModelEl = root.querySelector<HTMLElement>(
      "[data-metric-model]",
    );
    const metricSepEl = root.querySelector<HTMLElement>("[data-metric-sep]");
    const metricClassEl = root.querySelector<HTMLElement>(
      "[data-metric-class]",
    );
    const btnPulse = root.querySelector<HTMLButtonElement>("[data-btn-pulse]");
    const btnReset = root.querySelector<HTMLButtonElement>("[data-btn-reset]");

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // If reduced motion is preferred or canvas is unsupported, keep the crisp static SVG visible
    if (prefersReducedMotion || !canvas) {
      if (staticFallback) staticFallback.style.display = "block";
      if (canvas) canvas.style.display = "none";
      return;
    }

    let isDisposed = false;
    let animationFrameId = 0;

    // Dynamically load Three.js to keep initial page footprint nimble
    import("three")
      .then((THREE) => {
        if (isDisposed || !canvas) return;

        // Check WebGL availability
        try {
          const gl =
            canvas.getContext("webgl") ||
            canvas.getContext("experimental-webgl");
          if (!gl) throw new Error("WebGL unsupported");
        } catch (e) {
          if (staticFallback) staticFallback.style.display = "block";
          canvas.style.display = "none";
          return;
        }

        const container =
          root.querySelector<HTMLElement>("[data-canvas-container]") || root;
        let width = container.clientWidth;
        let height = container.clientHeight || 340;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(
          42,
          width / height,
          0.1,
          1000,
        );
        camera.position.set(0, 1.2, 7.8);

        const renderer = new THREE.WebGLRenderer({
          canvas,
          alpha: true,
          antialias: true,
          powerPreference: "high-performance",
        });
        renderer.setSize(width, height);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        // Build data nodes
        // Color palette adhering to "The Anomaly":
        // Paper: #f7f7f6, Ink: #16181d, Carmine: #c92e3e
        const INK_COLOR = 0x16181d;
        const CARMINE_COLOR = 0xc92e3e;
        const MUTED_LINE_COLOR = 0x8a909a;

        interface NodeData {
          id: number;
          label: string;
          isOutlier: boolean;
          position: THREE.Vector3;
          mesh: THREE.Mesh;
          model: string;
          separation: string;
          status: string;
        }

        const nodes: NodeData[] = [];
        const nodeCount = 38;
        const nodeGroup = new THREE.Group();
        scene.add(nodeGroup);

        // Shared geometries
        const normalGeo = new THREE.SphereGeometry(0.08, 16, 16);
        const outlierGeo = new THREE.SphereGeometry(0.18, 24, 24);
        const ringGeo = new THREE.RingGeometry(0.24, 0.28, 32);

        const normalMat = new THREE.MeshBasicMaterial({
          color: INK_COLOR,
          opacity: 0.85,
          transparent: true,
        });
        const outlierMat = new THREE.MeshBasicMaterial({
          color: CARMINE_COLOR,
        });
        const ringMat = new THREE.MeshBasicMaterial({
          color: CARMINE_COLOR,
          side: THREE.DoubleSide,
          transparent: true,
          opacity: 0.75,
        });

        // Generate clustered normal nodes in latent space
        for (let i = 0; i < nodeCount; i++) {
          // Form a structured manifold with random micro-variations
          const u = (i / nodeCount) * Math.PI * 2;
          const radius = 1.6 + Math.sin(u * 3) * 0.45;
          const x = Math.cos(u) * radius + (Math.random() - 0.5) * 0.55;
          const y = Math.sin(u * 2) * 0.75 + (Math.random() - 0.5) * 0.45;
          const z = Math.sin(u) * radius * 0.65 + (Math.random() - 0.5) * 0.55;

          const mesh = new THREE.Mesh(normalGeo, normalMat.clone());
          mesh.position.set(x, y, z);
          nodeGroup.add(mesh);

          nodes.push({
            id: 1000 + i * 47,
            label: `TX #${1000 + i * 47}`,
            isOutlier: false,
            position: new THREE.Vector3(x, y, z),
            mesh,
            model: i % 2 === 0 ? "FastAPI Inference" : "ASP.NET Core Gateway",
            separation: `${(0.12 + Math.random() * 0.18).toFixed(4)} dist`,
            status: "Nominal Flow",
          });
        }

        // Add the Flagged Anomaly (Outlier Node) clearly separated in latent space
        const outlierPos = new THREE.Vector3(2.45, 1.25, 0.45);
        const outlierMesh = new THREE.Mesh(outlierGeo, outlierMat);
        outlierMesh.position.copy(outlierPos);
        nodeGroup.add(outlierMesh);

        // Add a rotating halo ring around the outlier
        const haloMesh = new THREE.Mesh(ringGeo, ringMat);
        haloMesh.position.copy(outlierPos);
        haloMesh.rotation.x = Math.PI / 2;
        nodeGroup.add(haloMesh);

        const outlierNode: NodeData = {
          id: 3087,
          label: "TX #3087 [FLAGGED]",
          isOutlier: true,
          position: outlierPos,
          mesh: outlierMesh,
          model: "Autoencoder + LightGBM",
          separation: "4.82σ (0.8547 PR-AUC)",
          status: "High-Confidence Anomaly",
        };
        nodes.push(outlierNode);

        // Create network topology lines between nearby nodes
        const linePositions: number[] = [];
        const lineColors: number[] = [];
        const cNormal = new THREE.Color(MUTED_LINE_COLOR);
        const cCarmine = new THREE.Color(CARMINE_COLOR);

        for (let i = 0; i < nodes.length; i++) {
          for (let j = i + 1; j < nodes.length; j++) {
            const dist = nodes[i].position.distanceTo(nodes[j].position);
            if (dist < 1.35) {
              linePositions.push(
                nodes[i].position.x,
                nodes[i].position.y,
                nodes[i].position.z,
                nodes[j].position.x,
                nodes[j].position.y,
                nodes[j].position.z,
              );
              const isRedEdge = nodes[i].isOutlier || nodes[j].isOutlier;
              const c = isRedEdge ? cCarmine : cNormal;
              lineColors.push(c.r, c.g, c.b, c.r, c.g, c.b);
            }
          }
        }

        const lineGeo = new THREE.BufferGeometry();
        lineGeo.setAttribute(
          "position",
          new THREE.Float32BufferAttribute(linePositions, 3),
        );
        lineGeo.setAttribute(
          "color",
          new THREE.Float32BufferAttribute(lineColors, 3),
        );

        const lineMat = new THREE.LineBasicMaterial({
          vertexColors: true,
          transparent: true,
          opacity: 0.38,
        });

        const linesMesh = new THREE.LineSegments(lineGeo, lineMat);
        nodeGroup.add(linesMesh);

        // Pulse ring expansion mesh for "Simulate Detection"
        const pulseGeo = new THREE.RingGeometry(0.1, 0.16, 48);
        const pulseMat = new THREE.MeshBasicMaterial({
          color: CARMINE_COLOR,
          side: THREE.DoubleSide,
          transparent: true,
          opacity: 0,
        });
        const pulseMesh = new THREE.Mesh(pulseGeo, pulseMat);
        pulseMesh.position.copy(outlierPos);
        nodeGroup.add(pulseMesh);

        let pulseActive = false;
        let pulseProgress = 0;

        const triggerPulse = () => {
          pulseActive = true;
          pulseProgress = 0;
          pulseMesh.scale.set(1, 1, 1);
          pulseMat.opacity = 0.9;
        };

        btnPulse?.addEventListener("click", triggerPulse);

        // Raycasting for interactive hover inspection
        const raycaster = new THREE.Raycaster();
        raycaster.params.Points = { threshold: 0.2 };
        const mouse = new THREE.Vector2(-1000, -1000);
        let hoveredNode: NodeData | null = null;

        // Pointer Orbit controls with smooth damping
        let isDragging = false;
        let prevMouseX = 0;
        let prevMouseY = 0;
        let targetRotX = 0.12;
        let targetRotY = -0.35;
        let curRotX = targetRotX;
        let curRotY = targetRotY;

        const onPointerDown = (e: PointerEvent) => {
          isDragging = true;
          prevMouseX = e.clientX;
          prevMouseY = e.clientY;
        };

        const onPointerMove = (e: PointerEvent) => {
          const rect = canvas.getBoundingClientRect();
          mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
          mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

          if (isDragging) {
            const deltaX = e.clientX - prevMouseX;
            const deltaY = e.clientY - prevMouseY;
            prevMouseX = e.clientX;
            prevMouseY = e.clientY;

            targetRotY += deltaX * 0.007;
            targetRotX += deltaY * 0.007;
            targetRotX = Math.max(-0.6, Math.min(0.6, targetRotX));
          }
        };

        const onPointerUp = () => {
          isDragging = false;
        };

        canvas.addEventListener("pointerdown", onPointerDown);
        window.addEventListener("pointermove", onPointerMove);
        window.addEventListener("pointerup", onPointerUp);

        btnReset?.addEventListener("click", () => {
          targetRotX = 0.12;
          targetRotY = -0.35;
        });

        // Resize observer
        const onResize = () => {
          if (!container) return;
          width = container.clientWidth;
          height = container.clientHeight || 340;
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
          renderer.setSize(width, height);
        };
        window.addEventListener("resize", onResize);

        // Main render loop
        let clock = 0;
        const animate = () => {
          if (isDisposed) return;
          clock += 0.015;

          // Smooth camera damping
          curRotX += (targetRotX - curRotX) * 0.08;
          curRotY += (targetRotY - curRotY) * 0.08;

          // Subtle autonomous breathing orbit
          if (!isDragging) {
            targetRotY += 0.0008;
          }

          nodeGroup.rotation.x = curRotX;
          nodeGroup.rotation.y = curRotY;

          // Rotate outlier halo
          haloMesh.rotation.z += 0.02;
          const haloScale = 1 + Math.sin(clock * 3) * 0.08;
          haloMesh.scale.set(haloScale, haloScale, 1);

          // Pulse wave propagation
          if (pulseActive) {
            pulseProgress += 0.028;
            const currentRadius = 1 + pulseProgress * 14;
            pulseMesh.scale.set(currentRadius, currentRadius, 1);
            pulseMat.opacity = Math.max(0, 0.85 * (1 - pulseProgress));

            if (pulseProgress >= 1) {
              pulseActive = false;
            }
          }

          // Raycasting
          raycaster.setFromCamera(mouse, camera);
          const meshes = nodes.map((n) => n.mesh);
          const intersects = raycaster.intersectObjects(meshes);

          if (intersects.length > 0) {
            const hitMesh = intersects[0].object as THREE.Mesh;
            const found = nodes.find((n) => n.mesh === hitMesh);

            if (found && found !== hoveredNode) {
              if (hoveredNode && !hoveredNode.isOutlier) {
                (
                  hoveredNode.mesh.material as THREE.MeshBasicMaterial
                ).color.setHex(INK_COLOR);
                hoveredNode.mesh.scale.set(1, 1, 1);
              }

              hoveredNode = found;
              if (!found.isOutlier) {
                (found.mesh.material as THREE.MeshBasicMaterial).color.setHex(
                  CARMINE_COLOR,
                );
                found.mesh.scale.set(1.4, 1.4, 1.4);
              }

              // Update HUD
              if (nodeIdEl) nodeIdEl.textContent = found.label;
              if (nodeStatusEl) {
                nodeStatusEl.textContent = found.status;
                nodeStatusEl.classList.toggle("is-outlier", found.isOutlier);
              }
              if (metricModelEl) metricModelEl.textContent = found.model;
              if (metricSepEl) metricSepEl.textContent = found.separation;
              if (metricClassEl) {
                metricClassEl.textContent = found.isOutlier
                  ? "Anomaly Detected"
                  : "In-Distribution Flow";
                metricClassEl.classList.toggle("is-outlier", found.isOutlier);
              }
            }
          } else if (hoveredNode) {
            if (!hoveredNode.isOutlier) {
              (
                hoveredNode.mesh.material as THREE.MeshBasicMaterial
              ).color.setHex(INK_COLOR);
              hoveredNode.mesh.scale.set(1, 1, 1);
            }
            hoveredNode = null;
          }

          // Update coordinates in HUD
          if (hudCoords && clock % 0.15 < 0.02) {
            const deg = (((curRotY * 180) / Math.PI) % 360).toFixed(1);
            hudCoords.textContent = `T: ${clock.toFixed(1)}s · ROT: ${deg}°`;
          }

          renderer.render(scene, camera);
          animationFrameId = requestAnimationFrame(animate);
        };

        // Lazy start with IntersectionObserver to conserve battery/GPU
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                if (!animationFrameId) {
                  animationFrameId = requestAnimationFrame(animate);
                }
              } else {
                if (animationFrameId) {
                  cancelAnimationFrame(animationFrameId);
                  animationFrameId = 0;
                }
              }
            });
          },
          { threshold: 0.1 },
        );
        observer.observe(canvas);

        // Trigger an initial detection pulse after 1.2s to visually introduce the anomaly
        window.setTimeout(() => {
          if (!isDisposed) triggerPulse();
        }, 1200);

        // Cleanup
        return () => {
          isDisposed = true;
          observer.disconnect();
          window.removeEventListener("resize", onResize);
          canvas.removeEventListener("pointerdown", onPointerDown);
          window.removeEventListener("pointermove", onPointerMove);
          window.removeEventListener("pointerup", onPointerUp);
          btnPulse?.removeEventListener("click", triggerPulse);
          if (animationFrameId) cancelAnimationFrame(animationFrameId);
          renderer.dispose();
        };
      })
      .catch(() => {
        // If Three.js fails to load, gracefully display the static vector diagram
        if (staticFallback) staticFallback.style.display = "block";
        if (canvas) canvas.style.display = "none";
      });
  });
</script>

<style>
  .hero-centerpiece {
    position: relative;
    width: 100%;
    margin-top: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-soft);
    overflow: hidden;
  }

  .canvas-container {
    position: relative;
    width: 100%;
    height: clamp(320px, 46vw, 440px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .webgl-canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    touch-action: none;
  }

  .webgl-canvas:active {
    cursor: grabbing;
  }

  /* Static fallback */
  .static-fallback {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: var(--paper-soft);
  }

  .fallback-svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* HUD Overlay */
  .hud-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(0.75rem, 2vw, 1.25rem);
  }

  .hud-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    text-transform: uppercase;
  }

  .hud-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(247, 247, 246, 0.88);
    border: 1px solid var(--line);
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-pill);
    backdrop-filter: blur(8px);
  }

  .hud-pulse {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--signal);
    box-shadow: 0 0 0 0 rgba(201, 46, 62, 0.4);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(201, 46, 62, 0.6);
    }
    70% {
      box-shadow: 0 0 0 6px rgba(201, 46, 62, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(201, 46, 62, 0);
    }
  }

  .hud-coords {
    background: rgba(247, 247, 246, 0.88);
