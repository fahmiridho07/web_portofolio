---
import { getOrganizationLogo } from "@lib/organizations";

interface Props {
  organization: string;
  size?: "sm" | "md" | "lg";
  eager?: boolean;
}

const { organization, size = "md", eager = false } = Astro.props;
const logo = getOrganizationLogo(organization);

const displayHeightByVariant = {
  sm: 44,
  md: 52,
  lg: 64,
} as const;

const displayHeight = displayHeightByVariant[size];
const aspectRatio = logo ? logo.width / logo.height : 1;
const displayWidth = Math.round(displayHeight * aspectRatio);
const isWide = aspectRatio > 1.35;
const sizes = `${displayWidth}px`;
---

{
  logo && (
    <span
      class:list={["org-logo", `is-${size}`, isWide && "is-wide"]}
      style={`--org-logo-width: ${displayWidth}px; --org-logo-height: ${displayHeight}px;`}
    >
      <img
        src={logo.src}
        srcset={logo.srcset}
        sizes={sizes}
        alt=""
        width={logo.width}
        height={logo.height}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    </span>
  )
}

<style>
  .org-logo {
    display: inline-grid;
    width: var(--org-logo-width);
    height: var(--org-logo-height);
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(17, 24, 39, 0.1);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 6px 18px rgba(17, 24, 39, 0.05);
    padding: 0.42rem;
  }

  .org-logo.is-wide {
    padding-inline: 0.5rem;
  }

  .org-logo.is-sm {
    border-radius: 8px;
    padding-block: 0.36rem;
  }

  .org-logo.is-sm.is-wide {
    padding-inline: 0.42rem;
  }

  .org-logo.is-lg {
    border-radius: 12px;
    padding-block: 0.5rem;
  }

  .org-logo.is-lg.is-wide {
    padding-inline: 0.58rem;
  }

  .org-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>