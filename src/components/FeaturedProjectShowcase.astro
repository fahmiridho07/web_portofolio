---
import ProjectMockup from "@components/ProjectMockup.astro";
import { getCategoryMeta } from "@lib/projects";
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
const primaryProject = projects[0];
const secondaryProjects = projects.slice(1);
const primaryCategory = primaryProject ? getCategoryMeta(primaryProject.data.category) : undefined;
---

{
  primaryProject && (
    <div class="featured-showcase" data-reveal>
      <a
        class="primary-feature"
        href={`/projects/${primaryProject.data.slug}/`}
        aria-label={`Open the build: ${primaryProject.data.title}`}
      >
        <div class="primary-visual" aria-hidden="true">
          <ProjectMockup project={primaryProject} variant="featured" />
        </div>

        <div class="primary-copy">
          <p class="section-label">{primaryCategory?.title}</p>
          <h3>{primaryProject.data.title}</h3>
          <p>{primaryProject.data.result ?? primaryProject.data.summary}</p>
          <div class="primary-meta">
            <span>{primaryProject.data.metric ?? primaryProject.data.status}</span>
            <span>{primaryProject.data.role}</span>
          </div>
          <span class="feature-cta">Open the build -&gt;</span>
        </div>
      </a>

      <div class="secondary-stack">
        {
          secondaryProjects.map((project, index) => {
            const category = getCategoryMeta(project.data.category);
            const proof = project.data.proof?.[0] ?? project.data.metric ?? project.data.status;

            return (
              <a
                class="secondary-feature"
                href={`/projects/${project.data.slug}/`}
                aria-label={`Open the build: ${project.data.title}`}
              >
                <span class="feature-index">{String(index + 2).padStart(2, "0")}</span>
                <div class="secondary-thumb" aria-hidden="true">
                  <ProjectMockup project={project} variant="compact" showMetric={false} />
                </div>
                <div>
                  <small>{category.title}</small>
                  <h3>{project.data.title}</h3>
                  <p>{proof}</p>
                </div>
                <em aria-hidden="true">Open -&gt;</em>
              </a>
            );
          })
        }
      </div>
    </div>
  )
}

<style>
  .featured-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(19rem, 0.84fr);
    gap: clamp(1rem, 3vw, 1.5rem);
  }

  .primary-feature,
  .secondary-feature {
    position: relative;
    min-width: 0;
    color: inherit;
  }

  .primary-feature {
    display: grid;
    overflow: hidden;
    border: 1px solid rgba(17, 24, 39, 0.12);
    border-radius: 8px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(232, 238, 247, 0.78)),
      #ffffff;
    box-shadow:
      0 22px 64px rgba(17, 24, 39, 0.09),
      0 0 48px rgba(125, 211, 252, 0.06);
    transition:
      border-color var(--motion-medium) var(--ease-standard),
      box-shadow var(--motion-medium) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
  }

  .primary-feature::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(120deg, rgba(15, 159, 135, 0.1), transparent 28%),
      linear-gradient(300deg, rgba(125, 211, 252, 0.14), transparent 32%),
      linear-gradient(45deg, transparent 58%, rgba(216, 162, 56, 0.08));
    content: "";
    opacity: 0.76;
    pointer-events: none;
  }

  .primary-visual {
    position: relative;
    aspect-ratio: 1.42;
    overflow: hidden;
    background:
      radial-gradient(circle at 70% 20%, rgba(125, 211, 252, 0.14), transparent 28rem),
      #eef4ff;
  }

  .primary-copy {
    position: relative;
    display: grid;
    gap: 0.82rem;
    padding: clamp(1.15rem, 3vw, 1.6rem);
  }

  .primary-copy .section-label {
    color: var(--accent);
  }

  .primary-copy h3,
  .secondary-feature h3 {
    margin: 0;
    color: var(--text);
    font-weight: 600;
    letter-spacing: 0;
  }

  .primary-copy h3 {
    max-width: 760px;
    font-size: clamp(1.55rem, 3vw, 2.55rem);
    line-height: 1.02;
  }

  .primary-copy p,
  .secondary-feature p {
    margin: 0;
    color: var(--text-muted);
  }

  .primary-copy p {
    max-width: 68ch;
    font-size: 0.96rem;
    line-height: 1.7;
  }

  .primary-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .feature-cta {
    width: fit-content;
    color: var(--accent-coral);
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1;
  }

  .primary-meta span {
    border: 1px solid rgba(59, 130, 196, 0.2);
    border-radius: 999px;
    background: rgba(59, 130, 196, 0.08);
    color: #315f86;
    font-size: 0.78rem;
    line-height: 1;
    padding: 0.5rem 0.68rem;
  }

  .primary-meta span:first-child {
    border-color: rgba(15, 159, 135, 0.24);
    background: rgba(15, 159, 135, 0.12);
    color: #0f5f54;
  }

  .secondary-stack {
    display: grid;
    gap: 0.85rem;
  }

  .secondary-feature {
    display: grid;
    grid-template-columns: 2.4rem minmax(7.5rem, 0.36fr) minmax(0, 1fr) 3.1rem;
    gap: 0.85rem;
    align-items: center;
    overflow: hidden;
    min-height: 9.75rem;
    border: 1px solid rgba(17, 24, 39, 0.12);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.8), rgba(232, 239, 255, 0.56)),
      rgba(255, 255, 255, 0.64);
    padding: 0.78rem;
    transition:
      border-color var(--motion-medium) var(--ease-standard),
      background var(--motion-medium) var(--ease-standard),
      box-shadow var(--motion-medium) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
  }

  .feature-index,
  .secondary-feature small {
    color: var(--text-soft);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.68rem;
    line-height: 1;
  }

  .secondary-thumb {
    position: relative;
    height: 100%;
    min-height: 7.8rem;
    overflow: hidden;
    border-radius: 6px;
    background: var(--surface-subtle);
  }

  .secondary-feature h3 {
    margin-top: 0.46rem;
    font-size: clamp(1.02rem, 2vw, 1.28rem);
    line-height: 1.12;
  }

  .secondary-feature p {
    display: -webkit-box;
    margin-top: 0.58rem;
    overflow: hidden;
    font-size: 0.82rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .secondary-feature em {
    display: inline-flex;
    width: 3.1rem;
    justify-content: flex-end;
    color: var(--accent-coral);
    font-size: 0.76rem;
    font-weight: 700;
    font-style: normal;
    line-height: 1;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity var(--motion-fast) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
  }

  .primary-feature:hover,
  .primary-feature:focus-within {
    border-color: rgba(47, 123, 255, 0.3);
    box-shadow:
      0 26px 74px rgba(17, 24, 39, 0.12),
      0 0 54px rgba(125, 211, 252, 0.08);
    transform: translateY(-2px);
  }

  .secondary-feature:hover,
  .secondary-feature:focus-within {
    border-color: rgba(47, 123, 255, 0.3);
    background: #ffffff;
    box-shadow:
      0 18px 50px rgba(17, 24, 39, 0.08),
      0 0 36px rgba(125, 211, 252, 0.06);
    transform: translateY(-2px);
  }

  .secondary-feature:nth-child(2) {
    background:
      linear-gradient(135deg, rgba(255, 248, 232, 0.8), rgba(242, 237, 247, 0.55)),
      rgba(255, 255, 255, 0.66);
  }

  .secondary-feature:nth-child(3) {
    background:
      linear-gradient(135deg, rgba(236, 253, 245, 0.72), rgba(235, 241, 249, 0.6)),
      rgba(255, 255, 255, 0.66);
  }

  .secondary-feature:hover em,
  .secondary-feature:focus-within em {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 920px) {
    .featured-showcase {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .secondary-feature {
      grid-template-columns: minmax(0, 1fr) 3.1rem;
      min-height: auto;
      padding: 0.85rem;
    }

    .feature-index,
    .secondary-thumb {
      display: none;
    }

    .secondary-feature em {
      opacity: 1;
      transform: none;
    }
  }
</style>
