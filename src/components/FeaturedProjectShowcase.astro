---
import ProjectMockup from "@components/ProjectMockup.astro";
import { getCategoryMeta } from "@lib/projects";
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
const primaryProject = projects[0];
const secondaryProjects = projects.slice(1);
const primaryCategory = primaryProject ? getCategoryMeta(primaryProject.data.category) : undefined;
---

{
  primaryProject && (
    <div class="featured-showcase" data-reveal>
      <a
        class="primary-feature glass-card"
        href={`/projects/${primaryProject.data.slug}/`}
        aria-label={`Open the build: ${primaryProject.data.title}`}
        data-astro-prefetch="hover"
      >
        <div class="primary-visual" aria-hidden="true">
          <ProjectMockup project={primaryProject} variant="featured" />
        </div>

        <div class="primary-copy">
          <p class="section-label">{primaryCategory?.title}</p>
          <h3>{primaryProject.data.title}</h3>
          <div class="primary-meta">
            <span>{primaryProject.data.metric ?? primaryProject.data.status}</span>
            <span>{primaryProject.data.role}</span>
          </div>
        </div>
      </a>

      <div class="secondary-stack">
        {
          secondaryProjects.map((project, index) => {
            const category = getCategoryMeta(project.data.category);
            const metric = project.data.metric ?? project.data.status;

            return (
              <a
                class="secondary-feature glass-card"
                href={`/projects/${project.data.slug}/`}
                aria-label={`Open the build: ${project.data.title}`}
                data-astro-prefetch="hover"
              >
                <span class="feature-index">{String(index + 2).padStart(2, "0")}</span>
                <div class="secondary-thumb" aria-hidden="true">
                  <ProjectMockup project={project} variant="compact" showMetric={false} />
                </div>
                <div>
                  <small>{category.title}</small>
                  <h3>{project.data.title}</h3>
                  <p class="secondary-metric">{metric}</p>
                </div>
                <em aria-hidden="true">Open -&gt;</em>
              </a>
            );
          })
        }
      </div>
    </div>
  )
}

<style>
  .featured-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(19rem, 0.84fr);
    gap: var(--gap-grid);
  }

  .primary-feature,
  .secondary-feature {
    position: relative;
    min-width: 0;
    color: inherit;
  }

  .primary-feature {
    display: grid;
    overflow: hidden;
    box-shadow:
      var(--shadow-soft),
      inset 0 1px 0 var(--card-inset),
      0 0 48px color-mix(in srgb, var(--accent-cyan) 6%, transparent);
    transition:
      border-color var(--motion-medium) var(--ease-standard),
      box-shadow var(--motion-medium) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
  }

  .primary-feature::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(120deg, rgba(15, 159, 135, 0.1), transparent 28%),
      linear-gradient(300deg, rgba(125, 211, 252, 0.14), transparent 32%),
      linear-gradient(45deg, transparent 58%, rgba(216, 162, 56, 0.08));
    content: "";
    opacity: 0.76;
    pointer-events: none;
  }

  .primary-visual {
    position: relative;
    aspect-ratio: 1.42;
    overflow: hidden;
    background:
      radial-gradient(circle at 70% 20%, rgba(125, 211, 252, 0.14), transparent 28rem),
      #eef4ff;
  }

  .primary-copy {
    position: relative;
    display: grid;
    gap: var(--space-stack-sm);
    padding: clamp(1rem, 2.5vw, 1.35rem);
  }

  .primary-copy .section-label {
    color: var(--accent);
  }

  .primary-copy h3,
  .secondary-feature h3 {
    margin: 0;
    color: var(--text);
    font-weight: 600;
    letter-spacing: 0;
  }

  .primary-copy h3 {
    max-width: 760px;
    font-size: clamp(1.55rem, 3vw, 2.55rem);
    line-height: 1.02;
  }

  .primary-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .primary-meta span {
    border: 1px solid var(--badge-blue-border);
    border-radius: 999px;
    background: var(--badge-blue-bg);
    color: var(--accent-blue-on);
    font-size: 0.78rem;
    line-height: 1;
    padding: 0.5rem 0.68rem;
  }

  .primary-meta span:first-child {
    border-color: var(--badge-border-strong);
    background: var(--badge-metric-bg);
    color: var(--accent-on);
  }

  .secondary-stack {
    display: grid;
    gap: var(--space-stack-sm);
  }

  .secondary-feature {
    display: grid;
    grid-template-columns: 2.4rem minmax(7.5rem, 0.36fr) minmax(0, 1fr) 3.1rem;
    gap: var(--space-stack-sm);
    align-items: center;
    overflow: hidden;
    min-height: 9.75rem;
    padding: 0.78rem;
    transition:
      border-color var(--motion-medium) var(--ease-standard),
      background var(--motion-medium) var(--ease-standard),
      box-shadow var(--motion-medium) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
  }

  .feature-index,
  .secondary-feature small {
    color: var(--text-soft);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.68rem;
    line-height: 1;
  }

  .secondary-thumb {
    position: relative;
    height: 100%;
    min-height: 7.8rem;
    overflow: hidden;
    border-radius: 6px;
    background: var(--surface-subtle);
  }

  .secondary-feature h3 {
    margin-top: 0.46rem;
    font-size: clamp(1.02rem, 2vw, 1.28rem);
    line-height: 1.12;
  }

  .secondary-metric {
    margin: 0.45rem 0 0;
    color: var(--text-soft);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.72rem;
    line-height: 1;
  }

  .secondary-feature em {
    display: inline-flex;
    width: 3.1rem;
    justify-content: flex-end;
    color: var(--accent-coral);
    font-size: 0.76rem;
    font-weight: 700;
    font-style: normal;
    line-height: 1;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity var(--motion-fast) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
  }

  .primary-feature:hover,
  .primary-feature:focus-within {
    border-color: color-mix(in srgb, var(--accent-cyan) 30%, var(--card-border));
    box-shadow:
      var(--shadow-soft),
      0 0 54px color-mix(in srgb, var(--accent-cyan) 8%, transparent);
    transform: translateY(-2px);
  }

  .secondary-feature:hover,
  .secondary-feature:focus-within {
    border-color: color-mix(in srgb, var(--accent-cyan) 30%, var(--card-border));
    background: var(--card-bg-hover, var(--card-bg));
    box-shadow:
      var(--panel-shadow),
      0 0 36px color-mix(in srgb, var(--accent-cyan) 6%, transparent);
    transform: translateY(-2px);
  }

  .secondary-feature:hover em,
  .secondary-feature:focus-within em {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 920px) {
    .featured-showcase {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .secondary-feature {
      grid-template-columns: minmax(0, 1fr) 3.1rem;
      min-height: auto;
      padding: 0.85rem;
    }

    .feature-index,
    .secondary-thumb {
      display: none;
    }

    .secondary-feature em {
      opacity: 1;
      transform: none;
    }
  }
</style>
