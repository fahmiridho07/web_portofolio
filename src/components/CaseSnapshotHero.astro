---
import ProjectMockup from "@components/ProjectMockup.astro";
import { getLogoItems } from "@lib/logos";
import { getCategoryMeta } from "@lib/projects";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const category = getCategoryMeta(project.data.category);
const projectLogo = project.data.logo ?? category.logo;
const visibleStack = getLogoItems(project.data.stack.slice(0, 6));
const hiddenStackCount = Math.max(project.data.stack.length - visibleStack.length, 0);
const proofItems = (
  project.data.proof && project.data.proof.length > 0
    ? project.data.proof
    : [project.data.metric ?? project.data.status, project.data.status, ...project.data.stack]
)
  .filter(Boolean)
  .slice(0, 3);
const snapshotStats = [
  {
    label: "Outcome",
    value: project.data.metric ?? project.data.status,
  },
  {
    label: "Role",
    value: project.data.role,
  },
  {
    label: "Status",
    value: `${project.data.status} / ${project.data.year}`,
  },
];
---

<header class="case-snapshot-hero dark-section" data-dark-section>
  <div class="case-grid-lines" aria-hidden="true"></div>
  <div class="container case-command-grid">
    <div class="case-copy" data-reveal>
      <div class="case-kicker">
        {projectLogo && <span class="case-logo"><img src={projectLogo} alt="" width="24" height="24" loading="eager" /></span>}
        <p class="section-label">{category.title} / {project.data.year}</p>
      </div>

      <h1 class="display">{project.data.title}</h1>
      <p class="case-result">{project.data.result ?? project.data.summary}</p>

      <div class="case-actions">
        <a href="#case-study">Read case study</a>
        {
          project.data.links.map((link) => (
            <a href={link.href} target="_blank" rel="noreferrer">
              {link.label} -&gt;
            </a>
          ))
        }
      </div>

      <ul class="stack-pills" aria-label="Technology stack">
        {
          visibleStack.map((item) => (
            <li class:list={[item.logo && "has-logo"]}>
              {item.logo && <img src={item.logo} alt="" width="24" height="24" loading="lazy" />}
              <span>{item.label}</span>
            </li>
          ))
        }
        {hiddenStackCount > 0 && <li>+{hiddenStackCount} more</li>}
      </ul>
    </div>

    <aside class="snapshot-panel" aria-label="Project snapshot" data-reveal data-reveal-delay="120">
      <a class="snapshot-artifact" href={project.data.coverImage} target="_blank" rel="noreferrer">
        <ProjectMockup project={project} variant="case" showMetric={false} eager />
        <span class="artifact-open">Open artifact</span>
      </a>

      <div class="snapshot-stat-grid">
        {
          snapshotStats.map((item) => (
            <article>
              <span>{item.label}</span>
              <strong>{item.value}</strong>
            </article>
          ))
        }
      </div>

      <ul class="snapshot-proof" aria-label="Project proof points">
        {proofItems.map((item) => <li>{item}</li>)}
      </ul>
    </aside>
  </div>
</header>

<style>
  .case-snapshot-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 20% 18%, rgba(125, 211, 252, 0.14), transparent 24rem),
      radial-gradient(circle at 86% 24%, rgba(167, 243, 208, 0.12), transparent 28rem),
      linear-gradient(135deg, #07111e 0%, #111d2e 56%, #171321 100%);
    color: #ffffff;
    padding-block: clamp(6.5rem, 10vw, 9rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .case-grid-lines {
    position: absolute;
    inset: 0;
    opacity: 0.16;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 5.5rem 5.5rem;
    mask-image: linear-gradient(180deg, #000, transparent 82%);
    pointer-events: none;
  }

  .case-command-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.96fr) minmax(19rem, 0.74fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .case-copy,
  .snapshot-panel {
    min-width: 0;
  }

  .case-copy {
    display: grid;
    gap: 1.05rem;
  }

  .case-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: center;
  }

  .case-logo {
    display: inline-grid;
    width: 2.2rem;
    height: 2.2rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
  }

  .case-logo img {
    width: 1.24rem;
    height: 1.24rem;
    object-fit: contain;
  }

  .display {
    max-width: 940px;
    color: #ffffff;
  }

  .case-result {
    max-width: 760px;
    margin: 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: clamp(1rem, 1.7vw, 1.14rem);
    line-height: 1.72;
  }

  .case-actions,
  .stack-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-actions a {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.84);
    font-size: 0.78rem;
    line-height: 1;
    padding: 0.58rem 0.78rem;
  }

  .case-actions a:first-child {
    border-color: rgba(155, 231, 212, 0.34);
    background: rgba(155, 231, 212, 0.13);
    color: #d9fff5;
  }

  .stack-pills li {
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.6875rem;
    line-height: 1;
    padding: 0.42rem 0.66rem;
  }

  .stack-pills li.has-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.62rem 0.32rem 0.38rem;
  }

  .stack-pills img {
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    object-fit: contain;
    padding: 0.12rem;
  }

  .snapshot-panel {
    display: grid;
    gap: 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    background:
      linear-gradient(145deg, rgba(125, 211, 252, 0.1), rgba(167, 243, 208, 0.06)),
      linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.035)),
      rgba(255, 255, 255, 0.06);
    box-shadow:
      0 24px 90px rgba(0, 0, 0, 0.36),
      0 0 70px rgba(125, 211, 252, 0.08);
    padding: clamp(0.8rem, 2vw, 1rem);
    backdrop-filter: blur(18px);
  }

  .snapshot-artifact {
    position: relative;
    display: block;
    aspect-ratio: 1.55;
    overflow: hidden;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
  }

  .artifact-open {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 4;
    border-radius: 999px;
    background: rgba(8, 10, 16, 0.72);
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.72rem;
    line-height: 1;
    padding: 0.46rem 0.62rem;
  }

  .snapshot-stat-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.12);
  }

  .snapshot-stat-grid article {
    display: grid;
    gap: 0.42rem;
    min-height: 6rem;
    align-content: start;
    background: rgba(8, 10, 16, 0.52);
    padding: 0.8rem;
  }

  .snapshot-stat-grid span {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.64rem;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
  }

  .snapshot-stat-grid strong {
    display: -webkit-box;
    overflow: hidden;
    color: #ffffff;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.25;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .snapshot-proof {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .snapshot-proof li {
    position: relative;
    border-left: 2px solid #9be7d4;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8rem;
    line-height: 1.45;
    padding-left: 0.68rem;
  }

  @media (max-width: 900px) {
    .case-command-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .case-snapshot-hero {
      padding-block: 5.6rem 2.3rem;
    }

    .case-copy {
      gap: 0.9rem;
    }

    .snapshot-panel {
      gap: 0.65rem;
      padding: 0.65rem;
    }

    .snapshot-stat-grid {
      grid-template-columns: 1fr;
    }

    .snapshot-stat-grid article {
      min-height: auto;
    }
  }
</style>
