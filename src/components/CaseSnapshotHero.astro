---
import { getImageMeta } from "@lib/images";
import { getCategoryMeta } from "@lib/projects";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const category = getCategoryMeta(project.data.category);
const coverMeta = getImageMeta(project.data.coverImage);
const wordCount = (project.body ?? "").split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));
const facts = [
  { label: "Role", value: project.data.role },
  { label: "Outcome", value: project.data.metric ?? project.data.status, highlight: true },
  { label: "Status", value: `${project.data.status} / ${project.data.year}` },
  { label: "Stack", value: project.data.stack.slice(0, 5).join(" · ") },
];
---

<header class="case-snapshot-hero">
  <div class="container case-hero-inner">
    <div class="case-copy" data-reveal>
      <p class="section-label">
        {category.title} / {project.data.year} &middot; {readingMinutes} min read
      </p>
      <h1 class="display">{project.data.title}</h1>
      <p class="case-summary">{project.data.summary}</p>

      <div class="case-actions">
        <a class="dark-cta dark-cta-primary" href="#case-study">
          Read the case <span aria-hidden="true">&darr;</span>
        </a>
        {
          project.data.links.map((link) => (
            <a
              class="dark-cta dark-cta-secondary dark-cta-compact"
              href={link.href}
              target="_blank"
              rel="noreferrer"
            >
              {link.label} <span aria-hidden="true">&nearr;</span>
            </a>
          ))
        }
      </div>
    </div>

    <figure class="case-cover" data-reveal data-reveal-delay="100">
      <img
        src={project.data.coverImage}
        alt={`Cover image for ${project.data.title}`}
        width={coverMeta?.width}
        height={coverMeta?.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>

    <dl class="case-facts" data-reveal data-reveal-delay="60">
      {
        facts.map((fact) => (
          <div class="case-fact">
            <dt>
              {fact.highlight && <span class="fact-dot" aria-hidden="true" />}
              {fact.label}
            </dt>
            <dd class:list={[fact.highlight && "is-highlight"]}>{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</header>

<style>
  .case-snapshot-hero {
    padding-block: clamp(4.5rem, 9vw, 7rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .case-hero-inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.75rem);
  }

  .case-copy {
    display: grid;
    gap: 1rem;
  }

  .case-copy .display {
    max-width: 900px;
    font-size: clamp(2.2rem, 4.8vw, 4rem);
  }

  .case-summary {
    max-width: 62ch;
    margin: 0;
    color: var(--ink-muted);
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    line-height: 1.65;
  }

  .case-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .case-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: 1.1rem;
  }

  .case-fact {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .case-fact dt {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .fact-dot {
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 999px;
    background: var(--signal);
  }

  .case-fact dd {
    margin: 0;
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .case-fact dd.is-highlight {
    font-weight: 600;
  }

  .case-cover {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: #ffffff;
  }

  /* Contain, never crop: covers include diagrams whose edges carry meaning */
  .case-cover img {
    width: 100%;
    max-height: clamp(20rem, 44vw, 30rem);
    object-fit: contain;
    padding: clamp(0.75rem, 2vw, 1.5rem);
  }

  @media (max-width: 720px) {
    .case-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }
</style>
