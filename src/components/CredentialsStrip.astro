---
import OrganizationLogo from "@components/OrganizationLogo.astro";
import { education, experiences } from "@data/profile";

const primaryExperience = experiences[0];
const secondaryExperience = experiences[1];
const gpaShort = education.gpa.split("/")[0]?.trim() ?? education.gpa;

const backgroundRows = [
  {
    organization: education.institution,
    title: "Information Systems",
    detail: `GPA ${gpaShort} · ITS`,
    href: "/about/",
    primary: false,
  },
  {
    organization: primaryExperience.organization,
    title: "Software intern",
    detail: "IdeKU V3 · Power Automate · Power BI",
    href: primaryExperience.relatedProjectSlug
      ? `/projects/${primaryExperience.relatedProjectSlug}/`
      : "/about/",
    primary: Boolean(primaryExperience.relatedProjectSlug),
  },
  ...(secondaryExperience
    ? [
        {
          organization: secondaryExperience.organization,
          title: "R&D lead",
          detail: "R&D ops · SOPs · delivery",
          href: "/about/",
          primary: false,
        },
      ]
    : []),
];
---

<section class="trust-strip divider" aria-labelledby="trust-title">
  <div class="container trust-layout">
    <div class="trust-header" data-reveal>
      <div>
        <p class="section-label" id="trust-title">Background</p>
        <h2 class="trust-headline">Where the builds above come from.</h2>
      </div>
      <a class="trust-link" href="/about/" data-astro-prefetch="hover">
        About <span aria-hidden="true">-&gt;</span>
      </a>
    </div>

    <div class="trust-list glass-surface" data-reveal data-reveal-delay="80">
      {
        backgroundRows.map((row) => (
          <a
            class:list={["trust-row", row.primary && "is-primary"]}
            href={row.href}
            data-astro-prefetch="hover"
            aria-label={
              row.primary
                ? `Open ${row.title} build: ${row.detail}`
                : `About background: ${row.title}`
            }
          >
            <OrganizationLogo organization={row.organization} size="sm" eager={row.primary} />
            <span class="trust-row-copy">
              <span class="trust-row-title">{row.title}</span>
              <span class="trust-row-detail">{row.detail}</span>
            </span>
            <span class="trust-row-arrow" aria-hidden="true">-&gt;</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .trust-strip {
    position: relative;
    background:
      radial-gradient(
        ellipse 80% 50% at 12% 0%,
        color-mix(in srgb, var(--accent-cyan) 8%, transparent),
        transparent 58%
      ),
      var(--surface-light);
    padding-block: clamp(1.35rem, 2.5vw, 1.85rem);
  }

  .trust-layout {
    display: grid;
    gap: var(--space-stack-md);
  }

  .trust-header {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-stack-sm) var(--space-stack-lg);
  }

  .trust-header .section-label {
    color: var(--accent);
  }

  .trust-headline {
    max-width: 24ch;
    margin: var(--label-gap) 0 0;
    color: var(--text);
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.08;
  }

  .trust-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .trust-link span {
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .trust-link:hover span {
    transform: translateX(4px);
  }

  .trust-list {
    display: grid;
    overflow: hidden;
  }

  .trust-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.8rem;
    align-items: center;
    min-width: 0;
    color: inherit;
    padding: 0.82rem 1rem;
    transition: background var(--motion-fast) var(--ease-standard);
  }

  .trust-row + .trust-row {
    border-top: 1px solid var(--line);
  }

  .trust-row:hover {
    background: color-mix(in srgb, var(--accent-dim) 34%, transparent);
  }

  .trust-row.is-primary {
    background: color-mix(in srgb, var(--accent-dim) 22%, transparent);
  }

  .trust-row.is-primary:hover {
    background: color-mix(in srgb, var(--accent-dim) 42%, transparent);
  }

  .trust-row-copy {
    display: grid;
    gap: 0.14rem;
    min-width: 0;
  }

  .trust-row-title {
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .trust-row.is-primary .trust-row-title {
    color: var(--accent);
  }

  .trust-row-detail {
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .trust-row-arrow {
    flex-shrink: 0;
    width: 0.84rem;
    color: var(--text-soft);
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1;
    text-align: right;
    transition:
      color var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-out);
  }

  .trust-row:hover .trust-row-arrow {
    color: var(--accent);
    transform: translateX(3px);
  }

  .trust-row.is-primary .trust-row-arrow {
    color: color-mix(in srgb, var(--accent) 78%, var(--text-soft));
  }

  .trust-row.is-primary:hover .trust-row-arrow {
    color: var(--accent);
  }

  @media (max-width: 620px) {
    .trust-header {
      align-items: start;
    }

    .trust-headline {
      max-width: none;
      font-size: clamp(1.35rem, 5vw, 1.65rem);
    }

    .trust-row {
      padding: 0.75rem 0.9rem;
    }
  }
</style>