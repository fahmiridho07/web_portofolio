---
// SelectedWorkSection.astro: Dual-Mode Selected Work Gallery
// Solves the problem of invisible mobile previews and rigid text-only lists.
// Offers a Visual Showcase (rich cards with covers & stack pills) and an Editorial Index (table with hover preview).
import { heroProjectSlug } from "@data/profile";
import { getResponsiveImageSources } from "@lib/images";
import { getCategoryMeta, getSortedProjects } from "@lib/projects";

type AllProjects = Awaited<ReturnType<typeof getSortedProjects>>;
type ProjectEntry = AllProjects[number];

interface Props {
  projects: ProjectEntry[];
  totalCount: number;
}

const { projects, totalCount } = Astro.props;
---

<section id="work" class="work-section divider" data-work-section>
  <div class="container">
    <div class="work-toolbar" data-reveal>
      <div>
        <p class="section-label">Selected Work</p>
        <h2 class="work-heading">Engineered to ship.</h2>
      </div>

      <div class="toolbar-actions">
        <!-- View Mode Switcher -->
        <div
          class="view-switcher"
          role="group"
          aria-label="Work gallery display mode"
          data-view-switcher
        >
          <button
            type="button"
            class="view-btn is-active"
            data-view-mode="showcase"
            aria-pressed="true"
            title="Visual Showcase with Project Previews"
          >
            <svg
              viewBox="0 0 16 16"
              width="13"
              height="13"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm8 0A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3z"
              ></path>
            </svg>
            Showcase
          </button>
          <button
            type="button"
            class="view-btn"
            data-view-mode="index"
            aria-pressed="false"
            title="Editorial Index Table"
          >
            <svg
              viewBox="0 0 16 16"
              width="13"
              height="13"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"
              ></path>
            </svg>
            Index
          </button>
        </div>

        <a class="work-all-link" href="/projects/" data-astro-prefetch="hover">
          All {totalCount} projects <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- MODE 1: VISUAL SHOWCASE (Default) -->
    <div class="showcase-view" data-showcase-view>
      {
        projects.map((project, index) => {
          const category = getCategoryMeta(project.data.category);
          const metric = project.data.metric ?? project.data.status;
          const isFlagship = project.data.slug === heroProjectSlug;
          const image = getResponsiveImageSources(
            project.data.coverImage,
            "(max-width: 900px) 100vw, 48vw",
          );

          return (
            <article
              class:list={["showcase-card", isFlagship && "is-flagship"]}
              data-reveal
            >
              <a
                href={`/projects/${project.data.slug}/`}
                class="card-link"
                data-astro-prefetch="hover"
              >
                <div class="card-media">
                  <img
                    src={image.src}
                    srcset={image.srcset}
                    sizes={image.srcset ? image.sizes : undefined}
                    alt={`Cover preview for ${project.data.title}`}
                    width={image.width}
                    height={image.height}
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                  {isFlagship && (
                    <div class="flagship-badge">
                      <span class="flagship-dot" />
                      UNDERGRADUATE THESIS &middot; FLAGSHIP
                    </div>
                  )}
                  <div class="card-metric-pill">{metric}</div>
                </div>

                <div class="card-body">
                  <div class="card-category-line">
                    <span class="category-name">{category.title}</span>
                    <span class="card-year">&middot; {project.data.year}</span>
                  </div>

                  <h3 class="card-title">
                    {project.data.title}
                    <span class="card-arrow-icon" aria-hidden="true">
                      &nearr;
                    </span>
                  </h3>

                  <p class="card-summary">{project.data.summary}</p>

                  <div class="card-stack">
                    {project.data.stack.slice(0, 4).map((tech: string) => (
                      <span class="tech-pill">{tech}</span>
                    ))}
                    {project.data.stack.length > 4 && (
                      <span class="tech-pill-more">
                        +{project.data.stack.length - 4}
                      </span>
                    )}
                  </div>
                </div>
              </a>
            </article>
          );
        })
      }
    </div>

    <!-- MODE 2: EDITORIAL INDEX (Table) -->
    <div class="index-view" data-index-view hidden>
      <div class="work-list" data-work-list>
        {
          projects.map((project, index) => {
            const category = getCategoryMeta(project.data.category);
            const metric = project.data.metric ?? project.data.status;
            const logo = project.data.logo ?? category.logo;
            const isAnomaly = project.data.slug === heroProjectSlug;

            return (
              <a
                class:list={["work-row", isAnomaly && "is-anomaly"]}
                href={`/projects/${project.data.slug}/`}
                data-astro-prefetch="hover"
                data-work-row={String(index)}
              >
                <span class="work-index">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="work-logo" aria-hidden="true">
                  {logo && (
                    <img
                      src={logo}
                      alt=""
                      width="24"
                      height="24"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </span>
                <span class="work-copy">
                  <span class="work-title">{project.data.title}</span>
                  <span class="work-meta">
                    {category.title} &middot; {project.data.year}
                    {isAnomaly && (
                      <span class="work-flag-dot" aria-hidden="true" />
                    )}
                  </span>
                </span>
                <span class="work-metric">{metric}</span>
                <span class="work-arrow" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            );
          })
        }
      </div>

      <!-- Floating preview thumbnail (for pointer devices in table view) -->
      <div class="work-preview" data-work-preview aria-hidden="true">
        {
          projects.map((project, index) => {
            const image = getResponsiveImageSources(
              project.data.coverImage,
              "19rem",
            );
            return (
              <img
                src={image.src}
                srcset={image.srcset}
                sizes={image.srcset ? image.sizes : undefined}
                alt=""
                width={image.width}
                height={image.height}
                loading="lazy"
                decoding="async"
                data-work-preview-image={String(index)}
              />
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initOnPageLoad } from "@lib/page-script";

  initOnPageLoad(() => {
    const root = document.querySelector<HTMLElement>("[data-work-section]");
    if (!root) return;

    // View switcher
    const showcaseView = root.querySelector<HTMLElement>(
      "[data-showcase-view]",
    );
    const indexView = root.querySelector<HTMLElement>("[data-index-view]");
    const viewBtns = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-view-mode]"),
    );

    const setMode = (mode: string) => {
      viewBtns.forEach((b) => {
        const active = b.dataset.viewMode === mode;
        b.classList.toggle("is-active", active);
        b.setAttribute("aria-pressed", String(active));
      });

      if (mode === "showcase") {
        if (showcaseView) showcaseView.hidden = false;
        if (indexView) indexView.hidden = true;
      } else {
        if (showcaseView) showcaseView.hidden = true;
        if (indexView) indexView.hidden = false;
      }
    };

    viewBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        setMode(btn.dataset.viewMode || "showcase");
      });
    });

    // Floating cursor preview for index mode
    const fine = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    ).matches;
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const list = root.querySelector<HTMLElement>("[data-work-list]");
    const preview = root.querySelector<HTMLElement>("[data-work-preview]");

    if (fine && !reduceMotion && list && preview) {
      const images = Array.from(
        preview.querySelectorAll<HTMLImageElement>("[data-work-preview-image]"),
      );
      const controller = new AbortController();
      const { signal } = controller;
      let raf = 0;
      let x = 0;
      let y = 0;

      const render = () => {
        raf = 0;
        preview.style.transform = `translate3d(${x + 24}px, ${y - 90}px, 0)`;
      };

      const onMove = (event: PointerEvent) => {
        x = event.clientX;
        y = event.clientY;
        if (!raf) raf = requestAnimationFrame(render);
      };

      const onEnter = (event: Event) => {
        const row = (event.currentTarget as HTMLElement).dataset.workRow;
        images.forEach((img) => {
          img.classList.toggle(
            "is-active",
            img.dataset.workPreviewImage === row,
          );
        });
        preview.classList.add("is-visible");
      };

      const onLeave = () => {
        preview.classList.remove("is-visible");
      };

      list.addEventListener("pointermove", onMove, { signal });
      list.addEventListener("pointerleave", onLeave, { signal });
      list.querySelectorAll<HTMLElement>("[data-work-row]").forEach((row) => {
        row.addEventListener("pointerenter", onEnter, { signal });
        row.addEventListener("focus", () => onLeave(), { signal });
      });
    }
  });
</script>

<style>
  .work-section {
    padding-block: var(--space-section-before) var(--space-section-after);
    background: var(--paper);
  }

  .work-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .work-heading {
    margin: 0.5rem 0 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 470;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .toolbar-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .view-switcher {
    display: inline-flex;
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.2rem;
  }

  .view-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: none;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--ink-soft);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: all var(--motion-fast) var(--ease-standard);
  }

  .view-btn:hover {
    color: var(--ink);
  }

  .view-btn.is-active {
    background: #ffffff;
    color: var(--ink);
    box-shadow: 0 1px 3px rgba(22, 24, 29, 0.08);
  }

  .work-all-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .work-all-link:hover {
    color: var(--signal);
  }

  /* ------------------- SHOWCASE VIEW (Cards) ------------------- */
  .showcase-view {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .showcase-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-fast) var(--ease-standard);
  }

  .showcase-card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(22, 24, 29, 0.05);
  }

  /* The Flagship Card spans full width for maximum punch */
  .showcase-card.is-flagship {
    grid-column: 1 / -1;
    border-top: 3px solid var(--signal);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .is-flagship .card-link {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    align-items: stretch;
  }

  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1.65;
    background: var(--paper-soft);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .is-flagship .card-media {
    aspect-ratio: auto;
    min-height: 280px;
    border-bottom: none;
    border-right: 1px solid var(--line);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-slow) var(--ease-out);
  }

  .showcase-card:hover .card-media img {
    transform: scale(1.02);
  }

  .flagship-badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(22, 24, 29, 0.9);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-pill);
    backdrop-filter: blur(8px);
  }

  .flagship-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--signal);
  }

  .card-metric-pill {
    position: absolute;
    bottom: 0.85rem;
    left: 0.85rem;
    max-width: calc(100% - 1.7rem);
    background: rgba(247, 247, 246, 0.94);
    border: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-pill);
    backdrop-filter: blur(8px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .is-flagship .card-metric-pill {
    border-color: rgba(201, 46, 62, 0.4);
    color: var(--signal-deep);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    padding: clamp(1.2rem, 2.4vw, 1.6rem);
    flex-grow: 1;
  }

  .card-category-line {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    text-transform: uppercase;
    margin-bottom: 0.45rem;
  }

  .card-title {
    margin: 0 0 0.65rem;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.005em;
    color: var(--ink);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .is-flagship .card-title {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
  }

  .showcase-card:hover .card-title {
    color: var(--signal-deep);
  }

  .card-arrow-icon {
    font-size: 1rem;
    color: var(--ink-soft);
    transition:
      transform var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-standard);
  }

  .showcase-card:hover .card-arrow-icon {
    transform: translate(2px, -2px);
    color: var(--signal);
  }

  .card-summary {
    margin: 0 0 1.25rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--ink-muted);
    flex-grow: 1;
  }

  .card-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .tech-pill,
  .tech-pill-more {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--ink-soft);
    background: var(--paper-soft);
    border: 1px solid var(--line);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  /* ------------------- INDEX VIEW (Table) ------------------- */
  .work-list {
    display: grid;
  }

  .work-row {
    display: grid;
    grid-template-columns: 2.4rem 2.1rem minmax(0, 1fr) auto 2rem;
    gap: 1rem;
    align-items: baseline;
    border-top: 1px solid var(--line);
    margin-inline: calc(var(--space-4) * -1);
    padding-block: clamp(1.1rem, 2.6vw, 1.7rem);
    padding-inline: var(--space-4);
    transition: background var(--motion-fast) var(--ease-standard);
    color: inherit;
    text-decoration: none;
  }

  .work-row:hover,
  .work-row:focus-visible {
    background: var(--paper-soft);
  }

  .work-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .work-index {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .work-logo img {
    width: 1.6rem;
    height: 1.6rem;
    object-fit: contain;
    filter: grayscale(1) contrast(1.15);
    opacity: 0.72;
    transition: all var(--motion-fast) var(--ease-standard);
  }

  .work-row:hover .work-logo img {
    filter: grayscale(0);
    opacity: 1;
  }

  .work-copy {
    display: grid;
    gap: 0.35rem;
  }

  .work-title {
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.8vw, 2.1rem);
    font-weight: 480;
    letter-spacing: -0.005em;
    color: var(--ink);
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .work-row:hover .work-title {
    color: var(--signal-deep);
  }

  .work-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    text-transform: uppercase;
  }

  .work-flag-dot {
    display: inline-block;
    width: 0.34rem;
    height: 0.34rem;
    margin-left: 0.5rem;
    border-radius: 999px;
    background: var(--signal);
    transform: translateY(-0.06rem);
  }

  .work-metric {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    text-transform: uppercase;
    text-align: right;
  }

  .work-arrow {
    color: var(--ink-soft);
    font-size: 1rem;
    text-align: right;
    transition:
      transform var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-standard);
  }

  .work-row:hover .work-arrow {
    transform: translateX(4px);
    color: var(--signal);
  }

  .work-preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 30;
    width: clamp(15rem, 22vw, 19rem);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: #ffffff;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 200ms var(--ease-standard),
      scale 200ms var(--ease-out);
    scale: 0.96;
    will-change: transform;
  }

  .work-preview.is-visible {
    opacity: 1;
    scale: 1;
  }

  .work-preview img {
    display: none;
    width: 100%;
    aspect-ratio: 1.55;
    object-fit: cover;
  }

  .work-preview img.is-active {
    display: block;
  }

  @media (max-width: 900px) {
    .is-flagship .card-link {
      grid-template-columns: 1fr;
    }
    .is-flagship .card-media {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 720px) {
    .showcase-view {
      grid-template-columns: 1fr;
    }

    .work-row {
      grid-template-columns: 1.8rem 1.7rem minmax(0, 1fr) 1.5rem;
      gap: 0.7rem;
    }

    .work-metric {
      display: none;
    }
  }
</style>
