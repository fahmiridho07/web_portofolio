---
import CaseSnapshotHero from "@components/CaseSnapshotHero.astro";
import ProjectCard from "@components/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCaseStudyNavSections, getCaseStudySectionMap } from "@lib/case-study";
import { getCreativeWorkSchema } from "@lib/seo";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const allProjects = await getCollection("projects");
const relatedProjects = allProjects
  .filter((entry) => entry.data.slug !== project.data.slug)
  .sort((a, b) => {
    if (a.data.category === project.data.category && b.data.category !== project.data.category) {
      return -1;
    }

    if (a.data.category !== project.data.category && b.data.category === project.data.category) {
      return 1;
    }

    return a.data.priority - b.data.priority;
  })
  .slice(0, 2);
const proofItems = (
  project.data.proof && project.data.proof.length > 0
    ? project.data.proof
    : [project.data.metric ?? project.data.status, project.data.status, ...project.data.stack]
)
  .filter(Boolean)
  .slice(0, 3);
const quickReadItems = [
  {
    label: "Context",
    value: project.data.summary,
  },
  {
    label: "My role",
    value: project.data.role,
  },
  {
    label: "Result",
    value: project.data.result ?? project.data.metric ?? project.data.status,
  },
  {
    label: "Evidence",
    value: proofItems[0] ?? project.data.status,
  },
];
const siteUrl = Astro.site?.href ?? Astro.url.origin;
const projectSchema = getCreativeWorkSchema({
  site: siteUrl,
  title: project.data.title,
  description: project.data.summary,
  slug: project.data.slug,
  year: project.data.year,
  stack: project.data.stack,
});
const caseNavSections = getCaseStudyNavSections(project.body ?? "");
const caseSectionMap = getCaseStudySectionMap(project.body ?? "");
---

<BaseLayout title={project.data.title} description={project.data.summary} jsonLd={projectSchema}>
  <article>
    <CaseSnapshotHero project={project} />

    <div
      class="progress"
      role="progressbar"
      aria-label="Reading progress"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      data-case-progress-track
    >
      <span data-case-progress></span>
    </div>

    <section id="case-study" class="case-body">
      <div class="container case-body-inner">
        <nav class="case-read-nav" aria-label="Case study quick navigation">
          <a class="archive-return" href="/projects/"><span aria-hidden="true">&lt;-</span> All projects</a>
          <div class="read-flow">
            <p class="section-label">Read flow</p>
            <a href="#case-study" data-case-nav-link aria-current="location">Overview</a>
            {
              caseNavSections.map((section) => (
                <a href={`#${section.id}`} data-case-nav-link>
                  {section.label}
                </a>
              ))
            }
          </div>
        </nav>

        <div class="case-reading">
          <section class="case-brief" aria-label="Case study quick read" data-reveal>
            <div>
              <p class="section-label">Quick read</p>
              <h2>Skim the case by context, role, result, and evidence.</h2>
            </div>
            <div class="case-brief-grid">
              {
                quickReadItems.map((item) => (
                  <article>
                    <span>{item.label}</span>
                    <p>{item.value}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <div class="prose">
            <Content />
          </div>
        </div>
      </div>
    </section>
  </article>

  {
    relatedProjects.length > 0 && (
      <section class="related-section divider">
        <div class="container">
          <div class="related-heading">
            <p class="section-label">More work</p>
            <h2>Other case studies</h2>
          </div>
          <div class="related-grid">
            {relatedProjects.map((entry) => <ProjectCard project={entry} />)}
          </div>
        </div>
      </section>
    )
  }

  <section class="case-exit divider">
    <div class="container case-exit-card">
      <div>
        <p class="section-label">Project archive</p>
        <h2>Back to the full project index.</h2>
        <p>Return to all case studies and filter by modeling, automation, decision support, or analytics.</p>
      </div>
      <a href="/projects/">View all projects <span aria-hidden="true">-&gt;</span></a>
    </div>
  </section>

  <script define:vars={{ caseSectionMap }}>
    const progress = document.querySelector("[data-case-progress]");
    const progressTrack = document.querySelector("[data-case-progress-track]");
    let progressFrame = 0;

    const updateProgress = () => {
      window.cancelAnimationFrame(progressFrame);
      progressFrame = window.requestAnimationFrame(() => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const value = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
        const percent = Math.round(value * 100);
        progress?.style.setProperty("transform", `scaleX(${value})`);
        progressTrack?.setAttribute("aria-valuenow", String(percent));
        progressTrack?.classList.toggle("is-active", percent > 2 && percent < 98);
      });
    };

    updateProgress();
    window.addEventListener("scroll", updateProgress, { passive: true });
    window.addEventListener("resize", updateProgress);

    document.querySelectorAll(".prose h2").forEach((heading) => {
      const label = heading.textContent?.trim();
      const section = caseSectionMap.find((item) => item.label === label);

      if (section && !document.getElementById(section.id)) {
        heading.id = section.id;
      }
    });

    const readLinks = Array.from(document.querySelectorAll("[data-case-nav-link]"));
    const sections = readLinks
      .map((link) => {
        const id = link.hash.slice(1);
        const section = document.getElementById(id);
        return section ? { id, link, section } : null;
      })
      .filter(Boolean);

    const setActiveSection = (activeId) => {
      readLinks.forEach((link) => {
        const isActive = link.hash === `#${activeId}`;
        link.toggleAttribute("aria-current", isActive);

        if (isActive) {
          link.setAttribute("aria-current", "location");
        }
      });
    };

    const updateActiveSection = () => {
      const anchorLine = window.innerHeight * 0.28;
      const active = sections.reduce((current, item) => {
        if (!item) {
          return current;
        }

        const rect = item.section.getBoundingClientRect();
        return rect.top <= anchorLine ? item : current;
      }, sections[0]);

      if (active) {
        setActiveSection(active.id);
      }
    };

    if ("IntersectionObserver" in window) {
      const sectionObserver = new IntersectionObserver(updateActiveSection, {
        rootMargin: "-22% 0px -64% 0px",
        threshold: [0, 0.25, 0.7],
      });

      sections.forEach((item) => item && sectionObserver.observe(item.section));
    }

    updateActiveSection();
    window.addEventListener("scroll", updateActiveSection, { passive: true });
    window.addEventListener("resize", updateActiveSection);
  </script>
</BaseLayout>

<style>
  .progress {
    position: sticky;
    top: 3.8rem;
    z-index: 45;
    height: 3px;
    overflow: hidden;
    background: rgba(226, 232, 240, 0.18);
    opacity: 0.86;
    transition:
      opacity var(--motion-fast) var(--ease-standard),
      height var(--motion-fast) var(--ease-standard);
  }

  .progress.is-active {
    opacity: 1;
  }

  .progress span {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #9be7d4, #7dd3fc, #d8a238);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 90ms linear;
  }

  .progress span::after {
    position: absolute;
    top: 50%;
    right: 0;
    width: 4.5rem;
    height: 1rem;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.72), transparent 62%);
    content: "";
    transform: translate(50%, -50%);
    opacity: 0.7;
  }

  .case-body,
  .related-section,
  .case-exit {
    background:
      radial-gradient(circle at 0% 0%, rgba(125, 211, 252, 0.06), transparent 24rem),
      var(--surface-light);
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .case-body-inner {
    display: grid;
    grid-template-columns: minmax(9rem, 0.22fr) minmax(0, 860px);
    gap: clamp(1.4rem, 5vw, 4rem);
    align-items: start;
  }

  .case-read-nav {
    position: sticky;
    top: 5rem;
    display: grid;
    gap: 0.95rem;
    min-width: 0;
  }

  .read-flow {
    display: grid;
    gap: 0.42rem;
  }

  .read-flow .section-label {
    margin: 0 0 0.08rem;
  }

  .case-read-nav a {
    display: inline-flex;
    width: fit-content;
    border: 1px solid rgba(17, 24, 39, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.58);
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.5rem 0.68rem;
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      background var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-out);
  }

  .case-read-nav a:hover {
    border-color: rgba(15, 159, 135, 0.22);
    color: var(--accent);
    transform: translateX(2px);
  }

  .case-read-nav a[aria-current="location"] {
    border-color: rgba(15, 159, 135, 0.26);
    background:
      linear-gradient(135deg, rgba(15, 159, 135, 0.14), rgba(125, 211, 252, 0.1)),
      rgba(255, 255, 255, 0.76);
    color: var(--text);
    box-shadow: 0 8px 24px rgba(15, 159, 135, 0.08);
  }

  .archive-return {
    border-color: rgba(15, 159, 135, 0.2) !important;
    background: rgba(15, 159, 135, 0.1) !important;
    color: #0f766e !important;
  }

  .archive-return span,
  .case-exit-card a span {
    display: inline-block;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .archive-return:hover span {
    transform: translateX(-3px);
  }

  .case-reading,
  .prose {
    max-width: 860px;
    min-width: 0;
  }

  .case-reading {
    display: grid;
    gap: clamp(1.4rem, 3vw, 2.2rem);
  }

  .case-brief {
    display: grid;
    gap: 1rem;
    border: 1px solid rgba(17, 24, 39, 0.12);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.78), rgba(232, 238, 247, 0.54)),
      rgba(255, 255, 255, 0.72);
    box-shadow: 0 16px 48px rgba(17, 24, 39, 0.055);
    padding: clamp(1rem, 2.5vw, 1.35rem);
  }

  .case-brief h2 {
    max-width: 620px;
    margin: 0.52rem 0 0;
    color: var(--text);
    font-size: clamp(1.25rem, 2.2vw, 1.8rem);
    font-weight: 600;
    line-height: 1.08;
  }

  .case-brief-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid rgba(17, 24, 39, 0.08);
    border-radius: 8px;
    background: rgba(17, 24, 39, 0.08);
  }

  .case-brief-grid article {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    min-height: 8.5rem;
    background: rgba(255, 255, 255, 0.72);
    padding: 0.9rem;
  }

  .case-brief-grid span {
    color: var(--text-soft);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.68rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .case-brief-grid p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--text);
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  .related-heading {
    display: grid;
    gap: 0.65rem;
    margin-bottom: 1.5rem;
  }

  .related-heading h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.05;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 1.5rem);
  }

  .case-exit {
    padding-block-start: clamp(2.5rem, 5vw, 4rem);
  }

  .case-exit-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    border: 1px solid rgba(17, 24, 39, 0.12);
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(15, 159, 135, 0.08), rgba(125, 211, 252, 0.07)),
      rgba(255, 255, 255, 0.72);
    box-shadow: 0 16px 48px rgba(17, 24, 39, 0.055);
    padding: clamp(1rem, 2.5vw, 1.35rem);
  }

  .case-exit-card h2,
  .case-exit-card p {
    margin: 0;
  }

  .case-exit-card h2 {
    margin-top: 0.5rem;
    color: var(--text);
    font-size: clamp(1.3rem, 2.3vw, 2rem);
    font-weight: 600;
    line-height: 1.08;
  }

  .case-exit-card p:not(.section-label) {
    max-width: 52rem;
    margin-top: 0.55rem;
    color: var(--text-muted);
  }

  .case-exit-card a {
    display: inline-flex;
    min-height: 2.55rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(15, 159, 135, 0.22);
    border-radius: 999px;
    background: var(--accent);
    color: #ffffff;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.78rem 1rem;
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      background var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-out);
  }

  .case-exit-card a:hover {
    box-shadow: 0 12px 28px rgba(15, 159, 135, 0.14);
    transform: translateY(-1px);
  }

  .case-exit-card a:hover span {
    transform: translateX(3px);
  }

  @media (max-width: 820px) {
    .case-body-inner {
      grid-template-columns: 1fr;
    }

    .case-read-nav {
      position: static;
      display: flex;
      flex-wrap: wrap;
    }

    .read-flow {
      display: flex;
      flex: 1 1 100%;
      flex-wrap: wrap;
      gap: 0.42rem;
    }

    .read-flow .section-label {
      flex: 1 1 100%;
    }

    .case-brief-grid,
    .case-exit-card {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .case-body,
    .related-section,
    .case-exit {
      padding-block: 3.25rem;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }

    .case-brief-grid article {
      min-height: auto;
    }

    .case-exit-card a {
      justify-self: start;
    }
  }
</style>
