---
import CaseSnapshotHero from "@components/CaseSnapshotHero.astro";
import ContentImage from "@components/ContentImage.astro";
import ProjectVisualMetaphor from "@components/ProjectVisualMetaphor.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getImageMeta } from "@lib/images";
import {
  getBreadcrumbSchema,
  getCreativeWorkSchema,
  getProjectOpenGraph,
} from "@lib/seo";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const allProjects = await getCollection("projects");
const relatedProjects = allProjects
  .filter((entry) => entry.data.slug !== project.data.slug)
  .sort((a, b) => {
    if (
      a.data.category === project.data.category &&
      b.data.category !== project.data.category
    ) {
      return -1;
    }

    if (
      a.data.category !== project.data.category &&
      b.data.category === project.data.category
    ) {
      return 1;
    }

    return a.data.priority - b.data.priority;
  })
  .slice(0, 2);

const siteUrl = Astro.site?.href ?? Astro.url.origin;
const projectOg = getProjectOpenGraph(project.data);
const projectOgImage = getImageMeta(project.data.coverImage);
const projectSchema = getCreativeWorkSchema({
  site: siteUrl,
  title: project.data.title,
  description: project.data.summary,
  slug: project.data.slug,
  year: project.data.year,
  stack: project.data.stack,
  imagePath: project.data.coverImage,
});
const breadcrumbSchema = getBreadcrumbSchema(siteUrl, [
  { name: "Home", path: "/" },
  { name: "Projects", path: "/projects/" },
  { name: project.data.title, path: `/projects/${project.data.slug}/` },
]);
const articlePublishedTime = `${project.data.year}-01-01T00:00:00.000Z`;
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
  jsonLd={[projectSchema, breadcrumbSchema]}
  ogType="article"
  articlePublishedTime={articlePublishedTime}
  ogImagePath={projectOg.imagePath}
  ogImageAlt={projectOg.imageAlt}
  ogImageWidth={projectOgImage?.width}
  ogImageHeight={projectOgImage?.height}
>
  <article class="project-editorial-showcase">
    {/* 01. 3D KINETIC HERO SHOWCASE */}
    <CaseSnapshotHero project={project} />

    {/* 02. SYSTEM BLUEPRINT & VISUAL EVIDENCE */}
    <section id="visual-evidence" class="visual-exhibit-section divider">
      <div class="container">
        <div class="exhibit-header" data-reveal>
          <p class="section-label">Visual Exhibit</p>
          <h2 class="exhibit-title">System Blueprint &amp; Verification.</h2>
          <p class="exhibit-subhead">
            Algorithmic mechanism and measured empirical evidence from the
            shipped system.
          </p>
        </div>

        <div class="exhibit-metaphor-shell" data-reveal data-reveal-delay="40">
          <ProjectVisualMetaphor slug={project.data.slug} mode="stage" />
        </div>
      </div>
    </section>

    {/* 03. THE TRIAD: 3 VERIFIED TAKEAWAYS (CLEAN & MINIMAL) */}
    {
      project.data.proof && project.data.proof.length > 0 && (
        <section class="triad-section divider">
          <div class="container">
            <div class="triad-header" data-reveal>
              <p class="section-label">Engineering Takeaways</p>
              <h2 class="triad-title">Key Pillars &amp; Findings.</h2>
            </div>

            <div class="triad-grid" data-reveal data-reveal-delay="40">
              {project.data.proof.map((proofPoint, idx) => (
                <div class="triad-card">
                  <span class="triad-idx">0{idx + 1}</span>
                  <p class="triad-desc">{proofPoint}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {/* 04. DISCREET TECHNICAL SPEC DRAWER (FOR TECHNICAL EVALUATORS) */}
    <section class="technical-drawer-section divider">
      <div class="container">
        <details class="academic-drawer" id="methodology-notes">
          <summary class="drawer-summary">
            <div class="summary-left">
              <span class="drawer-bullet" aria-hidden="true">&plus;</span>
              <span class="drawer-title"
                >Technical Specification &amp; Methodology Notes</span
              >
            </div>
            <span class="drawer-hint">Expand paper spec</span>
          </summary>

          <div class="drawer-body">
            <div class="prose">
              <Content components={{ img: ContentImage }} />
            </div>
          </div>
        </details>
      </div>
    </section>
  </article>

  {/* 05. RELATED WORK */}
  {
    relatedProjects.length > 0 && (
      <section class="related-section divider">
        <div class="container">
          <div class="related-heading">
            <p class="section-label">More work</p>
            <h2>Related builds.</h2>
          </div>
          <div class="related-list">
            {relatedProjects.map((entry) => (
              <a
                class="related-row"
                href={`/projects/${entry.data.slug}/`}
                data-astro-prefetch="hover"
              >
                <span class="related-title">{entry.data.title}</span>
                <span class="related-meta">
                  {entry.data.metric ?? entry.data.status}
                </span>
                <span class="related-arrow" aria-hidden="true">
                  -&gt;
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* 06. ARCHIVE RETURN */}
  <section class="case-exit divider">
    <div class="container case-exit-card">
      <div>
        <p class="section-label">Archive</p>
        <h2>All projects.</h2>
      </div>
      <a href="/projects/" data-astro-prefetch="hover"
        >View index <span aria-hidden="true">-&gt;</span></a
      >
    </div>
  </section>

  <script>
    import { initOnPageLoad } from "@lib/page-script";

    initOnPageLoad(() => {
      const drawer =
        document.querySelector<HTMLDetailsElement>("#methodology-notes");
      if (!drawer) return;

      const hint = drawer.querySelector<HTMLElement>(".drawer-hint");

      drawer.addEventListener("toggle", () => {
        if (hint) {
          hint.textContent = drawer.open
            ? "Collapse paper spec"
            : "Expand paper spec";
        }
      });

      // Auto open if linked directly with #methodology-notes
      if (window.location.hash === "#methodology-notes") {
        drawer.open = true;
      }
    });
  </script>
</BaseLayout>

<style>
  .project-editorial-showcase {
    background: var(--paper);
  }

  /* ---------------------- Visual Exhibit Section ---------------------- */
  .visual-exhibit-section {
    background: var(--paper);
    padding-block: var(--space-section-before) var(--space-section-after);
  }

  .exhibit-header {
    display: grid;
    gap: 0.5rem;
    max-width: 680px;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .exhibit-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    font-weight: 480;
    line-height: 1.15;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .exhibit-subhead {
    margin: 0;
    color: var(--ink-muted);
    font-size: clamp(0.95rem, 1.3vw, 1.05rem);
    line-height: 1.6;
  }

  .exhibit-metaphor-shell {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: clamp(1.25rem, 2.5vw, 2rem);
  }

  /* ---------------------- The Triad Section (Key Takeaways) ---------------------- */
  .triad-section {
    background: var(--paper);
    padding-block: var(--space-section-before) var(--space-section-after);
  }

  .triad-header {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .triad-title {
    margin: 0.4rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    font-weight: 480;
    line-height: 1.15;
    color: var(--ink);
  }

  .triad-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .triad-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .triad-idx {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--signal-deep);
    letter-spacing: 0.08em;
  }

  .triad-desc {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  /* ---------------------- Discreet Technical Drawer ---------------------- */
  .technical-drawer-section {
    background: var(--paper);
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .academic-drawer {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper-soft);
    overflow: hidden;
    transition: background var(--motion-fast) var(--ease-standard);
  }

  .academic-drawer[open] {
    background: #ffffff;
  }

  .drawer-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.4rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .drawer-summary::-webkit-details-marker {
    display: none;
  }

  .drawer-summary:hover {
    color: var(--signal-deep);
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .drawer-bullet {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--signal);
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .academic-drawer[open] .drawer-bullet {
    transform: rotate(45deg);
  }

  .drawer-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ink);
  }

  .drawer-hint {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .drawer-body {
    border-top: 1px solid var(--line);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: #ffffff;
  }

  .prose {
    max-width: 820px;
    margin-inline: auto;
  }

  /* ---------------------- Related & Exit Sections ---------------------- */
  .related-section,
  .case-exit {
    background: var(--paper);
    padding-block: var(--space-section-before) var(--space-section-after);
  }

  .related-heading {
    display: grid;
    gap: var(--label-gap);
    margin-bottom: var(--space-stack-lg);
  }

  .related-heading h2 {
    margin: var(--label-gap) 0 0;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 480;
    line-height: 1.15;
  }

  .related-list {
    display: grid;
  }

  .related-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 1.5rem;
    gap: 1rem;
    align-items: baseline;
    border-top: 1px solid var(--line);
    padding-block: 1rem;
  }

  .related-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .related-title {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 490;
    line-height: 1.25;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .related-meta {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.4;
    text-align: right;
  }

  .related-arrow {
    color: var(--ink-soft);
    text-align: right;
    transition:
      color var(--motion-fast) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
  }

  .related-row:hover .related-title {
    color: var(--rust-deep);
  }

  .related-row:hover .related-arrow {
    color: var(--rust);
    transform: translateX(3px);
  }

  .case-exit {
    padding-block-start: var(--space-section-tight);
  }

  .case-exit-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: baseline;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(1rem, 2.4vw, 1.5rem);
  }

  .case-exit-card h2 {
    margin: var(--label-gap) 0 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.3vw, 1.8rem);
    font-weight: 480;
    line-height: 1.15;
  }

  .case-exit-card a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    color: var(--ink-muted);
    font-size: 0.84rem;
    font-weight: 500;
    line-height: 1;
    transition:
      color var(--motion-fast) var(--ease-standard),
      background var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-out);
  }

  .case-exit-card a:hover {
    color: var(--rust);
  }

  .case-exit-card a:hover span {
    transform: translateX(3px);
  }

  @media (max-width: 860px) {
    .triad-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .case-exit-card {
      grid-template-columns: 1fr;
    }

    .case-exit-card a {
      justify-self: start;
    }
  }

  @media (max-width: 640px) {
    .related-row {
      grid-template-columns: minmax(0, 1fr) 1.5rem;
      grid-template-areas:
        "title arrow"
        "meta arrow";
      gap: 0.35rem 0.75rem;
    }

    .related-title {
      grid-area: title;
    }

    .related-meta {
      grid-area: meta;
      text-align: left;
    }

    .related-arrow {
      grid-area: arrow;
      align-self: center;
    }

    .summary-left {
      flex-wrap: wrap;
      gap: 0.4rem;
    }
  }
</style>
