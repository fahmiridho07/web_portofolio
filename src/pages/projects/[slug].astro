---
import CaseSnapshotHero from "@components/CaseSnapshotHero.astro";
import ContentImage from "@components/ContentImage.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  getCaseStudyNavSections,
  getCaseStudySectionMap,
} from "@lib/case-study";
import { getImageMeta } from "@lib/images";
import {
  getBreadcrumbSchema,
  getCreativeWorkSchema,
  getProjectOpenGraph,
} from "@lib/seo";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const allProjects = await getCollection("projects");
const relatedProjects = allProjects
  .filter((entry) => entry.data.slug !== project.data.slug)
  .sort((a, b) => {
    if (
      a.data.category === project.data.category &&
      b.data.category !== project.data.category
    ) {
      return -1;
    }

    if (
      a.data.category !== project.data.category &&
      b.data.category === project.data.category
    ) {
      return 1;
    }

    return a.data.priority - b.data.priority;
  })
  .slice(0, 2);
const siteUrl = Astro.site?.href ?? Astro.url.origin;
const projectOg = getProjectOpenGraph(project.data);
const projectOgImage = getImageMeta(project.data.coverImage);
const projectSchema = getCreativeWorkSchema({
  site: siteUrl,
  title: project.data.title,
  description: project.data.summary,
  slug: project.data.slug,
  year: project.data.year,
  stack: project.data.stack,
  imagePath: project.data.coverImage,
});
const breadcrumbSchema = getBreadcrumbSchema(siteUrl, [
  { name: "Home", path: "/" },
  { name: "Projects", path: "/projects/" },
  { name: project.data.title, path: `/projects/${project.data.slug}/` },
]);
const articlePublishedTime = `${project.data.year}-01-01T00:00:00.000Z`;
const caseNavSections = getCaseStudyNavSections(project.body ?? "");
const caseSectionMap = getCaseStudySectionMap(project.body ?? "");
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
  jsonLd={[projectSchema, breadcrumbSchema]}
  ogType="article"
  articlePublishedTime={articlePublishedTime}
  ogImagePath={projectOg.imagePath}
  ogImageAlt={projectOg.imageAlt}
  ogImageWidth={projectOgImage?.width}
  ogImageHeight={projectOgImage?.height}
>
  <article data-case-sections={JSON.stringify(caseSectionMap)}>
    <CaseSnapshotHero project={project} />

    <div
      class="progress"
      role="progressbar"
      aria-label="Reading progress"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      data-case-progress-track
    >
      <span data-case-progress></span>
    </div>

    <section id="case-study" class="case-body">
      <div class="container case-body-inner">
        <nav class="case-read-nav" aria-label="Case study quick navigation">
          <a
            class="archive-return"
            href="/projects/"
            data-astro-prefetch="hover"
            ><span aria-hidden="true">&lt;-</span> All projects</a
          >
          <div class="read-flow">
            <p class="section-label">Read flow</p>
            <a
              class="read-flow-link"
              href="#case-study"
              data-case-nav-link
              aria-current="location">Overview</a
            >
            {
              caseNavSections.map((section) => (
                <a
                  class="read-flow-link"
                  href={`#${section.id}`}
                  data-case-nav-link
                >
                  {section.label}
                </a>
              ))
            }
          </div>
        </nav>

        <div class="case-reading">
          <div class="case-deep-dive" data-reveal>
            <div class="prose">
              <Content components={{ img: ContentImage }} />
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>

  {
    relatedProjects.length > 0 && (
      <section class="related-section divider">
        <div class="container">
          <div class="related-heading">
            <p class="section-label">More work</p>
            <h2>Related builds.</h2>
          </div>
          <div class="related-list">
            {relatedProjects.map((entry) => (
              <a
                class="related-row"
                href={`/projects/${entry.data.slug}/`}
                data-astro-prefetch="hover"
              >
                <span class="related-title">{entry.data.title}</span>
                <span class="related-meta">
                  {entry.data.metric ?? entry.data.status}
                </span>
                <span class="related-arrow" aria-hidden="true">
                  -&gt;
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="case-exit divider">
    <div class="container case-exit-card">
      <div>
        <p class="section-label">Archive</p>
        <h2>All projects.</h2>
      </div>
      <a href="/projects/" data-astro-prefetch="hover"
        >View index <span aria-hidden="true">-&gt;</span></a
      >
    </div>
  </section>

  <script>
    import type { CaseStudySection } from "@lib/case-study";
    import { initOnPageLoad } from "@lib/page-script";

    initOnPageLoad(() => {
      const caseRoot = document.querySelector<HTMLElement>(
        "[data-case-sections]",
      );
      const caseSectionMap: CaseStudySection[] = caseRoot?.dataset.caseSections
        ? JSON.parse(caseRoot.dataset.caseSections)
        : [];

      const progress = document.querySelector<HTMLElement>(
        "[data-case-progress]",
      );
      const progressTrack = document.querySelector<HTMLElement>(
        "[data-case-progress-track]",
      );
      const controller = new AbortController();
      const { signal } = controller;
      let progressFrame = 0;

      const updateProgress = () => {
        window.cancelAnimationFrame(progressFrame);
        progressFrame = window.requestAnimationFrame(() => {
          const max =
            document.documentElement.scrollHeight - window.innerHeight;
          const value = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
          const percent = Math.round(value * 100);
          progress?.style.setProperty("transform", `scaleX(${value})`);
          progressTrack?.setAttribute("aria-valuenow", String(percent));
          progressTrack?.classList.toggle(
            "is-active",
            percent > 2 && percent < 98,
          );
        });
      };

      document
        .querySelectorAll<HTMLHeadingElement>(".prose h2")
        .forEach((heading) => {
          const label = heading.textContent?.trim();
          const section = caseSectionMap.find((item) => item.label === label);

          if (section && !document.getElementById(section.id)) {
            heading.id = section.id;
          }
        });

      const readLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("[data-case-nav-link]"),
      );
      const sections = readLinks
        .map((link) => {
          const id = link.hash.slice(1);
          const section = document.getElementById(id);
          return section ? { id, link, section } : null;
        })
        .filter(
          (
            item,
          ): item is {
            id: string;
            link: HTMLAnchorElement;
            section: HTMLElement;
          } => Boolean(item),
        );

      const setActiveSection = (activeId: string) => {
        readLinks.forEach((link) => {
          const isActive = link.hash === `#${activeId}`;

          if (isActive) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };

      const updateActiveSection = () => {
        const anchorLine = window.innerHeight * 0.28;
        const active = sections.reduce<(typeof sections)[number] | null>(
          (current, item) => {
            const rect = item.section.getBoundingClientRect();
            return rect.top <= anchorLine ? item : current;
          },
          sections[0] ?? null,
        );

        if (active) {
          setActiveSection(active.id);
        }
      };

      let sectionObserver: IntersectionObserver | undefined;

      if ("IntersectionObserver" in window) {
        sectionObserver = new IntersectionObserver(updateActiveSection, {
          rootMargin: "-22% 0px -64% 0px",
          threshold: [0, 0.25, 0.7],
        });

        sections.forEach((item) => sectionObserver?.observe(item.section));
      }

      updateProgress();
      updateActiveSection();
      window.addEventListener("scroll", updateProgress, {
        passive: true,
        signal,
      });
      window.addEventListener("resize", updateProgress, { signal });
      window.addEventListener("scroll", updateActiveSection, {
        passive: true,
        signal,
      });
      window.addEventListener("resize", updateActiveSection, { signal });

      return () => {
        controller.abort();
        window.cancelAnimationFrame(progressFrame);
        sectionObserver?.disconnect();
      };
    });
  </script>
</BaseLayout>

<style>
  .progress {
    position: sticky;
    top: 3.55rem;
    z-index: 45;
    height: 2px;
    overflow: hidden;
    background: var(--line);
    transition: opacity var(--motion-fast) var(--ease-standard);
  }

  .progress span {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    background: var(--rust);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 90ms linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .progress {
      display: none;
    }
  }

  .case-body,
  .related-section,
  .case-exit {
    background: var(--paper);
    padding-block: var(--space-section-before) var(--space-section-after);
  }

  .case-body-inner {
    display: grid;
    grid-template-columns: minmax(9rem, 0.22fr) minmax(0, 860px);
    gap: var(--gap-grid-lg);
    align-items: start;
  }

  .case-read-nav {
    position: sticky;
    top: 5rem;
    display: grid;
    gap: var(--space-stack-md);
    min-width: 0;
  }

  .read-flow {
    display: grid;
    gap: var(--space-stack-xs);
  }

  .read-flow .section-label {
    margin: 0 0 0.08rem;
  }

  .read-flow-link {
    display: inline-flex;
    width: fit-content;
    border-left: 1.5px solid transparent;
    color: var(--ink-soft);
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.2;
    padding: 0.28rem 0 0.28rem 0.7rem;
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .read-flow-link:hover {
    border-left-color: var(--line-strong);
    color: var(--ink);
  }

  .read-flow-link[aria-current="location"] {
    border-left-color: var(--rust);
    color: var(--rust-deep);
  }

  .archive-return {
    display: inline-flex;
    width: fit-content;
    align-items: baseline;
    gap: 0.35rem;
    color: var(--ink-muted);
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1;
    padding-block: 0.25rem;
  }

  .archive-return:hover {
    color: var(--rust);
  }

  .archive-return span,
  .case-exit-card a span {
    display: inline-block;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .archive-return:hover span {
    transform: translateX(-3px);
  }

  .case-reading,
  .prose {
    max-width: 860px;
    min-width: 0;
  }

  .case-reading {
    display: grid;
    gap: var(--gap-grid-lg);
  }

  .case-deep-dive {
    display: grid;
    gap: var(--space-stack-md);
  }

  .related-heading {
    display: grid;
    gap: var(--label-gap);
    margin-bottom: var(--space-stack-lg);
  }

  .related-heading h2 {
    margin: var(--label-gap) 0 0;
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 480;
    line-height: 1.15;
  }

  .related-list {
    display: grid;
  }

  .related-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 1.5rem;
    gap: 1rem;
    align-items: baseline;
    border-top: 1px solid var(--line);
    padding-block: 1rem;
  }

  .related-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .related-title {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 490;
    line-height: 1.25;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .related-meta {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.4;
    text-align: right;
  }

  .related-arrow {
    color: var(--ink-soft);
    text-align: right;
    transition:
      color var(--motion-fast) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
  }

  .related-row:hover .related-title {
    color: var(--rust-deep);
  }

  .related-row:hover .related-arrow {
    color: var(--rust);
    transform: translateX(3px);
  }

  .case-exit {
    padding-block-start: var(--space-section-tight);
  }

  .case-exit-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: baseline;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(1rem, 2.4vw, 1.5rem);
  }

  .case-exit-card h2 {
    margin: var(--label-gap) 0 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.3vw, 1.8rem);
    font-weight: 480;
    line-height: 1.15;
  }

  .case-exit-card a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    color: var(--ink-muted);
    font-size: 0.84rem;
    font-weight: 500;
    line-height: 1;
    transition:
      color var(--motion-fast) var(--ease-standard),
      background var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-out);
  }

  .case-exit-card a:hover {
    color: var(--rust);
  }

  .case-exit-card a:hover span {
    transform: translateX(3px);
  }

  @media (max-width: 820px) {
    .case-body-inner {
      grid-template-columns: 1fr;
    }

    .case-read-nav {
      position: static;
      display: flex;
      flex-wrap: wrap;
    }

    .read-flow {
      display: flex;
      flex: 1 1 100%;
      flex-wrap: wrap;
      gap: 0.42rem;
    }

    .read-flow .section-label {
      flex: 1 1 100%;
    }

    .case-exit-card {
      grid-template-columns: 1fr;
    }

    .read-flow-link {
      border-left: 0;
      border-bottom: 1.5px solid transparent;
      padding: 0.25rem 0;
      margin-right: 0.9rem;
    }

    .read-flow-link:hover {
      border-bottom-color: var(--line-strong);
    }

    .read-flow-link[aria-current="location"] {
      border-bottom-color: var(--rust);
    }
  }

  @media (max-width: 760px) {
    .case-brief-grid article {
      min-height: auto;
    }

    .case-exit-card a {
      justify-self: start;
    }
  }
</style>
