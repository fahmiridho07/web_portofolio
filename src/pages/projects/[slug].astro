---
import CaseSnapshotHero from "@components/CaseSnapshotHero.astro";
import ContentImage from "@components/ContentImage.astro";
import ProjectCard from "@components/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCaseStudyNavSections, getCaseStudySectionMap } from "@lib/case-study";
import { getImageMeta } from "@lib/images";
import {
  getBreadcrumbSchema,
  getCreativeWorkSchema,
  getProjectOpenGraph,
} from "@lib/seo";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const allProjects = await getCollection("projects");
const relatedProjects = allProjects
  .filter((entry) => entry.data.slug !== project.data.slug)
  .sort((a, b) => {
    if (a.data.category === project.data.category && b.data.category !== project.data.category) {
      return -1;
    }

    if (a.data.category !== project.data.category && b.data.category === project.data.category) {
      return 1;
    }

    return a.data.priority - b.data.priority;
  })
  .slice(0, 2);
const proofItems = (
  project.data.proof && project.data.proof.length > 0
    ? project.data.proof
    : [project.data.metric ?? project.data.status, project.data.status, ...project.data.stack]
)
  .filter(Boolean)
  .slice(0, 3);
const quickReadItems = [
  {
    label: "Context",
    value: project.data.summary,
  },
  {
    label: "My role",
    value: project.data.role,
  },
  {
    label: "Result",
    value: project.data.result ?? project.data.metric ?? project.data.status,
  },
  {
    label: "Evidence",
    value: proofItems[0] ?? project.data.status,
  },
];
const siteUrl = Astro.site?.href ?? Astro.url.origin;
const projectOg = getProjectOpenGraph(project.data);
const projectOgImage = getImageMeta(project.data.coverImage);
const projectSchema = getCreativeWorkSchema({
  site: siteUrl,
  title: project.data.title,
  description: project.data.summary,
  slug: project.data.slug,
  year: project.data.year,
  stack: project.data.stack,
  imagePath: project.data.coverImage,
});
const breadcrumbSchema = getBreadcrumbSchema(siteUrl, [
  { name: "Home", path: "/" },
  { name: "Projects", path: "/projects/" },
  { name: project.data.title, path: `/projects/${project.data.slug}/` },
]);
const articlePublishedTime = `${project.data.year}-01-01T00:00:00.000Z`;
const caseNavSections = getCaseStudyNavSections(project.body ?? "");
const caseSectionMap = getCaseStudySectionMap(project.body ?? "");
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
  jsonLd={[projectSchema, breadcrumbSchema]}
  ogType="article"
  articlePublishedTime={articlePublishedTime}
  ogImagePath={projectOg.imagePath}
  ogImageAlt={projectOg.imageAlt}
  ogImageWidth={projectOgImage?.width}
  ogImageHeight={projectOgImage?.height}
>
  <article data-case-sections={JSON.stringify(caseSectionMap)}>
    <CaseSnapshotHero project={project} />

    <div
      class="progress"
      role="progressbar"
      aria-label="Reading progress"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      data-case-progress-track
    >
      <span data-case-progress></span>
    </div>

    <section id="case-study" class="case-body">
      <div class="container case-body-inner">
        <nav class="case-read-nav" aria-label="Case study quick navigation">
          <a class="archive-return" href="/projects/" data-astro-prefetch="hover"><span aria-hidden="true">&lt;-</span> All projects</a>
          <div class="read-flow">
            <p class="section-label">Read flow</p>
            <a class="glass-chip" href="#case-study" data-case-nav-link aria-current="location">Overview</a>
            {
              caseNavSections.map((section) => (
                <a class="glass-chip" href={`#${section.id}`} data-case-nav-link>
                  {section.label}
                </a>
              ))
            }
          </div>
        </nav>

        <div class="case-reading">
          <section class="case-brief glass-panel" aria-label="Case study summary" data-reveal>
            <div class="case-brief-grid">
              {
                quickReadItems.map((item) => (
                  <article>
                    <span>{item.label}</span>
                    <p>{item.value}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <div class="case-deep-dive" data-reveal>
            <p class="section-label">Deep dive</p>
            <div class="prose">
              <Content components={{ img: ContentImage }} />
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>

  {
    relatedProjects.length > 0 && (
      <section class="related-section divider">
        <div class="container">
          <div class="related-heading">
            <p class="section-label">More work</p>
            <h2>Related builds.</h2>
          </div>
          <div class="related-grid">
            {relatedProjects.map((entry) => <ProjectCard project={entry} />)}
          </div>
        </div>
      </section>
    )
  }

  <section class="case-exit divider">
    <div class="container case-exit-card">
      <div>
        <p class="section-label">Archive</p>
        <h2>All projects.</h2>
      </div>
      <a href="/projects/" data-astro-prefetch="hover">View index <span aria-hidden="true">-&gt;</span></a>
    </div>
  </section>

  <script>
    import type { CaseStudySection } from "@lib/case-study";
    import { initOnPageLoad } from "@lib/page-script";

    initOnPageLoad(() => {
      const caseRoot = document.querySelector<HTMLElement>("[data-case-sections]");
      const caseSectionMap: CaseStudySection[] = caseRoot?.dataset.caseSections
        ? JSON.parse(caseRoot.dataset.caseSections)
        : [];

      const progress = document.querySelector<HTMLElement>("[data-case-progress]");
      const progressTrack = document.querySelector<HTMLElement>("[data-case-progress-track]");
      const controller = new AbortController();
      const { signal } = controller;
      let progressFrame = 0;

      const updateProgress = () => {
        window.cancelAnimationFrame(progressFrame);
        progressFrame = window.requestAnimationFrame(() => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const value = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
          const percent = Math.round(value * 100);
          progress?.style.setProperty("transform", `scaleX(${value})`);
          progressTrack?.setAttribute("aria-valuenow", String(percent));
          progressTrack?.classList.toggle("is-active", percent > 2 && percent < 98);
        });
      };

      document.querySelectorAll<HTMLHeadingElement>(".prose h2").forEach((heading) => {
        const label = heading.textContent?.trim();
        const section = caseSectionMap.find((item) => item.label === label);

        if (section && !document.getElementById(section.id)) {
          heading.id = section.id;
        }
      });

      const readLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-case-nav-link]"));
      const sections = readLinks
        .map((link) => {
          const id = link.hash.slice(1);
          const section = document.getElementById(id);
          return section ? { id, link, section } : null;
        })
        .filter((item): item is { id: string; link: HTMLAnchorElement; section: HTMLElement } =>
          Boolean(item),
        );

      const setActiveSection = (activeId: string) => {
        readLinks.forEach((link) => {
          const isActive = link.hash === `#${activeId}`;

          if (isActive) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };

      const updateActiveSection = () => {
        const anchorLine = window.innerHeight * 0.28;
        const active = sections.reduce<(typeof sections)[number] | null>((current, item) => {
          const rect = item.section.getBoundingClientRect();
          return rect.top <= anchorLine ? item : current;
        }, sections[0] ?? null);

        if (active) {
          setActiveSection(active.id);
        }
      };

      let sectionObserver: IntersectionObserver | undefined;

      if ("IntersectionObserver" in window) {
        sectionObserver = new IntersectionObserver(updateActiveSection, {
          rootMargin: "-22% 0px -64% 0px",
          threshold: [0, 0.25, 0.7],
        });

        sections.forEach((item) => sectionObserver?.observe(item.section));
      }

      updateProgress();
      updateActiveSection();
      window.addEventListener("scroll", updateProgress, { passive: true, signal });
      window.addEventListener("resize", updateProgress, { signal });
      window.addEventListener("scroll", updateActiveSection, { passive: true, signal });
      window.addEventListener("resize", updateActiveSection, { signal });

      return () => {
        controller.abort();
        window.cancelAnimationFrame(progressFrame);
        sectionObserver?.disconnect();
      };
    });
  </script>
</BaseLayout>

<style>
  .progress {
    position: sticky;
    top: 3.8rem;
    z-index: 45;
    height: 3px;
    overflow: hidden;
    background: rgba(226, 232, 240, 0.18);
    opacity: 0.86;
    transition:
      opacity var(--motion-fast) var(--ease-standard),
      height var(--motion-fast) var(--ease-standard);
  }

  .progress.is-active {
    opacity: 1;
  }

  .progress span {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #9be7d4, #7dd3fc, #d8a238);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 90ms linear;
  }

  .progress span::after {
    position: absolute;
    top: 50%;
    right: 0;
    width: 4.5rem;
    height: 1rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent-cyan) 72%, transparent), transparent 62%);
    content: "";
    transform: translate(50%, -50%);
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .progress {
      display: none;
    }
  }

  .case-body,
  .related-section,
  .case-exit {
    background:
      radial-gradient(
        circle at 0% 0%,
        color-mix(in srgb, var(--accent-cyan) 6%, transparent),
        transparent 24rem
      ),
      var(--surface-light);
    padding-block: var(--space-section-before) var(--space-section-after);
  }

  .case-body-inner {
    display: grid;
    grid-template-columns: minmax(9rem, 0.22fr) minmax(0, 860px);
    gap: var(--gap-grid-lg);
    align-items: start;
  }

  .case-read-nav {
    position: sticky;
    top: 5rem;
    display: grid;
    gap: var(--space-stack-md);
    min-width: 0;
  }

  .read-flow {
    display: grid;
    gap: var(--space-stack-xs);
  }

  .read-flow .section-label {
    margin: 0 0 0.08rem;
  }

  .case-read-nav a {
    display: inline-flex;
    width: fit-content;
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.5rem 0.68rem;
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      background var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-out);
  }

  .case-read-nav a:hover {
    border-color: var(--badge-border);
    color: var(--accent);
    transform: translateX(2px);
  }

  .case-read-nav a[aria-current="location"] {
    border-color: var(--badge-border-strong);
    background: var(--chip-active-bg);
    color: var(--text);
    box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .archive-return {
    border-color: var(--badge-border) !important;
    background: var(--badge-metric-bg) !important;
    color: var(--accent-strong-on) !important;
  }

  .archive-return span,
  .case-exit-card a span {
    display: inline-block;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .archive-return:hover span {
    transform: translateX(-3px);
  }

  .case-reading,
  .prose {
    max-width: 860px;
    min-width: 0;
  }

  .case-reading {
    display: grid;
    gap: var(--gap-grid-lg);
  }

  .case-brief {
    overflow: hidden;
  }

  .case-deep-dive {
    display: grid;
    gap: var(--space-stack-md);
    padding-top: var(--space-section-tight);
    border-top: 1px solid var(--line);
  }

  .case-deep-dive .section-label {
    color: var(--text-soft);
  }

  .case-brief-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--grid-line);
    border-radius: 8px;
    background: var(--grid-line);
  }

  .case-brief-grid article {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    min-height: 7rem;
    background: var(--grid-cell-bg);
    padding: 0.85rem;
  }

  .case-brief-grid span {
    color: var(--text-soft);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.68rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .case-brief-grid p {
    margin: 0;
    color: var(--text);
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .related-heading {
    display: grid;
    gap: var(--label-gap);
    margin-bottom: var(--space-stack-lg);
  }

  .related-heading h2 {
    margin: var(--label-gap) 0 0;
    color: var(--text);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.05;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-grid);
  }

  .case-exit {
    padding-block-start: var(--space-section-tight);
  }

  .case-exit-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    border: 1px solid var(--panel-border);
    border-radius: 8px;
    background: var(--chip-highlight-bg);
    box-shadow: var(--panel-shadow);
    padding: clamp(1rem, 2.5vw, 1.35rem);
  }

  .case-exit-card h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.3rem, 2.3vw, 1.8rem);
    font-weight: 600;
    line-height: 1.08;
  }

  .case-exit-card a {
    display: inline-flex;
    min-height: 2.55rem;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: 999px;
    background: var(--accent);
    color: var(--button-on-accent);
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.78rem 1rem;
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      background var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-out);
  }

  .case-exit-card a:hover {
    box-shadow: 0 12px 28px rgba(15, 159, 135, 0.14);
    transform: translateY(-1px);
  }

  .case-exit-card a:hover span {
    transform: translateX(3px);
  }

  @media (max-width: 820px) {
    .case-body-inner {
      grid-template-columns: 1fr;
    }

    .case-read-nav {
      position: static;
      display: flex;
      flex-wrap: wrap;
    }

    .read-flow {
      display: flex;
      flex: 1 1 100%;
      flex-wrap: wrap;
      gap: 0.42rem;
    }

    .read-flow .section-label {
      flex: 1 1 100%;
    }

    .case-brief-grid,
    .case-exit-card {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .related-grid {
      grid-template-columns: 1fr;
    }

    .case-brief-grid article {
      min-height: auto;
    }

    .case-exit-card a {
      justify-self: start;
    }
  }
</style>
