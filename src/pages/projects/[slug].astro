---
import ProjectCard from "@components/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getImageMeta } from "@lib/images";
import { getLogoItems } from "@lib/logos";
import { getCategoryMeta } from "@lib/projects";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const category = getCategoryMeta(project.data.category);
const projectLogo = project.data.logo ?? category.logo;
const coverMeta = getImageMeta(project.data.coverImage);
const visibleStack = getLogoItems(project.data.stack.slice(0, 6));
const hiddenStackCount = Math.max(project.data.stack.length - visibleStack.length, 0);
const proofItems = (
  project.data.proof && project.data.proof.length > 0
    ? project.data.proof
    : [project.data.metric ?? project.data.status, project.data.status, ...project.data.stack]
)
  .filter(Boolean)
  .slice(0, 3);
const snapshotItems = [
  {
    label: "Result",
    value: project.data.result ?? project.data.summary,
  },
  {
    label: "Role",
    value: project.data.role,
  },
  {
    label: "Metric",
    value: project.data.metric ?? project.data.status,
  },
];
const { Content } = await render(project);
const allProjects = await getCollection("projects");
const relatedProjects = allProjects
  .filter((entry) => entry.data.slug !== project.data.slug)
  .sort((a, b) => {
    if (a.data.category === project.data.category && b.data.category !== project.data.category) {
      return -1;
    }

    if (a.data.category !== project.data.category && b.data.category === project.data.category) {
      return 1;
    }

    return a.data.priority - b.data.priority;
  })
  .slice(0, 2);
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article>
    <header class="case-hero dark-section" data-dark-section>
      <div class="container case-hero-inner">
        <div class="case-kicker">
          {projectLogo && <span class="case-logo"><img src={projectLogo} alt="" width="24" height="24" loading="eager" /></span>}
          <p class="section-label">{category.title} / {project.data.year}</p>
        </div>
        <h1 class="display">{project.data.title}</h1>
        <p>{project.data.result ?? project.data.summary}</p>

        <div class="meta-pills">
          <span>{project.data.metric ?? project.data.status}</span>
          <span>{project.data.status}</span>
          <span>{project.data.role}</span>
          {
            project.data.links.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer">
                {link.label} -&gt;
              </a>
            ))
          }
        </div>

        <ul class="stack-pills" aria-label="Technology stack">
          {
            visibleStack.map((item) => (
              <li class:list={[item.logo && "has-logo"]}>
                {item.logo && <img src={item.logo} alt="" width="24" height="24" loading="lazy" />}
                <span>{item.label}</span>
              </li>
            ))
          }
          {hiddenStackCount > 0 && <li>+{hiddenStackCount} more</li>}
        </ul>
      </div>
    </header>

    <div class="progress" aria-hidden="true">
      <span data-case-progress></span>
    </div>

    <section id="case-study" class="case-body">
      <div class="container case-body-inner">
        <section class="case-snapshot" aria-label="Project snapshot">
          <a class="snapshot-visual" href={project.data.coverImage} target="_blank" rel="noreferrer">
            <img
              src={project.data.coverImage}
              alt=""
              width={coverMeta?.width}
              height={coverMeta?.height}
              loading="lazy"
              decoding="async"
            />
            <span>{category.title}</span>
          </a>

          <div class="snapshot-copy">
            <div>
              <p class="section-label">Project snapshot</p>
              <h2>What to notice first.</h2>
            </div>

            <div class="snapshot-grid">
              {
                snapshotItems.map((item) => (
                  <article>
                    <span>{item.label}</span>
                    <p>{item.value}</p>
                  </article>
                ))
              }
            </div>

            <ul class="snapshot-proof" aria-label="Project proof points">
              {proofItems.map((item) => <li>{item}</li>)}
            </ul>

            <nav class="case-quick-nav" aria-label="Case study quick navigation">
              <a href="#evidence">Evidence</a>
              <a href="#approach">Approach</a>
              <a href="#result">Result</a>
            </nav>
          </div>
        </section>

        {
          project.data.result && (
            <aside class="result-callout" aria-label="Project result">
              <p class="section-label">Result</p>
              <p>{project.data.result}</p>
            </aside>
          )
        }

        <div class="prose">
          <Content />
        </div>
      </div>
    </section>
  </article>

  {
    relatedProjects.length > 0 && (
      <section class="related-section divider">
        <div class="container">
          <div class="related-heading">
            <p class="section-label">More work</p>
            <h2>Other case studies</h2>
          </div>
          <div class="related-grid">
            {relatedProjects.map((entry) => <ProjectCard project={entry} />)}
          </div>
        </div>
      </section>
    )
  }

  <script>
    const progress = document.querySelector<HTMLElement>("[data-case-progress]");
    const updateProgress = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const value = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
      progress?.style.setProperty("transform", `scaleX(${value})`);
    };

    updateProgress();
    window.addEventListener("scroll", updateProgress, { passive: true });
    window.addEventListener("resize", updateProgress);

    const anchorMap = new Map([
      ["evidence", "evidence"],
      ["approach", "approach"],
      ["result", "result"],
    ]);

    document.querySelectorAll<HTMLHeadingElement>(".prose h2").forEach((heading) => {
      const key = heading.textContent?.trim().toLowerCase();
      const id = key ? anchorMap.get(key) : undefined;

      if (id && !document.getElementById(id)) {
        heading.id = id;
      }
    });
  </script>
</BaseLayout>

<style>
  .dark-section {
    background: var(--surface-base);
    color: #ffffff;
  }

  .case-hero {
    padding-block: clamp(7rem, 12vw, 10rem) clamp(4rem, 8vw, 6rem);
  }

  .case-hero-inner {
    display: grid;
    gap: 1.1rem;
  }

  .case-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    align-items: center;
  }

  .case-logo {
    display: inline-grid;
    width: 2.1rem;
    height: 2.1rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
  }

  .case-logo img {
    width: 1.24rem;
    height: 1.24rem;
    object-fit: contain;
  }

  .case-hero .display {
    max-width: 900px;
    color: #ffffff;
  }

  .case-hero-inner > p:not(.section-label) {
    max-width: 760px;
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .meta-pills,
  .stack-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .meta-pills span,
  .meta-pills a {
    border-radius: 999px;
    background: var(--accent-dim);
    color: var(--accent);
    font-size: 0.75rem;
    line-height: 1;
    padding: 0.5rem 0.68rem;
  }

  .meta-pills span:nth-child(n + 2) {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.72);
  }

  .stack-pills li {
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.6875rem;
    line-height: 1;
    padding: 0.42rem 0.66rem;
  }

  .stack-pills li.has-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.62rem 0.32rem 0.38rem;
  }

  .stack-pills img {
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    object-fit: contain;
    padding: 0.12rem;
  }

  .progress {
    position: sticky;
    top: 0;
    z-index: 40;
    height: 2px;
    background: transparent;
  }

  .progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .case-body,
  .related-section {
    background: var(--surface-light);
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .case-body-inner {
    display: grid;
    gap: clamp(1.8rem, 5vw, 3.5rem);
  }

  .case-body-inner > *,
  .snapshot-visual,
  .snapshot-copy,
  .prose {
    min-width: 0;
  }

  .case-snapshot {
    display: grid;
    grid-template-columns: minmax(18rem, 0.48fr) minmax(0, 0.52fr);
    gap: clamp(1rem, 4vw, 2rem);
    align-items: stretch;
  }

  .snapshot-visual {
    position: relative;
    display: block;
    min-height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #ffffff;
  }

  .snapshot-visual img {
    width: 100%;
    height: 100%;
    min-height: 22rem;
    object-fit: cover;
  }

  .snapshot-visual span {
    position: absolute;
    left: 0.85rem;
    bottom: 0.85rem;
    border-radius: 999px;
    background: rgba(13, 13, 13, 0.72);
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.72rem;
    line-height: 1;
    padding: 0.48rem 0.66rem;
  }

  .snapshot-copy {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .snapshot-copy h2 {
    margin: 0.58rem 0 0;
    color: var(--text);
    font-size: clamp(1.45rem, 3vw, 2.2rem);
    font-weight: 500;
    line-height: 1.05;
  }

  .snapshot-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .snapshot-grid article {
    display: grid;
    gap: 0.55rem;
    min-height: 9rem;
    align-content: start;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.42);
    padding: clamp(0.9rem, 2vw, 1.1rem);
  }

  .snapshot-grid article:first-child {
    grid-column: 1 / -1;
  }

  .snapshot-grid span {
    color: var(--text-soft);
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
  }

  .snapshot-grid p {
    margin: 0;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .snapshot-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .snapshot-proof li,
  .case-quick-nav a {
    border: 1px solid rgba(29, 158, 117, 0.24);
    border-radius: 999px;
    background: var(--accent-dim);
    color: var(--accent);
    font-size: 0.76rem;
    line-height: 1.25;
    padding: 0.48rem 0.66rem;
  }

  .case-quick-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .case-quick-nav a {
    background: transparent;
    color: var(--text);
  }

  .result-callout {
    max-width: 900px;
    border-left: 3px solid var(--accent);
    background: var(--accent-dim);
    padding: clamp(1rem, 3vw, 1.4rem);
  }

  .result-callout p {
    margin: 0;
  }

  .result-callout p:not(.section-label) {
    max-width: 760px;
    color: var(--text);
    font-size: clamp(1.18rem, 2.4vw, 1.55rem);
    line-height: 1.45;
  }

  .prose {
    max-width: 860px;
  }

  .related-heading {
    display: grid;
    gap: 0.65rem;
    margin-bottom: 1.5rem;
  }

  .related-heading h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 500;
    line-height: 1.05;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 1.5rem);
  }

  @media (max-width: 760px) {
    .case-hero {
      padding-block: 6.5rem 4rem;
    }

    .case-snapshot {
      grid-template-columns: 1fr;
    }

    .snapshot-visual img {
      min-height: auto;
      aspect-ratio: 4 / 3;
    }

    .snapshot-grid {
      grid-template-columns: 1fr;
    }

    .snapshot-grid article {
      min-height: auto;
    }

    .result-callout {
      display: none;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
