---
import ProjectCard from "@components/ProjectCard.astro";
import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
import { projectCategories } from "@data/profile";
import { getCollectionPageSchema } from "@lib/seo";
import { getSortedProjects } from "@lib/projects";

const projects = await getSortedProjects();
const siteUrl = Astro.site?.href ?? Astro.url.origin;
const collectionSchema = getCollectionPageSchema({
  site: siteUrl,
  name: pageSeo.projects.title,
  description: pageSeo.projects.description,
  path: "/projects/",
});
const activeCategories = projectCategories.filter((category) =>
  projects.some((project) => project.data.category === category.id),
);
const projectCount = projects.length;
---

<BaseLayout
  title={pageSeo.projects.title}
  description={pageSeo.projects.description}
  jsonLd={collectionSchema}
>
  <section class="page-hero dark-section dark-hero-shell" data-dark-section style="--dark-hero-grid-size: 5.5rem">
    <div class="dark-hero-grid" aria-hidden="true"></div>
    <div class="container page-hero-inner" data-reveal>
      <div class="hero-copy">
        <p class="section-label">Project archive</p>
        <h1 class="display">All projects.</h1>
      </div>
      <div class="archive-count glass-dark">
        <strong>{projectCount}</strong>
        <span>builds</span>
      </div>
    </div>
  </section>

  <section class="project-index divider">
    <div class="container project-work">
      <div class="archive-toolbar" data-reveal>
        <p class="filter-status" data-filter-status aria-live="polite">{projectCount} shown</p>

        <div class="filter-tabs" role="toolbar" aria-label="Project category filters" data-filter-tabs>
          <span class="filter-indicator glass-chip" data-filter-indicator aria-hidden="true"></span>
          <button type="button" data-project-filter="" aria-pressed="true">All</button>
          {
            activeCategories.map((category) => (
              <button type="button" data-project-filter={category.id} aria-pressed="false">
                {category.title}
              </button>
            ))
          }
        </div>

        <button type="button" class="filter-reset glass-chip" data-filter-reset aria-label="Reset category filter" hidden>
          Reset
        </button>
      </div>

      <div class="project-grid" data-filter-list>
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <script>
    import { initOnPageLoad } from "@lib/page-script";

    initOnPageLoad(() => {
      const filterTabs = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-project-filter]"),
      );
      const filterTabList = document.querySelector<HTMLElement>("[data-filter-tabs]");
      const filterIndicator = document.querySelector<HTMLElement>("[data-filter-indicator]");
      const list = document.querySelector<HTMLElement>("[data-filter-list]");
      const items = Array.from(document.querySelectorAll<HTMLElement>("[data-category]"));
      const filterStatus = document.querySelector<HTMLElement>("[data-filter-status]");
      const resetFilter = document.querySelector<HTMLButtonElement>("[data-filter-reset]");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const controller = new AbortController();
      const { signal } = controller;

      const updateFilterIndicator = () => {
        const activeTab =
          filterTabs.find((item) => item.getAttribute("aria-pressed") === "true") ?? filterTabs[0];

        if (!activeTab || !filterTabList || !filterIndicator) {
          return;
        }

        filterIndicator.style.setProperty("--indicator-x", `${activeTab.offsetLeft}px`);
        filterIndicator.style.setProperty("--indicator-width", `${activeTab.offsetWidth}px`);
      };

      const updateFilterStatus = (active: string) => {
        const visibleItems = items.filter((item) => !item.hidden);
        const activeTab = filterTabs.find((item) => (item.dataset.projectFilter ?? "") === active);
        const activeLabel = activeTab?.textContent?.trim() ?? "";

        if (filterStatus) {
          filterStatus.textContent = active
            ? `${visibleItems.length} in ${activeLabel}`
            : `${items.length} shown`;
        }

        if (resetFilter) {
          resetFilter.hidden = !active;
        }
      };

      const allowedFilters = new Set(
        filterTabs
          .map((tab) => tab.dataset.projectFilter ?? "")
          .filter((value) => Boolean(value)),
      );

      const readFilterFromUrl = () => {
        const value = new URL(window.location.href).searchParams.get("category") ?? "";
        return allowedFilters.has(value) ? value : "";
      };

      const writeFilterToUrl = (active: string) => {
        const url = new URL(window.location.href);

        if (active) {
          url.searchParams.set("category", active);
        } else {
          url.searchParams.delete("category");
        }

        window.history.replaceState({}, "", url);
      };

      const applyFilter = (active: string, syncUrl = true) => {
        list?.classList.add("is-filtering");
        filterTabs.forEach((item) => {
          item.setAttribute("aria-pressed", String((item.dataset.projectFilter ?? "") === active));
        });
        updateFilterIndicator();

        if (syncUrl) {
          writeFilterToUrl(active);
        }

        window.setTimeout(() => {
          items.forEach((item) => {
            item.hidden = Boolean(active) && item.dataset.category !== active;
          });
          updateFilterStatus(active);
          list?.classList.remove("is-filtering");
        }, reduceMotion ? 0 : 140);
      };

      filterTabs.forEach((tab) => {
        tab.addEventListener(
          "click",
          () => applyFilter(tab.dataset.projectFilter ?? ""),
          { signal },
        );
      });

      filterTabList?.addEventListener(
        "keydown",
        (event) => {
          const key = event.key;
          if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(key)) {
            return;
          }

          const currentIndex = filterTabs.findIndex(
            (tab) => tab.getAttribute("aria-pressed") === "true",
          );
          if (currentIndex === -1) {
            return;
          }

          event.preventDefault();

          let nextIndex = currentIndex;
          if (key === "ArrowLeft") {
            nextIndex = currentIndex === 0 ? filterTabs.length - 1 : currentIndex - 1;
          } else if (key === "ArrowRight") {
            nextIndex = currentIndex === filterTabs.length - 1 ? 0 : currentIndex + 1;
          } else if (key === "Home") {
            nextIndex = 0;
          } else if (key === "End") {
            nextIndex = filterTabs.length - 1;
          }

          const nextTab = filterTabs[nextIndex];
          applyFilter(nextTab?.dataset.projectFilter ?? "");
          nextTab?.focus();
        },
        { signal },
      );

      resetFilter?.addEventListener("click", () => applyFilter(""), { signal });
      filterTabList?.addEventListener("scroll", updateFilterIndicator, { passive: true, signal });
      window.addEventListener("resize", updateFilterIndicator, { signal });

      applyFilter(readFilterFromUrl(), false);
      requestAnimationFrame(updateFilterIndicator);

      return () => controller.abort();
    });
  </script>
</BaseLayout>

<style>
  .page-hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-stack-lg);
    align-items: end;
    justify-content: space-between;
  }

  .hero-copy .section-label {
    color: rgba(255, 255, 255, 0.62);
  }

  .page-hero .display {
    max-width: 640px;
    margin-top: var(--label-gap);
    color: #ffffff;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 0.98;
  }

  .archive-count {
    display: grid;
    gap: 0.35rem;
    min-width: 8rem;
    padding: 0.9rem 1rem;
  }

  .archive-count strong {
    color: #9be7d4;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1;
  }

  .archive-count span {
    color: rgba(255, 255, 255, 0.66);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.68rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .project-index {
    background:
      radial-gradient(
        circle at 0% 0%,
        color-mix(in srgb, var(--accent-cyan) 6%, transparent),
        transparent 24rem
      ),
      var(--surface-light);
  }

  .project-work {
    display: grid;
    gap: var(--space-block-inner);
  }

  .archive-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 0.85rem;
    align-items: center;
  }

  .filter-status {
    margin: 0;
    color: var(--text-soft);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.68rem;
    line-height: 1;
    text-transform: uppercase;
    flex: 1 1 auto;
  }

  .filter-reset {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    border: 1px solid var(--badge-border);
    border-radius: 999px;
    color: var(--accent);
    cursor: pointer;
    font-size: 0.74rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.5rem 0.68rem;
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      background var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-out);
  }

  .filter-reset:hover {
    border-color: var(--badge-border-strong);
    background: var(--surface-elevated-hover);
    transform: translateY(-1px);
  }

  .filter-tabs {
    position: relative;
    display: flex;
    flex: 1 1 100%;
    gap: 0.45rem;
    overflow-x: auto;
    padding-bottom: 0.1rem;
    scrollbar-width: none;
  }

  .filter-tabs::-webkit-scrollbar {
    display: none;
  }

  .filter-indicator {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--indicator-width, 2.8rem);
    height: calc(100% - 0.1rem);
    border-color: var(--badge-border-strong);
    border-radius: 999px;
    background: var(--filter-indicator-bg);
    box-shadow:
      inset 0 1px 0 var(--filter-indicator-inset),
      0 8px 22px color-mix(in srgb, var(--accent) 8%, transparent);
    transform: translateX(var(--indicator-x, 0));
    transition:
      width var(--motion-medium) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
    pointer-events: none;
  }

  .filter-tabs button {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1;
    padding: 0.55rem 0.72rem;
    white-space: nowrap;
    transition:
      color var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-out);
  }

  .filter-tabs button:hover {
    color: var(--text);
    transform: translateY(-1px);
  }

  .filter-tabs button[aria-pressed="true"] {
    color: var(--text);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--gap-grid);
    transition:
      filter var(--motion-fast) var(--ease-standard),
      opacity var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-out);
  }

  .project-grid.is-filtering {
    opacity: 0.68;
    filter: blur(2px);
    transform: translateY(3px);
  }

  @media (max-width: 720px) {
    .project-grid.is-filtering {
      filter: none;
      opacity: 0.82;
    }
  }

  @media (max-width: 760px) {
    .page-hero {
      padding-block: 5rem var(--space-hero-bottom);
    }

    .archive-count {
      width: fit-content;
    }

    .filter-tabs {
      margin-inline: -0.625rem;
      padding-inline: 0.625rem;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .page-hero .display {
      font-size: clamp(2.2rem, 12vw, 3rem);
    }
  }
</style>