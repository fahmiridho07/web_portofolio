---
import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
import { heroProjectSlug, projectCategories } from "@data/profile";
import { getCollectionPageSchema } from "@lib/seo";
import { getCategoryMeta, getSortedProjects } from "@lib/projects";
import ProjectVisualMetaphor from "@components/ProjectVisualMetaphor.astro";

const projects = await getSortedProjects();
const siteUrl = Astro.site?.href ?? Astro.url.origin;
const collectionSchema = getCollectionPageSchema({
  site: siteUrl,
  name: pageSeo.projects.title,
  description: pageSeo.projects.description,
  path: "/projects/",
});

// Flagship Hero Project (Undergraduate Thesis)
const flagship =
  projects.find((p) => p.data.slug === heroProjectSlug) ?? projects[0];
const flagshipCategory = getCategoryMeta(flagship.data.category);

// Catalogue Projects: 10 production systems exhibited below the flagship thesis
const catalogueProjects = projects.filter(
  (p) => p.data.slug !== flagship.data.slug,
);
const catalogueCount = catalogueProjects.length;

const activeCategories = projectCategories.filter((category) =>
  catalogueProjects.some((project) => project.data.category === category.id),
);
const initialDiscipline = getCategoryMeta(
  catalogueProjects[0].data.category,
).title;
---

<BaseLayout
  title={pageSeo.projects.title}
  description={pageSeo.projects.description}
  jsonLd={collectionSchema}
>
  {/* 01. HEADER */}
  <header class="exhibition-header">
    <div class="container exhibition-container header-inner" data-reveal>
      <p class="section-label">Projects</p>
      <h1 class="display exhibition-headline">Selected Work</h1>
      <p class="exhibition-lead">
        Production software, machine learning systems, and operations research.
      </p>
    </div>
  </header>

  {/* 02. FEATURED HERO (MAGAZINE SPREAD) */}
  <section class="featured-hero-section divider">
    <div class="container exhibition-container">
      <div class="featured-hero-spread" data-reveal>
        <div class="hero-story-col">
          <div class="hero-tag-row">
            <span class="hero-pill">Undergraduate Thesis</span>
            <span class="hero-meta"
              >{flagshipCategory.title} &middot; {flagship.data.year}</span
            >
          </div>

          <h2 class="hero-project-title">
            <a
              href={`/projects/${flagship.data.slug}/`}
              data-astro-prefetch="hover"
            >
              {flagship.data.title}
            </a>
          </h2>

          <p class="hero-concept-prose">
            Detecting payment fraud under 1:590 class imbalance using latent
            oversampling and LightGBM on the IEEE-CIS benchmark.
          </p>

          <div class="hero-climax-box">
            <div class="hero-climax-stat">
              <span class="hero-climax-val">0.855</span>
              <span class="hero-climax-unit">PR-AUC</span>
            </div>
            <p class="hero-climax-note">
              74.7% recall at 89% precision &middot; 3,087 caught
            </p>
          </div>

          <a
            href={`/projects/${flagship.data.slug}/`}
            class="dark-cta dark-cta-primary hero-cta-btn desktop-hero-cta"
            data-astro-prefetch="hover"
          >
            View Case Study
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="hero-visual-col">
          <ProjectVisualMetaphor slug={flagship.data.slug} mode="hero" />
          <a
            href={`/projects/${flagship.data.slug}/`}
            class="dark-cta dark-cta-primary hero-cta-btn mobile-hero-cta"
            data-astro-prefetch="hover"
          >
            View Case Study
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* 03. CATALOGUE */}
  <section id="exhibition" class="catalogue-section divider">
    <div class="container exhibition-container">
      <div class="catalogue-toolbar" data-reveal>
        <div class="toolbar-title-group">
          <span class="section-label">Catalogue</span>
          <span
            class="filter-count-badge"
            data-filter-status
            aria-live="polite"
          >
            {catalogueCount} production systems
          </span>
        </div>

        <nav
          class="editorial-filters"
          role="toolbar"
          aria-label="Filter projects by discipline"
          data-filter-tabs
        >
          <button
            type="button"
            data-project-filter=""
            aria-pressed="true"
            class="filter-pill is-active"
          >
            All <span class="pill-count">({catalogueCount})</span>
          </button>
          {
            activeCategories.map((cat) => {
              const count = catalogueProjects.filter(
                (p) => p.data.category === cat.id,
              ).length;
              if (count === 0) return null;
              return (
                <button
                  type="button"
                  data-project-filter={cat.id}
                  aria-pressed="false"
                  class="filter-pill"
                >
                  {cat.title} <span class="pill-count">({count})</span>
                </button>
              );
            })
          }
        </nav>

        <button
          type="button"
          class="filter-clear-btn"
          data-filter-reset
          aria-label="Reset discipline filter"
          hidden
        >
          Reset
        </button>
      </div>

      <div class="exhibition-workspace" data-exhibition-workspace>
        {/* Left: Navigable Project Titles */}
        <div
          class="project-nav-col"
          data-catalogue-list
          role="navigation"
          aria-label="Project catalogue"
        >
          {
            catalogueProjects.map((project, index) => {
              const category = getCategoryMeta(project.data.category);
              const metric = project.data.metric ?? project.data.status;
              const isActive = index === 0;

              return (
                <article
                  class:list={["project-nav-item", isActive && "is-active"]}
                  data-project-slug={project.data.slug}
                  data-category={project.data.category}
                  data-reveal
                  data-reveal-delay={String(index * 30)}
                >
                  <a
                    href={`/projects/${project.data.slug}/`}
                    class="nav-item-link"
                    data-astro-prefetch="hover"
                    data-slug-trigger={project.data.slug}
                  >
                    <div class="nav-item-meta">
                      <span class="nav-index">
                        {String(index + 1).padStart(2, "0")}
                      </span>
                      <span class="nav-discipline">{category.title}</span>
                      <span class="nav-year">&middot; {project.data.year}</span>
                    </div>

                    <h3 class="nav-title">
                      <span
                        class="nav-title-text"
                        transition:name={`project-title-${project.data.slug}`}
                      >
                        {project.data.title}
                      </span>
                      <span class="nav-arrow" aria-hidden="true">
                        &nearr;
                      </span>
                    </h3>

                    <div class="nav-metric-line">
                      <span class="metric-marker" />
                      <span class="metric-text">{metric}</span>
                    </div>
                  </a>

                  {/* Mobile Ergonomic Tap-to-Inspect Toggle */}
                  <div class="mobile-card-controls">
                    <button
                      type="button"
                      class="mobile-inspect-btn"
                      data-mobile-inspect-toggle
                      aria-expanded={isActive ? "true" : "false"}
                      aria-label={`Toggle simulation preview for ${project.data.title}`}
                    >
                      <span class="inspect-btn-icon">
                        {isActive ? "−" : "+"}
                      </span>
                      <span class="inspect-btn-text">
                        {isActive ? "Hide Simulation" : "Inspect Simulation"}
                      </span>
                    </button>
                  </div>

                  <div
                    class:list={["mobile-inline-canvas", isActive && "is-open"]}
                    data-mobile-canvas
                  >
                    <ProjectVisualMetaphor
                      slug={project.data.slug}
                      mode="mobile"
                    />
                    <a
                      href={`/projects/${project.data.slug}/`}
                      class="mobile-case-action"
                      data-astro-prefetch="hover"
                    >
                      View Case Study &rarr;
                    </a>
                  </div>
                </article>
              );
            })
          }
        </div>

        {/* Right: Sticky Visual Stage */}
        <aside
          class="stage-sticky-col"
          aria-label="Project visual stage"
          data-stage-col
        >
          <div class="stage-frame-canvas">
            <div class="stage-header-bar">
              <div class="stage-live-indicator">
                <span class="pulse-beacon"></span>
                <span class="stage-counter-text" data-stage-counter>
                  01 / {String(catalogueCount).padStart(2, "0")}
                </span>
              </div>
              <div class="stage-discipline-tag" data-stage-discipline>
                {initialDiscipline}
              </div>
            </div>

            <div class="stage-panes-viewport" data-stage-panes>
              {
                catalogueProjects.map((project, index) => {
                  const isActive = index === 0;
                  const category = getCategoryMeta(project.data.category);

                  return (
                    <div
                      class:list={["stage-pane-item", isActive && "is-active"]}
                      data-pane-slug={project.data.slug}
                      aria-hidden={!isActive}
                    >
                      <div class="pane-meta-strip">
                        <span class="pane-cat">
                          {category.title} &middot; {project.data.year}
                        </span>
                        <h4 class="pane-headline">{project.data.title}</h4>
                      </div>

                      <div
                        class="pane-canvas-shell"
                        transition:name={`project-visual-${project.data.slug}`}
                      >
                        <ProjectVisualMetaphor
                          slug={project.data.slug}
                          mode="stage"
                        />
                      </div>

                      <div class="pane-action-bar">
                        <div class="pane-tech-pills">
                          {project.data.stack
                            .slice(0, 4)
                            .map((tech: string) => (
                              <span class="tech-pill">{tech}</span>
                            ))}
                        </div>

                        <a
                          href={`/projects/${project.data.slug}/`}
                          class="pane-inspect-button"
                          data-astro-prefetch="hover"
                        >
                          View Case Study <span aria-hidden="true">&rarr;</span>
                        </a>
                      </div>
                    </div>
                  );
                })
              }
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* CLIENT SCRIPT: SMOOTH SEQUENTIAL SCROLL STORYTELLING */}
  <script>
    import { initOnPageLoad } from "@lib/page-script";

    initOnPageLoad(() => {
      const items = Array.from(
        document.querySelectorAll<HTMLElement>("[data-project-slug]"),
      );
      const panes = Array.from(
        document.querySelectorAll<HTMLElement>("[data-pane-slug]"),
      );
      const filterBtns = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-project-filter]"),
      );
      const filterStatus = document.querySelector<HTMLElement>(
        "[data-filter-status]",
      );
      const filterReset = document.querySelector<HTMLButtonElement>(
        "[data-filter-reset]",
      );
      const stageCounter = document.querySelector<HTMLElement>(
        "[data-stage-counter]",
      );
      const stageDiscipline = document.querySelector<HTMLElement>(
        "[data-stage-discipline]",
      );

      const controller = new AbortController();
      const { signal } = controller;
      let activeSlug = items[0]?.dataset.projectSlug ?? "";

      let isUserScrolling = false;
      let scrollTimer: ReturnType<typeof setTimeout> | null = null;
      let rafId: number | null = null;

      const activateProject = (slug: string, scrollIntoView = false) => {
        if (!slug || slug === activeSlug) return;
        activeSlug = slug;

        const activeIndex = items.findIndex(
          (el) => el.dataset.projectSlug === slug,
        );
        const activeItem = items[activeIndex];

        items.forEach((item) => {
          const match = item.dataset.projectSlug === slug;
          item.classList.toggle("is-active", match);
          if (match) {
            item.setAttribute("aria-current", "true");
          } else {
            item.removeAttribute("aria-current");
          }
        });

        panes.forEach((pane) => {
          const match = pane.dataset.paneSlug === slug;
          pane.classList.toggle("is-active", match);
          pane.setAttribute("aria-hidden", String(!match));
        });

        if (stageCounter && activeIndex >= 0) {
          const num = String(activeIndex + 1).padStart(2, "0");
          const total = String(items.length).padStart(2, "0");
          stageCounter.textContent = `${num} / ${total}`;
        }

        if (stageDiscipline && activeItem) {
          const disc = activeItem
            .querySelector(".nav-discipline")
            ?.textContent?.trim();
          if (disc) stageDiscipline.textContent = disc;
        }

        if (scrollIntoView && activeItem) {
          activeItem.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }
      };

      // 1. Mouse hover: only active when user is not scrolling
      items.forEach((item) => {
        const slug = item.dataset.projectSlug ?? "";
        item.addEventListener(
          "mouseenter",
          () => {
            if (isUserScrolling) return; // Prevent stationary mouse from overriding scroll position
            activateProject(slug, false);
          },
          { signal },
        );

        item.addEventListener(
          "focusin",
          () => {
            activateProject(slug, false);
          },
          { signal },
        );
      });

      // 2. Keyboard Navigation (Arrow Keys Up / Down / Home / End)
      const navContainer = document.querySelector<HTMLElement>(
        "[data-catalogue-list]",
      );
      navContainer?.addEventListener(
        "keydown",
        (e: KeyboardEvent) => {
          if (!["ArrowUp", "ArrowDown", "Home", "End"].includes(e.key)) return;

          const visibleItems = items.filter((el) => !el.hidden);
          const currentIndex = visibleItems.findIndex(
            (el) => el.dataset.projectSlug === activeSlug,
          );
          if (currentIndex === -1) return;

          e.preventDefault();
          let nextIndex = currentIndex;

          if (e.key === "ArrowUp") {
            nextIndex =
              currentIndex === 0 ? visibleItems.length - 1 : currentIndex - 1;
          } else if (e.key === "ArrowDown") {
            nextIndex =
              currentIndex === visibleItems.length - 1 ? 0 : currentIndex + 1;
          } else if (e.key === "Home") {
            nextIndex = 0;
          } else if (e.key === "End") {
            nextIndex = visibleItems.length - 1;
          }

          const target = visibleItems[nextIndex];
          if (target) {
            const slug = target.dataset.projectSlug ?? "";
            activateProject(slug, true);
            target.querySelector<HTMLAnchorElement>(".nav-item-link")?.focus();
          }
        },
        { signal },
      );

      // 3. Smooth, sequential scroll tracking on desktop with hysteresis
      const checkScrollPosition = () => {
        if (window.innerWidth < 960) return;

        const exhibitionSection = document.getElementById("exhibition");
        if (!exhibitionSection) return;

        const sectionRect = exhibitionSection.getBoundingClientRect();
        // Only evaluate while the catalogue section is actively within the browsing area
        if (
          sectionRect.top > window.innerHeight * 0.7 ||
          sectionRect.bottom < window.innerHeight * 0.2
        ) {
          return;
        }

        const visibleItems = items.filter((el) => !el.hidden);
        if (visibleItems.length === 0) return;

        // Focus plane at 38% from viewport top (standard reading eye level)
        const focusY = window.innerHeight * 0.38;

        // Hysteresis deadband: prevent boundary flutter if current project is still near focus
        const currentIdx = visibleItems.findIndex(
          (el) => el.dataset.projectSlug === activeSlug,
        );
        if (currentIdx !== -1) {
          const currentRect = visibleItems[currentIdx].getBoundingClientRect();
          const deadband = 24; // 24px buffer
          if (
            currentRect.top <= focusY + deadband &&
            currentRect.bottom >= focusY - deadband
          ) {
            return; // Maintain current selection smoothly
          }
        }

        let selectedSlug = "";
        let minDistance = Infinity;

        for (const item of visibleItems) {
          const rect = item.getBoundingClientRect();
          // Sequential test: item spans across focus line
          if (rect.top <= focusY && rect.bottom >= focusY) {
            selectedSlug = item.dataset.projectSlug ?? "";
            break;
          }
          // Fallback: find nearest item center
          const itemCenter = rect.top + rect.height / 2;
          const dist = Math.abs(itemCenter - focusY);
          if (dist < minDistance) {
            minDistance = dist;
            selectedSlug = item.dataset.projectSlug ?? "";
          }
        }

        if (selectedSlug && selectedSlug !== activeSlug) {
          activateProject(selectedSlug, false);
        }
      };

      const onScroll = () => {
        if (window.innerWidth < 960) return;
        isUserScrolling = true;
        if (scrollTimer) clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
          isUserScrolling = false;
        }, 140);

        if (rafId) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(checkScrollPosition);
      };

      window.addEventListener("scroll", onScroll, { passive: true, signal });

      // 4. Category Filtering System
      const applyFilter = (category: string) => {
        const visible = items.filter((item) => {
          const matches = !category || item.dataset.category === category;
          item.hidden = !matches;
          return matches;
        });

        filterBtns.forEach((btn) => {
          const btnCat = btn.dataset.projectFilter ?? "";
          const active = btnCat === category;
          btn.setAttribute("aria-pressed", String(active));
          btn.classList.toggle("is-active", active);
        });

        if (filterStatus) {
          const activeBtn = filterBtns.find(
            (b) => (b.dataset.projectFilter ?? "") === category,
          );
          const label = activeBtn?.textContent?.trim() ?? "";
          filterStatus.textContent = category
            ? `${visible.length} in ${label}`
            : `${items.length} projects`;
        }

        if (filterReset) {
          filterReset.hidden = !category;
        }

        // Switch stage to first visible item
        if (
          visible.length > 0 &&
          !visible.some((i) => i.dataset.projectSlug === activeSlug)
        ) {
          const firstSlug = visible[0].dataset.projectSlug ?? "";
          activateProject(firstSlug, false);
        }
      };

      const syncUrl = (category: string) => {
        const url = new URL(window.location.href);
        if (category) {
          url.searchParams.set("category", category);
        } else {
          url.searchParams.delete("category");
        }
        window.history.replaceState({}, "", url);
      };

      filterBtns.forEach((btn) => {
        btn.addEventListener(
          "click",
          () => {
            const cat = btn.dataset.projectFilter ?? "";
            applyFilter(cat);
            syncUrl(cat);
          },
          { signal },
        );
      });

      filterReset?.addEventListener(
        "click",
        () => {
          applyFilter("");
          syncUrl("");
        },
        { signal },
      );

      // Mobile Tap-to-Inspect Accordion
      const inspectBtns = Array.from(
        document.querySelectorAll<HTMLButtonElement>(
          "[data-mobile-inspect-toggle]",
        ),
      );

      inspectBtns.forEach((btn) => {
        btn.addEventListener(
          "click",
          (e) => {
            e.stopPropagation();
            const card = btn.closest(".project-nav-item");
            if (!card) return;
            const canvas = card.querySelector<HTMLElement>(
              "[data-mobile-canvas]",
            );
            const icon = btn.querySelector<HTMLElement>(".inspect-btn-icon");
            const text = btn.querySelector<HTMLElement>(".inspect-btn-text");

            const isOpen = canvas?.classList.contains("is-open");
            if (isOpen) {
              canvas?.classList.remove("is-open");
              btn.setAttribute("aria-expanded", "false");
              if (icon) icon.textContent = "+";
              if (text) text.textContent = "Inspect Simulation";
            } else {
              canvas?.classList.add("is-open");
              btn.setAttribute("aria-expanded", "true");
              if (icon) icon.textContent = "−";
              if (text) text.textContent = "Hide Simulation";
            }
          },
          { signal },
        );
      });

      // Init from query param
      const paramCat =
        new URL(window.location.href).searchParams.get("category") ?? "";
      if (paramCat) {
        applyFilter(paramCat);
      } else {
        activateProject(items[0]?.dataset.projectSlug ?? "");
      }

      return () => {
        controller.abort();
        if (rafId) cancelAnimationFrame(rafId);
        if (scrollTimer) clearTimeout(scrollTimer);
      };
    });
  </script>
</BaseLayout>

<style>
  /* ------------------- GLOBAL EXHIBITION CONTAINER ------------------- */
  .exhibition-container {
    width: min(100% - 2.5rem, 1220px);
    margin-inline: auto;
  }

  /* ------------------- 01. EDITORIAL HEADER ------------------- */
  .exhibition-header {
    padding-block: clamp(5rem, 9vw, 7.5rem) clamp(2rem, 3.5vw, 3rem);
    background: var(--paper);
  }

  .header-inner {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 820px;
  }

  .exhibition-headline {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .exhibition-lead {
    margin: 0.4rem 0 0;
    color: var(--ink-muted);
    font-size: clamp(1.02rem, 1.4vw, 1.18rem);
    line-height: 1.62;
    max-width: 58ch;
  }

  /* ------------------- 02. FEATURED HERO (MAGAZINE SPREAD) ------------------- */
  .featured-hero-section {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    background: var(--paper);
  }

  .featured-hero-spread {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: clamp(2rem, 3.5vw, 3.5rem);
    align-items: center;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: clamp(1.75rem, 3vw, 2.75rem);
    box-shadow: 0 8px 30px rgba(22, 24, 29, 0.04);
  }

  .hero-story-col {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .hero-tag-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .hero-pill {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--paper);
    background: var(--signal-deep);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    text-transform: uppercase;
  }

  .hero-meta {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .hero-project-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    font-weight: 480;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .hero-project-title a {
    color: inherit;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .hero-project-title a:hover {
    color: var(--signal-deep);
  }

  .hero-concept-prose {
    margin: 0;
    font-size: clamp(0.92rem, 1.3vw, 1.02rem);
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .hero-climax-box {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.95rem 1.15rem;
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-left: 3px solid var(--signal);
    border-radius: var(--radius-sm);
  }

  .hero-climax-stat {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .hero-climax-val {
    font-family: var(--font-serif);
    font-size: 1.95rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1;
  }

  .hero-climax-unit {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--signal-deep);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-climax-note {
    margin: 0;
    font-size: 0.8rem;
    color: var(--ink-muted);
    line-height: 1.4;
  }

  .hero-cta-btn {
    align-self: flex-start;
    margin-top: 0.35rem;
  }

  .hero-visual-col {
    width: 100%;
