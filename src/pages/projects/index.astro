---
import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
import { heroProjectSlug, projectCategories } from "@data/profile";
import { getCollectionPageSchema } from "@lib/seo";
import { getCategoryMeta, getSortedProjects } from "@lib/projects";

const projects = await getSortedProjects();
const siteUrl = Astro.site?.href ?? Astro.url.origin;
const collectionSchema = getCollectionPageSchema({
  site: siteUrl,
  name: pageSeo.projects.title,
  description: pageSeo.projects.description,
  path: "/projects/",
});
const activeCategories = projectCategories.filter((category) =>
  projects.some((project) => project.data.category === category.id),
);
const projectCount = projects.length;
---

<BaseLayout
  title={pageSeo.projects.title}
  description={pageSeo.projects.description}
  jsonLd={collectionSchema}
>
  <section class="page-hero">
    <div class="container page-hero-inner" data-reveal>
      <p class="section-label">Project archive</p>
      <h1 class="display">All <em>{projectCount}</em> projects.</h1>
    </div>
  </section>

  <section class="project-index divider">
    <div class="container project-work">
      <div class="archive-toolbar" data-reveal>
        <p class="filter-status" data-filter-status aria-live="polite">{projectCount} shown</p>

        <div class="filter-tabs" role="toolbar" aria-label="Project category filters" data-filter-tabs>
          <button type="button" data-project-filter="" aria-pressed="true">All</button>
          {
            activeCategories.map((category) => (
              <button type="button" data-project-filter={category.id} aria-pressed="false">
                {category.title}
              </button>
            ))
          }
        </div>

        <button
          type="button"
          class="filter-reset"
          data-filter-reset
          aria-label="Reset category filter"
          hidden
        >
          Reset
        </button>
      </div>

      <div class="archive-list" data-filter-list>
        {
          projects.map((project, index) => {
            const category = getCategoryMeta(project.data.category);
            const metric = project.data.metric ?? project.data.status;
            const isAnomaly = project.data.slug === heroProjectSlug;

            return (
              <a
                class:list={["archive-row", isAnomaly && "is-anomaly"]}
                href={`/projects/${project.data.slug}/`}
                data-astro-prefetch="hover"
                data-category={project.data.category}
                data-reveal
              >
                <span class="archive-index">{String(index + 1).padStart(2, "0")}</span>
                <span class="archive-copy">
                  <span class="archive-title">{project.data.title}</span>
                  <span class="archive-meta">
                    {category.title} &middot; {project.data.year} &middot; {metric}
                    {isAnomaly && (
                      <span class="archive-flag">
                        <span class="archive-flag-dot" aria-hidden="true" /> the anomaly
                      </span>
                    )}
                  </span>
                </span>
                <span class="archive-arrow" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <script>
    import { initOnPageLoad } from "@lib/page-script";

    initOnPageLoad(() => {
      const filterTabs = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-project-filter]"),
      );
      const filterTabList = document.querySelector<HTMLElement>("[data-filter-tabs]");
      const list = document.querySelector<HTMLElement>("[data-filter-list]");
      const items = Array.from(document.querySelectorAll<HTMLElement>("[data-category]"));
      const filterStatus = document.querySelector<HTMLElement>("[data-filter-status]");
      const resetFilter = document.querySelector<HTMLButtonElement>("[data-filter-reset]");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const controller = new AbortController();
      const { signal } = controller;

      const updateFilterStatus = (active: string) => {
        const visibleItems = items.filter((item) => !item.hidden);
        const activeTab = filterTabs.find((item) => (item.dataset.projectFilter ?? "") === active);
        const activeLabel = activeTab?.textContent?.trim() ?? "";

        if (filterStatus) {
          filterStatus.textContent = active
            ? `${visibleItems.length} in ${activeLabel}`
            : `${items.length} shown`;
        }

        if (resetFilter) {
          resetFilter.hidden = !active;
        }
      };

      const allowedFilters = new Set(
        filterTabs
          .map((tab) => tab.dataset.projectFilter ?? "")
          .filter((value) => Boolean(value)),
      );

      const readFilterFromUrl = () => {
        const value = new URL(window.location.href).searchParams.get("category") ?? "";
        return allowedFilters.has(value) ? value : "";
      };

      const writeFilterToUrl = (active: string) => {
        const url = new URL(window.location.href);

        if (active) {
          url.searchParams.set("category", active);
        } else {
          url.searchParams.delete("category");
        }

        window.history.replaceState({}, "", url);
      };

      const applyFilter = (active: string, syncUrl = true) => {
        list?.classList.add("is-filtering");
        filterTabs.forEach((item) => {
          item.setAttribute("aria-pressed", String((item.dataset.projectFilter ?? "") === active));
        });

        if (syncUrl) {
          writeFilterToUrl(active);
        }

        window.setTimeout(
          () => {
            items.forEach((item) => {
              item.hidden = Boolean(active) && item.dataset.category !== active;
            });
            updateFilterStatus(active);
            list?.classList.remove("is-filtering");
          },
          reduceMotion ? 0 : 140,
        );
      };

      filterTabs.forEach((tab) => {
        tab.addEventListener("click", () => applyFilter(tab.dataset.projectFilter ?? ""), {
          signal,
        });
      });

      filterTabList?.addEventListener(
        "keydown",
        (event) => {
          const key = event.key;
          if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(key)) {
            return;
          }

          const currentIndex = filterTabs.findIndex(
            (tab) => tab.getAttribute("aria-pressed") === "true",
          );
          if (currentIndex === -1) {
            return;
          }

          event.preventDefault();

          let nextIndex = currentIndex;
          if (key === "ArrowLeft") {
            nextIndex = currentIndex === 0 ? filterTabs.length - 1 : currentIndex - 1;
          } else if (key === "ArrowRight") {
            nextIndex = currentIndex === filterTabs.length - 1 ? 0 : currentIndex + 1;
          } else if (key === "Home") {
            nextIndex = 0;
          } else if (key === "End") {
            nextIndex = filterTabs.length - 1;
          }

          const nextTab = filterTabs[nextIndex];
          applyFilter(nextTab?.dataset.projectFilter ?? "");
          nextTab?.focus();
        },
        { signal },
      );

      resetFilter?.addEventListener("click", () => applyFilter(""), { signal });

      applyFilter(readFilterFromUrl(), false);

      return () => controller.abort();
    });
  </script>
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(5rem, 10vw, 8rem) clamp(2rem, 4vw, 3rem);
  }

  .page-hero-inner {
    display: grid;
    gap: 0.75rem;
  }

  .page-hero .display em {
    font-style: italic;
  }

  .project-work {
    display: grid;
    gap: var(--space-block-inner);
  }

  .archive-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    align-items: center;
  }

  .filter-status {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
  }

  .filter-tabs button {
    border: 0;
    background: none;
    color: var(--ink-muted);
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1;
    padding: 0.4rem 0;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    transition:
      color var(--motion-fast) var(--ease-standard),
      text-decoration-color var(--motion-fast) var(--ease-standard);
  }

  .filter-tabs button:hover {
    color: var(--ink);
    text-decoration-color: var(--line-strong);
  }

  .filter-tabs button[aria-pressed="true"] {
    color: var(--rust-deep);
    text-decoration-color: var(--rust);
  }

  .filter-reset {
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: none;
    color: var(--ink-muted);
    cursor: pointer;
    font-size: 0.72rem;
    line-height: 1;
    padding: 0.42rem 0.7rem;
  }

  .filter-reset:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .archive-list {
    display: grid;
    transition: opacity var(--motion-fast) var(--ease-standard);
  }

  .archive-list.is-filtering {
    opacity: 0.35;
  }

  .archive-row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 2rem;
    gap: 1rem;
    align-items: baseline;
    border-top: 1px solid var(--line);
    padding-block: clamp(1rem, 2.2vw, 1.4rem);
  }

  .archive-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .archive-row[hidden] {
    display: none;
  }

  .archive-index {
    position: relative;
    justify-self: start;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1;
  }

  .archive-index::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.9rem;
    height: 1.55rem;
    border: 1.5px solid var(--signal);
    border-radius: 52% 48% 55% 45% / 60% 55% 45% 50%;
    content: "";
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.6) rotate(-6deg);
    transition:
      opacity var(--motion-medium) var(--ease-out),
      transform var(--motion-medium) var(--ease-out);
    pointer-events: none;
  }

  .archive-row:hover .archive-index::after,
  .archive-row:focus-visible .archive-index::after {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1) rotate(-6deg);
  }

  .archive-flag {
    display: inline-flex;
    align-items: center;
    gap: 0.34rem;
    margin-left: 0.55rem;
    color: var(--signal);
    letter-spacing: 0.06em;
  }

  .archive-flag-dot {
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 999px;
    background: var(--signal);
  }

  .archive-copy {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .archive-title {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2.4vw, 1.7rem);
    font-weight: 480;
    letter-spacing: -0.005em;
    line-height: 1.2;
    transition:
      color var(--motion-fast) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
  }

  .archive-meta {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .archive-arrow {
    color: var(--ink-soft);
    text-align: right;
    transition:
      color var(--motion-fast) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
  }

  .archive-row:hover .archive-title,
  .archive-row:focus-visible .archive-title {
    color: var(--rust-deep);
    transform: translateX(0.35rem);
  }

  .archive-row:hover .archive-arrow,
  .archive-row:focus-visible .archive-arrow {
    color: var(--rust);
    transform: translateX(4px);
  }

  @media (max-width: 720px) {
    .archive-row {
      grid-template-columns: 2rem minmax(0, 1fr) 1.5rem;
    }
  }
</style>
