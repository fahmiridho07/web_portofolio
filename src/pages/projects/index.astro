---
import ProjectCard from "@components/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { projectCategories } from "@data/profile";
import { getSortedProjects } from "@lib/projects";

const projects = await getSortedProjects();
const activeCategories = projectCategories.filter((category) =>
  projects.some((project) => project.data.category === category.id),
);
---

<BaseLayout
  title="Projects"
  description="Focused project index for data products, predictive modeling, decision support, analytics, and deployment proof."
>
  <section class="page-hero dark-section" data-dark-section>
    <div class="container">
      <p class="eyebrow">Project Index</p>
      <h1 class="display">Evidence for data products that ship.</h1>
      <p class="lead">
        Modeling, dashboards, workflow automation, deployment, and decision
        support, shown through the artifacts themselves.
      </p>
    </div>
  </section>

  <section class="project-index divider">
    <div class="container project-work">
      <div class="filter-tabs" aria-label="Project category filters">
        <button type="button" data-project-filter="" aria-pressed="true">All</button>
        {
          activeCategories.map((category) => (
            <button type="button" data-project-filter={category.id} aria-pressed="false">
              {category.title}
            </button>
          ))
        }
      </div>

      <div class="project-grid" data-filter-list>
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <script>
    const filterTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-project-filter]"));
    const list = document.querySelector<HTMLElement>("[data-filter-list]");
    const items = Array.from(document.querySelectorAll<HTMLElement>("[data-category]"));

    filterTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const active = tab.dataset.projectFilter ?? "";
        list?.classList.add("is-filtering");

        window.setTimeout(() => {
          filterTabs.forEach((item) => {
            item.setAttribute("aria-pressed", String((item.dataset.projectFilter ?? "") === active));
          });
          items.forEach((item) => {
            item.hidden = Boolean(active) && item.dataset.category !== active;
          });
          list?.classList.remove("is-filtering");
        }, 120);
      });
    });
  </script>
</BaseLayout>

<style>
  .page-hero {
    background: var(--surface-base);
    color: #ffffff;
    padding-block: clamp(7rem, 12vw, 10rem) clamp(4rem, 8vw, 6rem);
  }

  .page-hero .display {
    max-width: 840px;
    color: #ffffff;
  }

  .page-hero .lead {
    color: rgba(255, 255, 255, 0.72);
  }

  .project-index {
    background: var(--surface-light);
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .project-work {
    display: grid;
    gap: clamp(1rem, 3vw, 1.5rem);
  }

  .filter-tabs {
    display: flex;
    gap: 0.55rem;
    overflow-x: auto;
    padding-bottom: 0.15rem;
    scrollbar-width: none;
  }

  .filter-tabs::-webkit-scrollbar {
    display: none;
  }

  .filter-tabs button {
    flex: 0 0 auto;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1;
    padding: 0.58rem 0.72rem;
    white-space: nowrap;
  }

  .filter-tabs button[aria-pressed="true"] {
    background: var(--accent-dim);
    border-color: rgba(29, 158, 117, 0.32);
    color: var(--text);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.9rem, 2.5vw, 1.25rem);
    transition: opacity 150ms ease;
  }

  .project-grid.is-filtering {
    opacity: 0.3;
  }

  @media (max-width: 760px) {
    .page-hero {
      padding-block: 6.5rem 4rem;
    }

    .project-index {
      padding-block: 3.25rem;
    }

    .filter-tabs {
      margin-inline: -0.625rem;
      padding-inline: 0.625rem;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
