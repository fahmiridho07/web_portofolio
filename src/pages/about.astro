    transition: all var(--motion-fast) var(--ease-standard);
  }

  .roadmap-card:hover .marker-dot {
    border-color: var(--signal);
    background: var(--signal);
  }

  .marker-pulse {
    position: absolute;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
