  }

  .portrait-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-reticle {
    position: absolute;
    inset: 10px;
    pointer-events: none;
  }

  .reticle-corner {
    position: absolute;
    width: 8px;
    height: 8px;
    border-color: rgba(255, 255, 255, 0.7);
    border-style: solid;
  }

  .c-tl {
    top: 0;
    left: 0;
    border-width: 1.5px 0 0 1.5px;
  }
  .c-tr {
    top: 0;
    right: 0;
    border-width: 1.5px 1.5px 0 0;
  }
  .c-bl {
    bottom: 0;
    left: 0;
    border-width: 0 0 1.5px 1.5px;
  }
  .c-br {
    bottom: 0;
    right: 0;
    border-width: 0 1.5px 1.5px 0;
  }

  .photo-telemetry {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 8px;
    padding-inline: 4px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--ink-soft);
  }

  /* ------------------------------- Section Common Headers ------------------------------- */

  .section-header {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }

  .badge-num {
    color: var(--signal);
    font-weight: 700;
  }

  .section-heading {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(2.1rem, 4.2vw, 3.4rem);
    font-weight: 480;
    line-height: 1.14;
    letter-spacing: -0.01em;
  }

  .section-subhead {
    margin: 0;
    color: var(--ink-muted);
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.65;
    max-width: 56ch;
  }

  /* ---------------------- Chapter 2: Interactive Roadmap ---------------------- */

  .roadmap-section {
    padding-block: clamp(4rem, 8vw, 6.5rem);
    background: var(--paper);
  }

  .roadmap-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .roadmap-spine {
    position: absolute;
    left: 20px;
    top: 20px;
    bottom: 20px;
    width: 2px;
    background: var(--line);
  }

  .roadmap-nodes {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .roadmap-card {
    position: relative;
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 1.5rem;
    align-items: flex-start;
  }

  .card-marker {
    position: relative;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .marker-dot {
