---
// about.astro: Top-Tier Minimalist Editorial Portfolio About Page
// Inspired by Paco Coursey (paco.me), Brian Lovin (brianlovin.com), and Lee Robinson (leerob.io)
// Focus: Restrained typography, authentic voice, generous whitespace, and zero artificial gimmicks.

import { education, profile } from "@data/profile";
import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getProfilePageSchema } from "@lib/seo";
import { getImageMeta } from "@lib/images";
import { getResumeAction } from "@lib/resume";

const gpaShort = education.gpa.split("/")[0]?.trim() ?? education.gpa;
const siteUrl = Astro.site?.href ?? Astro.url.origin;
const profilePageSchema = getProfilePageSchema(siteUrl);
const aboutOgImage = getImageMeta(pageSeo.about.ogImagePath);
const profileImage = "/assets/profile/profile_photo.webp";
const profileImageSrcset =
  "/assets/profile/profile_photo-640.webp 640w, /assets/profile/profile_photo-960.webp 960w, /assets/profile/profile_photo.webp 1200w";
const profileImageMeta = getImageMeta(profileImage);
const resumeAction = getResumeAction();

// Chronological experience & research history
const experiences = [
  {
    period: "2025 &ndash; 2026",
    role: "Undergraduate Thesis Researcher",
    org: "ITS Surabaya",
    desc: "Researching deep generative Autoencoders for extreme class imbalance in financial transaction datasets. Achieved 0.8547 PR-AUC through Bayesian-tuned latent representation oversampling.",
  },
  {
    period: "2024 &ndash; 2025",
    role: "Software Engineer Intern",
    org: "PT Kaltim Prima Coal",
    desc: "Engineered and stabilized enterprise innovation platform (IdeKU V3) on ASP.NET Core for 5,000+ mining employees. Implemented role-based access control and automated multi-tier approval workflows.",
  },
  {
    period: "2022 &ndash; 2024",
    role: "Teaching Assistant",
    org: "ITS Surabaya",
    desc: "Assisted undergraduate laboratory sessions in Enterprise Systems Architecture, Database Modeling, and Object-Oriented Software Design.",
  },
];

// Engineering principles
const principles = [
  {
    num: "01",
    title: "Architecture Before Code",
    desc: "I believe software should be modeled around clear domain boundaries and data contracts before writing business logic. Clean schemas prevent entire classes of production bugs.",
  },
  {
    num: "02",
    title: "Empirical Rigour in ML",
    desc: "In skewed real-world data, accuracy is a vanity metric. I focus on leak-free validation, Precision-Recall AUC, and calibrated probability thresholds to solve genuine business problems.",
  },
  {
    num: "03",
    title: "Craft in the Small Things",
    desc: "Sub-millisecond backend latency, strict typing, thoughtful error messages, and accessible layouts are not extras—they are the definition of respectful engineering.",
  },
];
---

<BaseLayout
  title={pageSeo.about.title}
  description={pageSeo.about.description}
  jsonLd={profilePageSchema}
  ogImagePath={pageSeo.about.ogImagePath}
  ogImageAlt={pageSeo.about.ogImageAlt}
  ogImageWidth={aboutOgImage?.width}
  ogImageHeight={aboutOgImage?.height}
>
  <main class="editorial-about">
    <article class="container about-container" data-reveal>
      <!-- HEADER MASTHEAD -->
      <header class="about-header">
        <div class="header-meta">
          <span class="meta-label">ABOUT // ACHMAD FAHMI AINUR RIDHO</span>
          <span class="status-indicator">
            <span class="status-dot"></span>
            OPEN TO 2026 ROLES
          </span>
        </div>

        <h1 class="display about-title">
          Building resilient backends and researching machine learning for
          complex data.
        </h1>
      </header>

      <!-- BIO & PORTRAIT SECTION -->
      <section class="about-bio-section">
        <div class="bio-grid">
          <div class="bio-portrait-wrap">
            <figure class="portrait-figure">
              <img
                src={profileImage}
                srcset={profileImageSrcset}
                sizes="(max-width: 700px) 100vw, 220px"
                alt="Portrait of Achmad Fahmi Ainur Ridho"
                width={profileImageMeta?.width}
                height={profileImageMeta?.height}
                loading="eager"
                decoding="async"
                class="portrait-img"
              />
              <figcaption class="portrait-caption">
                Surabaya, ID &middot; Final Year
              </figcaption>
            </figure>
          </div>

          <div class="bio-prose">
            <p class="lead-text">
              I&rsquo;m a final-year Information Systems student at <strong
                >Institut Teknologi Sepuluh Nopember (ITS Surabaya)</strong
              > with an academic GPA of <strong>{gpaShort}/4.00</strong>,
              bridging the gap between full-stack systems engineering and
              applied AI research.
            </p>
            <p>
              My engineering journey started in enterprise software, developing
              and stabilizing large-scale applications with C# and ASP.NET Core
              for 5,000+ staff at <strong>PT Kaltim Prima Coal</strong>. Working
              with real production relational databases taught me to respect
              system reliability, clean domain contracts, and thoughtful
              performance tuning.
            </p>
            <p>
              Over time, I found myself drawn deeper into what data can predict
              rather than just how it is stored. Today, my primary research
              focuses on tackling extreme class imbalance in fraud detection
              using deep generative Autoencoders in latent space—combining
              rigorous data science with production-minded engineering.
            </p>
          </div>
        </div>
      </section>

      <!-- NOW (CURRENT FOCUS & STATUS) -->
      <section class="now-section">
        <div class="now-card">
          <div class="now-heading">
            <span class="now-pulse"></span>
            <h2 class="now-title">Now</h2>
            <span class="now-date">Early 2026</span>
          </div>
          <ul class="now-list">
            <li>
              <strong>Thesis:</strong> Finalizing research on Bayesian-tuned latent
              Autoencoders for fraud detection with zero data leakage.
            </li>
            <li>
              <strong>Engineering:</strong> Exploring high-throughput distributed
              microservices, Rust-based tooling, and low-latency web architecture.
            </li>
            <li>
              <strong>Status:</strong> Graduating in 2026. Actively looking for full-time
              Software Engineering and AI/ML roles where I can contribute to reliable
              systems.
            </li>
          </ul>
        </div>
      </section>

      <!-- EXPERIENCE & RESEARCH HISTORY -->
      <section class="history-section">
        <h2 class="section-label">Experience &amp; Research</h2>
        <div class="experience-list">
          {
            experiences.map((exp) => (
              <div class="exp-item">
                <div class="exp-meta">
                  <span class="exp-period" set:html={exp.period} />
                  <span class="exp-org">{exp.org}</span>
                </div>
                <div class="exp-body">
                  <h3 class="exp-role">{exp.role}</h3>
                  <p class="exp-desc">{exp.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- HOW I THINK / PRINCIPLES -->
      <section class="principles-section">
        <h2 class="section-label">Engineering Principles</h2>
        <div class="principles-list">
          {
            principles.map((p) => (
              <div class="principle-item">
                <span class="p-num">{p.num}</span>
                <div class="p-body">
                  <h3 class="p-title">{p.title}</h3>
                  <p class="p-desc">{p.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- FOOTER LINKS & CHANNELS -->
      <footer class="about-footer-nav">
        <div class="footer-cta-box">
          <p class="cta-kicker">WORK WITH ME</p>
          <h2 class="cta-title">Let&rsquo;s talk software or research.</h2>
          <p class="cta-sub">
            Whether you are building a resilient engineering team or exploring
            applied machine learning, I&rsquo;d love to connect.
          </p>

          <div class="links-row">
            <a href={profile.emailHref} class="link-btn primary-btn">
              Send an Email <span aria-hidden="true">&nearr;</span>
            </a>
            <a
              href="https://id.linkedin.com/in/fahmiridho"
              target="_blank"
              rel="noreferrer"
              class="link-btn"
            >
              LinkedIn <span aria-hidden="true">&nearr;</span>
            </a>
            <a
              href="https://github.com/fahmiridho07"
              target="_blank"
              rel="noreferrer"
              class="link-btn"
            >
              GitHub <span aria-hidden="true">&nearr;</span>
            </a>
            <a
              href={resumeAction.href}
              download={resumeAction.download ? "" : undefined}
              class="link-btn resume-btn"
            >
              {resumeAction.label}
              <span aria-hidden="true">&darr;</span>
            </a>
          </div>

          <div class="projects-bridge">
            <a
              href="/projects/"
              class="bridge-link"
              data-astro-prefetch="hover"
            >
              &larr; Browse All 11 Projects &amp; Case Studies
            </a>
          </div>
        </div>
      </footer>
    </article>
  </main>
</BaseLayout>

<style>
  /* ------------------------------- Editorial Container ------------------------------- */

  .editorial-about {
    background: var(--paper);
    padding-top: var(--space-hero-top);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .about-container {
    max-width: 780px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 4.5rem);
  }

  /* ------------------------------- Header Masthead ------------------------------- */

  .about-header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .header-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    font-weight: 600;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink);
    background: #ffffff;
    border: 1px solid var(--line);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--signal);
    box-shadow: 0 0 6px rgba(201, 46, 62, 0.6);
  }

  .about-title {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(2.3rem, 4.8vw, 3.6rem);
    font-weight: 480;
    line-height: 1.14;
    letter-spacing: -0.015em;
  }

  /* ------------------------------- Bio & Portrait ------------------------------- */

  .bio-grid {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: flex-start;
  }

  .bio-portrait-wrap {
    position: sticky;
    top: 6rem;
  }

  .portrait-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .portrait-img {
    width: 100%;
    aspect-ratio: 0.88;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-strong);
    background: var(--paper-soft);
    box-shadow: 0 10px 24px rgba(22, 24, 29, 0.04);
  }

  .portrait-caption {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-soft);
    text-align: center;
    letter-spacing: 0.06em;
  }

  .bio-prose {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--ink-muted);
  }

  .bio-prose p {
    margin: 0;
  }

  .bio-prose strong {
    color: var(--ink);
    font-weight: 600;
  }

  .lead-text {
    font-size: 1.15rem;
    color: var(--ink);
    line-height: 1.65;
  }

  /* ------------------------------- Now Card ------------------------------- */

  .now-section {
    width: 100%;
  }

  .now-card {
    background: #ffffff;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 4px 16px rgba(22, 24, 29, 0.03);
  }

  .now-heading {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .now-pulse {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #2e7d32;
    box-shadow: 0 0 8px rgba(46, 125, 50, 0.6);
  }

  .now-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--ink);
  }

  .now-date {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-soft);
    margin-left: auto;
    letter-spacing: 0.06em;
  }

  .now-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--ink-muted);
  }

  .now-list strong {
    color: var(--ink);
    font-weight: 600;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    margin-right: 0.35rem;
  }

  /* ------------------------------- Section Label ------------------------------- */

  .section-label {
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.75rem;
  }

  /* ------------------------------- Experience List ------------------------------- */

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .exp-item {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
  }

  .exp-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .exp-period {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--ink-soft);
    letter-spacing: 0.04em;
  }

  .exp-org {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink);
  }

  .exp-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .exp-role {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.18rem;
    font-weight: 500;
    color: var(--ink);
  }

  .exp-desc {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--ink-muted);
  }

  /* ------------------------------- Principles ------------------------------- */

  .principles-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .principle-item {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 1.25rem;
    align-items: baseline;
  }

  .p-num {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--signal);
  }

  .p-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .p-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.18rem;
    font-weight: 500;
    color: var(--ink);
  }

  .p-desc {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--ink-muted);
  }

  /* ------------------------------- Footer Nav & CTA ------------------------------- */

  .about-footer-nav {
    border-top: 1px solid var(--line);
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  .footer-cta-box {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .cta-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }

  .cta-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.8vw, 2.5rem);
    font-weight: 480;
    color: var(--ink);
    line-height: 1.2;
  }

  .cta-sub {
    margin: 0 0 1rem;
    font-size: 1.02rem;
    color: var(--ink-muted);
    line-height: 1.65;
    max-width: 48ch;
  }

  .links-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--ink);
    background: #ffffff;
    border: 1px solid var(--line);
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all var(--motion-fast) var(--ease-standard);
  }

  .link-btn:hover {
    border-color: var(--ink);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(22, 24, 29, 0.04);
  }

  .primary-btn {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
    font-weight: 600;
  }

  .primary-btn:hover {
    background: var(--signal-deep);
    border-color: var(--signal-deep);
    color: #ffffff;
  }

  .resume-btn {
    color: var(--signal-deep);
    border-color: rgba(201, 46, 62, 0.25);
  }

  .resume-btn:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

  .projects-bridge {
    margin-top: 1.5rem;
  }

  .bridge-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .bridge-link:hover {
    color: var(--ink);
  }

  /* ------------------------------- Responsive ------------------------------- */

  @media (max-width: 700px) {
    .bio-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .bio-portrait-wrap {
      position: static;
      max-width: 180px;
    }

    .exp-item {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .principle-item {
      grid-template-columns: 28px minmax(0, 1fr);
      gap: 0.75rem;
    }
  }
</style>
