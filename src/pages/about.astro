---
import FocusPanel from "@components/FocusPanel.astro";
import OrganizationLogo from "@components/OrganizationLogo.astro";
import SectionHeader from "@components/SectionHeader.astro";
import {
  coursesAndCertificates,
  education,
  experiences,
  profile,
  skillGroups,
} from "@data/profile";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getImageMeta } from "@lib/images";
import { getLogoItems } from "@lib/logos";

const primarySkills = new Set([
  "ASP.NET Core",
  "Python",
  "SQL Server",
  "Power BI",
  "Microsoft Power Automate",
]);
const profileHighlights = [
  profile.availability,
  `${profile.location} based`,
  `GPA ${education.gpa}`,
];
const profileAvatar = "/assets/profile/profile_avatar-160.webp";
const profileAvatarSrcset =
  "/assets/profile/profile_avatar-96.webp 96w, /assets/profile/profile_avatar-160.webp 160w";
const profileAvatarMeta = getImageMeta(profileAvatar);
const profileImage = "/assets/profile/profile_photo.webp";
const profileImageSrcset =
  "/assets/profile/profile_photo-640.webp 640w, /assets/profile/profile_photo-960.webp 960w, /assets/profile/profile_photo.webp 1200w";
const profileImageMeta = getImageMeta(profileImage);
---

<BaseLayout
  title="About"
  description="About Achmad Fahmi Ainur Ridho, a final-year Information Systems student at ITS focused on practical data products, machine learning, analytics, and backend workflows."
>
  <section class="section about-hero dark-section" data-dark-section>
    <div class="container about-grid">
      <div>
        <div class="about-person">
          <img
            src={profileAvatar}
            srcset={profileAvatarSrcset}
            sizes="54px"
            alt=""
            width={profileAvatarMeta?.width}
            height={profileAvatarMeta?.height}
            loading="eager"
            decoding="async"
          />
          <p class="eyebrow">{profile.name}</p>
        </div>
        <h1 class="display">Building practical data products across ML, analytics, and backend workflows.</h1>
      </div>
      <div class="about-lead">
        <p class="lead">
          I focus on machine learning, analytics, and backend workflows: the parts
          that turn messy data and business problems into usable systems.
        </p>
        <p class="target-line">{profile.roleSignal}</p>
      </div>
    </div>
  </section>

  <section class="section-tight profile-section">
    <div class="container profile-card">
      <div class="portrait">
        <img
          src={profileImage}
          srcset={profileImageSrcset}
          sizes="(max-width: 900px) calc(100vw - 1.25rem), 42vw"
          alt="Portrait of Achmad Fahmi Ainur Ridho"
          width={profileImageMeta?.width}
          height={profileImageMeta?.height}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="profile-copy">
        <p class="eyebrow">Positioning</p>
        <h2>{profile.headline}</h2>
        <p>
          My strongest work sits where data needs to become a usable artifact:
          an evaluated model, a dashboard, a deployed workflow, or a decision
          support system.
        </p>
        <ul class="profile-highlights" aria-label="Profile highlights">
          {profileHighlights.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-tight divider">
    <div class="container two-col">
      <SectionHeader eyebrow="Education" title="Academic foundation." />

      <div class="info-panel">
        <div class="info-kicker">
          <OrganizationLogo organization={education.institution} size="lg" />
          <div class="org-copy">
            <p class="org-name">{education.institution}</p>
            <p class="org-detail">{education.degree}</p>
          </div>
        </div>
        <dl>
          <div>
            <dt>Period</dt>
            <dd>{education.period}</dd>
          </div>
          <div>
            <dt>GPA</dt>
            <dd>{education.gpa}</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>{education.focus}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section-tight divider">
    <div class="container">
      <SectionHeader
        eyebrow="Experience"
        title="Experience that supports data-product work."
      />

      <div class="experience-list">
        {
          experiences.map((item) => (
            <article>
              <div class="experience-kicker">
                <OrganizationLogo organization={item.organization} size="lg" />
                <p class="org-name">{item.organization}</p>
              </div>
              <h3>{item.role}</h3>
              <p>{item.summary}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight divider">
    <div class="container">
      <SectionHeader eyebrow="Skills" title="Tools grouped around the target role." />

      <div class="skill-grid">
        {
          skillGroups.map((group) => {
            const primary = group.items.filter((item) => primarySkills.has(item));
            const secondary = group.items.filter((item) => !primarySkills.has(item));
            const primaryItems = getLogoItems(primary);

            return (
              <article>
                <h3>{group.title}</h3>
                {primary.length > 0 && (
                  <ul class="primary-skills" aria-label={`${group.title} primary skills`}>
                    {
                      primaryItems.map((item) => (
                        <li class:list={[item.logo && "has-logo"]}>
                          {item.logo && <img src={item.logo} alt="" width="24" height="24" loading="lazy" />}
                          <span>{item.label}</span>
                        </li>
                      ))
                    }
                  </ul>
                )}
                {secondary.length > 0 && (
                  <ul class="secondary-skills" aria-label={`${group.title} secondary skills`}>
                    {secondary.map((item) => <li>{item}</li>)}
                  </ul>
                )}
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section-tight divider">
    <div class="container workflow-grid">
      <div>
        <p class="eyebrow">Enterprise Systems</p>
        <h2>Workflow proof beyond project cards.</h2>
      </div>
      <div class="workflow-panels">
        <article>
          <h3>Odoo ERP teaching support</h3>
          <p>
            Guided students through Sales, Inventory, Human Resources, and
            Accounting modules while reviewing implementation projects.
          </p>
        </article>
        <article>
          <h3>Operational documentation</h3>
          <p>
            HMSI R&D work included SOPs, internal process optimization,
            supervision, documentation, and project delivery coordination.
          </p>
        </article>
        <article>
          <h3>Courses & applied evidence</h3>
          <ul>
            {coursesAndCertificates.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section id="contact" class="section-tight divider">
    <div class="container">
      <FocusPanel />
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 20% 18%, rgba(125, 211, 252, 0.14), transparent 24rem),
      radial-gradient(circle at 86% 24%, rgba(167, 243, 208, 0.12), transparent 28rem),
      linear-gradient(135deg, #07111e 0%, #111d2e 56%, #171321 100%);
    color: #ffffff;
    padding-block: clamp(6rem, 9vw, 7.8rem) clamp(3rem, 5vw, 4.2rem);
  }

  .about-hero::before {
    position: absolute;
    inset: 0;
    opacity: 0.16;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 4.5rem 4.5rem;
    mask-image: linear-gradient(180deg, #000, transparent 82%);
    content: "";
    pointer-events: none;
  }

  .about-hero .display {
    max-width: 820px;
    color: #ffffff;
  }

  .about-hero .lead {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
  }

  .about-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(18rem, 0.42fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
  }

  .about-lead {
    display: grid;
    gap: 1rem;
  }

  .target-line {
    margin: 0;
    border-left: 2px solid #9be7d4;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.55;
    padding-left: 0.82rem;
  }

  .about-person {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.85rem;
  }

  .about-person img {
    width: 3rem;
    height: 3rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    object-fit: cover;
    object-position: center 56%;
  }

  .about-person .eyebrow {
    margin: 0;
  }

  .profile-card {
    display: grid;
    grid-template-columns: minmax(18rem, 0.42fr) 1fr;
    gap: clamp(2rem, 6vw, 4rem);
    align-items: center;
  }

  .portrait {
    border: 1px solid var(--line);
    border-radius: 8px;
    min-height: clamp(26rem, 48vw, 36rem);
    background: var(--surface);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  .profile-copy {
    display: grid;
    align-content: center;
  }

  .profile-copy h2,
  .workflow-grid h2 {
    max-width: 760px;
    margin: 0.75rem 0 0;
    color: var(--text);
    font-size: clamp(1.7rem, 3vw, 2.8rem);
    line-height: 1.04;
    letter-spacing: 0;
  }

  .profile-copy p:not(.eyebrow) {
    max-width: 680px;
    margin: 1rem 0 0;
    color: var(--text-muted);
  }

  .profile-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.15rem 0 0;
    padding: 0;
    list-style: none;
  }

  .profile-highlights li {
    border: 1px solid rgba(15, 159, 135, 0.2);
    border-radius: 999px;
    background: var(--accent-dim);
    color: #0f766e;
    font-size: 0.78rem;
    line-height: 1.25;
    padding: 0.48rem 0.66rem;
  }

  .two-col {
    display: grid;
    gap: 1.25rem;
  }

  .info-panel {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.68);
    box-shadow: 0 14px 42px rgba(17, 24, 39, 0.04);
    padding: clamp(1rem, 3vw, 1.6rem);
  }

  .info-kicker,
  .experience-kicker {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
  }

  .org-copy {
    display: grid;
    gap: 0.28rem;
    align-self: center;
    min-width: 0;
  }

  .org-name,
  .org-detail {
    margin: 0;
  }

  .org-name {
    color: var(--text);
    font-size: 0.94rem;
    font-weight: 600;
    line-height: 1.38;
    text-wrap: pretty;
  }

  .org-detail {
    color: var(--text-muted);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .experience-kicker .org-name {
    align-self: center;
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .info-panel h2,
  .experience-list h3,
  .skill-grid h3,
  .workflow-panels h3 {
    margin: 0;
    color: var(--text);
    font-size: 1.15rem;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .info-kicker {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  dl {
    display: grid;
    gap: 0;
    margin: 0;
  }

  dl div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding-block: 0.9rem;
  }

  dt {
    color: var(--text-soft);
    font-size: 0.74rem;
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--text);
    font-weight: 500;
  }

  .experience-list,
  .skill-grid,
  .workflow-panels {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .experience-list article,
  .skill-grid article,
  .workflow-panels article {
    min-height: 15rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.58);
    padding: clamp(1rem, 2vw, 1.35rem);
  }

  .experience-kicker {
    margin-bottom: 0.35rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(17, 24, 39, 0.08);
  }

  .experience-list h3 {
    margin-top: 0.7rem;
    font-size: 1.05rem;
    line-height: 1.22;
  }

  .experience-list p,
  .workflow-panels p {
    margin: 0.8rem 0 0;
    color: var(--text-muted);
  }

  .skill-grid ul,
  .workflow-panels ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .skill-grid li,
  .workflow-panels li {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    border-radius: 999px;
    background: rgba(143, 232, 194, 0.07);
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1;
    padding: 0.42rem 0.62rem;
  }

  .skill-grid li img {
    width: 1.12rem;
    height: 1.12rem;
    box-sizing: content-box;
    flex: 0 0 auto;
    border-radius: 0;
    background: transparent;
    object-fit: contain;
    padding: 0;
    box-shadow: none;
  }

  .skill-grid .primary-skills {
    gap: 0.5rem;
  }

  .skill-grid .primary-skills li {
    background: rgba(236, 253, 245, 0.9);
    color: var(--text);
    font-size: 0.94rem;
    font-weight: 500;
    padding: 0.48rem 0.72rem;
  }

  .skill-grid .secondary-skills {
    margin-top: 0.75rem;
  }

  .skill-grid .secondary-skills li {
    background: transparent;
    color: var(--text-soft);
    font-size: 0.74rem;
    padding: 0.28rem 0;
  }

  .skill-grid .secondary-skills img {
    display: none;
  }

  .workflow-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.35fr) 1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  @media (max-width: 900px) {
    .about-grid,
    .profile-card,
    .workflow-grid,
    .experience-list,
    .skill-grid,
    .workflow-panels {
      grid-template-columns: 1fr;
    }

    .portrait {
      min-height: 18rem;
    }

    .experience-list article,
    .skill-grid article,
    .workflow-panels article {
      min-height: auto;
    }
  }

  @media (max-width: 620px) {
    .about-hero {
      padding-block: 6rem 3.2rem;
    }

    .about-grid {
      gap: 1.1rem;
    }

    .profile-section {
      padding-block-start: 2.25rem;
    }

    .profile-card {
      gap: 1.15rem;
    }

    .portrait {
      min-height: 15rem;
      border-radius: 8px;
    }

    .portrait img {
      object-position: center 42%;
    }

    .profile-copy h2,
    .workflow-grid h2 {
      font-size: 1.55rem;
      line-height: 1.08;
    }

    dl div {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .experience-list,
    .skill-grid,
    .workflow-panels {
      gap: 0.75rem;
      border: 0;
    }

    .experience-list article,
    .skill-grid article,
    .workflow-panels article {
      border: 1px solid var(--line);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.46);
    }

    .org-name {
      font-size: 0.88rem;
      line-height: 1.4;
    }

    .org-detail {
      font-size: 0.82rem;
    }

    .experience-list p,
    .workflow-panels p {
      display: -webkit-box;
      overflow: hidden;
      font-size: 0.9rem;
      line-height: 1.58;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }


  }
</style>
