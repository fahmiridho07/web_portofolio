---
import OrganizationLogo from "@components/OrganizationLogo.astro";
import {
  education,
  experiences,
  heroProjectSlug,
  profile,
  skillGroups,
  whyMeItems,
} from "@data/profile";
import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getProfilePageSchema } from "@lib/seo";
import { getImageMeta } from "@lib/images";
import { getSortedProjects } from "@lib/projects";

const gpaShort = education.gpa.split("/")[0]?.trim() ?? education.gpa;
const siteUrl = Astro.site?.href ?? Astro.url.origin;
const profilePageSchema = getProfilePageSchema(siteUrl);
const aboutOgImage = getImageMeta(pageSeo.about.ogImagePath);
const profileImage = "/assets/profile/profile_photo.webp";
const profileImageSrcset =
  "/assets/profile/profile_photo-640.webp 640w, /assets/profile/profile_photo-960.webp 960w, /assets/profile/profile_photo.webp 1200w";
const profileImageMeta = getImageMeta(profileImage);

const allProjects = await getSortedProjects();
const heroProject =
  allProjects.find((project) => project.data.slug === heroProjectSlug) ?? allProjects[0];
---

<BaseLayout
  title={pageSeo.about.title}
  description={pageSeo.about.description}
  jsonLd={profilePageSchema}
  ogImagePath={pageSeo.about.ogImagePath}
  ogImageAlt={pageSeo.about.ogImageAlt}
  ogImageWidth={aboutOgImage?.width}
  ogImageHeight={aboutOgImage?.height}
>
  <section class="about-hero">
    <div class="container about-hero-inner" data-reveal>
      <p class="about-kicker">{profile.name} &middot; {profile.role}</p>
      <h1 class="display">{profile.headline}</h1>
      <p class="role-signal">{profile.roleSignal}</p>
      <p class="about-facts">
        {profile.availability} &middot; GPA {gpaShort} &middot; Surabaya, Indonesia
      </p>
    </div>
  </section>

  <section class="profile-strip divider">
    <div class="container profile-card" data-reveal>
      <figure class="portrait">
        <img
          src={profileImage}
          srcset={profileImageSrcset}
          sizes="(max-width: 900px) calc(100vw - 1.5rem), 24vw"
          alt="Portrait of Achmad Fahmi Ainur Ridho"
          width={profileImageMeta?.width}
          height={profileImageMeta?.height}
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="profile-copy">
        <p class="profile-summary">{profile.summary}</p>
        <p class="profile-hook">{profile.aboutHook}</p>
        {
          heroProject && (
            <a class="profile-shipped" href={`/projects/${heroProject.data.slug}/`} data-astro-prefetch="hover">
              {profile.lastShippedLabel}: {heroProject.data.title}
              <span aria-hidden="true">-&gt;</span>
            </a>
          )
        }
      </div>
    </div>
  </section>

  <section class="about-section divider">
    <div class="container">
      <h2 class="section-label" data-reveal>Education</h2>

      <div class="edu-row" data-reveal>
        <div class="edu-org">
          <OrganizationLogo organization={education.institution} size="md" />
          <div>
            <p class="edu-name">{education.institution}</p>
            <p class="edu-degree">{education.degree}</p>
          </div>
        </div>
        <dl class="edu-facts">
          <div>
            <dt>Period</dt>
            <dd>{education.period}</dd>
          </div>
          <div>
            <dt>GPA</dt>
            <dd>{education.gpa}</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>{education.focus}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="about-section divider">
    <div class="container">
      <h2 class="section-label" data-reveal>Experience</h2>

      <ol class="xp-list">
        {
          experiences.map((item, index) => (
            <li class="xp-row" data-reveal data-reveal-delay={String((index + 1) * 50)}>
              <p class="xp-period">{item.period}</p>

              <div class="xp-content">
                <div class="xp-org">
                  <OrganizationLogo organization={item.organization} size="sm" />
                  <span>{item.organization}</span>
                </div>
                <h3 class="xp-role">{item.role}</h3>
                <p class="xp-summary">{item.summary}</p>
                <p class="xp-proof">{item.proof}</p>
                {
                  item.relatedProjectSlug && (
                    <a
                      class="xp-link"
                      href={`/projects/${item.relatedProjectSlug}/`}
                      data-astro-prefetch="hover"
                    >
                      See the build <span aria-hidden="true">-&gt;</span>
                    </a>
                  )
                }
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="about-section divider">
    <div class="container">
      <h2 class="section-label" data-reveal>Skills</h2>

      <div class="skills-grid">
        {
          skillGroups.map((group, index) => (
            <div class="skills-col" data-reveal data-reveal-delay={String((index + 1) * 50)}>
              <h3>{group.title}</h3>
              <p>{group.items.join(" · ")}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="working-style divider">
    <div class="container">
      <h2 class="section-label" data-reveal>Working style</h2>

      <div class="why-grid">
        {
          whyMeItems.map((item, index) => (
            <article class="why-card" data-reveal data-reveal-delay={String((index + 1) * 60)}>
              <span class="why-index">0{index + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* -------------------------------- Hero -------------------------------- */

  .about-hero {
    padding-block: var(--space-hero-top) var(--space-hero-bottom);
  }

  .about-hero-inner {
    display: grid;
    gap: 1.25rem;
  }

  .about-kicker,
  .about-facts {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .about-hero .display {
    max-width: 880px;
    font-size: clamp(2.3rem, 4.8vw, 3.9rem);
  }

  .role-signal {
    max-width: 44ch;
    margin: 0;
    color: var(--ink-muted);
    font-size: clamp(0.92rem, 1.3vw, 1rem);
    line-height: 1.6;
  }

  /* ---------------------------- Profile strip ---------------------------- */

  .profile-card {
    display: grid;
    grid-template-columns: minmax(11rem, 0.26fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .portrait {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }

  .portrait img {
    width: 100%;
    aspect-ratio: 0.85;
    object-fit: cover;
  }

  .profile-copy {
    display: grid;
    gap: 0.85rem;
  }

  .profile-summary {
    max-width: 34ch;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    font-weight: 470;
    letter-spacing: -0.005em;
    line-height: 1.35;
  }

  .profile-hook {
    max-width: 52ch;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .profile-shipped {
    display: inline-flex;
    width: fit-content;
    align-items: baseline;
    gap: 0.35rem;
    color: var(--ink-muted);
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.32em;
    transition:
      color var(--motion-fast) var(--ease-standard),
      text-decoration-color var(--motion-fast) var(--ease-standard);
  }

  .profile-shipped:hover {
    color: var(--rust);
    text-decoration-color: var(--rust);
  }

  .profile-shipped span {
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .profile-shipped:hover span {
    transform: translateX(3px);
  }

  /* ------------------------------ Education ------------------------------ */

  .edu-row {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1.5rem 3rem;
    margin-top: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(1.1rem, 2.6vw, 1.6rem);
  }

  .edu-org {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
  }

  .edu-name {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 490;
    line-height: 1.25;
  }

  .edu-degree {
    margin: 0.25rem 0 0;
    color: var(--ink-muted);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .edu-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
    align-content: center;
  }

  .edu-facts dt {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .edu-facts dd {
    margin: 0.4rem 0 0;
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.45;
  }

  /* ------------------------------ Experience ----------------------------- */

  .xp-list {
    display: grid;
    margin: clamp(1.25rem, 3vw, 2rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .xp-row {
    display: grid;
    grid-template-columns: minmax(9rem, 0.24fr) minmax(0, 1fr);
    gap: 0.75rem 3rem;
    border-top: 1px solid var(--line);
    padding-block: clamp(1.25rem, 2.8vw, 1.85rem);
  }

  .xp-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .xp-period {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    line-height: 1.7;
    text-transform: uppercase;
  }

  .xp-content {
    display: grid;
    gap: 0.55rem;
    justify-items: start;
  }

  .xp-org {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink-muted);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .xp-role {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    font-weight: 480;
    letter-spacing: -0.005em;
    line-height: 1.2;
  }

  .xp-summary {
    max-width: 62ch;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .xp-proof {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .xp-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    color: var(--ink-muted);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.32em;
    transition:
      color var(--motion-fast) var(--ease-standard),
      text-decoration-color var(--motion-fast) var(--ease-standard);
  }

  .xp-link:hover {
    color: var(--rust);
    text-decoration-color: var(--rust);
  }

  .xp-link span {
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .xp-link:hover span {
    transform: translateX(3px);
  }

  /* -------------------------------- Skills ------------------------------- */

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin-top: clamp(1.25rem, 3vw, 2rem);
  }

  .skills-col {
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
  }

  .skills-col h3 {
    margin: 0 0 0.6rem;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .skills-col p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.88rem;
    line-height: 1.85;
  }

  /* ---------------------------- Working style ---------------------------- */

  .working-style {
    padding-block: var(--space-section-before) var(--space-section-after);
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin-top: clamp(1.25rem, 3vw, 2rem);
  }

  .why-card {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
  }

  .why-index {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1;
  }

  .why-card h3 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .why-card p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  /* -------------------------------- Mobile ------------------------------- */

  @media (max-width: 900px) {
    .profile-card {
      grid-template-columns: 1fr;
    }

    .portrait {
      max-width: 20rem;
    }

    .edu-row {
      grid-template-columns: 1fr;
    }

    .skills-grid,
    .why-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  @media (max-width: 720px) {
    .xp-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .edu-facts {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
  }
</style>
