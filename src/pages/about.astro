  .phase-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    color: var(--ink);
    background: var(--paper-soft);
    border: 1px solid var(--line);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
  }

  .phase-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    font-weight: 500;
    color: var(--ink);
    line-height: 1.25;
  }

