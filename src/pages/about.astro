---

import OrganizationLogo from "@components/OrganizationLogo.astro";
import {
  coursesAndCertificates,
  education,
  experiences,
  heroProjectSlug,
  profile,
  skillGroups,
  whyMeItems,
} from "@data/profile";
import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getProfilePageSchema } from "@lib/seo";
import { getImageMeta } from "@lib/images";
import { getLogoItems } from "@lib/logos";
import { getSortedProjects } from "@lib/projects";

const primarySkills = new Set([
  "ASP.NET Core",
  "Python",
  "SQL Server",
  "Power BI",
  "Microsoft Power Automate",
]);
const profileHighlights = [
  profile.availability,
  `${profile.location} based`,
  `GPA ${education.gpa}`,
];
const siteUrl = Astro.site?.href ?? Astro.url.origin;
const profilePageSchema = getProfilePageSchema(siteUrl);
const aboutOgImage = getImageMeta(pageSeo.about.ogImagePath);
const profileImage = "/assets/profile/profile_photo.webp";
const profileImageSrcset =
  "/assets/profile/profile_photo-640.webp 640w, /assets/profile/profile_photo-960.webp 960w, /assets/profile/profile_photo.webp 1200w";
const profileImageMeta = getImageMeta(profileImage);

const allProjects = await getSortedProjects();
const heroProject =
  allProjects.find((project) => project.data.slug === heroProjectSlug) ??
  allProjects[0];
const primaryStackItems = getLogoItems([...primarySkills]);
const backendGroup = skillGroups[0];
const mlGroup = skillGroups[1];
const analyticsGroup = skillGroups[2];
const backendHighlights = getLogoItems(
  ["TypeScript", "ASP.NET Core", "Docker", "GitHub Actions", "FastAPI", "PostgreSQL"].filter((item) =>
    backendGroup.items.includes(item),
  ),
);
const mlHighlights = getLogoItems(
  ["Python", "Pandas", "Scikit-learn", "TensorFlow"].filter((item) => mlGroup.items.includes(item)),
);
const analyticsHighlights = getLogoItems(
  ["Power BI", "Microsoft Power Automate", "Odoo ERP"].filter((item) =>
    analyticsGroup.items.includes(item),
  ),
);

---

<BaseLayout
  title={pageSeo.about.title}
  description={pageSeo.about.description}
  jsonLd={profilePageSchema}
  ogImagePath={pageSeo.about.ogImagePath}
  ogImageAlt={pageSeo.about.ogImageAlt}
  ogImageWidth={aboutOgImage?.width}
  ogImageHeight={aboutOgImage?.height}
>
  <section class="about-hero dark-section dark-hero-shell" data-dark-section>
    <div class="dark-hero-grid" aria-hidden="true"></div>

    <div class="container about-hero-inner" data-reveal>
      <div class="about-person">
        <p class="section-label">{profile.name}</p>
        <span>{profile.location} / {profile.role}</span>
      </div>

      <h1 class="display">{profile.headline}</h1>
      <p class="role-signal">{profile.roleSignal}</p>

      <ul class="profile-highlights" aria-label="Profile highlights">
        {profileHighlights.map((item) => <li class="glass-pill-dark">{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="profile-strip divider">
    <div class="container profile-card" data-reveal>
      <div class="portrait glass-panel">
        <img
          src={profileImage}
          srcset={profileImageSrcset}
          sizes="(max-width: 900px) calc(100vw - 1.25rem), 28vw"
          alt="Portrait of Achmad Fahmi Ainur Ridho"
          width={profileImageMeta?.width}
          height={profileImageMeta?.height}
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="profile-copy">
        <p class="profile-summary">{profile.summary}</p>
        <p class="profile-hook">{profile.aboutHook}</p>
        {
          heroProject && (
            <a class="profile-shipped" href={`/projects/${heroProject.data.slug}/`} data-astro-prefetch="hover">
              {profile.lastShippedLabel}: {heroProject.data.title}
              <span aria-hidden="true">-&gt;</span>
            </a>
          )
        }
      </div>
    </div>
  </section>

  <section class="about-section divider">
    <div class="container section-block">
      <div class="section-head" data-reveal>
        <p class="section-label">Education</p>
        <h2>ITS.</h2>
      </div>

      <div class="info-panel glass-panel" data-reveal data-reveal-delay="80">
        <div class="info-kicker">
          <OrganizationLogo organization={education.institution} size="lg" />
          <div class="org-copy">
            <p class="org-name">{education.institution}</p>
            <p class="org-detail">{education.degree}</p>
          </div>
        </div>
        <dl>
          <div>
            <dt>Period</dt>
            <dd>{education.period}</dd>
          </div>
          <div>
            <dt>GPA</dt>
            <dd>{education.gpa}</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>{education.focus}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="about-section divider">
    <div class="container section-block">
      <div class="section-head" data-reveal>
        <p class="section-label">Experience</p>
        <h2>Four roles.</h2>
      </div>

      <ol class="experience-timeline">
        {
          experiences.map((item, index) => (
            <li class="timeline-item glass-elevated" data-reveal data-reveal-delay={String((index + 1) * 60)}>
              <div class="timeline-marker" aria-hidden="true">
                <span class="timeline-dot" />
              </div>

              <div class="timeline-content">
                <div class="timeline-head">
                  <div class="timeline-org">
                    <OrganizationLogo organization={item.organization} size="md" />
                    <div>
                      <p class="timeline-period">{item.period}</p>
                      <p class="org-name">{item.organization}</p>
                    </div>
                  </div>
                  <span class="timeline-proof glass-chip">{item.proof}</span>
                </div>

                <h3>{item.role}</h3>
                <p>{item.summary}</p>

                {
                  item.relatedProjectSlug && (
                    <a
                      class="timeline-link"
                      href={`/projects/${item.relatedProjectSlug}/`}
                      data-astro-prefetch="hover"
                    >
                      See related build <span aria-hidden="true">-&gt;</span>
                    </a>
                  )
                }
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="about-section divider">
    <div class="container section-block">
      <div class="section-head" data-reveal>
        <p class="section-label">Skills</p>
        <h2>Toolkit.</h2>
      </div>

      <div class="skill-bento">
        <article class="skill-bento-featured glass-elevated" data-reveal>
          <p class="bento-label">Core stack</p>
          <h3>What I reach for first.</h3>
          <ul class="featured-stack" aria-label="Primary stack">
            {
              primaryStackItems.map((item) => (
                <li>
                  {item.logo && <img src={item.logo} alt="" width="28" height="28" loading="lazy" decoding="async" />}
                  <span>{item.label}</span>
                </li>
              ))
            }
          </ul>
          <ul class="support-stack" aria-label="Backend and deployment highlights">
            {
              backendHighlights.map((item) => (
                <li class="glass-chip">
                  {item.logo && <img src={item.logo} alt="" width="18" height="18" loading="lazy" />}
                  <span>{item.label}</span>
                </li>
              ))
            }
          </ul>
        </article>

        <article class="skill-bento-card glass-elevated" data-reveal data-reveal-delay="60">
          <p class="bento-label">{mlGroup.title}</p>
          <h3>Models and data work.</h3>
          <ul class="skill-chip-list">
            {
              mlHighlights.map((item) => (
                <li class="glass-chip">
                  {item.logo && <img src={item.logo} alt="" width="18" height="18" loading="lazy" />}
                  <span>{item.label}</span>
                </li>
              ))
            }
          </ul>
          <p class="skill-overflow">
            {mlGroup.items.filter((item) => !mlHighlights.some((entry) => entry.label === item)).join(" · ")}
          </p>
        </article>

        <article class="skill-bento-card glass-elevated" data-reveal data-reveal-delay="120">
          <p class="bento-label">{analyticsGroup.title}</p>
          <h3>Analytics and ops.</h3>
          <ul class="skill-chip-list">
            {
              analyticsHighlights.map((item) => (
                <li class="glass-chip">
                  {item.logo && <img src={item.logo} alt="" width="18" height="18" loading="lazy" />}
                  <span>{item.label}</span>
                </li>
              ))
            }
          </ul>
          <p class="skill-overflow">
            {
              analyticsGroup.items
                .filter((item) => !analyticsHighlights.some((entry) => entry.label === item))
                .join(" · ")
            }
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="working-style dark-section dark-hero-shell" data-dark-section>
    <div class="dark-hero-grid" aria-hidden="true"></div>
    <div class="container section-block">
      <div class="section-head section-head-dark" data-reveal>
        <p class="section-label">Working style</p>
        <h2>How I work.</h2>
      </div>

      <div class="why-grid">
        {
          whyMeItems.map((item, index) => (
            <article class="why-card glass-dark" data-reveal data-reveal-delay={String((index + 1) * 60)}>
              <span class="why-index">0{index + 1}</span>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="about-section divider">
    <div class="container section-block">
      <div class="section-head" data-reveal>
        <p class="section-label">Also</p>
        <h2>Beyond project cards.</h2>
      </div>

      <ul class="credential-grid">
        {
          coursesAndCertificates.map((item, index) => (
            <li class="credential-card glass-elevated" data-reveal data-reveal-delay={String((index + 1) * 60)}>
              <span class="credential-year">{item.year}</span>
              <h3>{item.title}</h3>
              <p class="credential-issuer">{item.issuer}</p>
              <p>{item.context}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-stack-md);
  }

  .about-hero .display {
    max-width: 820px;
    margin: 0;
    color: #ffffff;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 0.98;
  }

  .about-person {
    display: grid;
    width: fit-content;
    gap: 0.35rem;
  }

  .about-person .section-label {
    margin: 0;
    color: rgba(255, 255, 255, 0.62);
  }

  .about-person span {
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .role-signal {
    max-width: 36rem;
    margin: 0;
    color: rgba(226, 232, 240, 0.68);
    font-size: clamp(0.9rem, 1.3vw, 1rem);
    line-height: 1.55;
  }

  .profile-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .profile-highlights li {
    color: rgba(226, 232, 240, 0.78);
    font-size: 0.76rem;
    line-height: 1.25;
    padding: 0.48rem 0.66rem;
  }

  .profile-strip,
  .about-section {
    background:
      radial-gradient(
        circle at 100% 0%,
        color-mix(in srgb, var(--accent-cyan) 5%, transparent),
        transparent 24rem
      ),
      var(--surface-light);
  }

  .profile-card {
    display: grid;
    grid-template-columns: minmax(12rem, 0.28fr) 1fr;
    gap: var(--gap-grid-lg);
    align-items: center;
  }

  .portrait {
    min-height: clamp(14rem, 28vw, 18rem);
    overflow: hidden;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  .profile-copy {
    display: grid;
    gap: var(--space-stack-md);
    min-width: 0;
  }

  .profile-summary {
    max-width: 52ch;
    margin: 0;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.55;
  }

  .profile-hook {
    max-width: 48ch;
    margin: 0;
    color: var(--text-soft);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .profile-shipped {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.42rem;
    border: 1px solid var(--badge-border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent-dim) 72%, var(--surface-elevated));
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.55rem 0.78rem;
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-out);
  }

  .profile-shipped:hover {
    border-color: var(--badge-border-strong);
    transform: translateX(2px);
  }

  .profile-shipped span {
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .profile-shipped:hover span {
    transform: translateX(3px);
  }

  .section-block {
    display: grid;
    gap: var(--space-block-inner);
  }

  .section-head .section-label {
    color: var(--accent);
  }

  .section-head h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.75rem, 3.5vw, 2.6rem);
    font-weight: 600;
    line-height: 1.02;
  }

  .section-head-dark .section-label {
    color: rgba(255, 255, 255, 0.62);
  }

  .section-head-dark h2 {
    color: #ffffff;
  }

  .info-panel {
    padding: clamp(1rem, 3vw, 1.4rem);
  }

  .info-kicker {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .org-copy {
    display: grid;
    gap: 0.28rem;
    align-self: center;
    min-width: 0;
  }

  .org-name,
  .org-detail {
    margin: 0;
  }

  .org-name {
    color: var(--text);
    font-size: 0.94rem;
    font-weight: 600;
    line-height: 1.38;
    text-wrap: pretty;
  }

  .org-detail {
    color: var(--text-muted);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  dl {
    display: grid;
    gap: 0;
    margin: 0;
  }

  dl div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding-block: 0.9rem;
  }

  dt {
    color: var(--text-soft);
    font-size: 0.74rem;
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--text);
    font-weight: 500;
  }

  .experience-timeline {
    position: relative;
    display: grid;
    gap: var(--gap-grid);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .experience-timeline::before {
    position: absolute;
    top: 1.35rem;
    bottom: 1.35rem;
    left: 1.09rem;
    width: 1px;
    background: linear-gradient(180deg, var(--accent), color-mix(in srgb, var(--accent-cyan) 72%, transparent));
    content: "";
    opacity: 0.45;
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding: clamp(1rem, 2vw, 1.2rem);
  }

  .timeline-marker {
    display: grid;
    place-items: center;
    padding-top: 0.2rem;
  }

  .timeline-dot {
    width: 0.82rem;
    height: 0.82rem;
    border: 2px solid var(--accent);
    border-radius: 999px;
    background: var(--surface-light);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-dim) 80%, transparent);
  }

  .timeline-content {
    display: grid;
    gap: var(--space-stack-sm);
    min-width: 0;
  }

  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .timeline-org {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    min-width: 0;
  }

  .timeline-period {
    margin: 0 0 0.18rem;
    color: var(--accent);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.68rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .timeline-proof {
    border-color: var(--badge-border);
    border-radius: 999px;
    color: var(--accent-on);
    font-size: 0.72rem;
    line-height: 1.25;
    padding: 0.42rem 0.62rem;
  }

  .timeline-content h3 {
    margin: 0;
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .timeline-content p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .timeline-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.35rem;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .timeline-link:hover {
    transform: translateX(2px);
  }

  .timeline-link span {
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .timeline-link:hover span {
    transform: translateX(3px);
  }

  .skill-bento {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) repeat(2, minmax(0, 1fr));
    grid-template-rows: auto auto;
    gap: var(--gap-grid);
  }

  .skill-bento-featured {
    grid-row: 1 / -1;
    display: grid;
    align-content: start;
    gap: var(--space-stack-sm);
    padding: clamp(1.1rem, 2.2vw, 1.35rem);
  }

  .skill-bento-card {
    display: grid;
    align-content: start;
    gap: var(--space-stack-sm);
    padding: clamp(1rem, 2vw, 1.2rem);
  }

  .bento-label {
    margin: 0;
    color: var(--accent);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.68rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .skill-bento h3 {
    margin: 0;
    color: var(--text);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .featured-stack {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
  }

  .featured-stack li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.62rem;
    align-items: center;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--panel-border));
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--skill-primary-bg) 70%, var(--surface-elevated));
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.2;
    padding: 0.72rem 0.78rem;
    box-shadow: inset 0 1px 0 var(--panel-inset);
  }

  .featured-stack img {
    width: 1.45rem;
    height: 1.45rem;
    object-fit: contain;
  }

  .support-stack,
  .skill-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.45rem 0 0;
    padding: 0;
    list-style: none;
  }

  .support-stack li,
  .skill-chip-list li {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1;
    padding: 0.42rem 0.62rem;
  }

  .support-stack img,
  .skill-chip-list img {
    width: 1rem;
    height: 1rem;
    object-fit: contain;
  }

  .skill-overflow {
    margin: 0.35rem 0 0;
    color: var(--text-soft);
    font-size: 0.76rem;
    line-height: 1.55;
  }

  .working-style {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-section-before) var(--space-section-after);
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap-grid);
  }

  .why-card {
    display: grid;
    align-content: start;
    gap: var(--space-stack-sm);
    padding: clamp(1rem, 2.2vw, 1.3rem);
  }

  .why-index {
    color: rgba(186, 230, 253, 0.72);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.72rem;
    line-height: 1;
  }

  .why-card h3 {
    margin: 0;
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .why-card p {
    margin: 0;
    color: rgba(226, 232, 240, 0.72);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .credential-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap-grid);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .credential-card {
    display: grid;
    align-content: start;
    gap: var(--space-stack-sm);
    padding: clamp(1rem, 2vw, 1.2rem);
  }

  .credential-year {
    color: var(--accent);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.68rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .credential-card h3 {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
