---
import OrganizationLogo from "@components/OrganizationLogo.astro";
import PersonalTextureBento from "@components/PersonalTextureBento.astro";
import {
  education,
  experiences,
  heroProjectSlug,
  profile,
  skillGroups,
  whyMeItems,
} from "@data/profile";
import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getProfilePageSchema } from "@lib/seo";
import { getImageMeta } from "@lib/images";
import { getSortedProjects } from "@lib/projects";

const gpaShort = education.gpa.split("/")[0]?.trim() ?? education.gpa;
const siteUrl = Astro.site?.href ?? Astro.url.origin;
const profilePageSchema = getProfilePageSchema(siteUrl);
const aboutOgImage = getImageMeta(pageSeo.about.ogImagePath);
const profileImage = "/assets/profile/profile_photo.webp";
const profileImageSrcset =
  "/assets/profile/profile_photo-640.webp 640w, /assets/profile/profile_photo-960.webp 960w, /assets/profile/profile_photo.webp 1200w";
const profileImageMeta = getImageMeta(profileImage);

const allProjects = await getSortedProjects();
const heroProject =
  allProjects.find((project) => project.data.slug === heroProjectSlug) ??
  allProjects[0];

const capabilityPills = [
  "AI/ML & Latent Oversampling",
  "Full-Stack .NET & APIs",
  "Data Systems & Benchmarking",
  "Enterprise ERP & Automation",
];
---

<BaseLayout
  title={pageSeo.about.title}
  description={pageSeo.about.description}
  jsonLd={profilePageSchema}
  ogImagePath={pageSeo.about.ogImagePath}
  ogImageAlt={pageSeo.about.ogImageAlt}
  ogImageWidth={aboutOgImage?.width}
  ogImageHeight={aboutOgImage?.height}
>
  <!-- ABOUT HERO -->
  <section class="about-hero">
    <div class="container about-hero-inner" data-reveal>
      <div class="about-hero-top">
        <p class="about-kicker">{profile.name} &middot; {profile.role}</p>
        <div class="status-badge">
          <span class="status-dot"></span>
          OPEN FOR 2026 ROLES
        </div>
      </div>

      <h1 class="display">{profile.headline}</h1>

      <!-- Core Capability Badges -->
      <div class="capability-row">
        {
          capabilityPills.map((cap) => (
            <span class="capability-pill">{cap}</span>
          ))
        }
      </div>

      <p class="role-signal">{profile.roleSignal}</p>

      <p class="about-facts">
        {profile.availability} &middot; GPA {gpaShort} &middot; Surabaya, Indonesia
      </p>
    </div>
  </section>

  <!-- PROFILE STRIP -->
  <section class="profile-strip divider">
    <div class="container profile-card" data-reveal>
      <figure class="portrait">
        <img
          src={profileImage}
          srcset={profileImageSrcset}
          sizes="(max-width: 900px) calc(100vw - 1.5rem), 24vw"
          alt="Portrait of Achmad Fahmi Ainur Ridho"
          width={profileImageMeta?.width}
          height={profileImageMeta?.height}
          loading="lazy"
          decoding="async"
        />
        <figcaption class="portrait-caption">
          Achmad Fahmi Ainur Ridho &middot; ITS Surabaya
        </figcaption>
      </figure>

      <div class="profile-copy">
        <p class="profile-summary">{profile.summary}</p>
        <p class="profile-hook">{profile.aboutHook}</p>
        {
          heroProject && (
            <div class="profile-shipped-box">
              <span class="shipped-badge">CURRENT THESIS FOCUS</span>
              <a
                class="profile-shipped"
                href={`/projects/${heroProject.data.slug}/`}
                data-astro-prefetch="hover"
              >
                {heroProject.data.title} &middot; 0.855 PR-AUC
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- EDUCATION SECTION -->
  <section class="about-section divider">
    <div class="container">
      <div class="section-heading-wrap" data-reveal>
        <p class="section-label">Academic Formation</p>
        <h2 class="about-section-title">Education & Research</h2>
      </div>

      <div class="edu-row" data-reveal>
        <div class="edu-org">
          <OrganizationLogo organization={education.institution} size="md" />
          <div>
            <p class="edu-name">{education.institution}</p>
            <p class="edu-degree">{education.degree}</p>
            <p class="edu-thesis-highlight">
              <strong>Thesis:</strong> Latent-space Autoencoder oversampling for extreme
              class imbalance in fraud detection (0.8547 test PR-AUC).
            </p>
          </div>
        </div>
        <dl class="edu-facts">
          <div>
            <dt>Period</dt>
            <dd>{education.period}</dd>
          </div>
          <div>
            <dt>GPA</dt>
            <dd class="highlight-carmine">{education.gpa}</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>{education.focus}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- EXPERIENCE SECTION -->
  <section class="about-section divider">
    <div class="container">
      <div class="section-heading-wrap" data-reveal>
        <p class="section-label">Production & Leadership</p>
        <h2 class="about-section-title">Verified Experience</h2>
      </div>

      <ol class="xp-list">
        {
          experiences.map((item, index) => (
            <li
              class="xp-row"
              data-reveal
              data-reveal-delay={String((index + 1) * 50)}
            >
              <div class="xp-sidebar">
                <p class="xp-period">{item.period}</p>
                <span class="xp-index">0{index + 1}</span>
              </div>

              <div class="xp-content">
                <div class="xp-org">
                  <OrganizationLogo
                    organization={item.organization}
                    size="sm"
                  />
                  <span class="xp-org-name">{item.organization}</span>
                </div>
                <h3 class="xp-role">{item.role}</h3>
                <p class="xp-summary">{item.summary}</p>

                <div class="xp-proof-badge">
                  <span class="proof-label">DELIVERABLES:</span>
                  <span class="proof-value">{item.proof}</span>
                </div>

                {item.relatedProjectSlug && (
                  <a
                    class="xp-link"
                    href={`/projects/${item.relatedProjectSlug}/`}
                    data-astro-prefetch="hover"
                  >
                    Inspect project architecture{" "}
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- SKILLS MATRIX -->
  <section class="about-section divider">
    <div class="container">
      <div class="section-heading-wrap" data-reveal>
        <p class="section-label">Stack & Machinery</p>
        <h2 class="about-section-title">Technical Competencies</h2>
      </div>

      <div class="skills-grid">
        {
          skillGroups.map((group, index) => (
            <div
              class="skills-col"
              data-reveal
              data-reveal-delay={String((index + 1) * 50)}
            >
              <div class="skills-col-header">
                <span class="skill-group-num">0{index + 1}</span>
                <h3>{group.title}</h3>
              </div>
              <div class="skill-chips-wrap">
                {group.items.map((skill) => (
                  <span class="skill-chip">{skill}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- WORKING STYLE & PRINCIPLES -->
  <section class="working-style divider">
    <div class="container">
      <div class="section-heading-wrap" data-reveal>
        <p class="section-label">Engineering Invariants</p>
        <h2 class="about-section-title">How I Build & Ship</h2>
      </div>

      <div class="why-grid">
        {
          whyMeItems.map((item, index) => (
            <article
              class="why-card"
              data-reveal
              data-reveal-delay={String((index + 1) * 60)}
            >
              <div class="why-card-top">
                <span class="why-index">RULE 0{index + 1}</span>
                <span class="why-dot" aria-hidden="true" />
              </div>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ANALOG RITUALS & CRAFT BENTO -->
  <PersonalTextureBento />
</BaseLayout>

<style>
  /* -------------------------------- Hero -------------------------------- */

  .about-hero {
    padding-block: var(--space-hero-top) clamp(2rem, 4vw, 3.5rem);
  }

  .about-hero-inner {
    display: grid;
    gap: 1.25rem;
  }

  .about-hero-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .about-kicker,
  .about-facts {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--paper-soft);
    border: 1px solid var(--line);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--signal);
    box-shadow: 0 0 0 0 rgba(201, 46, 62, 0.4);
    animation: status-pulse 2s infinite;
  }

  @keyframes status-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(201, 46, 62, 0.5);
    }
    70% {
      box-shadow: 0 0 0 6px rgba(201, 46, 62, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(201, 46, 62, 0);
    }
  }

  .about-hero .display {
    max-width: 880px;
    font-size: clamp(2.3rem, 4.8vw, 3.9rem);
  }

  .capability-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .capability-pill {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--ink);
    background: #ffffff;
    border: 1px solid var(--line);
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-pill);
  }

  .role-signal {
    max-width: 48ch;
    margin: 0;
    color: var(--ink-muted);
    font-size: clamp(0.95rem, 1.3vw, 1.05rem);
    line-height: 1.6;
  }

  /* ---------------------------- Profile strip ---------------------------- */

  .profile-card {
    display: grid;
    grid-template-columns: minmax(12rem, 0.28fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .portrait {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: #ffffff;
  }

  .portrait img {
    width: 100%;
    aspect-ratio: 0.85;
    object-fit: cover;
  }

  .portrait-caption {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    text-transform: uppercase;
    padding: 0.5rem 0.75rem;
    border-top: 1px solid var(--line);
    background: var(--paper-soft);
    text-align: center;
  }

  .profile-copy {
    display: grid;
    gap: 1rem;
  }

  .profile-summary {
    max-width: 36ch;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    font-weight: 470;
    letter-spacing: -0.005em;
    line-height: 1.35;
  }

  .profile-hook {
    max-width: 56ch;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .profile-shipped-box {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    width: fit-content;
  }

  .shipped-badge {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--signal);
    text-transform: uppercase;
  }

  .profile-shipped {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.3em;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .profile-shipped:hover {
    color: var(--signal);
  }

  /* ------------------------------ Sections ------------------------------ */

  .section-heading-wrap {
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .about-section-title {
    margin: 0.4rem 0 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 480;
    letter-spacing: -0.01em;
  }

  /* ------------------------------ Education ------------------------------ */

  .edu-row {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 1.5rem 3rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(1.2rem, 2.6vw, 1.8rem);
  }

  .edu-org {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .edu-name {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    font-weight: 490;
    line-height: 1.25;
  }

  .edu-degree {
    margin: 0.25rem 0 0.5rem;
    color: var(--ink-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .edu-thesis-highlight {
    margin: 0.4rem 0 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-soft);
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.75rem;
  }

  .edu-thesis-highlight strong {
    color: var(--ink);
  }

  .edu-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
    align-content: center;
  }

  .edu-facts dt {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .edu-facts dd {
    margin: 0.4rem 0 0;
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .highlight-carmine {
    color: var(--signal-deep) !important;
    font-weight: 650 !important;
  }

  /* ------------------------------ Experience ----------------------------- */

  .xp-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xp-row {
    display: grid;
    grid-template-columns: minmax(7rem, 0.22fr) minmax(0, 1fr);
    gap: 1rem 3rem;
    border-top: 1px solid var(--line);
    padding-block: clamp(1.4rem, 3vw, 2rem);
  }

  .xp-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .xp-sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .xp-period {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .xp-index {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--signal);
    font-weight: 600;
  }

  .xp-content {
    display: grid;
    gap: 0.65rem;
    justify-items: start;
  }

  .xp-org {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .xp-org-name {
    color: var(--ink-muted);
    font-size: 0.82rem;
    font-weight: 500;
  }

  .xp-role {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.2vw, 1.65rem);
    font-weight: 480;
    letter-spacing: -0.005em;
    line-height: 1.2;
  }

  .xp-summary {
    max-width: 64ch;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .xp-proof-badge {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem;
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.75rem;
    font-size: 0.78rem;
  }

  .proof-label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }

  .proof-value {
    color: var(--ink);
    font-weight: 500;
  }

  .xp-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--signal-deep);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    margin-top: 0.25rem;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .xp-link:hover {
    color: var(--signal);
  }

  /* -------------------------------- Skills ------------------------------- */

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .skills-col {
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .skills-col-header {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
  }

  .skill-group-num {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--signal);
    font-weight: 600;
  }

  .skills-col h3 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .skill-chips-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .skill-chip {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-muted);
    background: #ffffff;
    border: 1px solid var(--line);
    padding: 0.3rem 0.55rem;
    border-radius: var(--radius-sm);
    transition: all var(--motion-fast) var(--ease-standard);
  }

  .skill-chip:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  /* ---------------------------- Working style ---------------------------- */

  .working-style {
    padding-block: var(--space-section-before) var(--space-section-after);
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .why-card {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: clamp(1.2rem, 2.4vw, 1.6rem);
    transition: border-color var(--motion-fast) var(--ease-standard);
  }

  .why-card:hover {
    border-color: var(--line-strong);
  }

  .why-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .why-index {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .why-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--ink-soft);
  }

  .why-card h3 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .why-card p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  /* -------------------------------- Mobile ------------------------------- */

  @media (max-width: 900px) {
    .profile-card {
      grid-template-columns: 1fr;
    }

    .portrait {
      max-width: 18rem;
    }

    .edu-row {
      grid-template-columns: 1fr;
    }

    .skills-grid,
    .why-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  @media (max-width: 720px) {
    .xp-row {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }

    .edu-facts {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
  }
</style>
