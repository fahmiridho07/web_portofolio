---
// about.astro: Top-Tier Professional Journey & Engineering Methodology
// Focus: "HOW I THINK + MY JOURNEY + MY CRAFT & PROCESS"
// Zero redundancy with Home or Projects.
// No standalone hobby section; 3D illustrations used purely as subtle ambient accents.
// 1. Visual Dossier Hero with 3D tilted portrait, telemetry, and ambient craft decoration
// 2. Interactive Evolution Roadmap (4 Milestones across academic & enterprise career)
// 3. The Engineering Pipeline Schematic (4-step build methodology)
// 4. Fast-Action Sign-off with 1-click email copy & LinkedIn CTA

import { education, profile } from "@data/profile";
import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getProfilePageSchema } from "@lib/seo";
import { getImageMeta } from "@lib/images";
import { getResumeAction } from "@lib/resume";

const gpaShort = education.gpa.split("/")[0]?.trim() ?? education.gpa;
const siteUrl = Astro.site?.href ?? Astro.url.origin;
const profilePageSchema = getProfilePageSchema(siteUrl);
const aboutOgImage = getImageMeta(pageSeo.about.ogImagePath);
const profileImage = "/assets/profile/profile_photo.webp";
const profileImageSrcset =
  "/assets/profile/profile_photo-640.webp 640w, /assets/profile/profile_photo-960.webp 960w, /assets/profile/profile_photo.webp 1200w";
const profileImageMeta = getImageMeta(profileImage);
const resumeAction = getResumeAction();

// Evolution Milestones (Chronological Career & Research Roadmap)
const evolutionPhases = [
  {
    phase: "PHASE 01",
    period: "2022 &ndash; 2023",
    title: "Foundations & Systems Architecture",
    badge: "ITS SURABAYA",
    desc: "Mastered algorithmic complexity, relational database modeling, and software design patterns. Explored how raw data flows through backend pipelines.",
    highlight:
      "Academic GPA 3.62 &middot; Teaching Assistant in Enterprise Systems",
  },
  {
    phase: "PHASE 02",
    period: "2024",
    title: "Production Enterprise Engineering",
    badge: "PT KALTIM PRIMA COAL",
    desc: "Engineered and stabilized enterprise innovation platform (IdeKU V3) on ASP.NET Core for 5,000+ mining employees. Delivered RBAC security, embedded Power BI analytics, and automated supervisor approval workflows.",
    highlight: "Enterprise Scale &middot; Zero Production Downtime",
  },
  {
    phase: "PHASE 03",
    period: "2025 &ndash; 2026",
    title: "Machine Learning & Latent Research",
    badge: "UNDERGRADUATE THESIS",
    desc: "Tackled extreme class imbalance in financial transaction datasets. Designed deep generative Autoencoders to oversample latent representations without data leakage, paired with Bayesian-tuned LightGBM.",
    highlight: "0.8547 PR-AUC &middot; Bayesian Optuna Tuning",
  },
  {
    phase: "PHASE 04",
    period: "2026 &amp; BEYOND",
    title: "The Horizon: Systems + Intelligence",
    badge: "OPEN TO ROLES",
    desc: "Bridging the gap between scalable enterprise infrastructure and intelligent machine learning models. Ready to ship high-impact software starting from 2026.",
    highlight: "Software Engineering &middot; AI/ML Engineering",
  },
];

// Engineering Pipeline Steps (Mental Model & Build Methodology)
const pipelineSteps = [
  {
    num: "01",
    step: "SCHEMA & BOUNDARIES",
    title: "Architecture First",
    desc: "Establish domain models, strict type contracts, and database constraints before writing business logic.",
    pill: "Domain-Driven Design",
  },
  {
    num: "02",
    step: "RESILIENT CORE",
    title: "Clean API Execution",
    desc: "Build lightweight ASP.NET Core services with dependency injection, RBAC security, and automated error handling.",
    pill: "C# &middot; ASP.NET Core",
  },
  {
    num: "03",
    step: "EMPIRICAL MODELING",
    title: "Zero-Leakage ML",
    desc: "Strict cross-validation splits, latent space oversampling, and precision-recall optimization for skewed data.",
    pill: "LightGBM &middot; PyTorch",
  },
  {
    num: "04",
    step: "PRODUCTION POLISH",
    title: "Verified Delivery",
    desc: "Sub-millisecond API response benchmarking, automated test suites, and sub-second web render times.",
    pill: "100/100 Lighthouse",
  },
];
---

<BaseLayout
  title={pageSeo.about.title}
  description={pageSeo.about.description}
  jsonLd={profilePageSchema}
  ogImagePath={pageSeo.about.ogImagePath}
  ogImageAlt={pageSeo.about.ogImageAlt}
  ogImageWidth={aboutOgImage?.width}
  ogImageHeight={aboutOgImage?.height}
>
  <!-- CHAPTER 1: VISUAL DOSSIER HERO -->
  <section class="dossier-hero">
    <div class="container" data-reveal>
      <div class="dossier-meta-bar">
        <div class="dossier-id">
          <span class="id-kicker">DOSSIER // PROFILE</span>
          <span class="id-name">Achmad Fahmi Ainur Ridho &middot; Ridho</span>
        </div>
        <div class="availability-pill">
          <span class="pulse-beacon"></span>
          OPEN TO 2026 ROLES
        </div>
      </div>

      <div class="dossier-grid">
        <div class="dossier-text">
          <h1 class="display dossier-headline">
            I build software with architectural care and train models with
            scientific discipline.
          </h1>
          <p class="dossier-lead">
            Final-year Information Systems student at ITS Surabaya moving deep
            into AI engineering. My journey started with full-stack enterprise
            systems, but working with real production databases quickly revealed
            that what data predicts is even more interesting than the UI wrapped
            around it.
          </p>

          <div class="dossier-tags">
            <div class="dossier-tag-item">
              <span class="tag-title">ACADEMIC BASE</span>
              <span class="tag-val"
                >ITS Surabaya &middot; GPA {gpaShort}/4.00</span
              >
            </div>
            <div class="dossier-tag-item">
              <span class="tag-title">CORE PRACTICE</span>
              <span class="tag-val"
                >Full-Stack .NET &middot; AI/ML Research</span
              >
            </div>
            <div class="dossier-tag-item">
              <span class="tag-title">LOCATION</span>
              <span class="tag-val">Surabaya, Indonesia</span>
            </div>
          </div>
        </div>

        <div class="dossier-photo-wrap">
          <figure class="portrait-card" data-portrait-card>
            <!-- Tasteful Ambient 3D Decorative Accent in Backdrop -->
            <div class="portrait-ambient-decor" aria-hidden="true">
              <img
                src="/assets/floating/code-laptop.webp"
                alt=""
                width="140"
                height="140"
                loading="lazy"
                decoding="async"
                class="ambient-laptop-img"
              />
            </div>

            <div class="photo-container">
              <img
                src={profileImage}
                srcset={profileImageSrcset}
                sizes="(max-width: 900px) calc(100vw - 2rem), 320px"
                alt="Portrait of Achmad Fahmi Ainur Ridho"
                width={profileImageMeta?.width}
                height={profileImageMeta?.height}
                loading="eager"
                decoding="async"
                class="portrait-photo"
              />
              <div class="photo-reticle" aria-hidden="true">
                <span class="reticle-corner c-tl"></span>
                <span class="reticle-corner c-tr"></span>
                <span class="reticle-corner c-bl"></span>
                <span class="reticle-corner c-br"></span>
              </div>
            </div>
            <figcaption class="photo-telemetry">
              <span class="telemetry-item">LOC: SURABAYA, ID</span>
              <span class="telemetry-item">STATUS: FINAL YEAR</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 2: INTERACTIVE EVOLUTION ROADMAP -->
  <section class="roadmap-section divider" data-reveal>
    <div class="container">
      <div class="section-header">
        <div class="header-badge">
          <span class="badge-num">01</span>
          <span class="badge-title">CAREER &amp; ACADEMIC EVOLUTION</span>
        </div>
        <h2 class="section-heading">How I got here: 4 key milestones.</h2>
        <p class="section-subhead">
          From algorithmic fundamentals to enterprise mining production and
          generative AI thesis research.
        </p>
      </div>

      <div class="roadmap-timeline">
        <!-- Connecting Line Visual -->
        <div class="roadmap-spine" aria-hidden="true"></div>

        <div class="roadmap-nodes">
          {
            evolutionPhases.map((phase, idx) => (
              <div class="roadmap-card" data-phase-index={idx}>
                <div class="card-marker">
                  <span class="marker-dot" />
                  <span class="marker-pulse" />
                </div>
                <div class="card-content">
                  <div class="card-meta">
                    <span class="phase-code">{phase.phase}</span>
                    <span class="phase-period" set:html={phase.period} />
                    <span class="phase-badge">{phase.badge}</span>
                  </div>
                  <h3 class="phase-title">{phase.title}</h3>
                  <p class="phase-desc">{phase.desc}</p>
                  <div class="phase-highlight">
                    <span class="highlight-bullet" aria-hidden="true">
                      &bull;
                    </span>
                    <span set:html={phase.highlight} />
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 3: THE ENGINEERING PIPELINE SCHEMATIC -->
  <section class="pipeline-section divider" data-reveal>
    <div class="container">
      <div class="section-header">
        <div class="header-badge">
          <span class="badge-num">02</span>
          <span class="badge-title">THE METHODOLOGY</span>
        </div>
        <h2 class="section-heading">How I build systems that endure.</h2>
        <p class="section-subhead">
          A disciplined 4-stage pipeline that ensures code is maintainable,
          models are sound, and delivery is verified.
        </p>
      </div>

      <div class="pipeline-grid">
        {
          pipelineSteps.map((s, idx) => (
            <div class="pipeline-card">
              <div class="pipeline-card-head">
                <span class="pipeline-num">{s.num}</span>
                <span class="pipeline-step-name">{s.step}</span>
              </div>
              <h3 class="pipeline-title">{s.title}</h3>
              <p class="pipeline-desc">{s.desc}</p>
              <div class="pipeline-pill" set:html={s.pill} />
              {idx < 3 && (
                <div class="pipeline-arrow" aria-hidden="true">
                  &rarr;
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CHAPTER 4: FAST-ACTION SIGN-OFF -->
  <section class="about-action-section divider" data-reveal>
    <div class="container action-container">
      <div class="action-card">
        <div class="action-header">
          <p class="action-kicker">WHAT&rsquo;S NEXT</p>
          <h2 class="action-title">Let&rsquo;s create something remarkable.</h2>
          <p class="action-lead">
            Available for full-time Software Engineering and AI/ML roles
            starting in 2026.
          </p>
        </div>

        <div class="action-box">
          <div class="email-pill" data-email-box>
            <span class="email-address">{profile.email}</span>
            <button
              type="button"
              class="copy-btn"
              data-copy-email
              data-email={profile.email}
              aria-label="Copy email address"
            >
              <span data-copy-label>Copy Email</span>
            </button>
            <a href={profile.emailHref} class="send-btn">
              Direct Mail <span aria-hidden="true">&nearr;</span>
            </a>
          </div>

          <div class="external-links">
            <a
              href="https://id.linkedin.com/in/fahmiridho"
              target="_blank"
              rel="noreferrer"
              class="ext-btn"
            >
              Complete Career History on LinkedIn
              <span aria-hidden="true">&nearr;</span>
            </a>
            <a
              href="https://github.com/fahmiridho07"
              target="_blank"
              rel="noreferrer"
              class="ext-btn"
            >
              GitHub <span aria-hidden="true">&nearr;</span>
            </a>
            <a
              href={resumeAction.href}
              download={resumeAction.download ? "" : undefined}
              class="ext-btn ext-resume"
            >
              {resumeAction.label}
              <span aria-hidden="true">&darr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initOnPageLoad } from "@lib/page-script";

  initOnPageLoad(() => {
    // 3D Portrait Card Tilt Parallax
    const portrait = document.querySelector<HTMLElement>(
      "[data-portrait-card]",
    );
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (portrait && !reduceMotion) {
      portrait.addEventListener("mousemove", (e) => {
        const rect = portrait.getBoundingClientRect();
        const x = (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2);
        const y =
          (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2);
        portrait.style.transform = `perspective(1000px) rotateX(${-y * 5}deg) rotateY(${x * 5}deg) translateY(-4px)`;
      });

      portrait.addEventListener("mouseleave", () => {
        portrait.style.transform =
          "perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0)";
      });
    }

    // 1-Click Copy Email Logic
    const copyBtn =
      document.querySelector<HTMLButtonElement>("[data-copy-email]");
    if (copyBtn) {
      const copyLabel = copyBtn.querySelector<HTMLElement>("[data-copy-label]");
      const email = copyBtn.dataset.email || "achmadridho.id@gmail.com";

      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(email);
          if (copyLabel) copyLabel.textContent = "✓ Copied!";
          copyBtn.classList.add("is-copied");

          window.setTimeout(() => {
            if (copyLabel) copyLabel.textContent = "Copy Email";
            copyBtn.classList.remove("is-copied");
          }, 2200);
        } catch {
          window.location.href = `mailto:${email}`;
        }
      });
    }
  });
</script>

<style>
  /* ------------------------------- Chapter 1: Dossier Hero ------------------------------- */

  .dossier-hero {
    padding-block: var(--space-hero-top) clamp(3.5rem, 6vw, 5.5rem);
    background: var(--paper);
  }

  .dossier-meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .dossier-id {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .id-kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--signal-deep);
    font-weight: 700;
  }

  .id-name {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
  }

  .availability-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink);
    background: #ffffff;
    border: 1px solid var(--line);
    padding: 0.28rem 0.75rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  .pulse-beacon {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--signal);
    box-shadow: 0 0 0 0 rgba(201, 46, 62, 0.5);
    animation: beacon-ping 2s infinite;
  }

  @keyframes beacon-ping {
    0% {
      box-shadow: 0 0 0 0 rgba(201, 46, 62, 0.5);
    }
    70% {
      box-shadow: 0 0 0 5px rgba(201, 46, 62, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(201, 46, 62, 0);
    }
  }

  .dossier-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 5.5rem);
    align-items: center;
  }

  .dossier-text {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .dossier-headline {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 4.8vw, 3.8rem);
    font-weight: 480;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .dossier-lead {
    margin: 0;
    color: var(--ink-muted);
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.7;
    max-width: 52ch;
  }

  .dossier-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.25rem;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
    margin-top: 0.5rem;
  }

  .dossier-tag-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .tag-title {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }

  .tag-val {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink);
  }

  /* Portrait Card */
  .dossier-photo-wrap {
    display: flex;
    justify-content: center;
  }

  .portrait-card {
    position: relative;
    width: 100%;
    max-width: 320px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 10px;
    box-shadow: 0 16px 36px rgba(22, 24, 29, 0.05);
    margin: 0;
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  /* Ambient 3D Decorative Accent in Backdrop */
  .portrait-ambient-decor {
    position: absolute;
    top: -25px;
    right: -25px;
    width: 90px;
    height: 90px;
    pointer-events: none;
