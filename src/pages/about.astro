---
// about.astro: Editorial Storytelling & Design Showcase
// Focused on personal character, engineering principles, the meta-craft of this portfolio,
// and the three pillars of practice. Full detailed resume history is linked to LinkedIn.

import { education, profile } from "@data/profile";
import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getProfilePageSchema } from "@lib/seo";
import { getImageMeta } from "@lib/images";
import { getResumeAction } from "@lib/resume";

const gpaShort = education.gpa.split("/")[0]?.trim() ?? education.gpa;
const siteUrl = Astro.site?.href ?? Astro.url.origin;
const profilePageSchema = getProfilePageSchema(siteUrl);
const aboutOgImage = getImageMeta(pageSeo.about.ogImagePath);
const profileImage = "/assets/profile/profile_photo.webp";
const profileImageSrcset =
  "/assets/profile/profile_photo-640.webp 640w, /assets/profile/profile_photo-960.webp 960w, /assets/profile/profile_photo.webp 1200w";
const profileImageMeta = getImageMeta(profileImage);
const resumeAction = getResumeAction();

const designSystemSpecs = [
  {
    label: "Engine",
    value: "Astro Static Generator",
    desc: "Zero client-side runtime bloat. 100/100 Lighthouse performance by default.",
  },
  {
    label: "Kinetic Motion",
    value: "Pure CSS 3D Transforms",
    desc: "GPU-accelerated perspective matrices running at locked 60fps without heavy WebGL libraries.",
  },
  {
    label: "Typography",
    value: "Fraunces + Inter + SFMono",
    desc: "Variable optical serif for human warmth paired with geometric sans and monospace telemetry.",
  },
  {
    label: "Palette",
    value: "The Anomaly System",
    desc: "Warm paper ground (#f7f7f6), carbon ink (#16181d), and carmine red (#c92e3e) reserved strictly for signal.",
  },
];

const pillars = [
  {
    num: "01",
    tag: "ENGINEERING",
    title: "Production Software",
    lead: "Building backend systems that hold up under real-world usage.",
    points: [
      "Enterprise ASP.NET Core & C# APIs built with clean separation of concerns.",
      "Relational database design, query optimization, and RBAC security enforcement.",
      "Automated operational pipelines that eliminate hundreds of manual hours.",
    ],
  },
  {
    num: "02",
    tag: "RESEARCH",
    title: "Machine Learning Depth",
    lead: "Scientific rigor from data preprocessing to deployed model inference.",
    points: [
      "Specialized in extreme class imbalance (1:99 fraud detection datasets).",
      "Latent-space Autoencoder oversampling with Bayesian-tuned LightGBM (Optuna).",
      "Zero data leakage: strict cross-validation and evaluation on precision-recall curves.",
    ],
  },
  {
    num: "03",
    tag: "DISCIPLINE",
    title: "Everyday Rituals",
    lead: "The same obsession with craft and iteration outside the screen.",
    points: [
      "Manual V60 pour-over: 92°C extraction, 1:16 brew ratio, and origin bean notes.",
      "Competitive court badminton: 28 lbs BG66 Ultimax stringing, rear-court attack.",
      "Road running cadence: 178 SPM target, negative splits, and aerobic discipline.",
      "Cinematic storytelling: studying 35mm composition, editing rhythm, and direction.",
    ],
  },
];

const timelineSnapshot = [
  {
    year: "2024 &ndash; 2025",
    org: "PT Kaltim Prima Coal",
    role: "Full-Stack Software Engineering Intern",
    summary:
      "Stabilized enterprise innovation platform (IdeKU V3) on ASP.NET Core for 5,000+ mining employees. Delivered 7 core features, embedded Power BI analytics, and automated supervisor appointment workflows.",
  },
  {
    year: "2023 &ndash; 2024",
    org: "Institut Teknologi Sepuluh Nopember",
    role: "Teaching Assistant & Enterprise Systems Lab",
    summary:
      "Mentored 50+ undergraduate students on enterprise resource planning (Odoo ERP), business process re-engineering, and IT strategic alignment.",
  },
  {
    year: "2022 &ndash; 2026",
    org: "Institut Teknologi Sepuluh Nopember",
    role: "Bachelor of Information Systems",
    summary: `Expected graduation 2026 with GPA ${gpaShort}/4.00. Undergraduate thesis on latent-space generative oversampling for credit card fraud detection (0.855 PR-AUC).`,
  },
];
---

<BaseLayout
  title={pageSeo.about.title}
  description={pageSeo.about.description}
  jsonLd={profilePageSchema}
  ogImagePath={pageSeo.about.ogImagePath}
  ogImageAlt={pageSeo.about.ogImageAlt}
  ogImageWidth={aboutOgImage?.width}
  ogImageHeight={aboutOgImage?.height}
>
  <!-- HERO / PROFILE ESSAY -->
  <section class="about-hero">
    <div class="container" data-reveal>
      <div class="hero-identity-bar">
        <p class="hero-kicker">Achmad Fahmi Ainur Ridho &middot; Ridho</p>
        <div class="status-pill">
          <span class="status-dot"></span>
          OPEN FOR 2026 ROLES
        </div>
      </div>

      <div class="about-hero-grid">
        <div class="hero-text-col">
          <h1 class="display hero-display">
            I build software with architectural care and train models with
            scientific discipline.
          </h1>
          <p class="hero-narrative">
            I&rsquo;m a final-year Information Systems student at ITS Surabaya
            moving deep into AI engineering. My journey began with full-stack
            .NET enterprise development, but working with real production
            databases quickly revealed that what data predicts is even more
            interesting than the UI wrapped around it.
          </p>
          <p class="hero-narrative">
            Today, I treat software engineering and machine learning as two
            sides of the same coin: reliable code makes models deployable, while
            rigorous modeling turns raw data into actionable foresight.
          </p>

          <div class="hero-facts-row">
            <div class="fact-item">
              <span class="fact-label">FORMATION</span>
              <span class="fact-val">ITS Surabaya &middot; GPA {gpaShort}</span>
            </div>
            <div class="fact-item">
              <span class="fact-label">FOCUS</span>
              <span class="fact-val">Full-Stack .NET &middot; AI/ML</span>
            </div>
            <div class="fact-item">
              <span class="fact-label">LOCATION</span>
              <span class="fact-val">Surabaya, Indonesia</span>
            </div>
          </div>
        </div>

        <div class="hero-photo-col">
          <figure class="portrait-card" data-portrait-card>
            <div class="photo-frame">
              <img
                src={profileImage}
                srcset={profileImageSrcset}
                sizes="(max-width: 900px) calc(100vw - 2rem), 340px"
                alt="Portrait of Achmad Fahmi Ainur Ridho"
                width={profileImageMeta?.width}
                height={profileImageMeta?.height}
                loading="eager"
                decoding="async"
                class="portrait-img"
              />
            </div>
            <figcaption class="photo-caption">
              <span class="caption-name">Achmad Fahmi Ainur Ridho</span>
              <span class="caption-meta">Surabaya, ID &middot; 2026</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- THE META-CRAFT: WEBSITE ARCHITECTURE & DESIGN SYSTEM -->
  <section class="meta-section divider" data-reveal>
    <div class="container">
      <div class="section-heading">
        <p class="section-kicker">THE META-CRAFT</p>
        <h2 class="section-title">How this website was engineered.</h2>
        <p class="section-lead">
          A personal portfolio is the clearest proof of how someone designs,
          codes, and thinks. Every detail here is intentional.
        </p>
      </div>

      <div class="specs-grid">
        {
          designSystemSpecs.map((spec, idx) => (
            <div class="spec-card">
              <span class="spec-num">0{idx + 1}</span>
              <h3 class="spec-label">{spec.label}</h3>
              <p class="spec-value">{spec.value}</p>
              <p class="spec-desc">{spec.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- THE THREE PILLARS OF PRACTICE -->
  <section class="pillars-section divider" data-reveal>
    <div class="container">
      <div class="section-heading">
        <p class="section-kicker">CORE PILLARS</p>
        <h2 class="section-title">What I care about &amp; how I build.</h2>
        <p class="section-lead">
          Three core practices that shape how I write code, evaluate machine
          learning experiments, and live daily life.
        </p>
      </div>

      <div class="pillars-stack">
        {
          pillars.map((p) => (
            <article class="pillar-card-detailed">
              <div class="pillar-side">
                <span class="pillar-num">{p.num}</span>
                <span class="pillar-tag">{p.tag}</span>
              </div>
              <div class="pillar-main">
                <h3 class="pillar-heading">{p.title}</h3>
                <p class="pillar-lead-text">{p.lead}</p>
                <ul class="pillar-points">
                  {p.points.map((pt) => (
                    <li>
                      <span class="point-bullet" aria-hidden="true">
                        &bull;
                      </span>
                      <span>{pt}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CAREER & ACADEMIC SNAPSHOT (Clean & Non-Bloated) -->
  <section class="timeline-section divider" data-reveal>
    <div class="container">
      <div class="timeline-header">
        <div>
          <p class="section-kicker">EXPERIENCE SNAPSHOT</p>
          <h2 class="section-title">Where I&rsquo;ve delivered results.</h2>
        </div>
        <a
          href="https://id.linkedin.com/in/fahmiridho"
          target="_blank"
          rel="noreferrer"
          class="linkedin-cta-btn"
        >
          View Complete History on LinkedIn
          <span aria-hidden="true">&nearr;</span>
        </a>
      </div>

      <div class="timeline-stream">
        {
          timelineSnapshot.map((item) => (
            <div class="timeline-row">
              <div class="timeline-time">
                <span class="time-badge" set:html={item.year} />
              </div>
              <div class="timeline-body">
                <h3 class="timeline-org">{item.org}</h3>
                <p class="timeline-role">{item.role}</p>
                <p class="timeline-summary">{item.summary}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- MINIMAL CONTACT SIGN-OFF -->
  <section class="about-contact-section divider" data-reveal>
    <div class="container contact-mini-container">
      <div class="contact-mini-card">
        <p class="section-kicker">GET IN TOUCH</p>
        <h2 class="contact-mini-title">
          Let&rsquo;s talk software, AI, or coffee.
        </h2>
        <p class="contact-mini-lead">
          Open for software engineering and AI/ML opportunities starting in
          2026.
        </p>

        <div class="contact-mini-actions">
          <div class="email-copy-pill" data-email-box>
            <span class="email-text">{profile.email}</span>
            <button
              type="button"
              class="copy-pill-btn"
              data-copy-email
              data-email={profile.email}
              aria-label="Copy email address"
            >
              <span data-copy-label>Copy</span>
            </button>
            <a href={profile.emailHref} class="send-pill-btn">
              Email Me <span aria-hidden="true">&nearr;</span>
            </a>
          </div>

          <div class="channels-row">
            <a
              href="https://id.linkedin.com/in/fahmiridho"
              target="_blank"
              rel="noreferrer"
              class="ch-link"
            >
              LinkedIn <span aria-hidden="true">&nearr;</span>
            </a>
            <a
              href="https://github.com/fahmiridho07"
              target="_blank"
              rel="noreferrer"
              class="ch-link"
            >
              GitHub <span aria-hidden="true">&nearr;</span>
            </a>
            <a
              href={resumeAction.href}
              download={resumeAction.download ? "" : undefined}
              class="ch-link ch-resume"
            >
              {resumeAction.label}
              <span aria-hidden="true">&darr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initOnPageLoad } from "@lib/page-script";

  initOnPageLoad(() => {
    // 3D Portrait Card Tilt
    const portrait = document.querySelector<HTMLElement>(
      "[data-portrait-card]",
    );
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (portrait && !reduceMotion) {
      portrait.addEventListener("mousemove", (e) => {
        const rect = portrait.getBoundingClientRect();
        const x = (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2);
        const y =
          (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2);
        portrait.style.transform = `perspective(1000px) rotateX(${-y * 5}deg) rotateY(${x * 5}deg) translateY(-4px)`;
      });

      portrait.addEventListener("mouseleave", () => {
        portrait.style.transform =
          "perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0)";
      });
    }

    // 1-Click Copy Email Logic
    const copyBtn =
      document.querySelector<HTMLButtonElement>("[data-copy-email]");
    if (copyBtn) {
      const copyLabel = copyBtn.querySelector<HTMLElement>("[data-copy-label]");
      const email = copyBtn.dataset.email || "achmadridho.id@gmail.com";

      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(email);
          if (copyLabel) copyLabel.textContent = "Copied!";
          copyBtn.classList.add("is-copied");

          window.setTimeout(() => {
            if (copyLabel) copyLabel.textContent = "Copy";
            copyBtn.classList.remove("is-copied");
          }, 2200);
        } catch {
          window.location.href = `mailto:${email}`;
        }
      });
    }
  });
</script>

<style>
  /* ------------------------------- Hero Section ------------------------------- */

  .about-hero {
    padding-block: var(--space-hero-top) clamp(3rem, 6vw, 5rem);
    background: var(--paper);
  }

  .hero-identity-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    text-transform: uppercase;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink);
    background: var(--paper-soft);
    border: 1px solid var(--line);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
  }

  .status-dot {
    width: 6px;
    height: 6px;
