---
// about.astro: Creative Editorial Dossier & Engineering Methodology
// Fully differentiated from Home.
// 1. Creative, Animated, Fun Hero with Holographic Portrait Card, Spinning Emblem, and Live Local Clock
// 2. Interactive Evolution Roadmap (4 Milestones across academic & enterprise career)
// 3. The Engineering Pipeline Schematic (4-step build methodology)
// 4. Clean Editorial Next-Steps Bridge (Zero contact duplication with Home)

import { education } from "@data/profile";
import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getProfilePageSchema } from "@lib/seo";
import { getImageMeta } from "@lib/images";
import { getResumeAction } from "@lib/resume";

const gpaShort = education.gpa.split("/")[0]?.trim() ?? education.gpa;
const siteUrl = Astro.site?.href ?? Astro.url.origin;
const profilePageSchema = getProfilePageSchema(siteUrl);
const aboutOgImage = getImageMeta(pageSeo.about.ogImagePath);
const profileImage = "/assets/profile/profile_photo.webp";
const profileImageSrcset =
  "/assets/profile/profile_photo-640.webp 640w, /assets/profile/profile_photo-960.webp 960w, /assets/profile/profile_photo.webp 1200w";
const profileImageMeta = getImageMeta(profileImage);
const resumeAction = getResumeAction();

// Evolution Milestones (Chronological Career & Research Roadmap)
const evolutionPhases = [
  {
    phase: "PHASE 01",
    period: "2022 &ndash; 2023",
    title: "Foundations & Systems Architecture",
    badge: "ITS SURABAYA",
    desc: "Mastered algorithmic complexity, relational database modeling, and software design patterns. Explored how raw data flows through backend pipelines.",
    highlight:
      "Academic GPA 3.62 &middot; Teaching Assistant in Enterprise Systems",
  },
  {
    phase: "PHASE 02",
    period: "2024",
    title: "Production Enterprise Engineering",
    badge: "PT KALTIM PRIMA COAL",
    desc: "Engineered and stabilized enterprise innovation platform (IdeKU V3) on ASP.NET Core for 5,000+ mining employees. Delivered RBAC security, embedded Power BI analytics, and automated supervisor approval workflows.",
    highlight: "Enterprise Scale &middot; Zero Production Downtime",
  },
  {
    phase: "PHASE 03",
    period: "2025 &ndash; 2026",
    title: "Machine Learning & Latent Research",
    badge: "UNDERGRADUATE THESIS",
    desc: "Tackled extreme class imbalance in financial transaction datasets. Designed deep generative Autoencoders to oversample latent representations without data leakage, paired with Bayesian-tuned LightGBM.",
    highlight: "0.8547 PR-AUC &middot; Bayesian Optuna Tuning",
  },
  {
    phase: "PHASE 04",
    period: "2026 &amp; BEYOND",
    title: "The Horizon: Systems + Intelligence",
    badge: "OPEN TO ROLES",
    desc: "Bridging the gap between scalable enterprise infrastructure and intelligent machine learning models. Ready to ship high-impact software starting from 2026.",
    highlight: "Software Engineering &middot; AI/ML Engineering",
  },
];

// Engineering Pipeline Steps (Mental Model & Build Methodology)
const pipelineSteps = [
  {
    num: "01",
    step: "SCHEMA & BOUNDARIES",
    title: "Architecture First",
    desc: "Establish domain models, strict type contracts, and database constraints before writing business logic.",
    pill: "Domain-Driven Design",
  },
  {
    num: "02",
    step: "RESILIENT CORE",
    title: "Clean API Execution",
    desc: "Build lightweight ASP.NET Core services with dependency injection, RBAC security, and automated error handling.",
    pill: "C# &middot; ASP.NET Core",
  },
  {
    num: "03",
    step: "EMPIRICAL MODELING",
    title: "Zero-Leakage ML",
    desc: "Strict cross-validation splits, latent space oversampling, and precision-recall optimization for skewed data.",
    pill: "LightGBM &middot; PyTorch",
  },
  {
    num: "04",
    step: "PRODUCTION POLISH",
    title: "Verified Delivery",
    desc: "Sub-millisecond API response benchmarking, automated test suites, and sub-second web render times.",
    pill: "100/100 Lighthouse",
  },
];
---

<BaseLayout
  title={pageSeo.about.title}
  description={pageSeo.about.description}
  jsonLd={profilePageSchema}
  ogImagePath={pageSeo.about.ogImagePath}
  ogImageAlt={pageSeo.about.ogImageAlt}
  ogImageWidth={aboutOgImage?.width}
  ogImageHeight={aboutOgImage?.height}
>
  <!-- CHAPTER 1: CREATIVE ANIMATED DOSSIER HERO -->
  <section class="creative-hero">
    <div class="container" data-reveal>
      <!-- Top Creative Meta Strip -->
      <div class="hero-top-strip">
        <div class="creator-chip">
          <span class="chip-dot"></span>
          <span>Achmad Fahmi Ainur Ridho &middot; Ridho</span>
        </div>

        <div class="live-clock-pill" data-live-clock>
          <span class="clock-icon">&bull;</span>
          <span class="clock-city">Surabaya, ID</span>
          <span class="clock-time" data-clock-time>--:-- WIB</span>
        </div>
      </div>

      <div class="hero-creative-grid">
        <!-- Left: Punchy Narrative & Live Attributes -->
        <div class="hero-narrative-box">
          <div class="headline-wrapper">
            <h1 class="display hero-creative-title">
              I build software with <span class="highlight-ink"
                >architectural care</span
              > and train models with <span class="highlight-carmine"
                >scientific discipline<span class="dot-beacon"></span></span
              >.
            </h1>
          </div>

          <p class="hero-creative-lead">
            Final-year Information Systems student at ITS Surabaya moving deep
            into AI engineering. My journey began in full-stack .NET enterprise
            systems, but working with real production databases quickly revealed
            that what data predicts is even more interesting than the UI wrapped
            around it.
          </p>

          <!-- Interactive Curiosity Chips -->
          <div class="curiosity-pills">
            <div class="curiosity-pill" data-bounce-pill>
              <span class="pill-emoji">🏛️</span>
              <span>ITS Surabaya &middot; GPA {gpaShort}</span>
            </div>
            <div class="curiosity-pill" data-bounce-pill>
              <span class="pill-emoji">⚡</span>
              <span>Full-Stack .NET &middot; C#</span>
            </div>
            <div class="curiosity-pill" data-bounce-pill>
              <span class="pill-emoji">🔬</span>
              <span>AI Research &middot; Latent Oversampling</span>
            </div>
          </div>
        </div>

        <!-- Right: Creative Holographic Portrait Stage with Spinning Emblem & Interactive Stickers -->
        <div class="hero-stage-box">
          <div class="holographic-stage" data-holo-stage>
            <!-- Spinning Editorial Emblem -->
            <div class="spinning-emblem" aria-hidden="true">
              <svg viewBox="0 0 100 100" class="emblem-svg">
                <path
                  id="circlePath"
                  d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0"
                  fill="none"></path>
                <text
                  font-size="10.5"
                  font-family="monospace"
                  letter-spacing="2px"
                  fill="currentColor"
                >
                  <textPath href="#circlePath">
                    ✦ ARCHITECT ✦ RESEARCHER ✦ BUILDER
                  </textPath>
                </text>
              </svg>
              <div class="emblem-center-dot"></div>
            </div>

            <!-- The Tactile ID Badge / Portrait Card -->
            <div class="hologram-card" data-holo-card>
              <div class="card-sheen" data-card-sheen></div>

              <!-- Floating Interactive Sticker 1 (Top Left) -->
              <div class="card-sticker sticker-role" data-sticker>
                <span class="sticker-ping"></span>
                <span>SYSTEMS &amp; AI</span>
              </div>

              <!-- Floating Interactive Sticker 2 (Bottom Right) -->
              <div class="card-sticker sticker-thesis" data-sticker>
                <span>0.855 PR-AUC &bull; THESIS</span>
              </div>

              <!-- Photo Viewfinder Frame -->
              <div class="card-photo-frame">
                <img
                  src={profileImage}
                  srcset={profileImageSrcset}
                  sizes="(max-width: 900px) calc(100vw - 2rem), 320px"
                  alt="Portrait of Achmad Fahmi Ainur Ridho"
                  width={profileImageMeta?.width}
                  height={profileImageMeta?.height}
                  loading="eager"
                  decoding="async"
                  class="card-img"
                />
                <!-- Camera Crosshair Grid -->
                <div class="camera-reticle" aria-hidden="true">
                  <div class="reticle-target"></div>
                </div>
              </div>

              <div class="card-footer-telemetry">
                <span class="telemetry-tag">ID: RIDHO-2026</span>
                <span class="telemetry-status">OPEN TO ROLES</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 2: INTERACTIVE EVOLUTION ROADMAP -->
  <section class="roadmap-section divider" data-reveal>
    <div class="container">
      <div class="section-header">
        <div class="header-badge">
          <span class="badge-num">01</span>
          <span class="badge-title">CAREER &amp; ACADEMIC EVOLUTION</span>
        </div>
        <h2 class="section-heading">How I got here: 4 key milestones.</h2>
        <p class="section-subhead">
          From algorithmic fundamentals to enterprise mining production and
          generative AI thesis research.
        </p>
      </div>

      <div class="roadmap-timeline">
        <!-- Connecting Line Visual -->
        <div class="roadmap-spine" aria-hidden="true"></div>

        <div class="roadmap-nodes">
          {
            evolutionPhases.map((phase, idx) => (
              <div class="roadmap-card" data-phase-index={idx}>
                <div class="card-marker">
                  <span class="marker-dot" />
                  <span class="marker-pulse" />
                </div>
                <div class="card-content">
                  <div class="card-meta">
                    <span class="phase-code">{phase.phase}</span>
                    <span class="phase-period" set:html={phase.period} />
                    <span class="phase-badge">{phase.badge}</span>
                  </div>
                  <h3 class="phase-title">{phase.title}</h3>
                  <p class="phase-desc">{phase.desc}</p>
                  <div class="phase-highlight">
                    <span class="highlight-bullet" aria-hidden="true">
                      &bull;
                    </span>
                    <span set:html={phase.highlight} />
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 3: THE ENGINEERING PIPELINE SCHEMATIC -->
  <section class="pipeline-section divider" data-reveal>
    <div class="container">
      <div class="section-header">
        <div class="header-badge">
          <span class="badge-num">02</span>
          <span class="badge-title">THE METHODOLOGY</span>
        </div>
        <h2 class="section-heading">How I build systems that endure.</h2>
        <p class="section-subhead">
          A disciplined 4-stage pipeline that ensures code is maintainable,
          models are sound, and delivery is verified.
        </p>
      </div>

      <div class="pipeline-grid">
        {
          pipelineSteps.map((s, idx) => (
            <div class="pipeline-card">
              <div class="pipeline-card-head">
                <span class="pipeline-num">{s.num}</span>
                <span class="pipeline-step-name">{s.step}</span>
              </div>
              <h3 class="pipeline-title">{s.title}</h3>
              <p class="pipeline-desc">{s.desc}</p>
              <div class="pipeline-pill" set:html={s.pill} />
              {idx < 3 && (
                <div class="pipeline-arrow" aria-hidden="true">
                  &rarr;
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CHAPTER 4: EDITORIAL NEXT STEPS (Zero Redundancy with Home Contact) -->
  <section class="editorial-bridge-section divider" data-reveal>
    <div class="container bridge-container">
      <div class="bridge-card">
        <span class="bridge-kicker">WHAT NEXT</span>
        <h2 class="bridge-title">Inspect the technical proof.</h2>
        <p class="bridge-lead">
          Every project includes architecture diagrams, verified metrics,
          trade-off analyses, and production learnings.
        </p>

        <div class="bridge-actions">
          <a
            href="/projects/"
            class="primary-projects-btn"
            data-astro-prefetch="hover"
          >
            Explore All 11 Projects &amp; Case Studies
            <span aria-hidden="true">&rarr;</span>
          </a>

          <div class="bridge-channels">
            <span class="channels-label">Or explore credentials:</span>
            <div class="channels-links">
              <a
                href="https://id.linkedin.com/in/fahmiridho"
                target="_blank"
                rel="noreferrer"
                class="bridge-pill"
              >
                LinkedIn <span aria-hidden="true">&nearr;</span>
              </a>
              <a
                href="https://github.com/fahmiridho07"
                target="_blank"
                rel="noreferrer"
                class="bridge-pill"
              >
                GitHub <span aria-hidden="true">&nearr;</span>
              </a>
              <a
                href={resumeAction.href}
                download={resumeAction.download ? "" : undefined}
                class="bridge-pill bridge-resume"
              >
                {resumeAction.label}
                <span aria-hidden="true">&darr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initOnPageLoad } from "@lib/page-script";

  initOnPageLoad(() => {
    // 1. Real-Time Surabaya Clock (WIB = UTC+7)
    const clockEl = document.querySelector<HTMLElement>("[data-clock-time]");
    if (clockEl) {
      const updateClock = () => {
        const now = new Date();
        const options: Intl.DateTimeFormatOptions = {
          timeZone: "Asia/Jakarta",
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit",
          hour12: false,
        };
        clockEl.textContent = `${now.toLocaleTimeString("en-GB", options)} WIB`;
      };
      updateClock();
      const timer = window.setInterval(updateClock, 1000);
      window.addEventListener("astro:before-swap", () => clearInterval(timer), {
        once: true,
      });
    }

    // 2. 3D Holographic Card Mouse Tilt & Sheen Reflection
    const card = document.querySelector<HTMLElement>("[data-holo-card]");
    const sheen = document.querySelector<HTMLElement>("[data-card-sheen]");
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (card && !reduceMotion) {
      card.addEventListener("mousemove", (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2);
        const y =
          (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2);
        const rotX = -y * 8;
        const rotY = x * 8;
        card.style.transform = `perspective(1000px) rotateX(${rotX}deg) rotateY(${rotY}deg) translateY(-4px)`;

        if (sheen) {
          const sheenX = ((e.clientX - rect.left) / rect.width) * 100;
          const sheenY = ((e.clientY - rect.top) / rect.height) * 100;
          sheen.style.background = `radial-gradient(circle at ${sheenX}% ${sheenY}%, rgba(255,255,255,0.45) 0%, transparent 60%)`;
        }
      });

      card.addEventListener("mouseleave", () => {
        card.style.transform =
          "perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0)";
        if (sheen) sheen.style.background = "none";
      });

      // Interactive Click Squish
      card.addEventListener("click", () => {
        card.classList.add("is-squished");
        window.setTimeout(() => card.classList.remove("is-squished"), 400);
      });
    }

    // 3. Interactive Bouncing Stickers and Curiosity Chips
    const bounceElements = Array.from(
      document.querySelectorAll<HTMLElement>(
        "[data-sticker], [data-bounce-pill]",
      ),
    );
    bounceElements.forEach((el) => {
      el.addEventListener("click", (e) => {
        e.stopPropagation();
        el.classList.add("is-bouncing");
        window.setTimeout(() => el.classList.remove("is-bouncing"), 500);
      });
    });
  });
</script>

<style>
  /* ------------------------------- Creative Dossier Hero ------------------------------- */

  .creative-hero {
    padding-block: var(--space-hero-top) clamp(3.5rem, 7vw, 6rem);
    background: var(--paper);
    position: relative;
    overflow: hidden;
  }

  .hero-top-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(1.8rem, 3.5vw, 2.75rem);
    flex-wrap: wrap;
  }

  .creator-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink);
    background: #ffffff;
    border: 1px solid var(--line);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  .chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--signal);
  }

  .live-clock-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-soft);
    background: var(--paper-soft);
    border: 1px solid var(--line);
    padding: 0.28rem 0.75rem;
    border-radius: var(--radius-pill);
  }

  .clock-icon {
    color: #2e7d32;
    animation: clock-pulse 1.8s infinite;
  }

  @keyframes clock-pulse {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
    100% {
      opacity: 1;
    }
  }

  .clock-time {
    color: var(--ink);
    font-weight: 600;
  }

  /* Hero Grid */
  .hero-creative-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 5.5rem);
    align-items: center;
  }

  .hero-narrative-box {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .hero-creative-title {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 4.8vw, 3.8rem);
    font-weight: 480;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .highlight-ink {
    color: var(--ink);
    border-bottom: 2px solid var(--line-strong);
    padding-bottom: 1px;
  }

  .highlight-carmine {
    color: var(--signal-deep);
    position: relative;
  }

  .dot-beacon {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--signal);
    margin-left: 4px;
    box-shadow: 0 0 10px rgba(201, 46, 62, 0.6);
  }

  .hero-creative-lead {
    margin: 0;
    color: var(--ink-muted);
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.7;
    max-width: 52ch;
  }

  /* Curiosity Pills */
  .curiosity-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    padding-top: 0.5rem;
  }

  .curiosity-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #ffffff;
    border: 1px solid var(--line);
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink);
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(22, 24, 29, 0.03);
    transition: all var(--motion-fast) var(--ease-standard);
  }

  .curiosity-pill:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(22, 24, 29, 0.06);
  }

  .curiosity-pill.is-bouncing {
    animation: spring-squish 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Right Stage: Holographic Portrait */
  .hero-stage-box {
    display: flex;
    justify-content: center;
    position: relative;
  }

  .holographic-stage {
    position: relative;
    width: 100%;
    max-width: 340px;
  }

  /* Spinning Emblem */
  .spinning-emblem {
    position: absolute;
    top: -38px;
    right: -38px;
    width: 96px;
    height: 96px;
    color: var(--ink);
    z-index: 10;
    pointer-events: none;
    animation: emblem-rotate 24s linear infinite;
  }

  @keyframes emblem-rotate {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .emblem-svg {
    width: 100%;
    height: 100%;
  }

  .emblem-center-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--signal);
  }

  /* Hologram Card */
  .hologram-card {
    position: relative;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 12px;
    box-shadow: 0 20px 48px rgba(22, 24, 29, 0.08);
    transform-style: preserve-3d;
    transition: transform var(--motion-fast) var(--ease-standard);
    cursor: pointer;
  }

  .hologram-card.is-squished {
    animation: card-squish 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes card-squish {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(0.96) rotate(-1deg);
    }
    70% {
      transform: scale(1.02) rotate(1deg);
    }
    100% {
      transform: scale(1);
    }
  }

  .card-sheen {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
    pointer-events: none;
    z-index: 5;
    transition: background 0.1s ease;
  }

  /* Card Stickers */
  .card-sticker {
    position: absolute;
    z-index: 6;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.26rem 0.65rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
    cursor: pointer;
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .card-sticker:hover {
    transform: scale(1.1) !important;
  }

  .card-sticker.is-bouncing {
    animation: spring-squish 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sticker-role {
    top: -10px;
    left: -12px;
    background: var(--ink);
    color: #ffffff;
    transform: rotate(-6deg);
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .sticker-ping {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--signal);
  }

  .sticker-thesis {
    bottom: 35px;
    right: -14px;
    background: #ffffff;
    color: var(--signal-deep);
    border: 1px solid rgba(201, 46, 62, 0.3);
    transform: rotate(4deg);
  }

  @keyframes spring-squish {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.2) rotate(6deg);
    }
    70% {
      transform: scale(0.92) rotate(-4deg);
    }
    100% {
      transform: scale(1);
    }
  }

  /* Photo Container & Reticle */
  .card-photo-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 0.88;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--paper-soft);
  }

