    0% {
      box-shadow: 0 0 0 0 rgba(201, 46, 62, 0.5);
    }
    70% {
      box-shadow: 0 0 0 5px rgba(201, 46, 62, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(201, 46, 62, 0);
    }
  }

  .about-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .hero-text-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero-display {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(2.3rem, 4.6vw, 3.8rem);
    font-weight: 480;
    line-height: 1.12;
    letter-spacing: -0.015em;
  }

  .hero-narrative {
    margin: 0;
