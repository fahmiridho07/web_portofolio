---
import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title={pageSeo.notFound.title}
  description={pageSeo.notFound.description}
  robots={pageSeo.notFound.robots}
>
  <section class="not-found dark-hero-shell">
    <div class="container not-found-inner">
      <div class="not-found-card" data-reveal>
        <p class="section-label">404</p>
        <h1 class="display">Page not found.</h1>
        <div class="not-found-actions dark-cta-row">
          <a class="dark-cta dark-cta-primary" href="/">
            Home <span aria-hidden="true">-&gt;</span>
          </a>
          <a class="dark-cta dark-cta-secondary" href="/projects/" data-astro-prefetch="hover">Projects</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: calc(100vh - 8rem);
    align-items: center;
    padding-block-end: var(--space-section-end);
  }

  .not-found-inner {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
  }

  .not-found-card {
    display: grid;
    gap: var(--space-stack-md);
    width: min(100%, 28rem);
    padding: clamp(1.5rem, 4vw, 2rem);
    text-align: center;
  }

  .not-found-card .display {
    font-size: clamp(2rem, 6vw, 2.8rem);
  }

  .not-found-actions {
    justify-content: center;
    margin-top: var(--space-stack-xs);
  }

  @media (max-width: 620px) {
    .not-found {
      min-height: calc(100vh - 6rem);
      padding-block: 5rem var(--space-section-end);
    }
  }
</style>