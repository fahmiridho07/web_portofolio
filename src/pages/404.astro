---
import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title={pageSeo.notFound.title}
  description={pageSeo.notFound.description}
  robots={pageSeo.notFound.robots}
>
  <section class="not-found">
    <div class="container not-found-inner" data-reveal>
      <svg class="nf-plot" viewBox="0 0 240 130" aria-hidden="true">
        <path class="nf-axes" d="M24 6 V104 H232"></path>
        <path class="nf-grid" d="M24 40 H232 M24 72 H232"></path>
        <circle class="nf-dot" cx="44" cy="88" r="4"></circle>
        <circle class="nf-dot" cx="68" cy="78" r="4"></circle>
        <circle class="nf-dot" cx="92" cy="83" r="4"></circle>
        <circle class="nf-dot" cx="116" cy="68" r="4"></circle>
        <circle class="nf-dot" cx="140" cy="60" r="4"></circle>
        <circle class="nf-dot" cx="164" cy="64" r="4"></circle>
        <circle class="nf-dot" cx="188" cy="50" r="4"></circle>
        <circle class="nf-outlier" cx="204" cy="22" r="5"></circle>
        <circle class="nf-ring" cx="204" cy="22" r="12"></circle>
      </svg>

      <p class="section-label">404 &middot; anomaly detected</p>
      <h1 class="display">This page is an <em>outlier</em>.</h1>
      <p class="nf-copy">
        It sits outside every route this site knows. Flagged, logged, and nothing more to see here.
      </p>

      <div class="nf-actions dark-cta-row">
        <a class="dark-cta dark-cta-primary" href="/">
          Back to the data <span aria-hidden="true">-&gt;</span>
        </a>
        <a class="dark-cta dark-cta-secondary" href="/projects/" data-astro-prefetch="hover">Projects</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: calc(100vh - 12rem);
    align-items: center;
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .not-found-inner {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
  }

  .nf-plot {
    width: clamp(11rem, 24vw, 15rem);
    margin-bottom: 0.5rem;
    overflow: visible;
  }

  .nf-axes {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }

  .nf-grid {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
  }

  .nf-dot {
    fill: var(--ink);
    opacity: 0.62;
  }

  .nf-outlier {
    fill: var(--signal);
    opacity: 0.9;
  }

  .nf-ring {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.75;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.55);
    animation: nf-ring-in 420ms var(--ease-out) 350ms forwards;
  }

  @keyframes nf-ring-in {
    to {
      opacity: 0.9;
      transform: scale(1);
    }
  }

  .not-found .display {
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
  }

  .not-found .display em {
    color: var(--rust-deep);
    font-style: italic;
    font-weight: 450;
  }

  .nf-copy {
    max-width: 42ch;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .nf-actions {
    margin-top: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-ring {
      opacity: 0.9;
      transform: none;
      animation: none;
    }
  }
</style>
