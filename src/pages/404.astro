---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="The page you requested is not available on this portfolio site."
>
  <section class="section not-found">
    <div class="container not-found-inner">
      <p class="eyebrow">404</p>
      <h1 class="display">This page is not in the portfolio archive.</h1>
      <p class="lead">
        The link may be outdated or mistyped. Return to the homepage or browse
        the project index.
      </p>
      <div class="not-found-actions">
        <a class="action action-primary" href="/">Back to home</a>
        <a class="action action-secondary" href="/projects/">View projects</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100vh - 12rem);
    display: grid;
    align-items: center;
    background:
      radial-gradient(circle at 0% 0%, rgba(125, 211, 252, 0.08), transparent 24rem),
      var(--surface-light);
  }

  .not-found-inner {
    display: grid;
    gap: 1rem;
    max-width: 760px;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.5rem;
  }

  .action {
    display: inline-flex;
    min-height: 2.65rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.82rem 1.05rem;
  }

  .action-primary {
    background: var(--accent);
    color: #ffffff;
    box-shadow: 0 12px 28px rgba(15, 159, 135, 0.14);
  }

  .action-secondary {
    border: 1px solid rgba(15, 159, 135, 0.22);
    background: rgba(255, 255, 255, 0.72);
    color: var(--accent);
  }
</style>