---
import {
  homeProjectSlugs,
  profile,
  education,
  experiences,
} from "@data/profile";
import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getSortedProjects } from "@lib/projects";
import { getResumeAction } from "@lib/resume";
import HeroInteractive from "@components/HeroInteractive.astro";
import TelemetryGrid from "@components/TelemetryGrid.astro";
import SelectedWorkSection from "@components/SelectedWorkSection.astro";
import PersonalTextureBento from "@components/PersonalTextureBento.astro";

const allProjects = await getSortedProjects();
type ProjectEntry = (typeof allProjects)[number];
const homeProjects = homeProjectSlugs
  .map((slug) => allProjects.find((project) => project.data.slug === slug))
  .filter((project): project is ProjectEntry => Boolean(project));
const projectCount = allProjects.length;
const resumeAction = getResumeAction();
const gpaShort = education.gpa.split("/")[0]?.trim() ?? education.gpa;
const internship = experiences[0];

const backgroundRows = [
  {
    label: "Education",
    title: education.institution,
    detail: `${education.degree}, GPA ${gpaShort}, graduating 2026`,
  },
  {
    label: "Experience",
    title: internship.organization,
    detail: internship.summary,
  },
  {
    label: "Leadership",
    title: "HMSI ITS, R&D Vice Head",
    detail:
      "Led member development, innovation projects, and SOP work across the department.",
  },
];

const heroLead = "I build software that";
const heroTail = "and the machine learning behind it.";
const heroSentence = `${heroLead} ships, ${heroTail}`;
let heroWordIndex = 0;

// The ticker runs on results, not tool names: every entry is a real number
// from a case study on this site.
const marqueeItems = [
  { value: "0.8547 PR-AUC", label: "fraud thesis" },
  { value: "3,087 fraud caught", label: "89% precision" },
  { value: "0.47 → 0.67 held-out", label: "IndoBERT hybrid" },
  { value: "153.34 km routed", label: "ACO, 5 clusters" },
  { value: "R² 0.869", label: "airport demand" },
  { value: "0.852 accuracy", label: "3-class sentiment" },
  { value: "7 features shipped", label: "ASP.NET Core prod" },
  { value: "976k records", label: "LA crime classes" },
  { value: "120 months", label: "forecast horizon" },
  { value: "50+ students", label: "Odoo ERP teaching" },
];
---

<BaseLayout title={pageSeo.home.title} description={pageSeo.home.description}>
  <!-- HERO SECTION -->
  <section class="hero">
    <div class="container hero-inner" data-reveal>
      <div class="hero-text-block">
        <p class="hero-kicker">
          {profile.name} &middot; Surabaya, Indonesia
        </p>

        <h1 class="display hero-title" aria-label={heroSentence}>
          <span aria-hidden="true">
            {
              heroLead.split(" ").map((word) => (
                <span class="hero-word" style={`--wi: ${heroWordIndex++}`}>
                  {word}
                </span>
              ))
            }
            <span class="hero-word" style={`--wi: ${heroWordIndex++}`}>
              <em class="hero-em">
                ships
                <svg
                  class="hero-underline"
                  viewBox="0 0 200 20"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                >
                  <path d="M5 13 C 56 8, 138 6, 195 9" pathLength="1"></path>
                </svg>
              </em>,
            </span>
            {
              heroTail.split(" ").map((word) => (
                <span class="hero-word" style={`--wi: ${heroWordIndex++}`}>
                  {word}
                </span>
              ))
            }
          </span>
        </h1>

        <p class="hero-signal">{profile.roleSignal}</p>

        <p class="hero-now">
          <span class="hero-now-dot" aria-hidden="true"></span>
          {profile.currentFocus}
        </p>

        <div class="hero-actions">
          <a class="hero-link" href="#work"
            >View selected work <span aria-hidden="true">&darr;</span></a
          >
          <a class="hero-link" href="#analog-craft"
            >Analog rituals <span aria-hidden="true">&darr;</span></a
          >
          <a class="hero-link" href={profile.emailHref}
            >Email me <span aria-hidden="true">&nearr;</span></a
          >
        </div>
      </div>

      <!-- 3D WebGL Anomaly & Topological Data Centerpiece -->
      <HeroInteractive />
    </div>
  </section>

  <!-- TELEMETRY IMPACT BAR -->
  <TelemetryGrid />

  <!-- DUAL-MODE SELECTED WORK SHOWCASE -->
  <SelectedWorkSection projects={homeProjects} totalCount={projectCount} />

  <!-- PERSONAL TEXTURE BENTO GRID: ANALOG RITUALS & CRAFT -->
  <PersonalTextureBento />

  <!-- BACKGROUND & EDUCATION -->
  <section class="background divider">
    <div class="container">
      <div class="background-head" data-reveal>
        <p class="section-label">Trajectory</p>
        <h2 class="background-heading">Background & credentials.</h2>
      </div>

      <dl class="background-list">
        {
          backgroundRows.map((row) => (
            <div class="background-row" data-reveal>
              <dt>{row.label}</dt>
              <dd>
                <span class="background-title">{row.title}</span>
                <span class="background-detail">{row.detail}</span>
              </dd>
            </div>
          ))
        }
      </dl>

      <a
        class="background-more"
        href="/about/"
        data-astro-prefetch="hover"
        data-reveal
      >
        Full background & working principles <span aria-hidden="true"
          >&rarr;</span
        >
      </a>
    </div>
  </section>

  <!-- METRIC RESULTS MARQUEE -->
  <aside class="marquee divider" aria-label="Results in numbers">
    <p class="sr-only">
      {marqueeItems.map((item) => `${item.value} (${item.label})`).join(", ")}
    </p>
    <div class="marquee-track" aria-hidden="true">
      {
        [0, 1].map(() => (
          <div class="marquee-group">
            {marqueeItems.map((item, index) => (
              <span class="marquee-item">
                {item.value}
                <span class="marquee-label">{item.label}</span>
                <span
                  class:list={["marquee-dot", index === 2 && "is-anomaly"]}
                />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </aside>

  <!-- CONTACT FOOTER HERO -->
  <section id="contact" class="contact divider">
    <div class="container contact-inner" data-reveal>
      <p class="section-label">Contact</p>
      <h2 class="contact-title">Let&rsquo;s build <em>something</em>.</h2>
      <p class="contact-copy">{profile.contactPrompt}</p>

      <div class="contact-actions">
        <a class="dark-cta dark-cta-primary" href={profile.emailHref}>
          Email me <span aria-hidden="true">&nearr;</span>
        </a>

        <ul class="contact-links">
          <li>
            <a
              href={resumeAction.href}
              download={resumeAction.download ? "" : undefined}
            >
              {resumeAction.label}
            </a>
          </li>
          {
            profile.links
              .filter((link) => link.label !== "Email")
              .map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noreferrer">
                    {link.label}
                  </a>
                </li>
              ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ------------------------------- Hero ------------------------------- */

  .hero {
    position: relative;
    padding-block: var(--space-hero-top) clamp(2rem, 4vw, 3.5rem);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .hero-text-block {
    display: grid;
    gap: 1.25rem;
  }

  .hero-kicker {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero .display {
    max-width: 900px;
    font-size: clamp(2.7rem, 6.2vw, 5.4rem);
  }

  .hero-signal {
    max-width: 48ch;
    margin: 0;
    color: var(--ink-muted);
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    line-height: 1.6;
  }

  .hero-now {
    display: inline-flex;
    width: fit-content;
    align-items: baseline;
    gap: 0.55rem;
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.55;
  }

  .hero-now-dot {
    width: 0.42rem;
    height: 0.42rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--signal);
    transform: translateY(-0.05rem);
    animation: dot-pulse 2.4s var(--ease-standard) infinite;
  }

  @keyframes dot-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(201, 46, 62, 0.35);
    }

    50% {
      box-shadow: 0 0 0 5px rgba(201, 46, 62, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-now-dot {
      animation: none;
    }
  }

  .hero-word {
    display: inline-block;
    margin-right: 0.24em;
    opacity: 0;
    transform: translateY(0.55em);
    animation: hero-word-in 520ms var(--ease-out) forwards;
    animation-delay: calc(var(--wi) * 45ms);
  }

  @keyframes hero-word-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-em {
    position: relative;
    display: inline-block;
    color: inherit;
    font-style: italic;
    font-weight: 440;
  }

  .hero-underline {
    position: absolute;
    right: -0.04em;
    bottom: -0.16em;
    left: -0.04em;
    width: calc(100% + 0.08em);
    max-width: none;
    height: 0.16em;
    overflow: visible;
    pointer-events: none;
  }

  .hero-underline path {
    fill: none;
    stroke: var(--signal);
    stroke-width: 4.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.9;
    animation: underline-draw 600ms var(--ease-out) forwards;
    animation-delay: calc(var(--wi) * 45ms + 420ms);
    vector-effect: non-scaling-stroke;
  }

  @keyframes underline-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .hero-underline path {
      stroke-dashoffset: 0;
      animation: none;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .hero-link {
    margin-block: -0.45rem;
    padding-block: 0.45rem;
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    transition:
      color var(--motion-fast) var(--ease-standard),
      text-decoration-color var(--motion-fast) var(--ease-standard);
  }

  .hero-link:hover {
    color: var(--rust);
    text-decoration-color: var(--rust);
  }

  .hero-link span {
    display: inline-block;
    margin-left: 0.3rem;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .hero-link:hover span {
    transform: translateX(2px);
  }

  /* ---------------------------- Background ---------------------------- */

  .background-head {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .background-heading {
    margin: 0.4rem 0 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 480;
    letter-spacing: -0.01em;
  }

  .background-list {
    display: grid;
    margin: 0;
  }

  .background-row {
    display: grid;
    grid-template-columns: minmax(7rem, 0.25fr) minmax(0, 1fr);
    gap: 1rem 2rem;
    border-top: 1px solid var(--line);
    padding-block: clamp(1rem, 2.4vw, 1.5rem);
  }

  .background-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .background-row dt {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .background-row dd {
    display: grid;
    gap: 0.3rem;
    margin: 0;
  }

  .background-title {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 490;
    line-height: 1.25;
  }

  .background-detail {
    max-width: 60ch;
    color: var(--ink-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .background-more {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    margin-top: clamp(1rem, 2.4vw, 1.5rem);
    color: var(--ink-muted);
    font-size: 0.84rem;
    font-weight: 500;
  }

  .background-more:hover {
    color: var(--rust);
  }

  .background-more span {
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .background-more:hover span {
    transform: translateX(3px);
  }

  /* ------------------------------ Marquee ------------------------------ */

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    padding: 0;
  }

  .marquee {
    overflow: clip;
    padding-block: clamp(1.1rem, 2.4vw, 1.6rem);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 46s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-group {
    display: flex;
    flex-shrink: 0;
    align-items: baseline;
  }

  .marquee-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    margin-right: 1.6rem;
    color: var(--ink-muted);
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.2vw, 1.6rem);
    font-weight: 460;
    letter-spacing: -0.005em;
    line-height: 1;
    white-space: nowrap;
  }

  .marquee-item .marquee-dot {
    margin-left: 1.05rem;
  }

  .marquee-label {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.58em;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: translateY(-0.08em);
  }

  .marquee-dot {
    width: 0.34em;
    height: 0.34em;
    align-self: center;
    border: 1.5px solid var(--ink-soft);
    border-radius: 999px;
    opacity: 0.7;
    transform: translateY(0.02em);
  }

  .marquee-dot.is-anomaly {
    border-color: var(--signal);
    background: var(--signal);
    opacity: 1;
  }

  @keyframes marquee-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }

  /* ------------------------------ Contact ------------------------------ */

  .contact-inner {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .contact-title {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4.5vw, 3.4rem);
    font-weight: 470;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .contact-title em {
    color: var(--rust-deep);
    font-style: italic;
    font-weight: 450;
  }

  .contact-copy {
    max-width: 46ch;
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 0.75rem;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-links a {
    display: inline-block;
    margin-block: -0.45rem;
    padding-block: 0.45rem;
    color: var(--ink-muted);
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.32em;
    transition:
      color var(--motion-fast) var(--ease-standard),
      text-decoration-color var(--motion-fast) var(--ease-standard);
  }

  .contact-links a:hover {
    color: var(--rust);
    text-decoration-color: var(--rust);
  }

  /* ------------------------------ Mobile ------------------------------- */

  @media (max-width: 720px) {
    .hero .display {
      font-size: clamp(2.3rem, 10.5vw, 3.2rem);
    }

    .background-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
