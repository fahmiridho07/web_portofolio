---
import { profile } from "@data/profile";
import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getResumeAction } from "@lib/resume";
import FloatingHeroStage from "@components/FloatingHeroStage.astro";
import CleanProjectShowcase from "@components/CleanProjectShowcase.astro";
import FriendlyContact from "@components/FriendlyContact.astro";

const resumeAction = getResumeAction();

const heroLead = "I build software that";
const heroTail = "and the machine learning behind it.";
const heroSentence = `${heroLead} ships, ${heroTail}`;
let heroWordIndex = 0;

const craftPillars = [
  {
    number: "01",
    title: "Production Software",
    headline: "Reliable systems that hold up under real usage.",
    detail:
      "Enterprise ASP.NET Core, C#, clean REST APIs, database performance tuning, and automated workflows shipped to real business teams.",
    tag: "Full-Stack .NET & Python",
  },
  {
    number: "02",
    title: "Machine Learning Depth",
    headline: "Rigorous modeling tested without data leakage.",
    detail:
      "Undergraduate thesis on latent-space Autoencoder oversampling with LightGBM on 590,000 transactions. Focused on precision, real metrics, and deployability.",
    tag: "AI & Data Systems",
  },
  {
    number: "03",
    title: "Analog Disciplines",
    headline: "The same obsessive craft outside the terminal.",
    detail:
      "Daily manual V60 pour-over rituals, competitive badminton (28 lbs rear-court attack), road running splits (178 spm), and studying cinema direction.",
    tag: "Rituals & Craft",
  },
];
---

<BaseLayout title={pageSeo.home.title} description={pageSeo.home.description}>
  <!-- HERO SECTION -->
  <section class="hero">
    <div class="container hero-inner" data-reveal>
      <div class="hero-text-block">
        <div class="hero-top-line">
          <p class="hero-kicker">
            {profile.name} &middot; Surabaya, Indonesia
          </p>
          <div class="hero-availability">
            <span class="avail-dot" aria-hidden="true"></span>
            Open for 2026 Roles
          </div>
        </div>

        <h1 class="display hero-title" aria-label={heroSentence}>
          <span aria-hidden="true">
            {
              heroLead.split(" ").map((word) => (
                <span class="hero-word" style={`--wi: ${heroWordIndex++}`}>
                  {word}
                </span>
              ))
            }
            <span class="hero-word" style={`--wi: ${heroWordIndex++}`}>
              <em class="hero-em">
                ships
                <svg
                  class="hero-underline"
                  viewBox="0 0 200 20"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                >
                  <path d="M5 13 C 56 8, 138 6, 195 9" pathLength="1"></path>
                </svg>
              </em>,
            </span>
            {
              heroTail.split(" ").map((word) => (
                <span class="hero-word" style={`--wi: ${heroWordIndex++}`}>
                  {word}
                </span>
              ))
            }
          </span>
        </h1>

        <p class="hero-subhead">
          Final-year Information Systems student at ITS Surabaya moving deep
          into AI engineering. I care about clean architecture, models that
          solve actual problems, and the craft of everyday rituals.
        </p>

        <div class="hero-actions">
          <a class="hero-cta-primary" href="#work">
            Explore Selected Work
            <span aria-hidden="true">&darr;</span>
          </a>
          <a class="hero-cta-secondary" href="#contact">
            Say Hello
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a
            class="hero-cta-tertiary"
            href={resumeAction.href}
            download={resumeAction.download ? "" : undefined}
          >
            {resumeAction.label}
            <span aria-hidden="true">&darr;</span>
          </a>
        </div>
      </div>

      <!-- 3D Floating Illustrations Stage -->
      <FloatingHeroStage />
    </div>
  </section>

  <!-- SELECTED WORK SHOWCASE (Visual-First & Plain English) -->
  <CleanProjectShowcase />

  <!-- CRAFT & PILLARS SECTION -->
  <section class="pillars-section divider" data-reveal>
    <div class="container">
      <div class="pillars-header">
        <p class="section-kicker">DISCIPLINES & PHILOSOPHY</p>
        <h2 class="pillars-title">The intersection of code, models & craft.</h2>
      </div>

      <div class="pillars-grid">
        {
          craftPillars.map((pillar) => (
            <article class="pillar-card">
              <div class="pillar-top">
                <span class="pillar-num">{pillar.number}</span>
                <span class="pillar-tag">{pillar.tag}</span>
              </div>
              <h3 class="pillar-heading">{pillar.title}</h3>
              <p class="pillar-headline">{pillar.headline}</p>
              <p class="pillar-detail">{pillar.detail}</p>
            </article>
          ))
        }
      </div>

      <div class="pillars-footer">
        <a href="/about/" class="about-link" data-astro-prefetch="hover">
          Read full background, experience & education <span aria-hidden="true"
            >&rarr;</span
          >
        </a>
      </div>
    </div>
  </section>

  <!-- INVITING MINIMALIST CONTACT SECTION -->
  <FriendlyContact />
</BaseLayout>

<style>
  /* ------------------------------- Hero ------------------------------- */

  .hero {
    position: relative;
    padding-block: var(--space-hero-top) clamp(2rem, 4vw, 3.5rem);
    background: var(--paper);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-text-block {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 880px;
  }

  .hero-top-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .hero-kicker {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .hero-availability {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ink);
    background: var(--paper-soft);
    border: 1px solid var(--line);
    padding: 0.22rem 0.6rem;
    border-radius: var(--radius-pill);
  }

  .avail-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--signal);
    box-shadow: 0 0 0 0 rgba(201, 46, 62, 0.4);
    animation: avail-pulse 2.2s infinite;
  }

  @keyframes avail-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(201, 46, 62, 0.5);
    }
    70% {
      box-shadow: 0 0 0 5px rgba(201, 46, 62, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(201, 46, 62, 0);
    }
  }

  .hero .display {
    max-width: 900px;
    font-size: clamp(2.8rem, 6.2vw, 5.2rem);
    line-height: 1.08;
  }

  .hero-word {
    display: inline-block;
    margin-right: 0.24em;
    opacity: 0;
    transform: translateY(0.55em);
    animation: hero-word-in 520ms var(--ease-out) forwards;
    animation-delay: calc(var(--wi) * 45ms);
  }

  @keyframes hero-word-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-em {
    position: relative;
    display: inline-block;
    color: inherit;
    font-style: italic;
    font-weight: 440;
  }

  .hero-underline {
    position: absolute;
    right: -0.04em;
    bottom: -0.16em;
    left: -0.04em;
    width: calc(100% + 0.08em);
    max-width: none;
    height: 0.16em;
    overflow: visible;
    pointer-events: none;
  }

  .hero-underline path {
    fill: none;
    stroke: var(--signal);
    stroke-width: 4.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.9;
    animation: underline-draw 600ms var(--ease-out) forwards;
    animation-delay: calc(var(--wi) * 45ms + 420ms);
    vector-effect: non-scaling-stroke;
  }

  @keyframes underline-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .hero-subhead {
    max-width: 58ch;
    margin: 0;
    color: var(--ink-muted);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.68;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.25rem;
    margin-top: 0.5rem;
  }

  .hero-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-pill);
    transition: all var(--motion-fast) var(--ease-standard);
  }

  .hero-cta-primary:hover {
    background: var(--signal-deep);
    transform: translateY(-1px);
  }

  .hero-cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.72rem 1.3rem;
    border-radius: var(--radius-pill);
    transition: all var(--motion-fast) var(--ease-standard);
  }

  .hero-cta-secondary:hover {
    border-color: var(--ink);
    background: var(--paper-soft);
  }

  .hero-cta-tertiary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .hero-cta-tertiary:hover {
    color: var(--signal);
  }

  /* -------------------------- Pillars Section -------------------------- */

  .pillars-section {
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--paper);
  }

  .pillars-header {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    margin: 0;
  }

  .pillars-title {
    margin: 0.5rem 0 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 470;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .pillar-card {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: clamp(1.5rem, 2.5vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: all var(--motion-fast) var(--ease-standard);
  }

  .pillar-card:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(22, 24, 29, 0.04);
  }

  .pillar-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .pillar-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--signal);
  }

  .pillar-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--ink-soft);
    background: var(--paper-soft);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
  }

  .pillar-heading {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.25;
  }

  .pillar-headline {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.5;
  }

  .pillar-detail {
    margin: 0;
    font-size: 0.86rem;
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .pillars-footer {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .about-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-muted);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .about-link:hover {
    color: var(--signal);
  }

  @media (max-width: 900px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .hero-underline path {
      stroke-dashoffset: 0;
      animation: none;
    }
    .avail-dot {
      animation: none;
    }
  }
</style>
