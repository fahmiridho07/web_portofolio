---
import FeaturedProjectShowcase from "@components/FeaturedProjectShowcase.astro";
import ProjectMockup from "@components/ProjectMockup.astro";
import {
  coursesAndCertificates,
  education,
  experiences,
  homeProjectSlugs,
  profile,
} from "@data/profile";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getImageMeta } from "@lib/images";
import { getCategoryMeta, getSortedProjects } from "@lib/projects";

const allProjects = await getSortedProjects();
type ProjectEntry = (typeof allProjects)[number];
const homeProjects = homeProjectSlugs
  .map((slug) => allProjects.find((project) => project.data.slug === slug))
  .filter((project): project is ProjectEntry => Boolean(project));
const projectCount = allProjects.length;
const primaryExperience = experiences[0];
const activityItems = experiences.slice(1);
const profileAvatar = "/assets/profile/profile_avatar-160.webp";
const profileAvatarSrcset =
  "/assets/profile/profile_avatar-96.webp 96w, /assets/profile/profile_avatar-160.webp 160w";
const profileAvatarMeta = getImageMeta(profileAvatar);
const heroProject = homeProjects[0];
const heroCategory = heroProject ? getCategoryMeta(heroProject.data.category) : undefined;
const heroArtifactImage = heroProject?.data.coverImage;
const heroProof = heroProject?.data.proof?.[0] ?? heroProject?.data.metric ?? heroProject?.data.status;
const heroTags = ["Automation", "Dashboards", "ML systems", "Backend/data"];
---

<BaseLayout
  title="Achmad Fahmi Ainur Ridho Portfolio"
  description="Portfolio of Achmad Fahmi Ainur Ridho, a final-year Information Systems student building practical data products across machine learning, analytics, and backend workflows."
>
  <section class="simple-hero dark-section" data-dark-section>
    <div class="hero-gridlines" aria-hidden="true"></div>
    <div class="hero-ambient" aria-hidden="true"></div>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy" data-reveal>
        <div class="hero-person">
          <img
            src={profileAvatar}
            srcset={profileAvatarSrcset}
            sizes="54px"
            alt=""
            width={profileAvatarMeta?.width}
            height={profileAvatarMeta?.height}
            loading="eager"
            decoding="async"
          />
          <div>
            <p class="section-label">{profile.name}</p>
            <span>{profile.location} / {profile.role}</span>
          </div>
        </div>

        <div class="hero-message">
          <p class="hero-eyebrow">Data products / ML systems / workflow automation</p>
          <h1 class="display">I turn messy data workflows into shipped systems.</h1>
          <p>
            A compact showcase of practical systems: automation, dashboards,
            machine learning, and backend/data workflows, grounded in visible
            artifacts and clear decisions.
          </p>
        </div>

        <div class="hero-tags" aria-label="Portfolio focus">
          {heroTags.map((tag) => <span>{tag}</span>)}
        </div>

        <div class="hero-actions">
          <a class="hero-button hero-button-primary" href="#work">
            Explore selected work <span aria-hidden="true">-&gt;</span>
          </a>
          <a class="hero-button hero-button-secondary" href={profile.contactHref} target="_blank" rel="noreferrer">
            Contact
          </a>
        </div>
      </div>

      {
        heroProject && heroArtifactImage && (
          <aside class="hero-artifact" aria-label="Featured project artifact" data-reveal data-reveal-delay="120">
            <a class="artifact-card" href={`/projects/${heroProject.data.slug}/`}>
              <div class="artifact-image" aria-hidden="true">
                <ProjectMockup project={heroProject} variant="hero" eager />
              </div>
              <div class="artifact-body">
                <p class="section-label">{heroCategory?.title}</p>
                <h2>{heroProject.data.title}</h2>
                <p>{heroProof}</p>
                <span>View case study -&gt;</span>
              </div>
            </a>
          </aside>
        )
      }
    </div>
  </section>

  <section id="work" class="featured-work divider">
    <div class="container featured-inner">
      <div class="section-intro" data-reveal>
        <p class="section-label">Selected work</p>
        <h2>Four projects that show how the work comes together.</h2>
        <p>
          A tighter path through the portfolio: workflow automation, production
          stabilization, recommendation systems, and business analytics, each
          grounded in visible artifacts.
        </p>
      </div>

      <a class="archive-link" href="/projects/" data-reveal data-reveal-delay="80">
        Explore all {projectCount} projects <span aria-hidden="true">-&gt;</span>
      </a>

      <FeaturedProjectShowcase projects={homeProjects} />
    </div>
  </section>

  <section class="scan-section divider">
    <div class="container scan-grid">
      <article class="scan-card" data-reveal>
        <p class="section-label">Education</p>
        <h2>{education.degree}</h2>
        <p>{education.institution}</p>
        <small>{education.period} / GPA {education.gpa}</small>
      </article>

      <article class="scan-card is-highlighted" data-reveal data-reveal-delay="100">
        <p class="section-label">Experience</p>
        <h2>{primaryExperience.role}</h2>
        <p>{primaryExperience.organization}</p>
        <small>{primaryExperience.summary}</small>
      </article>

      <article class="scan-card" data-reveal data-reveal-delay="200">
        <p class="section-label">Activities</p>
        {
          activityItems.slice(0, 2).map((item) => (
            <div>
              <h3>{item.organization}</h3>
              <p>{item.role}</p>
            </div>
          ))
        }
        <small>{coursesAndCertificates[0]}</small>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .simple-hero {
    position: relative;
    display: grid;
    min-height: auto;
    overflow: hidden;
    background:
      radial-gradient(circle at 20% 18%, rgba(125, 211, 252, 0.14), transparent 24rem),
      radial-gradient(circle at 86% 24%, rgba(167, 243, 208, 0.12), transparent 28rem),
      linear-gradient(135deg, #07111e 0%, #111d2e 56%, #171321 100%);
    color: #ffffff;
    padding-block: clamp(5.2rem, 8vw, 6.2rem) clamp(2.2rem, 4vw, 3.2rem);
  }

  .hero-gridlines {
    position: absolute;
    inset: 0;
    opacity: 0.16;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 4.5rem 4.5rem;
    mask-image: linear-gradient(180deg, #000, transparent 82%);
  }

  .hero-ambient {
    position: absolute;
    right: max(-8rem, -8vw);
    top: 8rem;
    width: min(42rem, 58vw);
    aspect-ratio: 1.28;
    border-radius: 999px;
    background:
      radial-gradient(circle at 34% 42%, rgba(125, 211, 252, 0.24), transparent 34%),
      radial-gradient(circle at 68% 62%, rgba(251, 191, 154, 0.16), transparent 38%),
      rgba(255, 255, 255, 0.03);
    filter: blur(24px);
    opacity: 0.86;
    pointer-events: none;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(7, 17, 30, 0.96), rgba(7, 17, 30, 0.64) 52%, rgba(7, 17, 30, 0.25)),
      linear-gradient(180deg, transparent 64%, var(--surface-light) 100%);
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(17.5rem, 0.42fr);
    gap: clamp(2rem, 5vw, 4.6rem);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 1.2rem;
    min-width: 0;
  }

  .hero-person {
    display: inline-grid;
    width: fit-content;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.72rem;
    align-items: center;
  }

  .hero-person img {
    width: 3.15rem;
    height: 3.15rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    object-fit: cover;
    object-position: center 58%;
  }

  .hero-person .section-label {
    margin: 0 0 0.35rem;
    color: rgba(255, 255, 255, 0.62);
  }

  .hero-person span {
    display: block;
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .hero-message {
    display: grid;
    gap: 0.95rem;
  }

  .hero-eyebrow {
    width: fit-content;
    margin: 0;
    border: 1px solid rgba(148, 163, 184, 0.28);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.055);
    color: rgba(226, 232, 240, 0.9);
    font-size: 0.75rem;
    line-height: 1;
    padding: 0.52rem 0.72rem;
  }

  .hero-message .display {
    max-width: 820px;
    color: #ffffff;
    font-size: clamp(3rem, 6vw, 5.35rem);
    line-height: 0.94;
  }

  .hero-message p:not(.hero-eyebrow) {
    max-width: 41rem;
    margin: 0;
    color: rgba(226, 232, 240, 0.74);
    font-size: clamp(0.98rem, 1.45vw, 1.08rem);
    line-height: 1.72;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hero-tags span {
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    color: rgba(226, 232, 240, 0.72);
    font-size: 0.76rem;
    line-height: 1;
    padding: 0.48rem 0.66rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .hero-button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.84rem 1.05rem;
    transition:
      background var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-out);
  }

  .hero-button:hover {
    transform: translateY(-2px);
  }

  .hero-button span {
    display: inline-block;
    margin-left: 0.42rem;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .hero-button:hover span {
    transform: translateX(3px);
  }

  .hero-button-primary {
    border: 1px solid rgba(125, 211, 252, 0.36);
    background: #e7f8ff;
    box-shadow: 0 14px 36px rgba(125, 211, 252, 0.16);
    color: #0b1724;
  }

  .hero-button-secondary {
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.055);
    color: rgba(255, 255, 255, 0.82);
  }

  .hero-button-secondary:hover {
    border-color: rgba(125, 211, 252, 0.32);
    color: #ffffff;
  }

  .hero-artifact {
    min-width: 0;
  }

  .artifact-card {
    display: grid;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.13), rgba(255, 255, 255, 0.055)),
      rgba(10, 18, 30, 0.66);
    box-shadow:
      0 26px 80px rgba(0, 0, 0, 0.32),
      0 0 70px rgba(125, 211, 252, 0.08);
    color: inherit;
    backdrop-filter: blur(16px);
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-out);
  }

  .artifact-card:hover {
    border-color: rgba(125, 211, 252, 0.32);
    box-shadow:
      0 30px 90px rgba(0, 0, 0, 0.36),
      0 0 84px rgba(125, 211, 252, 0.12);
    transform: translateY(-3px);
  }

  .artifact-image {
    aspect-ratio: 1.55;
    margin: 0.72rem 0.72rem 0;
    overflow: hidden;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.06);
  }

  .artifact-body {
    display: grid;
    gap: 0.55rem;
    padding: 0.9rem 0.95rem 1rem;
  }

  .artifact-body .section-label {
    margin: 0;
    color: rgba(226, 232, 240, 0.58);
  }

  .artifact-body h2 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(1.05rem, 1.65vw, 1.28rem);
    font-weight: 600;
    line-height: 1.12;
  }

  .artifact-body p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: rgba(226, 232, 240, 0.7);
    font-size: 0.82rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .artifact-body span {
    color: #bae6fd;
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1;
  }

  .artifact-body span {
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .featured-work {
    background:
      radial-gradient(circle at 0% 0%, rgba(125, 211, 252, 0.06), transparent 24rem),
      var(--surface-light);
    padding-block: clamp(2.8rem, 4vw, 3.5rem) clamp(4rem, 8vw, 6.5rem);
  }

  .scan-section {
    background:
      radial-gradient(circle at 100% 20%, rgba(15, 159, 135, 0.05), transparent 28rem),
      var(--surface-light);
    padding-block: clamp(4rem, 8vw, 6.5rem);
  }

  .featured-inner {
    display: grid;
    gap: clamp(1.25rem, 3vw, 1.8rem);
  }

  .section-intro {
    display: grid;
    gap: 0.75rem;
    max-width: 760px;
  }

  .section-intro .section-label {
    color: var(--accent);
  }

  .section-intro h2,
  .scan-card h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.75rem, 3.5vw, 3.2rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.02;
  }

  .section-intro p,
  .scan-card p,
  .scan-card small {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .archive-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .archive-link span {
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .archive-link:hover span {
    transform: translateX(4px);
  }

  .scan-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 1.3rem);
  }

  .scan-card {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    min-height: 18rem;
    border: 1px solid rgba(17, 24, 39, 0.12);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.62);
    box-shadow: 0 14px 42px rgba(17, 24, 39, 0.045);
    padding: clamp(1rem, 2.5vw, 1.35rem);
  }

  .scan-card.is-highlighted {
    background:
      linear-gradient(145deg, rgba(15, 159, 135, 0.1), rgba(125, 211, 252, 0.08)),
      rgba(255, 255, 255, 0.74);
  }

  .scan-card h2 {
    font-size: clamp(1.25rem, 2vw, 1.7rem);
  }

  .scan-card h3 {
    margin: 0.75rem 0 0;
    color: var(--text);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.18;
  }

  .scan-card small {
    font-size: 0.86rem;
  }

  @media (max-width: 920px) {
    .simple-hero {
      min-height: auto;
    }

    .hero-grid,
    .scan-grid {
      grid-template-columns: 1fr;
    }

    .hero-shade {
      background:
        linear-gradient(180deg, rgba(7, 17, 30, 0.9) 0%, rgba(7, 17, 30, 0.76) 70%, var(--surface-light) 100%);
    }

    .hero-artifact {
      max-width: 32rem;
    }

    .scan-card {
      min-height: auto;
    }
  }

  @media (max-width: 620px) {
    .simple-hero {
      padding-block: 5.25rem 2.8rem;
    }

    .hero-message .display {
      font-size: clamp(2.35rem, 12vw, 3.45rem);
      line-height: 0.98;
    }

    .hero-message p:not(.hero-eyebrow) {
      font-size: 0.95rem;
      line-height: 1.62;
    }

    .hero-person img {
      width: 3rem;
      height: 3rem;
    }

    .hero-tags {
      gap: 0.42rem;
    }

    .hero-tags span {
      font-size: 0.72rem;
      padding: 0.44rem 0.58rem;
    }

    .artifact-image {
      aspect-ratio: 1.7;
      margin: 0.56rem 0.56rem 0;
    }

    .artifact-body {
      padding: 0.78rem 0.82rem 0.9rem;
    }

    .featured-work,
    .scan-section {
      padding-block: 3.25rem;
    }
  }
</style>
