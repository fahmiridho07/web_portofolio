---
// index.astro: Visual, Playful, Scroll-Driven Homepage Experience
// Story Architecture:
// Scenes 1-5: Pinned Continuous Storytelling Stage (ScrollStoryStage.astro)
// Scene 6: Visual Project Exhibits (VisualProjectExhibits.astro)
// Scene 7: Warm Minimalist Sign-off & Contact (FriendlyContact.astro)

import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
import ScrollStoryStage from "@components/ScrollStoryStage.astro";
import VisualProjectExhibits from "@components/VisualProjectExhibits.astro";
import FriendlyContact from "@components/FriendlyContact.astro";
---

<BaseLayout title={pageSeo.home.title} description={pageSeo.home.description}>
  <!-- SCENES 1 to 5: Pinned Scroll-Driven Storytelling Stage -->
  <ScrollStoryStage />

  <!-- SCENE 6: Animated Conceptual Project Exhibits -->
  <VisualProjectExhibits />

  <!-- SCENE 7: Warm Minimal Sign-off & Contact -->
  <FriendlyContact />
</BaseLayout>
