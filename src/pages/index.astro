---
// index.astro: Visual, Playful, Scroll-Driven Homepage Experience
// Story Architecture:
// Scenes 1-4: Pinned Continuous Storytelling Stage (ScrollStoryStage.astro)
// Scene 5: Interactive Engineering Lab & Exhibits (VisualProjectExhibits.astro)
// Scene 6: Warm Minimalist Sign-off & Contact (FriendlyContact.astro)

import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
import ScrollStoryStage from "@components/ScrollStoryStage.astro";
import TelemetryGrid from "@components/TelemetryGrid.astro";
import VisualProjectExhibits from "@components/VisualProjectExhibits.astro";
import FriendlyContact from "@components/FriendlyContact.astro";
---

<BaseLayout title={pageSeo.home.title} description={pageSeo.home.description}>
  {/* SCENES 1 to 4: Pinned Scroll-Driven Storytelling Stage */}
  <ScrollStoryStage />

  {/* VERIFIED PROOF: Engineering Telemetry & Shipped Outcomes */}
  <TelemetryGrid />

  {/* SCENE 5: Interactive Engineering Lab & Exhibits */}
  <VisualProjectExhibits />

  {/* SCENE 6: Warm Minimal Sign-off & Contact */}
  <FriendlyContact />
</BaseLayout>
