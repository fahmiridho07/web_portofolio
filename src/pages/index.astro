---
import { heroProjectSlug, homeProjectSlugs, profile, education, experiences } from "@data/profile";
import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getResponsiveImageSources } from "@lib/images";
import { getCategoryMeta, getSortedProjects } from "@lib/projects";
import { getResumeAction } from "@lib/resume";

const allProjects = await getSortedProjects();
type ProjectEntry = (typeof allProjects)[number];
const homeProjects = homeProjectSlugs
  .map((slug) => allProjects.find((project) => project.data.slug === slug))
  .filter((project): project is ProjectEntry => Boolean(project));
const projectCount = allProjects.length;
const resumeAction = getResumeAction();
const gpaShort = education.gpa.split("/")[0]?.trim() ?? education.gpa;
const internship = experiences[0];

const backgroundRows = [
  {
    label: "Education",
    title: education.institution,
    detail: `${education.degree}, GPA ${gpaShort}, graduating 2026`,
  },
  {
    label: "Experience",
    title: internship.organization,
    detail: internship.summary,
  },
  {
    label: "Leadership",
    title: "HMSI ITS, R&D Vice Head",
    detail: "Led member development, innovation projects, and SOP work across the department.",
  },
];

const heroLead = "I build software that";
const heroTail = "and the machine learning behind it.";
const heroSentence = `${heroLead} ships, ${heroTail}`;
let heroWordIndex = 0;

// The ticker runs on results, not tool names: every entry is a real number
// from a case study on this site.
const marqueeItems = [
  { value: "0.8547 PR-AUC", label: "fraud thesis" },
  { value: "3,087 fraud caught", label: "89% precision" },
  { value: "0.47 → 0.67 held-out", label: "IndoBERT hybrid" },
  { value: "153.34 km routed", label: "ACO, 5 clusters" },
  { value: "R² 0.869", label: "airport demand" },
  { value: "0.852 accuracy", label: "3-class sentiment" },
  { value: "7 features shipped", label: "ASP.NET Core prod" },
  { value: "976k records", label: "LA crime classes" },
  { value: "120 months", label: "forecast horizon" },
  { value: "50+ students", label: "Odoo ERP teaching" },
];
---

<BaseLayout title={pageSeo.home.title} description={pageSeo.home.description}>
  <section class="hero">
    <div class="container hero-inner" data-reveal>
      <svg class="hero-plot" viewBox="0 0 240 190" aria-hidden="true">
        <path class="plot-axes" d="M28 8 V158 H232" pathLength="1"></path>
        <path class="plot-grid" d="M28 58 H232 M28 108 H232"></path>
        <g class="plot-ticks">
          <path d="M28 58 h-4 M28 108 h-4 M78 158 v4 M128 158 v4 M178 158 v4"></path>
        </g>
        <circle class="plot-dot" cx="48" cy="138" r="4"></circle>
        <circle class="plot-dot" cx="70" cy="124" r="4"></circle>
        <circle class="plot-dot" cx="92" cy="131" r="4"></circle>
        <circle class="plot-dot" cx="114" cy="108" r="4"></circle>
        <circle class="plot-dot" cx="136" cy="96" r="4"></circle>
        <circle class="plot-dot" cx="158" cy="101" r="4"></circle>
        <circle class="plot-dot" cx="180" cy="80" r="4"></circle>
        <circle class="plot-dot" cx="204" cy="70" r="4"></circle>
        <circle class="plot-outlier" cx="196" cy="30" r="5"></circle>
        <circle class="plot-ring" cx="196" cy="30" r="13"></circle>
      </svg>

      <p class="hero-kicker">
        {profile.name} &middot; Surabaya, Indonesia
      </p>

      <h1 class="display hero-title" aria-label={heroSentence}>
        <span aria-hidden="true">
          {
            heroLead.split(" ").map((word) => (
              <span class="hero-word" style={`--wi: ${heroWordIndex++}`}>
                {word}
              </span>
            ))
          }
          <span class="hero-word" style={`--wi: ${heroWordIndex++}`}>
            <em class="hero-em">
              ships
              <svg class="hero-underline" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true">
                <path d="M5 13 C 56 8, 138 6, 195 9" pathLength="1"></path>
              </svg>
            </em>,
          </span>
          {
            heroTail.split(" ").map((word) => (
              <span class="hero-word" style={`--wi: ${heroWordIndex++}`}>
                {word}
              </span>
            ))
          }
        </span>
      </h1>

      <p class="hero-signal">{profile.roleSignal}</p>

      <p class="hero-now">
        <span class="hero-now-dot" aria-hidden="true"></span>
        {profile.currentFocus}
      </p>

      <div class="hero-actions">
        <a class="hero-link" href="#work">View work <span aria-hidden="true">&darr;</span></a>
        <a class="hero-link" href={profile.emailHref}
          >Email me <span aria-hidden="true">&nearr;</span></a
        >
      </div>
    </div>
  </section>

  <section id="work" class="work divider">
    <div class="container">
      <div class="work-head" data-reveal>
        <h2 class="section-label">Selected work</h2>
        <a class="work-all" href="/projects/" data-astro-prefetch="hover"
          >All {projectCount} projects <span aria-hidden="true">&rarr;</span></a
        >
      </div>

      <div class="work-list" data-work-list>
        {
          homeProjects.map((project, index) => {
            const category = getCategoryMeta(project.data.category);
            const metric = project.data.metric ?? project.data.status;
            const logo = project.data.logo ?? category.logo;
            const isAnomaly = project.data.slug === heroProjectSlug;

            return (
              <a
                class:list={["work-row", isAnomaly && "is-anomaly"]}
                href={`/projects/${project.data.slug}/`}
                data-astro-prefetch="hover"
                data-work-row={String(index)}
                data-reveal
              >
                <span class="work-index">{String(index + 1).padStart(2, "0")}</span>
                <span class="work-logo" aria-hidden="true">
                  {logo && <img src={logo} alt="" width="24" height="24" loading="lazy" decoding="async" />}
                </span>
                <span class="work-copy">
                  <span class="work-title">{project.data.title}</span>
                  <span class="work-meta">
                    {category.title} &middot; {project.data.year}
                    {isAnomaly && <span class="work-flag-dot" aria-hidden="true" />}
                  </span>
                </span>
                <span class="work-metric">{metric}</span>
                <span class="work-arrow" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            );
          })
        }
      </div>
    </div>

    <div class="work-preview" data-work-preview aria-hidden="true">
      {
        homeProjects.map((project, index) => {
          const image = getResponsiveImageSources(project.data.coverImage, "19rem");

          return (
            <img
              src={image.src}
              srcset={image.srcset}
              sizes={image.srcset ? image.sizes : undefined}
              alt=""
              width={image.width}
              height={image.height}
              loading="lazy"
              decoding="async"
              data-work-preview-image={String(index)}
            />
          );
        })
      }
    </div>
  </section>

  <section class="background divider">
    <div class="container">
      <h2 class="section-label" data-reveal>Background</h2>

      <dl class="background-list">
        {
          backgroundRows.map((row) => (
            <div class="background-row" data-reveal>
              <dt>{row.label}</dt>
              <dd>
                <span class="background-title">{row.title}</span>
                <span class="background-detail">{row.detail}</span>
              </dd>
            </div>
          ))
        }
      </dl>

      <a class="background-more" href="/about/" data-astro-prefetch="hover" data-reveal>
        More about me <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <aside class="marquee divider" aria-label="Results in numbers">
    <p class="sr-only">
      {marqueeItems.map((item) => `${item.value} (${item.label})`).join(", ")}
    </p>
    <div class="marquee-track" aria-hidden="true">
      {
        [0, 1].map(() => (
          <div class="marquee-group">
            {marqueeItems.map((item, index) => (
              <span class="marquee-item">
                {item.value}
                <span class="marquee-label">{item.label}</span>
                <span class:list={["marquee-dot", index === 2 && "is-anomaly"]} />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </aside>

  <section id="contact" class="contact divider">
    <div class="container contact-inner" data-reveal>
      <p class="section-label">Contact</p>
      <h2 class="contact-title">Let&rsquo;s build <em>something</em>.</h2>
      <p class="contact-copy">{profile.contactPrompt}</p>

      <div class="contact-actions">
        <a class="dark-cta dark-cta-primary" href={profile.emailHref}>
          Email me <span aria-hidden="true">&nearr;</span>
        </a>

        <ul class="contact-links">
          <li>
            <a href={resumeAction.href} download={resumeAction.download ? "" : undefined}>
              {resumeAction.label}
            </a>
          </li>
          {
            profile.links
              .filter((link) => link.label !== "Email")
              .map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noreferrer">
                    {link.label}
                  </a>
                </li>
              ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initOnPageLoad } from "@lib/page-script";

  // Floating project preview: a thumbnail follows the cursor over the work
  // list. Pointer-only, decorative (aria-hidden), and skipped entirely on
  // touch devices and for reduced-motion users.
  initOnPageLoad(() => {
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const list = document.querySelector<HTMLElement>("[data-work-list]");
    const preview = document.querySelector<HTMLElement>("[data-work-preview]");

    if (!fine || reduceMotion || !list || !preview) {
      return;
    }

    const images = Array.from(
      preview.querySelectorAll<HTMLImageElement>("[data-work-preview-image]"),
    );
    const controller = new AbortController();
    const { signal } = controller;
    let raf = 0;
    let x = 0;
    let y = 0;

    const render = () => {
      raf = 0;
      preview.style.transform = `translate3d(${x + 24}px, ${y - 90}px, 0)`;
    };

    const onMove = (event: PointerEvent) => {
      x = event.clientX;
      y = event.clientY;

      if (!raf) {
        raf = requestAnimationFrame(render);
      }
    };

    const onEnter = (event: Event) => {
      const row = (event.currentTarget as HTMLElement).dataset.workRow;
      images.forEach((image) => {
        image.classList.toggle("is-active", image.dataset.workPreviewImage === row);
      });
      preview.classList.add("is-visible");
    };

    const onLeave = () => {
      preview.classList.remove("is-visible");
    };

    list.addEventListener("pointermove", onMove, { signal });
    list.addEventListener("pointerleave", onLeave, { signal });
    list.querySelectorAll<HTMLElement>("[data-work-row]").forEach((row) => {
      row.addEventListener("pointerenter", onEnter, { signal });
      row.addEventListener("focus", () => onLeave(), { signal });
    });

    return () => {
      controller.abort();

      if (raf) {
        cancelAnimationFrame(raf);
      }
    };
  });

  // The chart's ordered dots politely dodge the cursor; the flagged outlier
  // holds its ground. The whole site's thesis in one interaction.
  initOnPageLoad(() => {
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const hero = document.querySelector<HTMLElement>(".hero");
    const plot = document.querySelector<SVGSVGElement>(".hero-plot");

    if (!fine || reduceMotion || !hero || !plot) {
      return;
    }

    const controller = new AbortController();
    const { signal } = controller;
    const dots = Array.from(plot.querySelectorAll<SVGCircleElement>(".plot-dot"));
    const state = dots.map(() => ({ x: 0, y: 0, tx: 0, ty: 0, baseX: 0, baseY: 0 }));
    const RADIUS = 80;
    const PUSH = 0.3;
    let raf = 0;
    let based = false;

    const cacheBases = () => {
      based = true;
      dots.forEach((dot, i) => {
        const rect = dot.getBoundingClientRect();
        state[i].baseX = rect.left + rect.width / 2 - state[i].x;
        state[i].baseY = rect.top + rect.height / 2 - state[i].y;
      });
    };

    const render = () => {
      let settled = true;

      state.forEach((s, i) => {
        s.x += (s.tx - s.x) * 0.14;
        s.y += (s.ty - s.y) * 0.14;

        if (Math.abs(s.tx - s.x) > 0.1 || Math.abs(s.ty - s.y) > 0.1) {
          settled = false;
        }

        dots[i].style.transform = `translate(${s.x.toFixed(1)}px, ${s.y.toFixed(1)}px)`;
      });

      raf = settled ? 0 : requestAnimationFrame(render);
    };

    const wake = () => {
      if (!raf) {
        raf = requestAnimationFrame(render);
      }
    };

    // Viewport-relative bases go stale on scroll/resize; re-cache lazily.
    window.addEventListener("scroll", () => (based = false), { passive: true, signal });
    window.addEventListener("resize", () => (based = false), { signal });

    hero.addEventListener(
      "pointermove",
      (event) => {
        if (!based) {
          cacheBases();
        }

        state.forEach((s) => {
          const dx = s.baseX - event.clientX;
          const dy = s.baseY - event.clientY;
          const dist = Math.hypot(dx, dy);

          if (dist < RADIUS && dist > 0) {
            const strength = (RADIUS - dist) * PUSH;
            s.tx = (dx / dist) * strength;
            s.ty = (dy / dist) * strength;
          } else {
            s.tx = 0;
            s.ty = 0;
          }
        });
        wake();
      },
      { passive: true, signal },
    );

    hero.addEventListener(
      "pointerleave",
      () => {
        state.forEach((s) => {
          s.tx = 0;
          s.ty = 0;
        });
        wake();
      },
      { signal },
    );

    return () => {
      controller.abort();

      if (raf) {
        cancelAnimationFrame(raf);
      }
    };
  });
</script>

<style>
  /* ------------------------------- Hero ------------------------------- */

  .hero {
    position: relative;
    overflow: clip;
    padding-block: var(--space-hero-top) var(--space-hero-bottom);
  }

  /* A tidy miniature scatter chart: axes, faint grid, an upward trend of ink
     dots, and one carmine outlier sitting clearly off the trend. Figurative,
     not abstract — it reads as "finds the signal in data" without a word.
     Anchored to the content grid so it stays proportional to the headline. */
  .hero-plot {
    position: absolute;
    top: 0.25rem;
    right: 0;
    z-index: 0;
    width: clamp(10rem, 16vw, 14rem);
    overflow: visible;
    pointer-events: none;
  }

  @media (max-width: 1100px) {
    .hero-plot {
      display: none;
    }
  }

  .plot-axes {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: plot-axes-draw 700ms var(--ease-out) 100ms forwards;
  }

  @keyframes plot-axes-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .plot-grid,
  .plot-ticks path {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
    opacity: 0;
    animation: plot-fade-in 400ms var(--ease-standard) 500ms forwards;
  }

  @keyframes plot-fade-in {
    to {
      opacity: 1;
    }
  }

  /* Dots land in reading order, like points being plotted one by one */
  .plot-dot {
    fill: var(--ink);
    opacity: 0;
    animation: plot-dot-in 320ms var(--ease-out) forwards;
  }

  .plot-dot:nth-of-type(1) { animation-delay: 620ms; }
  .plot-dot:nth-of-type(2) { animation-delay: 700ms; }
  .plot-dot:nth-of-type(3) { animation-delay: 780ms; }
  .plot-dot:nth-of-type(4) { animation-delay: 860ms; }
  .plot-dot:nth-of-type(5) { animation-delay: 940ms; }
  .plot-dot:nth-of-type(6) { animation-delay: 1020ms; }
  .plot-dot:nth-of-type(7) { animation-delay: 1100ms; }
  .plot-dot:nth-of-type(8) { animation-delay: 1180ms; }

  @keyframes plot-dot-in {
    to {
      opacity: 0.62;
    }
  }

  .plot-outlier {
    fill: var(--signal);
    opacity: 0;
    animation: plot-fade-in 320ms var(--ease-out) 1340ms forwards;
  }

  .plot-ring {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.75;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.55);
    animation: plot-ring-in 420ms var(--ease-out) 1460ms forwards;
  }

  @keyframes plot-ring-in {
    to {
      opacity: 0.9;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .plot-axes {
      stroke-dashoffset: 0;
      animation: none;
    }

    .plot-grid,
    .plot-ticks path {
      opacity: 1;
      animation: none;
    }

    .plot-dot {
      opacity: 0.62;
      animation: none;
    }

    .plot-outlier {
      opacity: 1;
      animation: none;
    }

    .plot-ring {
      opacity: 0.9;
      transform: none;
      animation: none;
    }
  }

  /* Headline arrives word by word, once, on load */
  /* Stagger kept tight: the headline is the LCP element, so every extra
     millisecond of delay here is paid in paint metrics */
  .hero-word {
    display: inline-block;
    margin-right: 0.24em;
    opacity: 0;
    transform: translateY(0.55em);
    animation: hero-word-in 520ms var(--ease-out) forwards;
    animation-delay: calc(var(--wi) * 45ms);
  }

  @keyframes hero-word-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* The flagged word stays ink; only the annotation is signal red,
     exactly like circling a point on a printed chart */
  .hero-em {
    position: relative;
    display: inline-block;
    color: inherit;
    font-style: italic;
    font-weight: 440;
  }

  /* The flagged word: one confident hand-drawn underline, stroked in after
     the word lands. */
  .hero-underline {
    position: absolute;
    right: -0.04em;
    bottom: -0.16em;
    left: -0.04em;
    width: calc(100% + 0.08em);
    /* Global svg rule clamps max-width to 100%; unclamp so the insets apply. */
    max-width: none;
    height: 0.16em;
    overflow: visible;
    pointer-events: none;
  }

  .hero-underline path {
    fill: none;
    stroke: var(--signal);
    stroke-width: 4.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.9;
    animation: underline-draw 600ms var(--ease-out) forwards;
    animation-delay: calc(var(--wi) * 45ms + 420ms);
    vector-effect: non-scaling-stroke;
  }

  @keyframes underline-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .hero-underline path {
      stroke-dashoffset: 0;
      animation: none;
    }
  }

  .hero-inner {
    position: relative;
    display: grid;
    gap: 1.5rem;
  }

  .hero-kicker {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero .display {
    max-width: 900px;
    font-size: clamp(2.7rem, 6.2vw, 5.4rem);
  }

  .hero-signal {
    max-width: 44ch;
    margin: 0;
    color: var(--ink-muted);
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    line-height: 1.6;
  }

  .hero-now {
    display: inline-flex;
    width: fit-content;
    align-items: baseline;
    gap: 0.55rem;
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.55;
  }

  .hero-now-dot {
    width: 0.42rem;
    height: 0.42rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--signal);
    transform: translateY(-0.05rem);
    animation: dot-pulse 2.4s var(--ease-standard) infinite;
  }

  @keyframes dot-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(201, 46, 62, 0.35);
    }

    50% {
      box-shadow: 0 0 0 5px rgba(201, 46, 62, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-now-dot {
      animation: none;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .hero-link {
    /* Pad the hit area without moving the layout */
    margin-block: -0.45rem;
    padding-block: 0.45rem;
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    transition:
      color var(--motion-fast) var(--ease-standard),
      text-decoration-color var(--motion-fast) var(--ease-standard);
  }

  .hero-link:hover {
    color: var(--rust);
    text-decoration-color: var(--rust);
  }

  .hero-link span {
    display: inline-block;
    margin-left: 0.3rem;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .hero-link:hover span {
    transform: translateX(2px);
  }

  /* ---------------------------- Work list ----------------------------- */

  .work {
    position: relative;
  }

  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .work-all {
    color: var(--ink-muted);
    font-size: 0.84rem;
    font-weight: 500;
  }

  .work-all:hover {
    color: var(--rust);
  }

  .work-all span {
    display: inline-block;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .work-all:hover span {
    transform: translateX(3px);
  }

  .work-list {
    display: grid;
  }

  .work-row {
    display: grid;
    grid-template-columns: 2.4rem 2.1rem minmax(0, 1fr) auto 2rem;
    gap: 1rem;
    align-items: baseline;
    border-top: 1px solid var(--line);
    /* Bleed the hover surface past the text column without moving anything */
    margin-inline: calc(var(--space-4) * -1);
    padding-block: clamp(1.1rem, 2.6vw, 1.7rem);
    padding-inline: var(--space-4);
    transition: background var(--motion-fast) var(--ease-standard);
  }

  .work-row:hover,
