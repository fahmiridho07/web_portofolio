---
import CredentialsStrip from "@components/CredentialsStrip.astro";
import FeaturedProjectShowcase from "@components/FeaturedProjectShowcase.astro";
import FocusPanel from "@components/FocusPanel.astro";
import ProjectMockup from "@components/ProjectMockup.astro";
import { heroProjectSlug, homeProjectSlugs, profile } from "@data/profile";
import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getImageMeta } from "@lib/images";
import { getCategoryMeta, getSortedProjects } from "@lib/projects";

const allProjects = await getSortedProjects();
type ProjectEntry = (typeof allProjects)[number];
const homeProjects = homeProjectSlugs
  .map((slug) => allProjects.find((project) => project.data.slug === slug))
  .filter((project): project is ProjectEntry => Boolean(project));
const projectCount = allProjects.length;
const profileAvatar = "/assets/profile/profile_avatar-160.webp";
const profileAvatarSrcset =
  "/assets/profile/profile_avatar-96.webp 96w, /assets/profile/profile_avatar-160.webp 160w";
const profileAvatarMeta = getImageMeta(profileAvatar);
const heroProject =
  allProjects.find((project) => project.data.slug === heroProjectSlug) ?? homeProjects[1] ?? homeProjects[0];
const heroCategory = heroProject ? getCategoryMeta(heroProject.data.category) : undefined;
const heroArtifactImage = heroProject?.data.coverImage;
const heroProof = heroProject?.data.metric ?? heroProject?.data.status;
const homeProjectLabel = `${homeProjects.length} ${homeProjects.length === 1 ? "build" : "builds"}`;
---

<BaseLayout title={pageSeo.home.title} description={pageSeo.home.description}>
  <section class="simple-hero dark-section dark-hero-shell" data-dark-section>
    <div class="hero-backdrop" aria-hidden="true">
      <div class="hero-orb hero-orb-cyan"></div>
      <div class="hero-orb hero-orb-mint"></div>
      <div class="hero-orb hero-orb-warm"></div>
      <div class="hero-light-pool"></div>
      <div class="hero-beam"></div>
      <div class="dark-hero-grid"></div>
      <div class="hero-vignette"></div>
      <div class="hero-floor"></div>
    </div>
    <div class="container hero-grid">
      <div class="hero-copy" data-reveal>
        <div class="hero-person">
          <img
            src={profileAvatar}
            srcset={profileAvatarSrcset}
            sizes="54px"
            alt=""
            width={profileAvatarMeta?.width}
            height={profileAvatarMeta?.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div>
            <p class="section-label">{profile.name}</p>
            <span>{profile.location} / {profile.role}</span>
          </div>
        </div>

        <div class="hero-message">
          <h1 class="display">I turn messy data workflows into shipped systems.</h1>
          <p class="role-signal">{profile.roleSignal}</p>
        </div>

        <div class="dark-cta-row">
          <a class="dark-cta dark-cta-primary" href="#work">
            View work <span aria-hidden="true">-&gt;</span>
          </a>
          <a class="dark-cta dark-cta-secondary" href="/about/" data-astro-prefetch="hover">
            About
          </a>
        </div>
      </div>

      {
        heroProject && heroArtifactImage && (
          <aside class="hero-artifact" aria-label="Featured project artifact" data-reveal data-reveal-delay="120">
            <a class="artifact-card glass-dark" href={`/projects/${heroProject.data.slug}/`} data-astro-prefetch="hover">
              <div class="artifact-image" aria-hidden="true">
                <ProjectMockup project={heroProject} variant="hero" eager />
              </div>
              <div class="artifact-body">
                <p class="section-label">{heroCategory?.title}</p>
                <h2>{heroProject.data.title}</h2>
                <p>{heroProof}</p>
                <span>Open the build -&gt;</span>
              </div>
            </a>
          </aside>
        )
      }
    </div>
  </section>

  <section id="work" class="featured-work divider">
    <div class="container featured-inner">
      <div class="work-header" data-reveal>
        <div>
          <p class="section-label">Selected work</p>
          <h2>{homeProjectLabel}.</h2>
        </div>
        <a class="archive-link" href="/projects/" data-astro-prefetch="hover">
          All {projectCount} projects <span aria-hidden="true">-&gt;</span>
        </a>
      </div>

      <FeaturedProjectShowcase projects={homeProjects} />
    </div>
  </section>

  <CredentialsStrip />

  <section id="contact" class="contact-section divider">
    <div class="container contact-inner">
      <FocusPanel compact />
    </div>
  </section>
</BaseLayout>

<style>
  .simple-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: auto;
    background:
      radial-gradient(circle at 14% 12%, rgba(125, 211, 252, 0.16), transparent 28rem),
      radial-gradient(circle at 88% 18%, rgba(167, 243, 208, 0.14), transparent 32rem),
      radial-gradient(circle at 62% 88%, rgba(216, 162, 56, 0.08), transparent 24rem),
      linear-gradient(145deg, #06101c 0%, #0d1a2c 46%, #12101f 100%);
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-orb {
    position: absolute;
    border-radius: 999px;
    filter: blur(56px);
    will-change: transform;
  }

  .hero-orb-cyan {
    top: 8%;
    right: -4%;
    width: min(38rem, 54vw);
    height: min(30rem, 42vw);
    background: radial-gradient(circle, rgba(125, 211, 252, 0.42) 0%, transparent 68%);
    animation: hero-drift-cyan 32s var(--ease-standard) infinite;
  }

  .hero-orb-mint {
    top: 42%;
    left: -8%;
    width: min(30rem, 44vw);
    height: min(24rem, 36vw);
    background: radial-gradient(circle, rgba(155, 231, 212, 0.28) 0%, transparent 70%);
    animation: hero-drift-mint 38s var(--ease-standard) infinite;
  }

  .hero-orb-warm {
    right: 22%;
    bottom: 6%;
    width: min(24rem, 34vw);
    height: min(18rem, 28vw);
    background: radial-gradient(circle, rgba(216, 162, 56, 0.2) 0%, transparent 72%);
    animation: hero-drift-warm 42s var(--ease-standard) infinite;
  }

  .hero-light-pool {
    position: absolute;
    top: 18%;
    right: 10%;
    width: min(26rem, 40vw);
    aspect-ratio: 1.15;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(125, 211, 252, 0.16), transparent 64%);
    filter: blur(36px);
    opacity: 0.9;
  }

  .hero-beam {
    position: absolute;
    top: -18%;
    left: 32%;
    width: 42%;
    height: 136%;
    background: linear-gradient(
      112deg,
      transparent 40%,
      rgba(125, 211, 252, 0.07) 49%,
      rgba(155, 231, 212, 0.05) 52%,
      transparent 60%
    );
    transform: rotate(-7deg);
    opacity: 0.75;
  }

  .simple-hero .dark-hero-grid {
    opacity: 0.2;
    mask-image: radial-gradient(ellipse 92% 72% at 48% 18%, #000 12%, transparent 78%);
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(6, 16, 28, 0.78) 0%, rgba(6, 16, 28, 0.34) 46%, rgba(6, 16, 28, 0.1) 100%),
      linear-gradient(180deg, rgba(6, 16, 28, 0.28) 0%, transparent 34%, transparent 68%, rgba(243, 246, 251, 0.92) 100%);
  }

  .hero-floor {
    position: absolute;
    right: 12%;
    bottom: 0;
    left: 12%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(125, 211, 252, 0.28),
      rgba(155, 231, 212, 0.22),
      transparent
    );
    box-shadow: 0 0 40px rgba(125, 211, 252, 0.14);
    opacity: 0.8;
  }

  @keyframes hero-drift-cyan {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }

    50% {
      transform: translate3d(-2.5%, 2%, 0) scale(1.04);
    }
  }

  @keyframes hero-drift-mint {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }

    50% {
      transform: translate3d(3%, -2%, 0) scale(1.05);
    }
  }

  @keyframes hero-drift-warm {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }

    50% {
      transform: translate3d(-2%, 1.5%, 0) scale(1.03);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-orb {
      animation: none;
    }
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(17.5rem, 0.42fr);
    gap: var(--gap-hero);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: var(--space-stack-lg);
    min-width: 0;
  }

  .hero-person {
    display: inline-grid;
    width: fit-content;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.72rem;
    align-items: center;
  }

  .hero-person img {
    width: 3.15rem;
    height: 3.15rem;
    border: 1px solid var(--glass-dark-logo-border);
    border-radius: 999px;
    object-fit: cover;
    object-position: center 58%;
  }

  .hero-person .section-label {
    margin: 0 0 0.35rem;
    color: rgba(255, 255, 255, 0.62);
  }

  .hero-person span {
    display: block;
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .hero-message {
    display: grid;
    gap: var(--space-stack-md);
  }

  .hero-message .display {
    max-width: 820px;
    color: #ffffff;
    font-size: clamp(3rem, 6vw, 5.35rem);
    line-height: 0.94;
  }

  .role-signal {
    max-width: 36rem;
    margin: 0;
    color: rgba(226, 232, 240, 0.68);
    font-size: clamp(0.9rem, 1.3vw, 1rem);
    font-weight: 400;
    line-height: 1.55;
  }

  .hero-artifact {
    min-width: 0;
  }

  .artifact-card {
    display: grid;
    overflow: hidden;
    color: inherit;
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-out);
  }

  .artifact-card:hover {
    border-color: rgba(125, 211, 252, 0.32);
    box-shadow: var(--glass-dark-shadow-hover);
    transform: translateY(-3px);
  }

  .artifact-image {
    aspect-ratio: 1.55;
    margin: 0.72rem 0.72rem 0;
    overflow: hidden;
    border-radius: 6px;
    background: var(--glass-dark-well);
  }

  .artifact-body {
    display: grid;
    gap: 0.55rem;
    padding: 0.9rem 0.95rem 1rem;
  }

  .artifact-body .section-label {
    margin: 0;
    color: rgba(226, 232, 240, 0.58);
  }

  .artifact-body h2 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(1.05rem, 1.65vw, 1.28rem);
    font-weight: 600;
    line-height: 1.12;
  }

  .artifact-body p {
    margin: 0;
    color: rgba(226, 232, 240, 0.7);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .artifact-body span {
    color: #bae6fd;
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1;
  }

  .artifact-body span {
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .featured-work {
    position: relative;
    background:
      radial-gradient(
        ellipse 90% 55% at 50% -8%,
        color-mix(in srgb, var(--accent-cyan) 9%, transparent),
        transparent 58%
      ),
      radial-gradient(
        circle at 0% 0%,
        color-mix(in srgb, var(--accent-cyan) 6%, transparent),
        transparent 24rem
      ),
      var(--surface-light);
  }

  .featured-work::before {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 5rem;
    background: linear-gradient(180deg, rgba(243, 246, 251, 0.55), transparent);
    content: "";
    pointer-events: none;
  }

  .contact-section {
    position: relative;
    background:
      radial-gradient(
        ellipse 72% 48% at 50% 0%,
        color-mix(in srgb, var(--accent-cyan) 8%, transparent),
        transparent 56%
      ),
      radial-gradient(
        ellipse 70% 45% at 100% 12%,
        color-mix(in srgb, var(--accent) 7%, transparent),
        transparent 52%
      ),
      radial-gradient(
        circle at 100% 20%,
        color-mix(in srgb, var(--accent) 5%, transparent),
        transparent 28rem
      ),
      var(--surface-light);
  }

  .contact-inner {
    padding-block: clamp(0.5rem, 1.2vw, 0.85rem) clamp(0.65rem, 1.5vw, 1rem);
  }

  .featured-inner {
    display: grid;
    gap: var(--space-block-inner);
  }

  .work-header {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-stack-sm) var(--space-stack-lg);
  }

  .work-header .section-label {
    color: var(--accent);
  }

  .work-header h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.75rem, 3.5vw, 2.8rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.02;
  }

  .archive-link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .archive-link span {
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .archive-link:hover span {
    transform: translateX(4px);
  }

  @media (max-width: 920px) {
    .simple-hero {
      min-height: auto;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-vignette {
      background:
        linear-gradient(180deg, rgba(6, 16, 28, 0.82) 0%, rgba(6, 16, 28, 0.58) 62%, rgba(243, 246, 251, 0.94) 100%);
    }

    .hero-orb-cyan {
      top: 14%;
      right: -18%;
    }

    .hero-light-pool {
      top: 28%;
      right: 4%;
      width: min(20rem, 72vw);
    }

    .hero-artifact {
      max-width: 32rem;
    }

  }

  @media (max-width: 620px) {
    .simple-hero {
      padding-block: 5rem var(--space-hero-bottom);
    }

    .hero-message .display {
      font-size: clamp(2.35rem, 12vw, 3.45rem);
      line-height: 0.98;
    }

    .role-signal {
      font-size: 0.88rem;
      line-height: 1.5;
    }

    .hero-person img {
      width: 3rem;
      height: 3rem;
    }

    .artifact-image {
      aspect-ratio: 1.7;
      margin: 0.56rem 0.56rem 0;
    }

    .artifact-body {
      padding: 0.78rem 0.82rem 0.9rem;
    }

    .work-header {
      align-items: start;
    }
  }
</style>
