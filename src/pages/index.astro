---
import ProjectCard from "@components/ProjectCard.astro";
import {
  coursesAndCertificates,
  education,
  experiences,
  profile,
  projectCategories,
} from "@data/profile";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCategoryMeta, getSortedProjects } from "@lib/projects";

const allProjects = await getSortedProjects();
const activeCategories = projectCategories.filter((category) =>
  allProjects.some((project) => project.data.category === category.id),
);
const flagshipProject =
  allProjects.find((project) => project.data.slug === "kpc-power-automate-po-automation") ??
  allProjects[0];
const flagshipProof = flagshipProject
  ? (
      flagshipProject.data.proof && flagshipProject.data.proof.length > 0
        ? flagshipProject.data.proof
        : [flagshipProject.data.metric ?? flagshipProject.data.status, flagshipProject.data.status, ...flagshipProject.data.stack]
    )
      .filter(Boolean)
      .slice(0, 3)
  : [];
const rolePills = ["Data / ML Engineering", "Data Analytics", "Backend / Data Systems"];
const primaryExperience = experiences[0];
const activityItems = experiences.slice(1);
---

<BaseLayout
  title="Achmad Fahmi Ainur Ridho Portfolio"
  description="Portfolio of Achmad Fahmi Ainur Ridho, a final-year Information Systems student building practical data products across machine learning, analytics, and backend workflows."
>
  <section class="hero dark-section" data-dark-section>
    <div class="hero-circle hero-circle-large" aria-hidden="true"></div>
    <div class="hero-circle hero-circle-small" aria-hidden="true"></div>

    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="hero-person">
          <img src="/assets/profile/profile_photo.png" alt="" loading="eager" decoding="async" />
          <div>
            <p class="section-label">{profile.name}</p>
            <span>{profile.location} / {profile.role}</span>
          </div>
        </div>
        <h1 class="display">I build data products that actually ship.</h1>
        <p>
          Models, dashboards, backend workflows, and automation that turn messy
          inputs into useful systems.
        </p>
        <a class="text-arrow" href="#work">View work <span aria-hidden="true">-&gt;</span></a>
      </div>

      <div class="role-stack" aria-label="Role fit">
        {
          rolePills.map((role, index) => (
            <span class:list={[index === 0 && "is-primary"]}>{role}</span>
          ))
        }
      </div>
    </div>
  </section>

  {
    flagshipProject && (
      <section class="flagship-section">
        <div class="container flagship">
          <div class="flagship-copy">
            <p class="section-label">{getCategoryMeta(flagshipProject.data.category).title}</p>
            <h2>{flagshipProject.data.title}</h2>
            <p>{flagshipProject.data.result ?? flagshipProject.data.summary}</p>
            <span>{flagshipProject.data.metric ?? flagshipProject.data.status}</span>
            <ul class="flagship-proof" aria-label="Featured project proof points">
              {flagshipProof.map((item) => <li>{item}</li>)}
            </ul>
            <a class="text-arrow" href={`/projects/${flagshipProject.data.slug}/`}>
              Read case study <span aria-hidden="true">-&gt;</span>
            </a>
          </div>

          <a class="flagship-preview" href={`/projects/${flagshipProject.data.slug}/`}>
            <img src={flagshipProject.data.coverImage} alt="" loading="eager" />
            <span>
              <strong>{flagshipProject.data.title}</strong>
              <small>{flagshipProject.data.metric ?? flagshipProject.data.status}</small>
            </span>
          </a>
        </div>
      </section>
    )
  }

  <section id="work" class="work-section divider">
    <div class="container project-work" data-project-work data-view="list">
      <div class="work-head">
        <div>
          <p class="section-label">Project index</p>
          <h2>Evidence, quick to switch context.</h2>
        </div>

        <div class="view-toggle" aria-label="Project view mode">
          <button type="button" data-view-mode="grid" aria-pressed="false">Grid</button>
          <button type="button" data-view-mode="list" aria-pressed="true">List</button>
        </div>
      </div>

      <div class="filter-tabs" aria-label="Project category filters">
        <button type="button" data-project-filter="" aria-pressed="true">All</button>
        {
          activeCategories.map((category) => (
            <button type="button" data-project-filter={category.id} aria-pressed="false">
              {category.title}
            </button>
          ))
        }
      </div>

      <div class="project-grid" data-filter-list>
        {allProjects.map((project) => <ProjectCard project={project} />)}
      </div>

      <div class="project-list" data-filter-list>
        {
          allProjects.map((project, index) => {
            const category = getCategoryMeta(project.data.category);

            return (
              <a
                class="project-row"
                data-category={project.data.category}
                href={`/projects/${project.data.slug}/`}
              >
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{project.data.title}</strong>
                <small>{category.title}</small>
                <small>{project.data.metric ?? project.data.status}</small>
                <small>{project.data.year}</small>
                <em aria-hidden="true">-&gt;</em>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="resume-section divider">
    <div class="container resume-grid">
      <article>
        <p class="section-label">Education</p>
        <h2>{education.degree}</h2>
        <p>{education.institution}</p>
        <small>{education.period} / GPA {education.gpa}</small>
      </article>

      <article>
        <p class="section-label">Experience</p>
        <h2>{primaryExperience.role}</h2>
        <p>{primaryExperience.organization}</p>
        <small>{primaryExperience.summary}</small>
      </article>

      <article>
        <p class="section-label">Activities</p>
        {
          activityItems.slice(0, 2).map((item) => (
            <div>
              <h3>{item.organization}</h3>
              <p>{item.role}</p>
            </div>
          ))
        }
        <small>{coursesAndCertificates[0]}</small>
      </article>
    </div>
  </section>

  <script>
    const projectWork = document.querySelector<HTMLElement>("[data-project-work]");
    const filterTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-project-filter]"));
    const viewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-view-mode]"));
    const filterLists = Array.from(document.querySelectorAll<HTMLElement>("[data-filter-list]"));
    const projectItems = Array.from(document.querySelectorAll<HTMLElement>("[data-category]"));
    let activeFilter = "";

    const setView = (view: string) => {
      projectWork?.setAttribute("data-view", view);
      viewButtons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.viewMode === view));
      });
    };

    const applyFilter = (nextFilter: string) => {
      activeFilter = nextFilter;
      filterLists.forEach((list) => list.classList.add("is-filtering"));

      window.setTimeout(() => {
        filterTabs.forEach((tab) => {
          tab.setAttribute("aria-pressed", String((tab.dataset.projectFilter ?? "") === activeFilter));
        });

        projectItems.forEach((item) => {
          item.hidden = Boolean(activeFilter) && item.dataset.category !== activeFilter;
        });

        filterLists.forEach((list) => list.classList.remove("is-filtering"));
      }, 120);
    };

    setView(window.matchMedia("(max-width: 760px)").matches ? "grid" : "list");
    viewButtons.forEach((button) => button.addEventListener("click", () => setView(button.dataset.viewMode ?? "grid")));
    filterTabs.forEach((tab) => tab.addEventListener("click", () => applyFilter(tab.dataset.projectFilter ?? "")));
  </script>
</BaseLayout>

<style>
  .dark-section {
    background: var(--surface-base);
    color: #ffffff;
  }

  .hero {
    position: relative;
    display: grid;
    min-height: 100vh;
    align-items: center;
    overflow: hidden;
    padding-block: clamp(6.5rem, 12vw, 9rem) clamp(5rem, 10vw, 8rem);
  }

  .hero::after {
    position: absolute;
    inset: auto 0 0;
    height: 10rem;
    background: linear-gradient(180deg, rgba(13, 13, 13, 0), var(--surface-light));
    content: "";
    pointer-events: none;
  }

  .hero-circle {
    position: absolute;
    border: 0.5px solid rgba(255, 255, 255, 0.06);
    border-radius: 999px;
    pointer-events: none;
  }

  .hero-circle-large {
    top: -18rem;
    right: -11rem;
    width: clamp(30rem, 52vw, 46rem);
    aspect-ratio: 1;
  }

  .hero-circle-small {
    right: 13vw;
    bottom: 16vh;
    width: clamp(10rem, 18vw, 16rem);
    aspect-ratio: 1;
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(17rem, 0.38fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 1.2rem;
  }

  .hero-person {
    display: inline-grid;
    width: fit-content;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.72rem;
    align-items: center;
  }

  .hero-person img {
    width: 3.35rem;
    height: 3.35rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    object-fit: cover;
    object-position: center 58%;
  }

  .hero-person .section-label {
    margin: 0 0 0.35rem;
  }

  .hero-person span {
    display: block;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .hero-copy .display {
    color: #ffffff;
  }

  .hero-copy p:not(.section-label) {
    max-width: 36rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: 1rem;
    line-height: 1.7;
  }

  .text-arrow {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.38rem;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .text-arrow span {
    transition: transform 200ms ease;
  }

  .text-arrow:hover span {
    transform: translateX(4px);
  }

  .role-stack {
    display: grid;
    gap: 0.72rem;
  }

  .role-stack span {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.46);
    font-size: 0.92rem;
    line-height: 1;
    padding: 0.8rem 1rem;
  }

  .role-stack .is-primary {
    border-color: rgba(29, 158, 117, 0.54);
    color: rgba(255, 255, 255, 0.82);
  }

  .flagship-section,
  .work-section,
  .resume-section {
    background: var(--surface-light);
    padding-block: clamp(4.5rem, 9vw, 7rem);
  }

  .flagship {
    display: grid;
    grid-template-columns: minmax(0, 0.45fr) minmax(18rem, 0.55fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .flagship-copy {
    display: grid;
    gap: 0.9rem;
  }

  .flagship-copy .section-label {
    color: var(--accent);
  }

  .flagship-copy h2,
  .work-head h2,
  .resume-grid h2 {
    margin: 0;
    color: var(--text);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 500;
    line-height: 1.04;
  }

  .flagship-copy p {
    margin: 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .flagship-copy > span {
    width: fit-content;
    border-radius: 999px;
    background: var(--accent-dim);
    color: var(--accent);
    font-size: 0.82rem;
    line-height: 1;
    padding: 0.55rem 0.78rem;
  }

  .flagship-proof {
    display: grid;
    gap: 0.5rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .flagship-proof li {
    position: relative;
    border-left: 2px solid var(--accent);
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.45;
    padding-left: 0.72rem;
  }

  .flagship-preview {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 14px;
    background: var(--surface-subtle);
  }

  .flagship-preview img {
    width: 100%;
    aspect-ratio: 1.55;
    object-fit: cover;
    transition: transform 200ms ease;
  }

  .flagship-preview span {
    position: absolute;
    inset: auto 1rem 1rem;
    display: grid;
    gap: 0.45rem;
    max-width: calc(100% - 2rem);
    color: #ffffff;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  .flagship-preview strong {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .flagship-preview small {
    width: fit-content;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.72rem;
    line-height: 1;
    padding: 0.42rem 0.58rem;
  }

  .flagship-preview::after {
    position: absolute;
    inset: 0;
    background: rgba(13, 13, 13, 0.44);
    content: "";
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .flagship-preview:hover img {
    transform: scale(1.02);
  }

  .flagship-preview:hover::after,
  .flagship-preview:hover span {
    opacity: 1;
  }

  .flagship-preview:hover span {
    transform: translateY(0);
    z-index: 1;
  }

  .project-work {
    display: grid;
    gap: clamp(1rem, 3vw, 1.5rem);
  }

  .work-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: end;
  }

  .filter-tabs {
    display: flex;
    gap: 0.55rem;
    overflow-x: auto;
    padding-bottom: 0.15rem;
    scrollbar-width: none;
  }

  .filter-tabs::-webkit-scrollbar {
    display: none;
  }

  .view-toggle {
    display: inline-flex;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.45);
  }

  .filter-tabs button {
    flex: 0 0 auto;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1;
    padding: 0.58rem 0.72rem;
    white-space: nowrap;
  }

  .view-toggle button {
    border: 0;
    background: transparent;
    color: var(--text-soft);
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1;
    padding: 0.58rem 0.78rem;
  }

  .view-toggle button[aria-pressed="true"],
  .filter-tabs button[aria-pressed="true"] {
    background: var(--accent-dim);
    border-color: rgba(29, 158, 117, 0.32);
    color: var(--text);
  }

  .project-grid,
  .project-list {
    transition: opacity 150ms ease;
  }

  .project-grid.is-filtering,
  .project-list.is-filtering {
    opacity: 0.3;
  }

  .project-grid {
    display: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.9rem, 2.5vw, 1.25rem);
  }

  .project-list {
    display: none;
    border-top: 1px solid var(--line);
  }

  .project-work[data-view="grid"] .project-grid,
  .project-work[data-view="list"] .project-list {
    display: grid;
  }

  .project-row {
    position: relative;
    display: grid;
    min-height: 58px;
    grid-template-columns: 3rem minmax(0, 1.3fr) minmax(8rem, 0.7fr) minmax(6rem, 0.5fr) 3.5rem 1rem;
    gap: 0.8rem;
    align-items: center;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    padding-block: 0.75rem;
    transition: background 150ms ease;
  }

  .project-row:hover {
    background: var(--surface-subtle);
  }

  .project-row span,
  .project-row small {
    color: var(--text-soft);
    font-size: 0.6875rem;
    line-height: 1.3;
  }

  .project-row strong {
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.22;
    overflow-wrap: break-word;
  }

  .project-row em {
    color: var(--accent);
    font-style: normal;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }

  .project-row:hover em {
    opacity: 1;
    transform: translateX(0);
  }

  .resume-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 6vw, 4rem);
  }

  .resume-grid article {
    display: grid;
    align-content: start;
    gap: 0.65rem;
  }

  .resume-grid p,
  .resume-grid small {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .resume-grid h3 {
    margin: 1rem 0 0;
    color: var(--text);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.2;
  }

  @media (max-width: 860px) {
    .hero-grid,
    .flagship,
    .resume-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
    }

    .work-head {
      grid-template-columns: 1fr;
      justify-items: stretch;
    }

    .view-toggle {
      width: fit-content;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-row {
      grid-template-columns: 2.3rem minmax(0, 1fr) 1rem;
      gap: 0.35rem 0.7rem;
      align-items: start;
      padding-block: 0.95rem;
    }

    .project-row span {
      grid-row: span 3;
      padding-top: 0.2rem;
    }

    .project-row strong {
      grid-column: 2;
    }

    .project-row small {
      grid-column: 2;
      display: block;
    }

    .project-row small:last-of-type {
      display: none;
    }

    .project-row em {
      grid-column: 3;
      grid-row: 1;
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-block: 5.4rem 3.6rem;
    }

    .hero-grid {
      gap: 1.8rem;
    }

    .hero-copy {
      gap: 1rem;
    }

    .hero-person img {
      width: 3rem;
      height: 3rem;
    }

    .role-stack {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .flagship-section,
    .work-section,
    .resume-section {
      padding-block: 3.25rem;
    }

    .flagship {
      gap: 1.35rem;
    }

    .flagship-copy {
      gap: 0.75rem;
    }

    .flagship-preview {
      border-radius: 8px;
    }

    .flagship-preview img {
      aspect-ratio: 4 / 3;
    }

    .flagship-preview::after,
    .flagship-preview span {
      opacity: 1;
    }

    .flagship-preview span {
      transform: none;
    }

    .filter-tabs {
      margin-inline: -0.625rem;
      padding-inline: 0.625rem;
    }
  }
</style>
