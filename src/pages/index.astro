---
import { heroProjectSlug, homeProjectSlugs, profile, education, experiences } from "@data/profile";
import { pageSeo } from "@data/seo";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getImageMeta } from "@lib/images";
import { getCategoryMeta, getSortedProjects } from "@lib/projects";
import { getResumeAction } from "@lib/resume";

const allProjects = await getSortedProjects();
type ProjectEntry = (typeof allProjects)[number];
const homeProjects = homeProjectSlugs
  .map((slug) => allProjects.find((project) => project.data.slug === slug))
  .filter((project): project is ProjectEntry => Boolean(project));
const projectCount = allProjects.length;
const resumeAction = getResumeAction();
const gpaShort = education.gpa.split("/")[0]?.trim() ?? education.gpa;
const internship = experiences[0];

const backgroundRows = [
  {
    label: "Education",
    title: education.institution,
    detail: `${education.degree}, GPA ${gpaShort}, graduating 2026`,
  },
  {
    label: "Experience",
    title: internship.organization,
    detail: internship.summary,
  },
  {
    label: "Leadership",
    title: "HMSI ITS, R&D Vice Head",
    detail: "Led member development, innovation projects, and SOP work across the department.",
  },
];

const heroLead = "I build software that";
const heroTail = "and the machine learning behind it.";
const heroSentence = `${heroLead} ships, ${heroTail}`;
let heroWordIndex = 0;

const marqueeItems = [
  "ASP.NET Core",
  "Python",
  "LightGBM",
  "Power BI",
  "SQL Server",
  "TensorFlow",
  "Optuna",
  "Docker",
  "Power Automate",
  "Scikit-learn",
];
---

<BaseLayout title={pageSeo.home.title} description={pageSeo.home.description}>
  <section class="hero">
    <svg class="hero-ornament" viewBox="0 0 220 170" aria-hidden="true">
      <circle class="orn-dot" cx="18" cy="128" r="4"></circle>
      <circle class="orn-dot" cx="52" cy="84" r="4"></circle>
      <circle class="orn-dot" cx="84" cy="132" r="4"></circle>
      <circle class="orn-dot" cx="112" cy="72" r="4"></circle>
      <circle class="orn-dot" cx="146" cy="118" r="4"></circle>
      <circle class="orn-dot" cx="196" cy="140" r="4"></circle>
      <circle class="orn-dot" cx="38" cy="40" r="4"></circle>
      <circle class="orn-dot" cx="140" cy="30" r="4"></circle>
      <circle class="orn-outlier" cx="182" cy="52" r="5.5"></circle>
      <path
        class="orn-ring"
        d="M203 44 C 198 30, 172 28, 163 42 C 154 56, 168 72, 184 70 C 200 68, 207 56, 203 46"
        pathLength="1"></path>
    </svg>

    <div class="container hero-inner" data-reveal>
      <p class="hero-kicker">
        {profile.name} &middot; Surabaya, Indonesia
      </p>

      <h1 class="display hero-title" aria-label={heroSentence}>
        <span aria-hidden="true">
          {
            heroLead.split(" ").map((word) => (
              <span class="hero-word" style={`--wi: ${heroWordIndex++}`}>
                {word}
              </span>
            ))
          }
          <span class="hero-word" style={`--wi: ${heroWordIndex++}`}>
            <em class="hero-em">
              ships,
              <svg class="hero-circle" viewBox="0 0 200 74" preserveAspectRatio="none">
                <path
                  d="M186 16 C 168 -2, 40 -4, 18 22 C -2 46, 34 70, 100 70 C 158 70, 194 54, 190 30"
                  pathLength="1"></path>
              </svg>
            </em>
          </span>
          {
            heroTail.split(" ").map((word) => (
              <span class="hero-word" style={`--wi: ${heroWordIndex++}`}>
                {word}
              </span>
            ))
          }
        </span>
      </h1>

      <p class="hero-signal">{profile.roleSignal}</p>

      <p class="hero-now">
        <span class="hero-now-dot" aria-hidden="true"></span>
        {profile.currentFocus}
      </p>

      <div class="hero-actions">
        <a class="hero-link" href="#work">View work <span aria-hidden="true">&darr;</span></a>
        <a class="hero-link" href={profile.emailHref}
          >Email me <span aria-hidden="true">&nearr;</span></a
        >
      </div>
    </div>
  </section>

  <section id="work" class="work divider">
    <div class="container">
      <div class="work-head" data-reveal>
        <p class="section-label">Selected work</p>
        <a class="work-all" href="/projects/" data-astro-prefetch="hover"
          >All {projectCount} projects <span aria-hidden="true">&rarr;</span></a
        >
      </div>

      <div class="work-list" data-work-list>
        {
          homeProjects.map((project, index) => {
            const category = getCategoryMeta(project.data.category);
            const metric = project.data.metric ?? project.data.status;
            const logo = project.data.logo ?? category.logo;
            const isAnomaly = project.data.slug === heroProjectSlug;

            return (
              <a
                class:list={["work-row", isAnomaly && "is-anomaly"]}
                href={`/projects/${project.data.slug}/`}
                data-astro-prefetch="hover"
                data-work-row={String(index)}
                data-reveal
              >
                <span class="work-index">{String(index + 1).padStart(2, "0")}</span>
                <span class="work-logo" aria-hidden="true">
                  {logo && <img src={logo} alt="" width="24" height="24" loading="lazy" decoding="async" />}
                </span>
                <span class="work-copy">
                  <span class="work-title">{project.data.title}</span>
                  <span class="work-meta">
                    {category.title} &middot; {project.data.year}
                    {isAnomaly && (
                      <span class="work-flag">
                        <span class="work-flag-dot" aria-hidden="true" /> the anomaly
                      </span>
                    )}
                  </span>
                </span>
                <span class="work-metric">{metric}</span>
                <span class="work-arrow" aria-hidden="true">
                  &rarr;
                </span>
              </a>
            );
          })
        }
      </div>
    </div>

    <div class="work-preview" data-work-preview aria-hidden="true">
      {
        homeProjects.map((project, index) => {
          const meta = getImageMeta(project.data.coverImage);

          return (
            <img
              src={project.data.coverImage}
              alt=""
              width={meta?.width}
              height={meta?.height}
              loading="lazy"
              decoding="async"
              data-work-preview-image={String(index)}
            />
          );
        })
      }
    </div>
  </section>

  <section class="background divider">
    <div class="container">
      <p class="section-label" data-reveal>Background</p>

      <dl class="background-list">
        {
          backgroundRows.map((row) => (
            <div class="background-row" data-reveal>
              <dt>{row.label}</dt>
              <dd>
                <span class="background-title">{row.title}</span>
                <span class="background-detail">{row.detail}</span>
              </dd>
            </div>
          ))
        }
      </dl>

      <a class="background-more" href="/about/" data-astro-prefetch="hover" data-reveal>
        More about me <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <aside class="marquee divider" aria-label="Tools I work with">
    <p class="sr-only">{marqueeItems.join(", ")}</p>
    <div class="marquee-track" aria-hidden="true">
      {
        [0, 1].map(() => (
          <div class="marquee-group">
            {marqueeItems.map((item, index) => (
              <span class="marquee-item">
                {item}
                <span class:list={["marquee-dot", index === 2 && "is-anomaly"]} />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </aside>

  <section id="contact" class="contact divider">
    <div class="container contact-inner" data-reveal>
      <p class="section-label">Contact</p>
      <h2 class="contact-title">Let&rsquo;s build <em>something</em>.</h2>
      <p class="contact-copy">{profile.contactPrompt}</p>

      <div class="contact-actions">
        <a class="dark-cta dark-cta-primary" href={profile.emailHref}>
          Email me <span aria-hidden="true">&nearr;</span>
        </a>

        <ul class="contact-links">
          <li>
            <a href={resumeAction.href} download={resumeAction.download ? "" : undefined}>
              {resumeAction.label}
            </a>
          </li>
          {
            profile.links
              .filter((link) => link.label !== "Email")
              .map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noreferrer">
                    {link.label}
                  </a>
                </li>
              ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initOnPageLoad } from "@lib/page-script";

  // Floating project preview: a thumbnail follows the cursor over the work
  // list. Pointer-only, decorative (aria-hidden), and skipped entirely on
  // touch devices and for reduced-motion users.
  initOnPageLoad(() => {
    const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const list = document.querySelector<HTMLElement>("[data-work-list]");
    const preview = document.querySelector<HTMLElement>("[data-work-preview]");

    if (!fine || reduceMotion || !list || !preview) {
      return;
    }

    const images = Array.from(
      preview.querySelectorAll<HTMLImageElement>("[data-work-preview-image]"),
    );
    let raf = 0;
    let x = 0;
    let y = 0;

    const render = () => {
      raf = 0;
      preview.style.transform = `translate3d(${x + 24}px, ${y - 90}px, 0)`;
    };

    const onMove = (event: PointerEvent) => {
      x = event.clientX;
      y = event.clientY;

      if (!raf) {
        raf = requestAnimationFrame(render);
      }
    };

    const onEnter = (event: Event) => {
      const row = (event.currentTarget as HTMLElement).dataset.workRow;
      images.forEach((image) => {
        image.classList.toggle("is-active", image.dataset.workPreviewImage === row);
      });
      preview.classList.add("is-visible");
    };

    const onLeave = () => {
      preview.classList.remove("is-visible");
    };

    const controller = new AbortController();
    const { signal } = controller;

    list.addEventListener("pointermove", onMove, { signal });
    list.addEventListener("pointerleave", onLeave, { signal });
    list.querySelectorAll<HTMLElement>("[data-work-row]").forEach((row) => {
      row.addEventListener("pointerenter", onEnter, { signal });
      row.addEventListener("focus", () => onLeave(), { signal });
    });

    return () => {
      controller.abort();

      if (raf) {
        cancelAnimationFrame(raf);
      }
    };
  });
</script>

<style>
  /* ------------------------------- Hero ------------------------------- */

  .hero {
    position: relative;
    overflow: clip;
    padding-block: var(--space-hero-top) var(--space-hero-bottom);
  }

  /* The anomaly mark: an ordered scatter with one flagged outlier.
     The signature of the whole site, drawn from the fraud detection thesis. */
  .hero-ornament {
    position: absolute;
    top: clamp(4.5rem, 9vw, 7rem);
    right: clamp(1rem, 6vw, 5rem);
    z-index: 0;
    width: clamp(9rem, 18vw, 14rem);
    overflow: visible;
    pointer-events: none;
  }

  .orn-dot {
    fill: var(--ink);
    opacity: 0;
    animation: orn-dot-in 500ms var(--ease-out) forwards;
  }

  .orn-dot:nth-of-type(1) { animation-delay: 80ms; }
  .orn-dot:nth-of-type(2) { animation-delay: 160ms; }
  .orn-dot:nth-of-type(3) { animation-delay: 240ms; }
  .orn-dot:nth-of-type(4) { animation-delay: 320ms; }
  .orn-dot:nth-of-type(5) { animation-delay: 400ms; }
  .orn-dot:nth-of-type(6) { animation-delay: 480ms; }
  .orn-dot:nth-of-type(7) { animation-delay: 560ms; }
  .orn-dot:nth-of-type(8) { animation-delay: 640ms; }

  @keyframes orn-dot-in {
    to {
      opacity: 0.18;
    }
  }

  .orn-outlier {
    fill: var(--signal);
    opacity: 0;
    animation: orn-outlier-in 400ms var(--ease-out) 820ms forwards;
  }

  @keyframes orn-outlier-in {
    to {
      opacity: 0.85;
    }
  }

  .orn-ring {
    fill: none;
    stroke: var(--signal);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.85;
    animation: ring-draw 650ms var(--ease-out) 1050ms forwards;
  }

  @keyframes ring-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Headline arrives word by word, once, on load */
  .hero-word {
    display: inline-block;
    margin-right: 0.24em;
    opacity: 0;
    transform: translateY(0.55em);
    animation: hero-word-in 640ms var(--ease-out) forwards;
    animation-delay: calc(var(--wi) * 60ms);
  }

  @keyframes hero-word-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* The flagged word stays ink; only the annotation is signal red,
     exactly like circling a point on a printed chart */
  .hero-em {
    position: relative;
    display: inline-block;
    color: inherit;
    font-style: italic;
    font-weight: 440;
  }

  /* The flagged word: a hand-drawn annotation circle, stroked in after the
     word lands. Same gesture as circling an outlier on a chart. */
  .hero-circle {
    position: absolute;
    inset: -0.18em -0.34em -0.16em -0.32em;
    width: calc(100% + 0.66em);
    /* Global svg rule clamps max-width to 100%, which pinned the circle to the
       word box and shifted it left. Unclamp so the insets actually apply. */
    max-width: none;
    height: calc(100% + 0.34em);
    overflow: visible;
    pointer-events: none;
  }

  .hero-circle path {
    fill: none;
    stroke: var(--signal);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.9;
    animation: circle-draw 850ms var(--ease-out) forwards;
    animation-delay: calc(var(--wi) * 60ms + 480ms);
    vector-effect: non-scaling-stroke;
  }

  @keyframes circle-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .hero-circle path {
      stroke-dashoffset: 0;
      animation: none;
    }

    .orn-dot {
      opacity: 0.18;
      animation: none;
    }

    .orn-outlier {
      opacity: 0.85;
      animation: none;
    }

    .orn-ring {
      stroke-dashoffset: 0;
      animation: none;
    }
  }

  .hero-inner {
    display: grid;
    gap: 1.5rem;
  }

  .hero-kicker {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero .display {
    max-width: 900px;
    font-size: clamp(2.7rem, 6.2vw, 5.4rem);
  }

  .hero-signal {
    max-width: 44ch;
    margin: 0;
    color: var(--ink-muted);
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    line-height: 1.6;
  }

  .hero-now {
    display: inline-flex;
    width: fit-content;
    align-items: baseline;
    gap: 0.55rem;
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.55;
  }

  .hero-now-dot {
    width: 0.42rem;
    height: 0.42rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--signal);
    transform: translateY(-0.05rem);
    animation: dot-pulse 2.4s var(--ease-standard) infinite;
  }

  @keyframes dot-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(217, 38, 55, 0.35);
    }

    50% {
      box-shadow: 0 0 0 5px rgba(217, 38, 55, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-now-dot {
      animation: none;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 0.5rem;
  }

  .hero-link {
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    transition:
      color var(--motion-fast) var(--ease-standard),
      text-decoration-color var(--motion-fast) var(--ease-standard);
  }

  .hero-link:hover {
    color: var(--rust);
    text-decoration-color: var(--rust);
  }

  .hero-link span {
    display: inline-block;
    margin-left: 0.3rem;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .hero-link:hover span {
    transform: translateX(2px);
  }

  /* ---------------------------- Work list ----------------------------- */

  .work {
    position: relative;
  }

  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .work-all {
    color: var(--ink-muted);
    font-size: 0.84rem;
    font-weight: 500;
  }

  .work-all:hover {
    color: var(--rust);
  }

  .work-all span {
    display: inline-block;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .work-all:hover span {
    transform: translateX(3px);
  }

  .work-list {
    display: grid;
  }

  .work-row {
    display: grid;
    grid-template-columns: 2.4rem 2.1rem minmax(0, 1fr) auto 2rem;
    gap: 1rem;
    align-items: baseline;
    border-top: 1px solid var(--line);
    padding-block: clamp(1.1rem, 2.6vw, 1.7rem);
    transition: background var(--motion-fast) var(--ease-standard);
  }

  .work-logo {
    align-self: center;
  }

  .work-logo img {
    width: 1.6rem;
    height: 1.6rem;
    object-fit: contain;
    filter: grayscale(1) contrast(1.15);
    opacity: 0.72;
    transition:
      filter var(--motion-medium) var(--ease-standard),
      opacity var(--motion-medium) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
  }

  .work-row:hover .work-logo img,
  .work-row:focus-visible .work-logo img {
    filter: grayscale(0);
    opacity: 1;
    transform: rotate(-8deg) scale(1.12);
  }

  .work-row:last-child {
    border-bottom: 1px solid var(--line);
  }

  /* On hover the row number gets circled, the same flagging gesture as the
     hero annotation */
  .work-index {
    position: relative;
    /* Shrink to the digits so the hover ring centers on the number, not on
       the stretched grid cell */
    justify-self: start;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1;
  }

  .work-index::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.9rem;
    height: 1.55rem;
    border: 1.5px solid var(--signal);
    border-radius: 52% 48% 55% 45% / 60% 55% 45% 50%;
    content: "";
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.6) rotate(-6deg);
    transition:
      opacity var(--motion-medium) var(--ease-out),
      transform var(--motion-medium) var(--ease-out);
    pointer-events: none;
  }

  .work-row:hover .work-index::after,
  .work-row:focus-visible .work-index::after {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1) rotate(-6deg);
  }

  .work-row:hover .work-index,
  .work-row:focus-visible .work-index {
    color: var(--ink);
  }

  /* The flagged row: one anomaly among the ordered records */
  .work-flag {
    display: inline-flex;
    align-items: center;
    gap: 0.34rem;
    margin-left: 0.55rem;
    color: var(--signal);
    letter-spacing: 0.06em;
  }

  .work-flag-dot {
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 999px;
    background: var(--signal);
  }

  .work-copy {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .work-title {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.8vw, 2.1rem);
    font-weight: 480;
    letter-spacing: -0.005em;
    line-height: 1.15;
    transition:
      color var(--motion-fast) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
  }

  .work-meta {
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .work-metric {
    max-width: 15rem;
    color: var(--ink-muted);
    font-size: 0.78rem;
    line-height: 1.45;
    text-align: right;
  }

  .work-arrow {
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1;
    text-align: right;
    transition:
      color var(--motion-fast) var(--ease-standard),
      transform var(--motion-medium) var(--ease-out);
  }

  .work-row:hover .work-title,
  .work-row:focus-visible .work-title {
    color: var(--rust-deep);
    transform: translateX(0.4rem);
  }

  .work-row:hover .work-arrow,
  .work-row:focus-visible .work-arrow {
    color: var(--rust);
    transform: translateX(4px);
  }

  /* Floating preview thumbnail (pointer devices only; positioned by JS) */
  .work-preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 30;
    width: clamp(15rem, 22vw, 19rem);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: #ffffff;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 200ms var(--ease-standard),
      scale 200ms var(--ease-out);
    scale: 0.96;
    will-change: transform;
  }

  .work-preview.is-visible {
    opacity: 1;
    scale: 1;
  }

  .work-preview img {
    display: none;
    width: 100%;
    aspect-ratio: 1.55;
    object-fit: cover;
    object-position: top left;
  }

  .work-preview img.is-active {
    display: block;
  }

  @media (hover: none), (pointer: coarse) {
    .work-preview {
      display: none;
    }
  }

  /* ---------------------------- Background ---------------------------- */

  .background-list {
    display: grid;
    margin: clamp(1.25rem, 3vw, 2rem) 0 0;
  }

  .background-row {
    display: grid;
    grid-template-columns: minmax(7rem, 0.25fr) minmax(0, 1fr);
    gap: 1rem 2rem;
